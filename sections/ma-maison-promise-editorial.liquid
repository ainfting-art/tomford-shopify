{%- comment -%}
  MAISON AMIIR — The Maison Promise (Editorial Magazine Rebuild)
  Resolved all draft database conflicts: clean decimal line-heights (no 100x division),
  lowered schema minimums to prevent lockout from older stored values, step: 1 on sliders,
  Title Case 56px serif heading, 28px italic intro, 30/70 editorial layout, and 4% watermark.
{%- endcomment -%}

{%- liquid
  assign sid         = section.id
  assign img_blocks  = section.blocks | where: 'type', 'image'
  assign deco_blocks = section.blocks | where: 'type', 'decorative'
  assign img_count   = img_blocks | size
  assign use_slider  = false
  if img_count > 1
    assign use_slider = true
  endif

  assign preset = section.settings.color_preset
  assign bg     = section.settings.bg_color
  assign ink    = section.settings.text_color
  assign gold   = '#A8894E'

  assign wm_display       = 'flex'
  if section.settings.show_watermark == false
    assign wm_display = 'none'
  endif

  assign rule_justify     = 'flex-start'
  assign cell_align_items = 'flex-start'
  if section.settings.text_align == 'center'
    assign rule_justify     = 'center'
    assign cell_align_items = 'center'
  endif
-%}

<style>
/* ═══════════════════════════════════════
   RESET & PRESETS
═══════════════════════════════════════ */
#shopify-section-{{ sid }} *,
#shopify-section-{{ sid }} *::before,
#shopify-section-{{ sid }} *::after { box-sizing: border-box; margin: 0; padding: 0; }
#shopify-section-{{ sid }} { opacity: 1 !important; transform: none !important; }

{%- if preset == 'ivory' -%}
  #shopify-section-{{ sid }} { --pm2-bg: #F4EEE1; --pm2-ink: #171310; --pm2-ink2: rgba(23,19,16,.75); --pm2-gold: #A8894E; --pm2-line: rgba(23,19,16,.06); }
{%- elsif preset == 'noir' -%}
  #shopify-section-{{ sid }} { --pm2-bg: #0c0b0a; --pm2-ink: #F4EEE1; --pm2-ink2: rgba(244,238,225,.75); --pm2-gold: #A8894E; --pm2-line: rgba(244,238,225,.06); }
{%- elsif preset == 'editorial_light' -%}
  #shopify-section-{{ sid }} { --pm2-bg: #FAFAF8; --pm2-ink: #111111; --pm2-ink2: rgba(17,17,17,.70); --pm2-gold: #A8894E; --pm2-line: rgba(17,17,17,.06); }
{%- elsif preset == 'editorial_dark' -%}
  #shopify-section-{{ sid }} { --pm2-bg: #151411; --pm2-ink: #e8e0d0; --pm2-ink2: rgba(232,224,208,.70); --pm2-gold: #C6A15B; --pm2-line: rgba(232,224,208,.06); }
{%- else -%}
  #shopify-section-{{ sid }} { --pm2-bg: {{ bg }}; --pm2-ink: {{ ink }}; --pm2-ink2: {{ section.settings.body_color }}; --pm2-gold: {{ section.settings.eyebrow_color }}; --pm2-line: {{ section.settings.grid_line_color }}; }
{%- endif -%}

/* ═══════════════════════════════════════
   SECTION SHELL
═══════════════════════════════════════ */
#shopify-section-{{ sid }} .ma-pm2 {
  position: relative;
  background: var(--pm2-bg);
  overflow: hidden;
  margin-top: {{ section.settings.margin_top }}px;
  margin-bottom: {{ section.settings.margin_bottom }}px;
  min-height: {{ section.settings.min_height }}px;
  display: flex;
  align-items: center;
}

/* ═══════════════════════════════════════
   WATERMARK — Reuses live logo reference
═══════════════════════════════════════ */
#shopify-section-{{ sid }} .ma-pm2__watermark {
  display: {{ wm_display }};
  position: absolute;
  right: {{ section.settings.wm_pos_x }}%;
  top: {{ section.settings.wm_pos_y }}%;
  transform: translate(50%, -50%) scale({{ section.settings.wm_scale | divided_by: 100.0 }}) rotate({{ section.settings.wm_rotation }}deg);
  width: min(85%, 680px);
  opacity: {{ section.settings.wm_opacity | divided_by: 100.0 }};
  pointer-events: none;
  z-index: 0;
  filter: blur({{ section.settings.wm_blur }}px);
  user-select: none;
  align-items: center;
  justify-content: center;
}
#shopify-section-{{ sid }} .ma-pm2__watermark img {
  width: 100%;
  height: auto;
  display: block;
}

/* ═══════════════════════════════════════
   DESKTOP COMPOSITION: 30% Left / 70% Right
═══════════════════════════════════════ */
@media (min-width: 900px) {
  #shopify-section-{{ sid }} .ma-pm2__layout {
    display: grid;
    grid-template-columns: {{ section.settings.left_col_width }}fr {{ section.settings.right_col_width }}fr;
    width: 100%;
    max-width: {{ section.settings.section_width }}px;
    margin: 0 auto;
    padding: {{ section.settings.pad_top }}px {{ section.settings.pad_right }}px {{ section.settings.pad_bottom }}px {{ section.settings.pad_left }}px;
    min-height: {{ section.settings.min_height }}px;
    align-items: {{ section.settings.vertical_align }};
    gap: {{ section.settings.col_gap }}px;
    position: relative;
    z-index: 1;
  }

  /* ── LEFT: Visual Composition Area ── */
  #shopify-section-{{ sid }} .ma-pm2__left {
    position: relative;
    height: 100%;
    min-height: {{ section.settings.img_height }}px;
    overflow: hidden;
    border-radius: {{ section.settings.img_radius }}px;
    {% if section.settings.img_shadow %}box-shadow: 0 25px 50px -12px rgba(0,0,0,0.18);{% endif %}
  }

  {% if section.settings.full_bleed_left %}
    #shopify-section-{{ sid }} .ma-pm2__left {
      margin-left: calc(-50vw + 50%);
      border-radius: 0 {{ section.settings.img_radius }}px {{ section.settings.img_radius }}px 0;
    }
  {% endif %}

  {% if section.settings.enable_fade_edge %}
  #shopify-section-{{ sid }} .ma-pm2__left::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: {{ section.settings.fade_width }}%;
    background: linear-gradient(to right, rgba(244,238,225,0) 0%, var(--pm2-bg) 100%);
    opacity: {{ section.settings.fade_strength | divided_by: 100.0 }};
    pointer-events: none;
    z-index: 4;
  }
  {% endif %}

  #shopify-section-{{ sid }} .ma-pm2__slider {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  #shopify-section-{{ sid }} .ma-pm2__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity {{ section.settings.slide_transition }}ms ease;
    pointer-events: none;
  }
  #shopify-section-{{ sid }} .ma-pm2__slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }
  #shopify-section-{{ sid }} .ma-pm2__slide img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.img_object_fit }};
    object-position: {{ section.settings.img_focal_x }}% {{ section.settings.img_focal_y }}%;
    transform: scale({{ section.settings.img_scale | divided_by: 100.0 }}) translate({{ section.settings.img_offset_x }}px, {{ section.settings.img_offset_y }}px);
    opacity: {{ section.settings.img_opacity | divided_by: 100.0 }};
    filter: brightness({{ section.settings.img_brightness | divided_by: 100.0 }}) contrast({{ section.settings.img_contrast | divided_by: 100.0 }}) saturate({{ section.settings.img_saturation | divided_by: 100.0 }});
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #shopify-section-{{ sid }} .ma-pm2__arrow {
    position: absolute;
    bottom: 20px;
    z-index: 10;
    background: rgba(23,19,16,0.5);
    border: 1px solid rgba(168,137,78,0.4);
    color: #A8894E;
    width: 36px; height: 36px;
    border-radius: 50%;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    font-size: 13px;
    transition: all 0.3s ease;
  }
  #shopify-section-{{ sid }} .ma-pm2__arrow:hover { background: #171310; color: #F4EEE1; }
  #shopify-section-{{ sid }} .ma-pm2__arrow--prev { left: 16px; }
  #shopify-section-{{ sid }} .ma-pm2__arrow--next { left: 60px; }

  #shopify-section-{{ sid }} .ma-pm2__dots {
    position: absolute;
    bottom: 24px;
    right: 24px;
    display: flex;
    gap: 6px;
    z-index: 10;
  }
  #shopify-section-{{ sid }} .ma-pm2__dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: rgba(168,137,78,0.4);
    border: none; cursor: pointer; padding: 0;
    transition: all 0.3s ease;
  }
  #shopify-section-{{ sid }} .ma-pm2__dot.is-active {
    background: #A8894E;
    transform: scale(1.4);
  }

  /* ── RIGHT: Centered Content Spread ── */
  #shopify-section-{{ sid }} .ma-pm2__right {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: {{ section.settings.content_pad }}px {{ section.settings.content_pad }}px {{ section.settings.content_pad }}px {{ section.settings.col_gap | divided_by: 2 }}px;
    text-align: {{ section.settings.text_align }};
  }
}

/* ═══════════════════════════════════════
   HEADER BLOCK
═══════════════════════════════════════ */
#shopify-section-{{ sid }} .ma-pm2__eyebrow {
  font-family: {{ section.settings.eyebrow_font.family }}, 'Marcellus', Georgia, serif;
  font-size: {{ section.settings.eyebrow_size }}px;
  font-weight: {{ section.settings.eyebrow_weight }};
  letter-spacing: {{ section.settings.eyebrow_spacing }}px;
  text-transform: uppercase;
  color: var(--pm2-gold);
  display: block;
  margin-bottom: 12px;
}

#shopify-section-{{ sid }} .ma-pm2__rule {
  display: flex;
  align-items: center;
  gap: 12px;
  justify-content: {{ rule_justify }};
  margin-bottom: 20px;
}
#shopify-section-{{ sid }} .ma-pm2__rule::before,
#shopify-section-{{ sid }} .ma-pm2__rule::after {
  content: '';
  display: block;
  width: 54px;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--pm2-gold), transparent);
}
#shopify-section-{{ sid }} .ma-pm2__rule-icon {
  color: var(--pm2-gold);
  font-size: 11px;
  line-height: 1;
}

#shopify-section-{{ sid }} .ma-pm2__heading {
  font-family: {{ section.settings.heading_font.family }}, 'Cormorant Garamond', Georgia, serif !important;
  font-size: {{ section.settings.heading_size }}px;
  font-weight: {{ section.settings.heading_weight }} !important;
  letter-spacing: {{ section.settings.heading_spacing }}px;
  line-height: {{ section.settings.heading_line_height }};
  text-transform: none !important;
  color: var(--pm2-ink);
  margin: 0 0 18px;
}

#shopify-section-{{ sid }} .ma-pm2__intro {
  font-family: {{ section.settings.body_font.family }}, 'Cormorant Garamond', Georgia, serif;
  font-size: {{ section.settings.body_size }}px;
  font-weight: {{ section.settings.body_weight }};
  font-style: italic;
  line-height: {{ section.settings.body_line_height }};
  letter-spacing: {{ section.settings.body_spacing }}px;
  color: var(--pm2-ink2);
  max-width: 48ch;
  margin: 0 auto {{ section.settings.grid_gap }}px;
}

/* ═══════════════════════════════════════
   PROMISE GRID
═══════════════════════════════════════ */
#shopify-section-{{ sid }} .ma-pm2__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-top: {{ section.settings.grid_line_thickness }}px {{ section.settings.grid_line_style }} var(--pm2-line);
  border-left: {{ section.settings.grid_line_thickness }}px {{ section.settings.grid_line_style }} var(--pm2-line);
  margin-bottom: {{ section.settings.grid_gap }}px;
}

#shopify-section-{{ sid }} .ma-pm2__cell {
  position: relative;
  overflow: hidden;
  padding: {{ section.settings.cell_pad }}px 20px;
  text-align: {{ section.settings.text_align }};
  border-right: {{ section.settings.grid_line_thickness }}px {{ section.settings.grid_line_style }} var(--pm2-line);
  border-bottom: {{ section.settings.grid_line_thickness }}px {{ section.settings.grid_line_style }} var(--pm2-line);
  display: flex;
  flex-direction: column;
  align-items: {{ cell_align_items }};
}

#shopify-section-{{ sid }} .ma-pm2__cell-num {
  position: absolute;
  right: 10px;
  bottom: -14px;
  font-family: {{ section.settings.heading_font.family }}, Georgia, serif;
  font-weight: 600;
  font-size: 72px;
  line-height: 1;
  color: var(--pm2-ink);
  opacity: 0.035;
  pointer-events: none;
  user-select: none;
  z-index: 0;
}

#shopify-section-{{ sid }} .ma-pm2__icon {
  position: relative;
  z-index: 1;
  display: block;
  margin-bottom: 12px;
  color: var(--pm2-gold);
}
#shopify-section-{{ sid }} .ma-pm2__icon svg {
  width: {{ section.settings.icon_size }}px;
  height: {{ section.settings.icon_size }}px;
  display: block;
  fill: none;
  stroke: currentColor;
  stroke-width: {{ section.settings.icon_stroke }};
  stroke-linecap: round;
  stroke-linejoin: round;
  opacity: {{ section.settings.icon_opacity | divided_by: 100.0 }};
}
#shopify-section-{{ sid }} .ma-pm2__icon img {
  width: {{ section.settings.icon_size }}px;
  height: {{ section.settings.icon_size }}px;
  object-fit: contain;
  display: block;
}

#shopify-section-{{ sid }} .ma-pm2__kicker {
  position: relative;
  z-index: 1;
  font-family: {{ section.settings.eyebrow_font.family }}, 'Marcellus', Georgia, serif;
  font-size: {{ section.settings.promise_kicker_size }}px;
  font-weight: {{ section.settings.eyebrow_weight }};
  letter-spacing: 0.26em;
  text-transform: uppercase;
  color: var(--pm2-gold);
  display: block;
  margin-bottom: 6px;
}

#shopify-section-{{ sid }} .ma-pm2__title {
  position: relative;
  z-index: 1;
  font-family: {{ section.settings.promise_title_font.family }}, 'Cormorant Garamond', Georgia, serif;
  font-size: {{ section.settings.promise_title_size }}px;
  font-weight: {{ section.settings.promise_title_weight }};
  line-height: 1.15;
  color: {{ section.settings.promise_title_color }};
  margin-bottom: 8px;
}

#shopify-section-{{ sid }} .ma-pm2__desc {
  position: relative;
  z-index: 1;
  font-family: {{ section.settings.promise_body_font.family }}, 'Cormorant Garamond', Georgia, serif;
  font-size: {{ section.settings.promise_body_size }}px;
  font-weight: {{ section.settings.promise_body_weight }};
  line-height: {{ section.settings.promise_body_line_height }};
  color: {{ section.settings.promise_body_color }};
  margin: 0;
}

/* ═══════════════════════════════════════
   FOUNDER SEAL
═══════════════════════════════════════ */
#shopify-section-{{ sid }} .ma-pm2__seal {
  text-align: center;
  padding: 24px 0 10px;
  border-top: 1px solid var(--pm2-line);
  position: relative;
  z-index: 1;
}
#shopify-section-{{ sid }} .ma-pm2__seal-rule {
  display: flex;
  align-items: center;
  gap: 16px;
  justify-content: center;
  margin-bottom: 14px;
}
#shopify-section-{{ sid }} .ma-pm2__seal-rule::before,
#shopify-section-{{ sid }} .ma-pm2__seal-rule::after {
  content: '';
  display: block;
  height: 1px;
  width: 90px;
  background: linear-gradient(90deg, transparent, var(--pm2-gold), transparent);
}
#shopify-section-{{ sid }} .ma-pm2__seal-badge {
  font-size: 18px;
  color: var(--pm2-gold);
  line-height: 1;
  letter-spacing: 0.15em;
}
#shopify-section-{{ sid }} .ma-pm2__sign {
  font-family: {{ section.settings.heading_font.family }}, Georgia, serif;
  font-size: {{ section.settings.body_size | minus: 4 }}px;
  font-weight: 500;
  color: var(--pm2-ink);
}
#shopify-section-{{ sid }} .ma-pm2__sign em {
  font-weight: 400;
  font-style: italic;
  color: #6E1220;
}

/* ═══════════════════════════════════════
   EDITORIAL ANIMATIONS
═══════════════════════════════════════ */
{% if section.settings.enable_animations %}
  #shopify-section-{{ sid }} .ma-pm2__anim {
    opacity: 0;
    {% if section.settings.anim_type == 'fade_up' %}transform: translateY(20px);{% endif %}
    transition: opacity {{ section.settings.anim_speed }}ms ease, transform {{ section.settings.anim_speed }}ms cubic-bezier(0.16,1,0.3,1);
  }
  #shopify-section-{{ sid }} .ma-pm2__anim.is-visible {
    opacity: 1;
    transform: none;
  }
  #shopify-section-{{ sid }} .ma-pm2__anim:nth-child(2) { transition-delay: {{ section.settings.anim_delay }}ms; }
  #shopify-section-{{ sid }} .ma-pm2__anim:nth-child(3) { transition-delay: {{ section.settings.anim_delay | times: 2 }}ms; }
  #shopify-section-{{ sid }} .ma-pm2__anim:nth-child(4) { transition-delay: {{ section.settings.anim_delay | times: 3 }}ms; }
  #shopify-section-{{ sid }} .ma-pm2__cell { opacity: 0; transform: translateY(16px); transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.16,1,0.3,1); }
  #shopify-section-{{ sid }} .ma-pm2__cell.is-visible { opacity: 1; transform: none; }
  #shopify-section-{{ sid }} .ma-pm2__cell:nth-child(2) { transition-delay: 80ms; }
  #shopify-section-{{ sid }} .ma-pm2__cell:nth-child(3) { transition-delay: 160ms; }
  #shopify-section-{{ sid }} .ma-pm2__cell:nth-child(4) { transition-delay: 240ms; }
{% endif %}

@media (prefers-reduced-motion: reduce) {
  #shopify-section-{{ sid }} * { transition: none !important; animation: none !important; }
}
</style>

{%- comment -%} ── HTML STRUCTURE ── {%- endcomment -%}

<section class="ma-pm2" id="ma-pm2-{{ sid }}">

  {%- if section.settings.show_watermark -%}
    <div class="ma-pm2__watermark" aria-hidden="true">
      <img src="https://maisonamiir.com/cdn/shop/files/MAISON-LOGO-NEW.png?v=1775626552&width=800"
           alt=""
           loading="lazy"
           width="800">
    </div>
  {%- endif -%}

  <div class="ma-pm2__layout">

    <div class="ma-pm2__left">

      {%- if img_count > 0 -%}
        <div class="ma-pm2__slider" id="ma-pm2-slider-{{ sid }}">
          {%- for block in img_blocks -%}
            <div class="ma-pm2__slide{% if forloop.first %} is-active{% endif %}"
                 data-index="{{ forloop.index0 }}"
                 {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image
                   | image_url: width: 1400
                   | image_tag:
                       loading: 'lazy',
                       alt: section.settings.heading,
                       width: block.settings.image.width,
                       height: block.settings.image.height }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'ma-pm2__placeholder' }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        {%- if use_slider -%}
          {%- if section.settings.show_arrows -%}
            <button class="ma-pm2__arrow ma-pm2__arrow--prev" aria-label="Previous image">&#8592;</button>
            <button class="ma-pm2__arrow ma-pm2__arrow--next" aria-label="Next image">&#8594;</button>
          {%- endif -%}
          {%- if section.settings.show_dots -%}
            <div class="ma-pm2__dots">
              {%- for block in img_blocks -%}
                <button class="ma-pm2__dot{% if forloop.first %} is-active{% endif %}"
                        data-index="{{ forloop.index0 }}"
                        aria-label="Image {{ forloop.index }}"></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endif -%}

      {%- else -%}
        <div class="ma-pm2__slide is-active">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'ma-pm2__placeholder' }}
        </div>
      {%- endif -%}

      {%- for block in deco_blocks -%}
        {%- if block.settings.deco_image != blank -%}
          <div class="ma-pm2__deco"
               style="position:absolute; z-index:5;
                      left:{{ block.settings.deco_x }}%; top:{{ block.settings.deco_y }}%;
                      width:{{ block.settings.deco_width }}px;
                      transform:rotate({{ block.settings.deco_rotation }}deg);
                      opacity:{{ block.settings.deco_opacity | divided_by: 100.0 }};"
               {{ block.shopify_attributes }}>
            {{ block.settings.deco_image
               | image_url: width: 400
               | image_tag: loading: 'lazy', alt: '' }}
          </div>
        {%- endif -%}
      {%- endfor -%}

    </div>

    <div class="ma-pm2__right">

      <div class="ma-pm2__header">
        {%- if section.settings.eyebrow != blank -%}
          <span class="ma-pm2__eyebrow {% if section.settings.enable_animations %}ma-pm2__anim{% endif %}">
            {{ section.settings.eyebrow | escape }}
          </span>
        {%- endif -%}

        <div class="ma-pm2__rule {% if section.settings.enable_animations %}ma-pm2__anim{% endif %}">
          <span class="ma-pm2__rule-icon">✦</span>
        </div>

        {%- if section.settings.heading != blank -%}
          <h2 class="ma-pm2__heading {% if section.settings.enable_animations %}ma-pm2__anim{% endif %}">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}

        {%- if section.settings.subline != blank -%}
          <p class="ma-pm2__intro {% if section.settings.enable_animations %}ma-pm2__anim{% endif %}">
            {{ section.settings.subline | escape }}
          </p>
        {%- endif -%}
      </div>

      <div class="ma-pm2__grid">

        <div class="ma-pm2__cell">
          <span class="ma-pm2__cell-num" aria-hidden="true">01</span>
          <span class="ma-pm2__icon" aria-hidden="true">
            {%- if section.settings.icon1 != blank -%}
              {{ section.settings.icon1 | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}
            {%- else -%}
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M9 2.5h6M10 2.5v4.6L6.5 15.1A3 3 0 0 0 9.3 20.9h5.4a3 3 0 0 0 2.8-5.8L14 7.1V2.5"/>
                <path d="M8 14.5h8"/>
              </svg>
            {%- endif -%}
          </span>
          {%- if section.settings.k1 != blank -%}<span class="ma-pm2__kicker">{{ section.settings.k1 | escape }}</span>{%- endif -%}
          {%- if section.settings.t1 != blank -%}<p class="ma-pm2__title">{{ section.settings.t1 | escape }}</p>{%- endif -%}
          {%- if section.settings.d1 != blank -%}<p class="ma-pm2__desc">{{ section.settings.d1 | escape }}</p>{%- endif -%}
        </div>

        <div class="ma-pm2__cell">
          <span class="ma-pm2__cell-num" aria-hidden="true">02</span>
          <span class="ma-pm2__icon" aria-hidden="true">
            {%- if section.settings.icon2 != blank -%}
