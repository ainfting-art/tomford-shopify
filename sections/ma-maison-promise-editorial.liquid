{%- comment -%}
  MA Maison Promise — Editorial. Standalone section, does not modify the existing
  "MA — Maison Promise" section. Watermark reuses the exact same logo source/approach
  as the current live section (large, centered, very low opacity, behind content).
{%- endcomment -%}

{%- liquid
  assign image_count = 0
  for block in section.blocks
    if block.type == 'image'
      assign image_count = image_count | plus: 1
    endif
  endfor

  assign bg = section.settings.background_color
  assign txt = section.settings.text_color
  assign hd = section.settings.heading_color
  assign eb = section.settings.eyebrow_color
  case section.settings.color_preset
    when 'maison_ivory'
      assign bg = '#f4eee1'
      assign txt = 'rgba(23,19,16,0.72)'
      assign hd = '#171310'
      assign eb = '#a8894e'
    when 'maison_noir'
      assign bg = '#14110d'
      assign txt = 'rgba(245,240,230,0.72)'
      assign hd = '#f5f0e6'
      assign eb = '#c9a24b'
    when 'editorial_light'
      assign bg = '#ffffff'
      assign txt = '#3a3a3a'
      assign hd = '#111111'
      assign eb = '#8a8a8a'
    when 'editorial_dark'
      assign bg = '#0c0b0a'
      assign txt = '#c9c2b3'
      assign hd = '#f5f0e6'
      assign eb = '#a8894e'
  endcase
-%}

{% style %}
  #shopify-section-{{ section.id }} .ma-mp2 {
    position: relative;
    overflow: hidden;
    background: {{ bg }};
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }

  /* ---------- Watermark (reused approach: large, centered, very low opacity) ---------- */
  #shopify-section-{{ section.id }} .ma-mp2__watermark {
    display: {% if section.settings.watermark_enabled %}block{% else %}none{% endif %};
    position: absolute;
    left: {{ section.settings.watermark_position_x }}%;
    top: {{ section.settings.watermark_position_y }}%;
    width: {{ section.settings.watermark_scale }}%;
    transform: translate(-50%, -50%) rotate({{ section.settings.watermark_rotation }}deg);
    opacity: {{ section.settings.watermark_opacity | times: 1.0 | divided_by: 100 }};
    filter: blur({{ section.settings.watermark_blur }}px) {% if section.settings.watermark_tone == 'grayscale' %}grayscale(1){% elsif section.settings.watermark_tone == 'gold' %}sepia(1) saturate(2) hue-rotate(-10deg){% endif %};
    z-index: 0;
    pointer-events: none;
  }

  /* ---------- Hero: image/slider + content, side by side even on mobile ---------- */
  #shopify-section-{{ section.id }} .ma-mp2__hero {
    position: relative; z-index: 1;
    display: flex;
    align-items: flex-start;
    gap: {{ section.settings.column_gap }}px;
    padding: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_right }}px 0 {{ section.settings.mobile_padding_left }}px;
  }
  #shopify-section-{{ section.id }} .ma-mp2__left {
    position: relative;
    width: {{ section.settings.mobile_hero_image_width }}%;
    flex: 0 0 {{ section.settings.mobile_hero_image_width }}%;
    aspect-ratio: 3 / 4;
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
    {% if section.settings.image_shadow %}box-shadow: 0 16px 34px rgba(0,0,0,0.22);{% endif %}
  }
  #shopify-section-{{ section.id }} .ma-mp2__slide {
    position: absolute; inset: 0; opacity: 0;
    transition: opacity 600ms ease;
  }
  #shopify-section-{{ section.id }} .ma-mp2__slide.is-active { opacity: 1; }
  #shopify-section-{{ section.id }} .ma-mp2__slide img {
    width: 100%; height: 100%;
    object-fit: {{ section.settings.image_object_fit }};
    object-position: {{ section.settings.image_position_x }}% {{ section.settings.image_position_y }}%;
    transform: scale({{ section.settings.image_scale | times: 1.0 | divided_by: 100 }});
    opacity: {{ section.settings.image_opacity | times: 1.0 | divided_by: 100 }};
  }
  #shopify-section-{{ section.id }} .ma-mp2__deco {
    position: absolute;
    z-index: 2;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .ma-mp2__dots {
    position: absolute; left: 0; right: 0; bottom: 10px; z-index: 3;
    display: flex; justify-content: center; gap: 6px;
  }
  #shopify-section-{{ section.id }} .ma-mp2__dot {
    width: 6px; height: 6px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.8);
    background: transparent; padding: 0; cursor: pointer;
  }
  #shopify-section-{{ section.id }} .ma-mp2__dot.is-active { background: rgba(255,255,255,0.9); }
  #shopify-section-{{ section.id }} .ma-mp2__arrow {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 3;
    width: 28px; height: 28px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.6);
    background: rgba(0,0,0,0.25); color: #fff; font-size: 14px; cursor: pointer;
  }
  #shopify-section-{{ section.id }} .ma-mp2__arrow--prev { left: 8px; }
  #shopify-section-{{ section.id }} .ma-mp2__arrow--next { right: 8px; }

  #shopify-section-{{ section.id }} .ma-mp2__right {
    flex: 1 1 auto;
    min-width: 0;
    text-align: left;
  }
  #shopify-section-{{ section.id }} .ma-mp2__eyebrow {
    font-family: {{ section.settings.eyebrow_font.family }}, sans-serif;
    font-size: {{ section.settings.mobile_eyebrow_size }}px;
    letter-spacing: {{ section.settings.eyebrow_letter_spacing }}px;
    text-transform: uppercase;
    color: {{ eb }};
    margin: 0 0 10px;
  }
  #shopify-section-{{ section.id }} .ma-mp2__heading {
    font-family: {{ section.settings.heading_font.family }}, serif;
    font-size: {{ section.settings.mobile_heading_size }}px;
    line-height: {{ section.settings.heading_line_height }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    color: {{ hd }};
    margin: 0 0 12px;
  }
  #shopify-section-{{ section.id }} .ma-mp2__intro {
    font-family: {{ section.settings.body_font.family }}, sans-serif;
    font-style: italic;
    font-size: {{ section.settings.mobile_body_size }}px;
    line-height: {{ section.settings.body_line_height }};
    color: {{ txt }};
    margin: 0;
  }

  /* ---------- Promises: mobile = stacked rows ---------- */
  #shopify-section-{{ section.id }} .ma-mp2__promises {
    position: relative; z-index: 1;
    padding: {{ section.settings.promise_spacing }}px {{ section.settings.mobile_padding_right }}px {{ section.settings.mobile_padding_bottom }}px {{ section.settings.mobile_padding_left }}px;
  }
  #shopify-section-{{ section.id }} .ma-mp2__promise {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: {{ section.settings.promise_spacing }}px 0;
    border-top: {{ section.settings.divider_thickness }}px {{ section.settings.divider_style }} rgba({{ section.settings.divider_color_rgb }}, {{ section.settings.divider_opacity | times: 1.0 | divided_by: 100 }});
  }
  #shopify-section-{{ section.id }} .ma-mp2__promise:first-child { border-top: 0; }
  #shopify-section-{{ section.id }} .ma-mp2__icon {
    flex: 0 0 auto;
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    color: {{ section.settings.icon_color }};
    opacity: {{ section.settings.icon_opacity | times: 1.0 | divided_by: 100 }};
  }
  #shopify-section-{{ section.id }} .ma-mp2__icon svg {
    width: 100%; height: 100%; fill: none; stroke: currentColor;
    stroke-width: 1.2; stroke-linecap: round; stroke-linejoin: round;
  }
  #shopify-section-{{ section.id }} .ma-mp2__icon img { width: 100%; height: 100%; object-fit: contain; }
  #shopify-section-{{ section.id }} .ma-mp2__promise-kicker {
    font-family: {{ section.settings.promise_title_font.family }}, sans-serif;
    font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase;
    color: {{ eb }};
    margin: 0 0 6px;
  }
  #shopify-section-{{ section.id }} .ma-mp2__promise-title {
    font-family: {{ section.settings.promise_title_font.family }}, serif;
    font-weight: {{ section.settings.promise_title_weight }};
    font-size: {{ section.settings.promise_title_size }}px;
    color: {{ hd }};
    margin: 0 0 6px;
  }
  #shopify-section-{{ section.id }} .ma-mp2__promise-body {
    font-family: {{ section.settings.promise_body_font.family }}, sans-serif;
    font-size: {{ section.settings.promise_body_size }}px;
    line-height: {{ section.settings.promise_body_line_height }};
    color: {{ txt }};
    margin: 0;
  }

  /* ---------- Signature ---------- */
  #shopify-section-{{ section.id }} .ma-mp2__signature {
    position: relative; z-index: 1;
    display: flex; align-items: center; justify-content: center; gap: 14px;
    padding: 0 20px {{ section.settings.mobile_padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .ma-mp2__sig-line {
    height: 1px; width: 44px;
    background: {{ section.settings.line_color }};
    opacity: 0.6;
  }
  #shopify-section-{{ section.id }} .ma-mp2__emblem {
    display: {% if section.settings.show_emblem %}flex{% else %}none{% endif %};
    align-items: center; justify-content: center;
    width: {{ section.settings.emblem_size }}px; height: {{ section.settings.emblem_size }}px;
    border-radius: 50%; border: 1px solid {{ section.settings.line_color }};
    opacity: {{ section.settings.emblem_opacity | times: 1.0 | divided_by: 100 }};
    font-family: {{ section.settings.heading_font.family }}, serif;
    font-size: {{ section.settings.emblem_size | times: 1.0 | divided_by: 2.6 }}px;
    color: {{ hd }};
  }

  /* ---------- Reveal animation ---------- */
  {% if section.settings.animation_type != 'none' %}
    #shopify-section-{{ section.id }} .ma-mp2__reveal {
      opacity: 0;
      transition: opacity {{ section.settings.animation_speed }}ms ease {{ section.settings.animation_delay }}ms,
                  transform {{ section.settings.animation_speed }}ms cubic-bezier(0.16,1,0.3,1) {{ section.settings.animation_delay }}ms;
    }
    {% if section.settings.animation_type == 'fade_up' %}
      #shopify-section-{{ section.id }} .ma-mp2__reveal { transform: translateY(20px); }
    {% elsif section.settings.animation_type == 'reveal' %}
      #shopify-section-{{ section.id }} .ma-mp2__reveal { transform: scale(0.97); }
    {% endif %}
    #shopify-section-{{ section.id }} .ma-mp2__reveal.is-visible { opacity: 1; transform: none; }
  {% endif %}

  /* =================================================================
     DESKTOP (min-width 750px): true 2-column + 2x2 promise grid
     ================================================================= */
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .ma-mp2__watermark { width: {{ section.settings.watermark_scale | times: 0.6 }}%; }
    #shopify-section-{{ section.id }} .ma-mp2 {
      max-width: {{ section.settings.section_width }}px;
      margin-left: auto; margin-right: auto;
      min-height: {{ section.settings.section_min_height }}px;
    }
    #shopify-section-{{ section.id }} .ma-mp2__hero {
      align-items: stretch;
      padding: {{ section.settings.padding_top }}px {{ section.settings.padding_right }}px 0 {{ section.settings.padding_left }}px;
    }
    #shopify-section-{{ section.id }} .ma-mp2__left {
      width: {{ section.settings.left_column_width }}%;
      flex: 0 0 {{ section.settings.left_column_width }}%;
      aspect-ratio: auto;
      align-self: stretch;
    }
    #shopify-section-{{ section.id }} .ma-mp2__right {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    #shopify-section-{{ section.id }} .ma-mp2__eyebrow { font-size: {{ section.settings.eyebrow_size }}px; }
    #shopify-section-{{ section.id }} .ma-mp2__heading { font-size: {{ section.settings.heading_size }}px; }
    #shopify-section-{{ section.id }} .ma-mp2__intro { font-size: {{ section.settings.body_size }}px; max-width: {{ section.settings.content_max_width }}px; }

    #shopify-section-{{ section.id }} .ma-mp2__promises {
      padding: {{ section.settings.content_spacing }}px {{ section.settings.padding_right }}px {{ section.settings.padding_bottom }}px {{ section.settings.padding_left }}px;
    }
    #shopify-section-{{ section.id }} .ma-mp2__promise-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      border-top: {{ section.settings.divider_thickness }}px {{ section.settings.divider_style }} rgba({{ section.settings.divider_color_rgb }}, {{ section.settings.divider_opacity | times: 1.0 | divided_by: 100 }});
      border-bottom: {{ section.settings.divider_thickness }}px {{ section.settings.divider_style }} rgba({{ section.settings.divider_color_rgb }}, {{ section.settings.divider_opacity | times: 1.0 | divided_by: 100 }});
    }
    #shopify-section-{{ section.id }} .ma-mp2__promise {
      display: block;
      border-top: 0;
      padding: {{ section.settings.grid_gap | plus: 24 }}px {{ section.settings.grid_gap | plus: 24 }}px;
    }
    #shopify-section-{{ section.id }} .ma-mp2__promise:nth-child(1),
    #shopify-section-{{ section.id }} .ma-mp2__promise:nth-child(2) {
      border-bottom: {{ section.settings.divider_thickness }}px {{ section.settings.divider_style }} rgba({{ section.settings.divider_color_rgb }}, {{ section.settings.divider_opacity | times: 1.0 | divided_by: 100 }});
    }
    #shopify-section-{{ section.id }} .ma-mp2__promise:nth-child(2n+1) {
      border-right: {{ section.settings.divider_thickness }}px {{ section.settings.divider_style }} rgba({{ section.settings.divider_color_rgb }}, {{ section.settings.divider_opacity | times: 1.0 | divided_by: 100 }});
    }
    #shopify-section-{{ section.id }} .ma-mp2__icon { width: {{ section.settings.icon_size | plus: 4 }}px; height: {{ section.settings.icon_size | plus: 4 }}px; margin-bottom: 14px; }
    #shopify-section-{{ section.id }} .ma-mp2__promise-title { font-size: {{ section.settings.promise_title_size | plus: 4 }}px; }
    #shopify-section-{{ section.id }} .ma-mp2__promise-body { font-size: {{ section.settings.promise_body_size }}px; }

    #shopify-section-{{ section.id }} .ma-mp2__signature { padding: 20px 20px {{ section.settings.padding_bottom }}px; }
  }
{% endstyle %}

<section
  class="ma-mp2"
  id="ma-mp2-{{ section.id }}"
  data-autoplay="{{ section.settings.slider_autoplay }}"
  data-autoplay-speed="{{ section.settings.slider_autoplay_speed }}"
  data-loop="{{ section.settings.slider_loop }}"
>
  <img
    class="ma-mp2__watermark"
    src="https://maisonamiir.com/cdn/shop/files/MAISON-LOGO-NEW.png?v=1775626552&width=800"
    alt=""
    aria-hidden="true"
    loading="lazy"
  >

  <div class="ma-mp2__hero">
    <div class="ma-mp2__left ma-mp2__reveal">
      {%- for block in section.blocks -%}
        {%- if block.type == 'image' -%}
          <div class="ma-mp2__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.image.alt | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
            {%- endif -%}
          </div>
        {%- elsif block.type == 'decorative_asset' -%}
          {%- if block.settings.image != blank -%}
            <img
              class="ma-mp2__deco"
              src="{{ block.settings.image | image_url: width: 500 }}"
              alt=""
              style="left:{{ block.settings.position_x }}%; top:{{ block.settings.position_y }}%; width:{{ block.settings.width }}px; transform:translate(-50%,-50%) rotate({{ block.settings.rotation }}deg); opacity:{{ block.settings.opacity | times: 1.0 | divided_by: 100 }};"
              loading="lazy"
              {{ block.shopify_attributes }}
            >
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if image_count > 1 and section.settings.slider_dots -%}
        <div class="ma-mp2__dots">
          {%- for i in (1..image_count) -%}
            <button type="button" class="ma-mp2__dot{% if forloop.first %} is-active{% endif %}" data-slide-to="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if image_count > 1 and section.settings.slider_arrows -%}
        <button type="button" class="ma-mp2__arrow ma-mp2__arrow--prev" data-slide-prev aria-label="Previous slide">‹</button>
        <button type="button" class="ma-mp2__arrow ma-mp2__arrow--next" data-slide-next aria-label="Next slide">›</button>
      {%- endif -%}
    </div>

    <div class="ma-mp2__right ma-mp2__reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="ma-mp2__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="ma-mp2__heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.intro != blank -%}<p class="ma-mp2__intro">{{ section.settings.intro }}</p>{%- endif -%}
    </div>
  </div>

  <div class="ma-mp2__promises ma-mp2__reveal">
    <div class="ma-mp2__promise-grid">
      {%- for i in (1..4) -%}
        {%- case i -%}
          {%- when 1 -%}{%- assign k = section.settings.k1 -%}{%- assign t = section.settings.t1 -%}{%- assign d = section.settings.d1 -%}{%- assign icon_img = section.settings.icon1 -%}
          {%- when 2 -%}{%- assign k = section.settings.k2 -%}{%- assign t = section.settings.t2 -%}{%- assign d = section.settings.d2 -%}{%- assign icon_img = section.settings.icon2 -%}
          {%- when 3 -%}{%- assign k = section.settings.k3 -%}{%- assign t = section.settings.t3 -%}{%- assign d = section.settings.d3 -%}{%- assign icon_img = section.settings.icon3 -%}
          {%- when 4 -%}{%- assign k = section.settings.k4 -%}{%- assign t = section.settings.t4 -%}{%- assign d = section.settings.d4 -%}{%- assign icon_img = section.settings.icon4 -%}
        {%- endcase -%}
        <div class="ma-mp2__promise">
          <span class="ma-mp2__icon">
            {%- if icon_img != blank -%}
              <img src="{{ icon_img | image_url: width: 80 }}" alt="">
            {%- else -%}
              {%- case i -%}
                {%- when 1 -%}<svg viewBox="0 0 24 24"><path d="M9 2.5h6M10 2.5v4.6L6.5 15.1A3 3 0 0 0 9.3 20.9h5.4a3 3 0 0 0 2.8-5.8L14 7.1V2.5"/><path d="M8 14.5h8"/></svg>
                {%- when 2 -%}<svg viewBox="0 0 24 24"><path d="M12 3l7 2.6v5.1c0 4.4-3 7.4-7 8.8-4-1.4-7-4.4-7-8.8V5.6L12 3z"/><path d="M9 12l2 2 4-4.2"/></svg>
                {%- when 3 -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4.1"/><path d="M12 2v2.3M12 19.7V22M2 12h2.3M19.7 12H22M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M19.1 4.9l-1.6 1.6M6.5 17.5l-1.6 1.6"/></svg>
                {%- when 4 -%}<svg viewBox="0 0 24 24"><path d="M12 3s6 6.6 6 11a6 6 0 0 1-12 0c0-4.4 6-11 6-11z"/><path d="M9.6 14.2a2.6 2.6 0 0 0 2.1 2.4"/></svg>
              {%- endcase -%}
            {%- endif -%}
          </span>
          {%- if k != blank -%}<p class="ma-mp2__promise-kicker">{{ k }}</p>{%- endif -%}
          {%- if t != blank -%}<p class="ma-mp2__promise-title">{{ t }}</p>{%- endif -%}
          {%- if d != blank -%}<p class="ma-mp2__promise-body">{{ d }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- if section.settings.sign != blank or section.settings.show_emblem -%}
    <div class="ma-mp2__signature ma-mp2__reveal">
      <span class="ma-mp2__sig-line"></span>
      {%- if section.settings.show_emblem -%}<span class="ma-mp2__emblem">M</span>{%- endif -%}
      <span class="ma-mp2__sig-line"></span>
    </div>
  {%- endif -%}
</section>

<script>
(function () {
  var root = document.getElementById('ma-mp2-{{ section.id }}');
  if (!root) return;

  var revealEls = root.querySelectorAll('.ma-mp2__reveal');
  if (revealEls.length && 'IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    revealEls.forEach(function (el) { io.observe(el); });
  } else {
    revealEls.forEach(function (el) { el.classList.add('is-visible'); });
  }

  var slides = root.querySelectorAll('.ma-mp2__slide');
  if (slides.length > 1) {
    var current = 0;
    var loop = root.dataset.loop === 'true';
    var autoplay = root.dataset.autoplay === 'true';
    var autoplaySpeed = parseInt(root.dataset.autoplaySpeed, 10) || 5000;
    var timer = null;

    function goTo(index) {
      if (index < 0) index = loop ? slides.length - 1 : 0;
      if (index >= slides.length) index = loop ? 0 : slides.length - 1;
      slides[current].classList.remove('is-active');
      var dots = root.querySelectorAll('.ma-mp2__dot');
      if (dots[current]) dots[current].classList.remove('is-active');
      current = index;
      slides[current].classList.add('is-active');
      if (dots[current]) dots[current].classList.add('is-active');
    }

    var prevBtn = root.querySelector('[data-slide-prev]');
    var nextBtn = root.querySelector('[data-slide-next]');
    if (prevBtn) prevBtn.addEventListener('click', function () { goTo(current - 1); resetTimer(); });
    if (nextBtn) nextBtn.addEventListener('click', function () { goTo(current + 1); resetTimer(); });
    root.querySelectorAll('.ma-mp2__dot').forEach(function (dot) {
      dot.addEventListener('click', function () { goTo(parseInt(dot.dataset.slideTo, 10)); resetTimer(); });
    });

    function resetTimer() {
      if (timer) clearInterval(timer);
      if (autoplay) timer = setInterval(function () { goTo(current + 1); }, autoplaySpeed);
    }
    resetTimer();
  }
})();
</script>

{% schema %}
{
  "name": "MA Promise Editorial",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Buy Without a Doubt" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Maison Promise" },
    { "type": "textarea", "id": "intro", "label": "Intro text", "default": "Wear it first. Decide after. A scent is personal — you should never commit to one you haven't lived with." },
    { "type": "text", "id": "sign", "label": "Sign-off (leave blank to hide)", "default": "The house takes the risk." },

    {
      "type": "header",
      "content": "Promise 01 — The Tester"
    },
    { "type": "text", "id": "k1", "label": "Kicker", "default": "The Tester" },
    { "type": "text", "id": "t1", "label": "Title", "default": "A Tester in Every Order" },
