{%- comment -%} ── JAVASCRIPT ── {%- endcomment -%}
<script>
(function () {
  var sec = document.getElementById('ma-pm2-{{ sid }}');
  if (!sec) return;

  {% if section.settings.enable_animations %}
  (function () {
    var els = sec.querySelectorAll('.ma-pm2__anim, .ma-pm2__cell');
    if (!els.length || !('IntersectionObserver' in window)) {
      els.forEach(function (el) { el.classList.add('is-visible'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    els.forEach(function (el) { io.observe(el); });
  })();
  {% endif %}

  var sliderEl = document.getElementById('ma-pm2-slider-{{ sid }}');
  if (!sliderEl) return;
  var slides = Array.from(sliderEl.querySelectorAll('.ma-pm2__slide'));
  if (slides.length < 2) return;

  var current  = 0;
  var autoplay = {{ section.settings.slider_autoplay | json }};
  var speed    = {{ section.settings.slider_speed }};
  var loop     = {{ section.settings.slider_loop | json }};
  var timer    = null;

  var dots     = Array.from(sec.querySelectorAll('.ma-pm2__dot'));
  var prevBtn  = sec.querySelector('.ma-pm2__arrow--prev');
  var nextBtn  = sec.querySelector('.ma-pm2__arrow--next');

  function goTo(idx) {
    slides[current].classList.remove('is-active');
    if (dots[current]) dots[current].classList.remove('is-active');
    current = (idx + slides.length) % slides.length;
    slides[current].classList.add('is-active');
    if (dots[current]) dots[current].classList.add('is-active');
  }

  function startAuto() {
    timer = setInterval(function () {
      if (!loop && current === slides.length - 1) { clearInterval(timer); return; }
      goTo(current + 1);
    }, speed);
  }

  if (prevBtn) prevBtn.addEventListener('click', function () { clearInterval(timer); goTo(current - 1); if (autoplay) startAuto(); });
  if (nextBtn) nextBtn.addEventListener('click', function () { clearInterval(timer); goTo(current + 1); if (autoplay) startAuto(); });
  dots.forEach(function (dot) {
    dot.addEventListener('click', function () {
      clearInterval(timer);
      goTo(parseInt(this.dataset.index, 10));
      if (autoplay) startAuto();
    });
  });

  if (autoplay) startAuto();
})();
</script>

