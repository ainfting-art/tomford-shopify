{%- comment -%} ── HTML STRUCTURE ── {%- endcomment -%}

<section class="ma-mp3" id="ma-mp3-{{ sid }}">

  {%- if section.settings.enable_texture -%}
    <div class="ma-mp3__grain" aria-hidden="true"></div>
  {%- endif -%}

  {%- if section.settings.show_watermark -%}
    <div class="ma-mp3__watermark" aria-hidden="true">
      {%- if section.settings.watermark_image != blank -%}
        <img src="{{ section.settings.watermark_image | image_url: width: 800 }}" alt="" loading="lazy">
      {%- else -%}
        <img src="https://maisonamiir.com/cdn/shop/files/MAISON-LOGO-NEW.png?v=1775626552&width=800" alt="" loading="lazy">
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="ma-mp3__wrap">

    <!-- ── LEFT: Campaign Artwork & True Pixel Dissolve Mask ── -->
    <div class="ma-mp3__img-col {% if section.settings.enable_animations %}ma-mp3__anim{% endif %}">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1400 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

    <!-- ── RIGHT: Centered Editorial Content Spread ── -->
