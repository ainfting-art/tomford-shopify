        <div class="ma-mp3__cta-wrap {% if section.settings.enable_animations %}ma-mp3__anim{% endif %}">
          <a href="{{ section.settings.cta_link }}" class="ma-mp3__cta-btn">{{ section.settings.cta_text | escape }}</a>
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

{%- comment -%} ── JAVASCRIPT ANIMATIONS ── {%- endcomment -%}
<script>
(function () {
  var sec = document.getElementById('ma-mp3-{{ sid }}');
  if (!sec) return;

  {% if section.settings.enable_animations %}
  (function () {
    var els = sec.querySelectorAll('.ma-mp3__anim, .ma-mp3__c');
    if (!els.length || !('IntersectionObserver' in window)) {
      els.forEach(function (el) { el.classList.add('is-visible'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    els.forEach(function (el) { io.observe(el); });
  })();
  {% endif %}
})();
</script>

