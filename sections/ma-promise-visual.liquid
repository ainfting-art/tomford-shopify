{%- comment -%} ── JAVASCRIPT ANIMATIONS & PARALLAX ENGINE ── {%- endcomment -%}
<script>
(function () {
  var sec = document.getElementById('ma-mp3-{{ sid }}');
  if (!sec) return;

  {% if section.settings.enable_animations %}
  (function () {
    var els = sec.querySelectorAll('.ma-mp3__anim, .ma-mp3__c');
    if (!els.length || !('IntersectionObserver' in window)) {
      els.forEach(function (el) { el.classList.add('is-visible'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    els.forEach(function (el) { io.observe(el); });
  })();
  {% endif %}

  /* ── 3. & 6. DESKTOP IMAGE & WATERMARK PARALLAX ENGINE ── */
  {% if section.settings.enable_img_parallax or section.settings.wm_anim == 'parallax' %}
    var imgCol = sec.querySelector('.ma-mp3__img-col');
    var wmEl = sec.querySelector('.ma-mp3__watermark');
    if ((imgCol || wmEl) && window.innerWidth >= 900) {
      var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReduced) {
        var ticking = false;
        var pStr = {{ section.settings.parallax_strength | default: 6 }};
        function updateParallax() {
          if (window.innerWidth < 900) {
            if (imgCol) imgCol.style.transform = '';
            ticking = false;
            return;
          }
          var rect = sec.getBoundingClientRect();
          var vh = window.innerHeight || document.documentElement.clientHeight;
          if (rect.top <= vh && rect.bottom >= 0) {
            var progress = (vh - rect.top) / (vh + rect.height);
            var yOffset = (progress - 0.5) * (pStr * 6);
            if (imgCol && {{ section.settings.enable_img_parallax | default: false }}) {
              imgCol.style.transform = 'translate3d(0, ' + yOffset.toFixed(2) + 'px, 0)';
            }
            if (wmEl && '{{ section.settings.wm_anim }}' === 'parallax') {
              var wmOffset = (progress - 0.5) * -40;
              wmEl.style.transform = 'translate(50%, -50%) scale({{ section.settings.wm_scale | default: 75 | divided_by: 100.0 }}) rotate({{ section.settings.wm_rotation | default: 0 }}deg) translate3d(0, ' + wmOffset.toFixed(2) + 'px, 0)';
            }
          }
          ticking = false;
        }
        window.addEventListener('scroll', function() {
          if (!ticking) {
            window.requestAnimationFrame(updateParallax);
            ticking = true;
          }
        }, { passive: true });
        updateParallax();
      }
    }
  {% endif %}
})();
</script>

{% schema %}
{
  "name": "MA Promise Editorial",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "── COLOR PRESETS & THEME ──"
    },
    {
      "type": "select",
      "id": "color_preset",
      "label": "Theme Mode Preset",
      "options": [
        { "value": "ivory", "label": "Maison Ivory (Warm Cream & Gold)" },
        { "value": "noir", "label": "Maison Noir (Black & Gold)" },
        { "value": "editorial_light", "label": "Editorial Light (Minimal White)" },
        { "value": "soft_linen", "label": "Soft Linen (Earth Luxury)" },
        { "value": "warm_paper", "label": "Warm Paper (Rich Heritage)" },
        { "value": "custom", "label": "Custom (Use Pickers Below)" }
      ],
      "default": "ivory"
