        {%- endif -%}

        {%- if section.settings.subline != blank -%}
          <p class="ma-mp3__s">{{ section.settings.subline | escape }}</p>
        {%- endif -%}
      </div>

      <!-- Promise 2×2 Grid -->
      <div class="ma-mp3__cards">

        <!-- Card 1 -->
        <div class="ma-mp3__c">
          <span class="ma-mp3__num" aria-hidden="true">01</span>
          <span class="ma-mp3__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M9 2.5h6M10 2.5v4.6L6.5 15.1A3 3 0 0 0 9.3 20.9h5.4a3 3 0 0 0 2.8-5.8L14 7.1V2.5"/><path d="M8 14.5h8"/></svg>
          </span>
          {%- if section.settings.k1 != blank -%}<span class="ma-mp3__kick">{{ section.settings.k1 | escape }}</span>{%- endif -%}
          {%- if section.settings.t1 != blank -%}<p class="ma-mp3__t">{{ section.settings.t1 | escape }}</p>{%- endif -%}
          {%- if section.settings.d1 != blank -%}<p class="ma-mp3__d">{{ section.settings.d1 | escape }}</p>{%- endif -%}
        </div>

        <!-- Card 2 -->
        <div class="ma-mp3__c">
          <span class="ma-mp3__num" aria-hidden="true">02</span>
          <span class="ma-mp3__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 3l7 2.6v5.1c0 4.4-3 7.4-7 8.8-4-1.4-7-4.4-7-8.8V5.6L12 3z"/><path d="M9 12l2 2 4-4.2"/></svg>
          </span>
          {%- if section.settings.k2 != blank -%}<span class="ma-mp3__kick">{{ section.settings.k2 | escape }}</span>{%- endif -%}
          {%- if section.settings.t2 != blank -%}<p class="ma-mp3__t">{{ section.settings.t2 | escape }}</p>{%- endif -%}
          {%- if section.settings.d2 != blank -%}<p class="ma-mp3__d">{{ section.settings.d2 | escape }}</p>{%- endif -%}
        </div>

        <!-- Card 3 -->
        <div class="ma-mp3__c">
          <span class="ma-mp3__num" aria-hidden="true">03</span>
          <span class="ma-mp3__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4.1"/><path d="M12 2v2.3M12 19.7V22M2 12h2.3M19.7 12H22M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M19.1 4.9l-1.6 1.6M6.5 17.5l-1.6 1.6"/></svg>
          </span>
          {%- if section.settings.k3 != blank -%}<span class="ma-mp3__kick">{{ section.settings.k3 | escape }}</span>{%- endif -%}
          {%- if section.settings.t3 != blank -%}<p class="ma-mp3__t">{{ section.settings.t3 | escape }}</p>{%- endif -%}
          {%- if section.settings.d3 != blank -%}<p class="ma-mp3__d">{{ section.settings.d3 | escape }}</p>{%- endif -%}
        </div>

        <!-- Card 4 -->
        <div class="ma-mp3__c">
          <span class="ma-mp3__num" aria-hidden="true">04</span>
          <span class="ma-mp3__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 3s6 6.6 6 11a6 6 0 0 1-12 0c0-4.4 6-11 6-11z"/><path d="M9.6 14.2a2.6 2.6 0 0 0 2.1 2.4"/></svg>
          </span>
          {%- if section.settings.k4 != blank -%}<span class="ma-mp3__kick">{{ section.settings.k4 | escape }}</span>{%- endif -%}
          {%- if section.settings.t4 != blank -%}<p class="ma-mp3__t">{{ section.settings.t4 | escape }}</p>{%- endif -%}
          {%- if section.settings.d4 != blank -%}<p class="ma-mp3__d">{{ section.settings.d4 | escape }}</p>{%- endif -%}
        </div>

      </div>

      <!-- Founder Signature Seal -->
      {%- if section.settings.sign != blank -%}
        <div class="ma-mp3__seal {% if section.settings.enable_animations %}ma-mp3__anim{% endif %}">
          <div class="ma-mp3__seal-rule">
