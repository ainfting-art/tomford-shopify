{%- comment -%}
  MA Maison Promise — Visual. Standalone section (does not modify ma-home-risk.liquid).
  Same typography/color system and watermark as the current live section, plus a hero
  image. Mobile: image beside header only, then promises as a stacked list below.
  Desktop: image spans full height on the left, promises become a 2x2 grid on the right.
{%- endcomment -%}

<section class="ma-mp3" id="ma-mp3-{{ section.id }}">
  <div class="ma-mp3__wrap">
    <div class="ma-mp3__img">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy">
      {%- endif -%}
    </div>

    <div class="ma-mp3__right">
      <img class="ma-mp3__logo" src="https://maisonamiir.com/cdn/shop/files/MAISON-LOGO-NEW.png?v=1775626552&width=800" alt="" aria-hidden="true" loading="lazy">

      <div class="ma-mp3__head">
        {%- if section.settings.eyebrow != blank -%}<p class="ma-mp3__k">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="ma-mp3__h">{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.subline != blank -%}<p class="ma-mp3__s">{{ section.settings.subline | escape }}</p>{%- endif -%}
      </div>

      <div class="ma-mp3__cards">
        <div class="ma-mp3__c">
          <span class="ma-mp3__num" aria-hidden="true">01</span>
          <span class="ma-mp3__ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 2.5h6M10 2.5v4.6L6.5 15.1A3 3 0 0 0 9.3 20.9h5.4a3 3 0 0 0 2.8-5.8L14 7.1V2.5"/><path d="M8 14.5h8"/></svg></span>
          {%- if section.settings.k1 != blank -%}<p class="ma-mp3__kick">{{ section.settings.k1 | escape }}</p>{%- endif -%}
          <p class="ma-mp3__t">{{ section.settings.t1 | escape }}</p>
          <p class="ma-mp3__d">{{ section.settings.d1 | escape }}</p>
        </div>
        <div class="ma-mp3__c">
          <span class="ma-mp3__num" aria-hidden="true">02</span>
          <span class="ma-mp3__ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3l7 2.6v5.1c0 4.4-3 7.4-7 8.8-4-1.4-7-4.4-7-8.8V5.6L12 3z"/><path d="M9 12l2 2 4-4.2"/></svg></span>
          {%- if section.settings.k2 != blank -%}<p class="ma-mp3__kick">{{ section.settings.k2 | escape }}</p>{%- endif -%}
          <p class="ma-mp3__t">{{ section.settings.t2 | escape }}</p>
          <p class="ma-mp3__d">{{ section.settings.d2 | escape }}</p>
        </div>
        <div class="ma-mp3__c">
          <span class="ma-mp3__num" aria-hidden="true">03</span>
          <span class="ma-mp3__ic" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4.1"/><path d="M12 2v2.3M12 19.7V22M2 12h2.3M19.7 12H22M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M19.1 4.9l-1.6 1.6M6.5 17.5l-1.6 1.6"/></svg></span>
          {%- if section.settings.k3 != blank -%}<p class="ma-mp3__kick">{{ section.settings.k3 | escape }}</p>{%- endif -%}
          <p class="ma-mp3__t">{{ section.settings.t3 | escape }}</p>
          <p class="ma-mp3__d">{{ section.settings.d3 | escape }}</p>
        </div>
        <div class="ma-mp3__c">
          <span class="ma-mp3__num" aria-hidden="true">04</span>
          <span class="ma-mp3__ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3s6 6.6 6 11a6 6 0 0 1-12 0c0-4.4 6-11 6-11z"/><path d="M9.6 14.2a2.6 2.6 0 0 0 2.1 2.4"/></svg></span>
          {%- if section.settings.k4 != blank -%}<p class="ma-mp3__kick">{{ section.settings.k4 | escape }}</p>{%- endif -%}
          <p class="ma-mp3__t">{{ section.settings.t4 | escape }}</p>
          <p class="ma-mp3__d">{{ section.settings.d4 | escape }}</p>
        </div>
      </div>

      {%- if section.settings.sign != blank -%}
        <div class="ma-mp3__seal">
          <div class="ma-mp3__seal-rule" aria-hidden="true"></div>
          <span class="ma-mp3__seal-mark" aria-hidden="true">M</span>
          <div class="ma-mp3__seal-rule" aria-hidden="true"></div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Marcellus&display=swap');

  #shopify-section-{{ section.id }} { opacity: 1 !important; transform: none !important; }

  #ma-mp3-{{ section.id }}.ma-mp3 {
    --pm-cream: {{ section.settings.bg_color }};
    --pm-ink: {{ section.settings.ink_color }};
    --pm-ink2: {{ section.settings.ink_color }}b3;
    --pm-gold: {{ section.settings.gold_color }};
    --pm-burg: {{ section.settings.burgundy_color }};
    --pm-line: {{ section.settings.ink_color }}24;
    --pm-serif: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    --pm-label: 'Marcellus', Georgia, serif;
    position: relative;
    background: var(--pm-cream);
    color: var(--pm-ink);
    font-family: var(--pm-serif);
    border-top: 1px solid var(--pm-line);
    border-bottom: 1px solid var(--pm-line);
  }

  #ma-mp3-{{ section.id }} .ma-mp3__wrap { position: relative; padding: 20px 20px 0; }
  #ma-mp3-{{ section.id }} .ma-mp3__img {
    float: left;
    width: {{ section.settings.mobile_image_width }}%;
    margin: 0 16px 12px 0;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 2px;
  }
  #ma-mp3-{{ section.id }} .ma-mp3__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #ma-mp3-{{ section.id }} .ma-mp3__right { position: relative; }
  #ma-mp3-{{ section.id }} .ma-mp3__logo {
    display: block;
    position: absolute;
    right: -6%;
    top: -4%;
    width: 62%;
    opacity: {{ section.settings.watermark_opacity | times: 1.0 | divided_by: 100 }};
    z-index: 0;
    pointer-events: none;
  }

  #ma-mp3-{{ section.id }} .ma-mp3__head { position: relative; z-index: 1; padding-top: 6px; }
  #ma-mp3-{{ section.id }} .ma-mp3__k {
    font-family: var(--pm-label); font-size: 9.5px; letter-spacing: .3em; text-transform: uppercase;
    color: var(--pm-burg); margin: 0 0 10px;
  }
  #ma-mp3-{{ section.id }} .ma-mp3__h {
    font-family: var(--pm-serif) !important; font-weight: 500 !important;
    text-transform: none !important; letter-spacing: .005em !important;
    font-size: {{ section.settings.mobile_heading_size }}px; line-height: 1.08; color: var(--pm-ink); margin: 0;
  }
  #ma-mp3-{{ section.id }} .ma-mp3__s {
    font-family: var(--pm-serif); font-style: italic; font-size: {{ section.settings.mobile_body_size }}px;
    line-height: 1.4; color: var(--pm-ink2); margin: 8px 0 0;
  }

  #ma-mp3-{{ section.id }} .ma-mp3__cards { clear: both; position: relative; z-index: 1; margin-top: 22px; }
  #ma-mp3-{{ section.id }} .ma-mp3__c {
    position: relative; overflow: hidden; padding: 18px 0; text-align: left;
    border-top: 1px solid var(--pm-line);
  }
  #ma-mp3-{{ section.id }} .ma-mp3__c:first-child { border-top: 0; }
  #ma-mp3-{{ section.id }} .ma-mp3__num {
    position: absolute; right: 4px; bottom: -12px; z-index: 0; pointer-events: none;
    font-family: var(--pm-serif); font-weight: 600; font-size: 60px; line-height: 1;
    color: {{ section.settings.burgundy_color }}12;
  }
  #ma-mp3-{{ section.id }} .ma-mp3__ic { display: block; position: relative; z-index: 1; width: 24px; height: 24px; color: var(--pm-gold); margin: 0 0 10px; }
  #ma-mp3-{{ section.id }} .ma-mp3__ic svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.15; stroke-linecap: round; stroke-linejoin: round; }
  #ma-mp3-{{ section.id }} .ma-mp3__kick { position: relative; z-index: 1; font-family: var(--pm-label); font-size: 8.5px; letter-spacing: .2em; text-transform: uppercase; color: var(--pm-gold); margin: 0 0 6px; }
  #ma-mp3-{{ section.id }} .ma-mp3__t { position: relative; z-index: 1; font-family: var(--pm-serif); font-weight: 600; font-size: {{ section.settings.promise_title_size_mobile }}px; line-height: 1.1; color: var(--pm-ink); margin: 0 0 6px; }
  #ma-mp3-{{ section.id }} .ma-mp3__d { position: relative; z-index: 1; font-family: var(--pm-serif); font-size: {{ section.settings.promise_body_size_mobile }}px; line-height: 1.4; color: var(--pm-ink2); margin: 0; }

  #ma-mp3-{{ section.id }} .ma-mp3__seal { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; gap: 12px; padding: 20px 0 26px; margin-top: 6px; border-top: 1px solid var(--pm-line); }
  #ma-mp3-{{ section.id }} .ma-mp3__seal-rule { height: 1px; width: 60px; background: linear-gradient(90deg, transparent, var(--pm-gold), transparent); }
  #ma-mp3-{{ section.id }} .ma-mp3__seal-mark {
    width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--pm-gold);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--pm-serif); font-size: 14px; color: var(--pm-ink);
  }

  /* ---------- DESKTOP: image spans full height left, 2x2 grid right ---------- */
  @media (min-width: 900px) {
    #ma-mp3-{{ section.id }} .ma-mp3__wrap {
      max-width: {{ section.settings.section_width }}px;
      margin: 0 auto;
      padding: {{ section.settings.desktop_padding }}px 40px;
      display: grid;
      grid-template-columns: {{ section.settings.left_column_width }}% 1fr;
      column-gap: {{ section.settings.column_gap }}px;
      align-items: stretch;
    }
    #ma-mp3-{{ section.id }} .ma-mp3__img {
      float: none; width: 100%; height: 100%; margin: 0; aspect-ratio: auto;
    }
    #ma-mp3-{{ section.id }} .ma-mp3__right { display: flex; flex-direction: column; justify-content: center; }
    #ma-mp3-{{ section.id }} .ma-mp3__logo { right: 0; top: 0; width: 55%; }
    #ma-mp3-{{ section.id }} .ma-mp3__k { font-size: 11px; letter-spacing: .4em; margin-bottom: 18px; }
    #ma-mp3-{{ section.id }} .ma-mp3__h { font-size: {{ section.settings.heading_size }}px; }
    #ma-mp3-{{ section.id }} .ma-mp3__s { font-size: {{ section.settings.body_size }}px; margin-top: 16px; max-width: 46ch; }
    #ma-mp3-{{ section.id }} .ma-mp3__cards {
      display: grid; grid-template-columns: 1fr 1fr; margin-top: 38px;
      border-top: 1px solid var(--pm-line); border-bottom: 1px solid var(--pm-line);
    }
    #ma-mp3-{{ section.id }} .ma-mp3__c { border-top: 0; padding: 30px 26px; }
    #ma-mp3-{{ section.id }} .ma-mp3__c:nth-child(1),
    #ma-mp3-{{ section.id }} .ma-mp3__c:nth-child(2) { border-bottom: 1px solid var(--pm-line); }
    #ma-mp3-{{ section.id }} .ma-mp3__c:nth-child(odd) { border-right: 1px solid var(--pm-line); padding-left: 0; }
    #ma-mp3-{{ section.id }} .ma-mp3__c:nth-child(even) { padding-right: 0; }
    #ma-mp3-{{ section.id }} .ma-mp3__num { right: 10px; bottom: -16px; font-size: 76px; }
    #ma-mp3-{{ section.id }} .ma-mp3__ic { width: 28px; height: 28px; margin-bottom: 14px; }
    #ma-mp3-{{ section.id }} .ma-mp3__t { font-size: {{ section.settings.promise_title_size_desktop }}px; margin-bottom: 10px; }
    #ma-mp3-{{ section.id }} .ma-mp3__d { font-size: {{ section.settings.promise_body_size_desktop }}px; line-height: 1.5; }
    #ma-mp3-{{ section.id }} .ma-mp3__seal { padding: 26px 0; }
    #ma-mp3-{{ section.id }} .ma-mp3__seal-rule { width: 90px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #ma-mp3-{{ section.id }} * { transition: none !important; }
  }
</style>

{% schema %}
{
  "name": "MA Promise Visual",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Buy Without a Doubt" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Maison Promise" },
    { "type": "text", "id": "subline", "label": "Sub-line", "default": "Wear it first. Decide after. A scent is personal — you should never commit to one you haven't lived with." },
    { "type": "text", "id": "sign", "label": "Show signature emblem (leave blank to hide)", "default": "M" },

    {
      "type": "header",
      "content": "Hero image"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "mobile_image_width", "label": "Image width (mobile)", "min": 35, "max": 55, "step": 1, "default": 45, "unit": "%" },
    { "type": "range", "id": "left_column_width", "label": "Image column width (desktop)", "min": 25, "max": 45, "step": 1, "default": 33, "unit": "%" },

    {
      "type": "header",
      "content": "Promise 01 — The Tester"
    },
    { "type": "text", "id": "k1", "label": "Kicker", "default": "The Tester" },
    { "type": "text", "id": "t1", "label": "Title", "default": "A Tester in Every Order" },
    { "type": "textarea", "id": "d1", "label": "Promise", "default": "Live with the scent for days before you ever break the seal on the bottle." },

    {
      "type": "header",
      "content": "Promise 02 — The Return"
    },
    { "type": "text", "id": "k2", "label": "Kicker", "default": "The Return" },
    { "type": "text", "id": "t2", "label": "Title", "default": "Seven Days to Decide" },
    { "type": "textarea", "id": "d2", "label": "Promise", "default": "Return the sealed bottle within seven days for a full refund. No questions asked." },

    {
      "type": "header",
      "content": "Promise 03 — The Climate"
    },
    { "type": "text", "id": "k3", "label": "Kicker", "default": "The Climate" },
    { "type": "text", "id": "t3", "label": "Title", "default": "Crafted for India" },
    { "type": "textarea", "id": "d3", "label": "Promise", "default": "Built for Indian skin, heat and humidity — not London winters." },

    {
      "type": "header",
      "content": "Promise 04 — The Formula"
    },
    { "type": "text", "id": "k4", "label": "Kicker", "default": "The Formula" },
    { "type": "text", "id": "t4", "label": "Title", "default": "The Oil is Everything" },
    { "type": "textarea", "id": "d4", "label": "Promise", "default": "Most of what you pay goes into the oil — not the bottle, the box, or the campaign." },

    {
      "type": "header",
      "content": "Watermark"
    },
    { "type": "range", "id": "watermark_opacity", "label": "Opacity", "min": 0, "max": 20, "step": 1, "default": 6, "unit": "%" },

    {
      "type": "header",
      "content": "Colors"
    },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#f4eee1" },
    { "type": "color", "id": "ink_color", "label": "Text (ink)", "default": "#171310" },
    { "type": "color", "id": "gold_color", "label": "Gold accent", "default": "#a8894e" },
    { "type": "color", "id": "burgundy_color", "label": "Burgundy accent (kicker)", "default": "#6e1220" },

    {
      "type": "header",
      "content": "Typography sizes"
    },
    { "type": "range", "id": "heading_size", "label": "Heading size (desktop)", "min": 32, "max": 64, "step": 1, "default": 48, "unit": "px" },
    { "type": "range", "id": "mobile_heading_size", "label": "Heading size (mobile)", "min": 22, "max": 40, "step": 1, "default": 28, "unit": "px" },
    { "type": "range", "id": "body_size", "label": "Sub-line size (desktop)", "min": 14, "max": 22, "step": 1, "default": 18, "unit": "px" },
    { "type": "range", "id": "mobile_body_size", "label": "Sub-line size (mobile)", "min": 12, "max": 18, "step": 1, "default": 14, "unit": "px" },
    { "type": "range", "id": "promise_title_size_desktop", "label": "Promise title size (desktop)", "min": 16, "max": 28, "step": 1, "default": 22, "unit": "px" },
    { "type": "range", "id": "promise_title_size_mobile", "label": "Promise title size (mobile)", "min": 14, "max": 22, "step": 1, "default": 18, "unit": "px" },
    { "type": "range", "id": "promise_body_size_desktop", "label": "Promise body size (desktop)", "min": 12, "max": 18, "step": 1, "default": 15, "unit": "px" },
    { "type": "range", "id": "promise_body_size_mobile", "label": "Promise body size (mobile)", "min": 11, "max": 16, "step": 1, "default": 13, "unit": "px" },

    {
      "type": "header",
      "content": "Layout — Desktop"
    },
    { "type": "range", "id": "section_width", "label": "Max width", "min": 1000, "max": 1500, "step": 20, "default": 1240, "unit": "px" },
    { "type": "range", "id": "column_gap", "label": "Gap between image and content", "min": 20, "max": 80, "step": 4, "default": 48, "unit": "px" },
    { "type": "range", "id": "desktop_padding", "label": "Vertical padding", "min": 20, "max": 100, "step": 5, "default": 50, "unit": "px" }
  ],
  "presets": [
    {
      "name": "MA Promise Visual"
    }
  ]
}
{% endschema %}
