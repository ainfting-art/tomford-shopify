      <div class="ma-mp3__head {% if section.settings.enable_animations %}ma-mp3__anim{% endif %}">
        {%- if section.settings.eyebrow != blank -%}
          <span class="ma-mp3__k">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}

        <div class="ma-mp3__rule">
          <span class="ma-mp3__rule-icon">✦</span>
        </div>

        {%- if section.settings.heading != blank -%}
