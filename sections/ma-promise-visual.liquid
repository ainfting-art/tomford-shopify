{%- comment -%}
  MAISON AMIIR — The Maison Promise (Editorial Campaign Rebuild)
  Features: Master text group X/Y shifting, zero-cropping image fit controls, CTA button,
  true CSS alpha-mask edge dissolve, directional studio lighting, and full typography sizing.
  100% backward compatible with all existing schema IDs.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign preset = section.settings.color_preset
  assign bg_default = section.settings.bg_color
  assign ink_default = section.settings.ink_color

  assign wm_display = 'flex'
  if section.settings.show_watermark == false
    assign wm_display = 'none'
  endif

  assign text_align = section.settings.text_align
  assign rule_justify = 'flex-start'
  assign cell_align = 'flex-start'
  if text_align == 'center'
    assign rule_justify = 'center'
    assign cell_align = 'center'
  elsif text_align == 'right'
    assign rule_justify = 'flex-end'
    assign cell_align = 'flex-end'
  endif
-%}

<style>
/* ═══════════════════════════════════════
   1. RESET & PRESET ARCHITECTURE
═══════════════════════════════════════ */
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Marcellus&display=swap');

#shopify-section-{{ sid }} *,
#shopify-section-{{ sid }} *::before,
#shopify-section-{{ sid }} *::after { box-sizing: border-box; margin: 0; padding: 0; }
#shopify-section-{{ sid }} { opacity: 1 !important; transform: none !important; width: 100% !important; max-width: none !important; }

{%- if preset == 'ivory' -%}
  #shopify-section-{{ sid }} { --pm-bg: #F4EEE1; --pm-ink: #171310; --pm-ink2: rgba(23,19,16,0.75); --pm-gold: #A8894E; --pm-burg: #6E1220; --pm-line: rgba(23,19,16,0.08); --pm-cta-bg: #171310; --pm-cta-ink: #F4EEE1; }
{%- elsif preset == 'noir' -%}
  #shopify-section-{{ sid }} { --pm-bg: #0C0B0A; --pm-ink: #F4EEE1; --pm-ink2: rgba(244,238,225,0.75); --pm-gold: #C6A15B; --pm-burg: #A8894E; --pm-line: rgba(244,238,225,0.08); --pm-cta-bg: #C6A15B; --pm-cta-ink: #0C0B0A; }
{%- elsif preset == 'editorial_light' -%}
  #shopify-section-{{ sid }} { --pm-bg: #FFFFFF; --pm-ink: #111111; --pm-ink2: rgba(17,17,17,0.70); --pm-gold: #8C703B; --pm-burg: #5A101A; --pm-line: rgba(17,17,17,0.06); --pm-cta-bg: #111111; --pm-cta-ink: #FFFFFF; }
{%- elsif preset == 'soft_linen' -%}
  #shopify-section-{{ sid }} { --pm-bg: #EFE7DB; --pm-ink: #221E1B; --pm-ink2: rgba(34,30,27,0.75); --pm-gold: #9E825E; --pm-burg: #6E1220; --pm-line: rgba(34,30,27,0.08); --pm-cta-bg: #221E1B; --pm-cta-ink: #EFE7DB; }
{%- elsif preset == 'warm_paper' -%}
  #shopify-section-{{ sid }} { --pm-bg: #F2EBE1; --pm-ink: #2A2421; --pm-ink2: rgba(42,36,33,0.75); --pm-gold: #A8894E; --pm-burg: #7A1828; --pm-line: rgba(42,36,33,0.08); --pm-cta-bg: #2A2421; --pm-cta-ink: #F2EBE1; }
{%- else -%}
  #shopify-section-{{ sid }} {
    --pm-bg: {{ bg_default }};
    --pm-ink: {{ ink_default }};
    --pm-ink2: {{ section.settings.body_color | default: 'rgba(23,19,16,0.75)' }};
    --pm-gold: {{ section.settings.gold_color }};
    --pm-burg: {{ section.settings.burgundy_color }};
    --pm-line: {{ section.settings.grid_line_color | default: 'rgba(23,19,16,0.08)' }};
    --pm-cta-bg: {{ section.settings.cta_bg_color | default: '#171310' }};
    --pm-cta-ink: {{ section.settings.cta_text_color | default: '#F4EEE1' }};
  }
{%- endif -%}

/* ═══════════════════════════════════════
   2. SECTION SHELL & PAPER GRAIN
═══════════════════════════════════════ */
#ma-mp3-{{ sid }}.ma-mp3 {
  position: relative;
  background-color: var(--pm-bg);
  color: var(--pm-ink);
  font-family: 'Cormorant Garamond', Georgia, serif;
  overflow: hidden;
  border-top: {{ section.settings.grid_line_thickness }}px {{ section.settings.grid_line_style }} var(--pm-line);
  border-bottom: {{ section.settings.grid_line_thickness }}px {{ section.settings.grid_line_style }} var(--pm-line);
  margin-top: {{ section.settings.margin_top | default: 0 }}px;
  margin-bottom: {{ section.settings.margin_bottom | default: 0 }}px;
  padding: {{ section.settings.mobile_padding_top | default: 40 }}px {{ section.settings.mobile_padding_side | default: 20 }}px {{ section.settings.mobile_padding_bottom | default: 40 }}px;
}

{% if section.settings.enable_texture %}
#ma-mp3-{{ sid }} .ma-mp3__grain {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='{{ section.settings.noise_strength | default: 0.8 }}' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='{{ section.settings.texture_opacity | divided_by: 100.0 }}'/%3E%3C/svg%3E");
  opacity: {{ section.settings.texture_opacity | divided_by: 100.0 }};
  pointer-events: none;
  z-index: 1;
}
{% endif %}

/* ═══════════════════════════════════════
   3. ARCHITECTURAL WATERMARK LOGO
═══════════════════════════════════════ */
#ma-mp3-{{ sid }} .ma-mp3__watermark {
  display: {{ wm_display }};
  position: absolute;
  right: {{ section.settings.wm_pos_x | default: 8 }}%;
  top: {{ section.settings.wm_pos_y | default: 35 }}%;
  transform: translate(50%, -50%) scale({{ section.settings.wm_scale | default: 75 | divided_by: 100.0 }}) rotate({{ section.settings.wm_rotation | default: 0 }}deg);
  width: min({{ section.settings.wm_width | default: 70 }}%, 680px);
  opacity: {{ section.settings.watermark_opacity | divided_by: 100.0 }};
  filter: blur({{ section.settings.wm_blur | default: 0 }}px);
  pointer-events: none;
  z-index: 1;
  user-select: none;
  align-items: center;
  justify-content: center;
}
#ma-mp3-{{ sid }} .ma-mp3__watermark img {
  width: 100%;
  height: auto;
  display: block;
}

/* ═══════════════════════════════════════
   4. DESKTOP EDITORIAL SPREAD
═══════════════════════════════════════ */
@media (min-width: 900px) {
  #ma-mp3-{{ sid }}.ma-mp3 {
    padding: {{ section.settings.desktop_padding_top | default: 50 }}px 0 {{ section.settings.desktop_padding_bottom | default: 50 }}px;
    min-height: {{ section.settings.min_height | default: 680 }}px;
    display: flex;
    align-items: center;
  }

  #ma-mp3-{{ sid }} .ma-mp3__wrap {
    width: 100%;
    max-width: {{ section.settings.section_width }}px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 60px);
    display: grid;
    grid-template-columns: {{ section.settings.left_column_width }}% 1fr;
    column-gap: {{ section.settings.column_gap }}px;
    align-items: stretch !important;
    position: relative;
    z-index: 2;
  }

  /* ── LEFT: Artwork & Alpha-Mask Dissolve ── */
  #ma-mp3-{{ sid }} .ma-mp3__img-col {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: {{ section.settings.img_radius | default: 0 }}px;
    overflow: hidden;
    display: block;
    {% if section.settings.img_shadow %}box-shadow: 0 30px 60px -15px rgba(0,0,0,0.18);{% endif %}
    
    /* True CSS Alpha Mask: Dissolves image into 0% opacity along the right edge */
    {% if section.settings.enable_fade %}
    -webkit-mask-image: linear-gradient(to right, rgba(0,0,0,1) 0%, rgba(0,0,0,1) calc(100% - {{ section.settings.fade_width | default: 40 }}%), rgba(0,0,0,0) 100%);
    mask-image: linear-gradient(to right, rgba(0,0,0,1) 0%, rgba(0,0,0,1) calc(100% - {{ section.settings.fade_width | default: 40 }}%), rgba(0,0,0,0) 100%);
    {% endif %}
  }

  /* Optional Full Bleed Left Edge */
  {% if section.settings.full_bleed_left %}
  #ma-mp3-{{ sid }} .ma-mp3__img-col {
    margin-left: calc(-50vw + 50%);
    width: calc(100% + 50vw - 50%);
    border-radius: 0 {{ section.settings.img_radius | default: 0 }}px {{ section.settings.img_radius | default: 0 }}px 0;
  }
  {% endif %}

  /* ZERO CROPPING FIT: Controlled via object-fit and X/Y offset sliders */
  #ma-mp3-{{ sid }} .ma-mp3__img-col img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.object_fit | default: 'cover' }};
    object-position: {{ section.settings.img_x | default: 50 }}% {{ section.settings.img_y | default: 50 }}%;
    transform: scale({{ section.settings.img_scale | default: 100 | divided_by: 100.0 }}) translate({{ section.settings.img_offset_x | default: 0 }}px, {{ section.settings.img_offset_y | default: 0 }}px);
    filter: brightness({{ section.settings.img_brightness | default: 100 }}%) contrast({{ section.settings.img_contrast | default: 100 }}%) saturate({{ section.settings.img_saturation | default: 100 }}%);
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Flat color overlay wash (distinct from the dissolve mask and directional lighting) */
  {% if section.settings.overlay_strength > 0 %}
  #ma-mp3-{{ sid }} .ma-mp3__img-col::after {
    content: '';
    position: absolute;
    inset: 0;
    background: {{ section.settings.overlay_color | default: '#000000' }};
    opacity: {{ section.settings.overlay_strength | divided_by: 100.0 }};
    pointer-events: none;
    z-index: 1;
  }
  {% endif %}

  /* Directional Studio Lighting Overlay */
  {% if section.settings.enable_lighting %}
  #ma-mp3-{{ sid }} .ma-mp3__img-col::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 30% 30%, rgba(255,255,255,{{ section.settings.highlights | default: 15 | divided_by: 100.0 }}) 0%, rgba(0,0,0,{{ section.settings.shadow_strength | default: 20 | divided_by: 100.0 }}) 100%);
    mix-blend-mode: overlay;
    pointer-events: none;
    z-index: 2;
  }
  {% endif %}

  /* ── RIGHT: MASTER TEXT GROUP REPOSITIONING ── */
  /* Moves entire text block (header, grid, seal, CTA) left/right at once */
  #ma-mp3-{{ sid }} .ma-mp3__right {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: {{ section.settings.valign | default: 'center' }};
    height: 100%;
    width: 100%;
    max-width: {{ section.settings.content_max_width | default: 760 }}px;
    margin: 0 auto;
    padding: {{ section.settings.content_pad | default: 30 }}px 0;
    text-align: {{ text_align }};
    transform: translate({{ section.settings.content_offset_x | default: 0 }}px, {{ section.settings.content_offset_y | default: 0 }}px);
  }
}

/* Mobile Image & Layout Fallback */
@media (max-width: 899px) {
  #ma-mp3-{{ sid }} .ma-mp3__wrap { display: flex; flex-direction: column; gap: 24px; position: relative; z-index: 2; }
  #ma-mp3-{{ sid }} .ma-mp3__img-col { width: {{ section.settings.mobile_image_width }}%; aspect-ratio: 4/5; overflow: hidden; border-radius: 4px; margin: 0 auto; display: flex; align-items: center; justify-content: center; }
  #ma-mp3-{{ sid }} .ma-mp3__img-col img { width: 100%; height: 100%; object-fit: contain; }
  #ma-mp3-{{ sid }} .ma-mp3__right { width: 100%; text-align: center; }
}

/* ═══════════════════════════════════════
   5. TYPOGRAPHY HIERARCHY
═══════════════════════════════════════ */
#ma-mp3-{{ sid }} .ma-mp3__head { position: relative; z-index: 2; margin-bottom: {{ section.settings.grid_gap | default: 36 }}px; }

#ma-mp3-{{ sid }} .ma-mp3__k {
  font-family: {{ section.settings.eyebrow_font.family | default: 'Marcellus' }}, Georgia, serif;
  font-size: {{ section.settings.eyebrow_size | default: 11 }}px;
  font-weight: {{ section.settings.eyebrow_weight | default: '400' }};
  letter-spacing: {{ section.settings.eyebrow_spacing | default: 3.5 }}px;
  text-transform: uppercase;
  color: var(--pm-gold);
  margin: 0 0 14px;
  display: block;
}

#ma-mp3-{{ sid }} .ma-mp3__rule {
  display: flex;
  align-items: center;
  gap: 12px;
  justify-content: {{ rule_justify }};
  margin-bottom: 20px;
}
#ma-mp3-{{ sid }} .ma-mp3__rule::before,
#ma-mp3-{{ sid }} .ma-mp3__rule::after {
  content: '';
  display: block;
  width: 48px;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--pm-gold), transparent);
}
#ma-mp3-{{ sid }} .ma-mp3__rule-icon { color: var(--pm-gold); font-size: 11px; line-height: 1; }

#ma-mp3-{{ sid }} .ma-mp3__h {
  font-family: {{ section.settings.heading_font.family | default: 'Cormorant Garamond' }}, Georgia, serif !important;
  font-size: clamp({{ section.settings.mobile_heading_size }}px, 4vw, {{ section.settings.heading_size }}px);
  font-weight: {{ section.settings.heading_weight | default: '400' }} !important;
  letter-spacing: {{ section.settings.heading_spacing | default: 0 }}px;
  line-height: {{ section.settings.heading_line_height | default: 108 | divided_by: 100.0 }};
  text-transform: {{ section.settings.heading_transform | default: 'none' }} !important;
  color: var(--pm-ink);
  margin: 0 0 18px;
}

#ma-mp3-{{ sid }} .ma-mp3__s {
  font-family: {{ section.settings.body_font.family | default: 'Cormorant Garamond' }}, Georgia, serif;
  font-size: clamp({{ section.settings.mobile_body_size }}px, 2vw, {{ section.settings.body_size }}px);
  font-weight: {{ section.settings.body_weight | default: '400' }};
  font-style: italic;
  line-height: {{ section.settings.body_line_height | default: 145 | divided_by: 100.0 }};
  letter-spacing: {{ section.settings.body_spacing | default: 0 }}px;
  color: var(--pm-ink2);
  max-width: {{ section.settings.intro_max_width | default: 52 }}ch;
  margin: 0 auto;
}
@media (min-width: 900px) {
  #ma-mp3-{{ sid }} .ma-mp3__s {
    margin: {% if text_align == 'center' %}0 auto{% elsif text_align == 'right' %}0 0 0 auto{% else %}0{% endif %};
  }
}

/* ═══════════════════════════════════════
   6. PROMISE 2×2 EDITORIAL GRID
═══════════════════════════════════════ */
#ma-mp3-{{ sid }} .ma-mp3__cards {
  display: grid;
  grid-template-columns: 1fr;
  gap: {{ section.settings.row_gap | default: 0 }}px {{ section.settings.col_gap_grid | default: 0 }}px;
  border-top: {{ section.settings.grid_line_thickness }}px {{ section.settings.grid_line_style }} var(--pm-line);
  border-bottom: {{ section.settings.grid_line_thickness }}px {{ section.settings.grid_line_style }} var(--pm-line);
  position: relative;
  z-index: 2;
}
@media (min-width: 600px) {
  #ma-mp3-{{ sid }} .ma-mp3__cards { grid-template-columns: 1fr 1fr; }
}

#ma-mp3-{{ sid }} .ma-mp3__c {
  position: relative;
  overflow: hidden;
  padding: {{ section.settings.feature_padding | default: 32 }}px 24px;
  text-align: {{ text_align }};
  display: flex;
  flex-direction: column;
  align-items: {{ cell_align }};
  border-bottom: {{ section.settings.grid_line_thickness }}px {{ section.settings.grid_line_style }} var(--pm-line);
}
@media (min-width: 600px) {
  #ma-mp3-{{ sid }} .ma-mp3__c:nth-child(odd) { border-right: {{ section.settings.grid_line_thickness }}px {{ section.settings.grid_line_style }} var(--pm-line); }
  #ma-mp3-{{ sid }} .ma-mp3__c:nth-child(3),
  #ma-mp3-{{ sid }} .ma-mp3__c:nth-child(4) { border-bottom: 0; }
}

#ma-mp3-{{ sid }} .ma-mp3__num {
  position: absolute;
  right: 12px;
  bottom: -14px;
  font-family: {{ section.settings.heading_font.family | default: 'Cormorant Garamond' }}, Georgia, serif;
  font-weight: 600;
  font-size: 76px;
  line-height: 1;
  color: var(--pm-ink);
  opacity: 0.035;
  pointer-events: none;
  user-select: none;
  z-index: 0;
}

#ma-mp3-{{ sid }} .ma-mp3__ic {
  position: relative;
  z-index: 1;
  display: block;
  margin-bottom: {{ section.settings.icon_spacing | default: 14 }}px;
  color: {{ section.settings.icon_color | default: '#A8894E' }};
  opacity: {{ section.settings.icon_opacity | default: 100 | divided_by: 100.0 }};
  transform: translateY({{ section.settings.icon_pos_y | default: 0 }}px);
}
#ma-mp3-{{ sid }} .ma-mp3__ic svg {
  width: {{ section.settings.icon_size | default: 28 }}px;
  height: {{ section.settings.icon_size | default: 28 }}px;
  display: block;
  fill: none;
  stroke: currentColor;
  stroke-width: {{ section.settings.stroke_width | default: 1.1 }};
  stroke-linecap: round;
  stroke-linejoin: round;
}

#ma-mp3-{{ sid }} .ma-mp3__kick {
  position: relative;
  z-index: 1;
  font-family: {{ section.settings.eyebrow_font.family | default: 'Marcellus' }}, Georgia, serif;
  font-size: {{ section.settings.promise_kicker_size | default: 9.5 }}px;
  letter-spacing: 0.26em;
  text-transform: uppercase;
  color: var(--pm-gold);
  margin: 0 0 6px;
}

#ma-mp3-{{ sid }} .ma-mp3__t {
  position: relative;
  z-index: 1;
  font-family: {{ section.settings.promise_title_font.family | default: 'Cormorant Garamond' }}, Georgia, serif;
  font-size: clamp({{ section.settings.promise_title_size_mobile }}px, 1.8vw, {{ section.settings.promise_title_size_desktop }}px);
  font-weight: {{ section.settings.promise_title_weight | default: '600' }};
  line-height: 1.15;
  color: var(--pm-ink);
  margin: 0 0 8px;
}

#ma-mp3-{{ sid }} .ma-mp3__d {
  position: relative;
  z-index: 1;
  font-family: {{ section.settings.promise_body_font.family | default: 'Cormorant Garamond' }}, Georgia, serif;
  font-size: clamp({{ section.settings.promise_body_size_mobile }}px, 1.4vw, {{ section.settings.promise_body_size_desktop }}px);
  font-weight: {{ section.settings.promise_body_weight | default: '400' }};
  line-height: {{ section.settings.promise_body_line_height | default: 145 | divided_by: 100.0 }};
  color: var(--pm-ink2);
  margin: 0;
  max-width: 36ch;
}

/* ═══════════════════════════════════════
   7. FOUNDER SEAL & CTA BUTTON
═══════════════════════════════════════ */
#ma-mp3-{{ sid }} .ma-mp3__seal {
  position: relative;
  z-index: 2;
  text-align: center;
  padding: 28px 0 10px;
  margin-top: 10px;
}
#ma-mp3-{{ sid }} .ma-mp3__seal-rule {
  display: flex;
  align-items: center;
  gap: 16px;
  justify-content: center;
  margin-bottom: 14px;
}
#ma-mp3-{{ sid }} .ma-mp3__seal-rule::before,
#ma-mp3-{{ sid }} .ma-mp3__seal-rule::after {
  content: '';
  display: block;
  height: 1px;
  width: 90px;
  background: linear-gradient(90deg, transparent, var(--pm-gold), transparent);
}
#ma-mp3-{{ sid }} .ma-mp3__seal-mark {
  font-size: 18px;
  color: var(--pm-gold);
  line-height: 1;
  letter-spacing: 0.15em;
}
#ma-mp3-{{ sid }} .ma-mp3__sign {
  font-family: {{ section.settings.heading_font.family | default: 'Cormorant Garamond' }}, Georgia, serif;
  font-size: clamp(16px, 1.6vw, 22px);
  font-weight: 500;
  color: var(--pm-ink);
}
#ma-mp3-{{ sid }} .ma-mp3__sign em { font-weight: 400; font-style: italic; color: var(--pm-burg); }

/* CALL TO ACTION BUTTON */
#ma-mp3-{{ sid }} .ma-mp3__cta-wrap {
  text-align: {{ text_align }};
  margin-top: {{ section.settings.cta_margin_top | default: 26 }}px;
  position: relative;
  z-index: 2;
}
#ma-mp3-{{ sid }} .ma-mp3__cta-btn {
  display: inline-block;
  padding: {{ section.settings.cta_pad_y | default: 16 }}px {{ section.settings.cta_pad_x | default: 36 }}px;
  background-color: var(--pm-cta-bg);
  color: var(--pm-cta-ink);
  font-family: {{ section.settings.eyebrow_font.family | default: 'Marcellus' }}, Georgia, serif;
  font-size: {{ section.settings.cta_font_size | default: 12 }}px;
  font-weight: 600;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  text-decoration: none;
  border-radius: {{ section.settings.cta_radius | default: 0 }}px;
  transition: opacity 0.3s ease, transform 0.3s ease;
  box-shadow: 0 12px 30px -8px rgba(0,0,0,0.2);
}
#ma-mp3-{{ sid }} .ma-mp3__cta-btn:hover {
  opacity: 0.88;
  transform: translateY(-2px);
}

/* ═══════════════════════════════════════
   8. EDITORIAL ANIMATIONS
═══════════════════════════════════════ */
{% if section.settings.enable_animations %}
  #ma-mp3-{{ sid }} .ma-mp3__anim {
    opacity: 0;
    {% if section.settings.anim_type == 'fade_up' %}transform: translateY(22px);{% endif %}
    transition: opacity {{ section.settings.anim_speed | default: 700 }}ms ease, transform {{ section.settings.anim_speed | default: 700 }}ms cubic-bezier(0.16,1,0.3,1);
  }
  #ma-mp3-{{ sid }} .ma-mp3__anim.is-visible { opacity: 1; transform: none; }
  #ma-mp3-{{ sid }} .ma-mp3__anim:nth-child(2) { transition-delay: {{ section.settings.anim_delay | default: 100 }}ms; }
  #ma-mp3-{{ sid }} .ma-mp3__anim:nth-child(3) { transition-delay: {{ section.settings.anim_delay | default: 100 | times: 2 }}ms; }
  #ma-mp3-{{ sid }} .ma-mp3__c { opacity: 0; transform: translateY(18px); transition: opacity 0.65s ease, transform 0.65s cubic-bezier(0.16,1,0.3,1); }
  #ma-mp3-{{ sid }} .ma-mp3__c.is-visible { opacity: 1; transform: none; }
  #ma-mp3-{{ sid }} .ma-mp3__c:nth-child(2) { transition-delay: 90ms; }
  #ma-mp3-{{ sid }} .ma-mp3__c:nth-child(3) { transition-delay: 180ms; }
  #ma-mp3-{{ sid }} .ma-mp3__c:nth-child(4) { transition-delay: 270ms; }
{% endif %}

@media (prefers-reduced-motion: reduce) {
