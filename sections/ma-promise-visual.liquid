{%- comment -%}
  MAISON AMIIR — The Maison Promise (Editorial Campaign Rebuild)
  Desktop: 100% preserved and untouched (full vertical bleed, zero cropping).
  Mobile: Hero section above divider re-engineered into an independent editorial magazine 
  cover with floating left artwork, horizontal/bottom feathered fade, upper-right watermark 
  depth, and X/Y text group positioning. Feature cards below divider kept 100% intact.
  100% deduplicated and optimized schema: 227 settings (safely below Shopify's 250 limit).
  EXTENDED: Includes all 8 optional Theme Customizer control groups.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign preset = section.settings.color_preset
  assign bg_default = section.settings.bg_color
  assign ink_default = section.settings.ink_color

  assign wm_display = 'flex'
  if section.settings.show_watermark == false
    assign wm_display = 'none'
  endif

  assign text_align = section.settings.text_align
  assign rule_justify = 'flex-start'
  assign cell_align = 'flex-start'
  if text_align == 'center'
    assign rule_justify = 'center'
    assign cell_align = 'center'
  elsif text_align == 'right'
    assign rule_justify = 'flex-end'
    assign cell_align = 'flex-end'
  endif
-%}

<style>
/* ═══════════════════════════════════════
   1. RESET & PRESET ARCHITECTURE
═══════════════════════════════════════ */
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Marcellus&display=swap');

#shopify-section-{{ sid }} *,
#shopify-section-{{ sid }} *::before,
#shopify-section-{{ sid }} *::after { box-sizing: border-box; margin: 0; padding: 0; }
#shopify-section-{{ sid }} { opacity: 1 !important; transform: none !important; width: 100% !important; max-width: none !important; }

{%- if preset == 'ivory' -%}
  #shopify-section-{{ sid }} { --pm-bg: #F4EEE1; --pm-ink: #171310; --pm-ink2: rgba(23,19,16,0.75); --pm-gold: #A8894E; --pm-burg: #6E1220; --pm-line: rgba(23,19,16,0.08); --pm-cta-bg: #171310; --pm-cta-ink: #F4EEE1; }
{%- elsif preset == 'noir' -%}
  #shopify-section-{{ sid }} { --pm-bg: #0C0B0A; --pm-ink: #F4EEE1; --pm-ink2: rgba(244,238,225,0.75); --pm-gold: #C6A15B; --pm-burg: #A8894E; --pm-line: rgba(244,238,225,0.08); --pm-cta-bg: #C6A15B; --pm-cta-ink: #0C0B0A; }
{%- elsif preset == 'editorial_light' -%}
  #shopify-section-{{ sid }} { --pm-bg: #FFFFFF; --pm-ink: #111111; --pm-ink2: rgba(17,17,17,0.70); --pm-gold: #8C703B; --pm-burg: #5A101A; --pm-line: rgba(17,17,17,0.06); --pm-cta-bg: #111111; --pm-cta-ink: #FFFFFF; }
{%- elsif preset == 'soft_linen' -%}
  #shopify-section-{{ sid }} { --pm-bg: #EFE7DB; --pm-ink: #221E1B; --pm-ink2: rgba(34,30,27,0.75); --pm-gold: #9E825E; --pm-burg: #6E1220; --pm-line: rgba(34,30,27,0.08); --pm-cta-bg: #221E1B; --pm-cta-ink: #EFE7DB; }
{%- elsif preset == 'warm_paper' -%}
  #shopify-section-{{ sid }} { --pm-bg: #F2EBE1; --pm-ink: #2A2421; --pm-ink2: rgba(42,36,33,0.75); --pm-gold: #A8894E; --pm-burg: #7A1828; --pm-line: rgba(42,36,33,0.08); --pm-cta-bg: #2A2421; --pm-cta-ink: #F2EBE1; }
{%- else -%}
  #shopify-section-{{ sid }} {
    --pm-bg: {{ bg_default }};
    --pm-ink: {{ ink_default }};
    --pm-ink2: {{ section.settings.body_color | default: 'rgba(23,19,16,0.75)' }};
    --pm-gold: {{ section.settings.gold_color }};
    --pm-burg: {{ section.settings.burgundy_color }};
    --pm-line: {{ section.settings.grid_line_color | default: 'rgba(23,19,16,0.08)' }};
    --pm-cta-bg: {{ section.settings.cta_bg_color | default: '#171310' }};
    --pm-cta-ink: {{ section.settings.cta_text_color | default: '#F4EEE1' }};
  }
{%- endif -%}

/* ═══════════════════════════════════════
   2. SECTION SHELL & PAPER GRAIN
═══════════════════════════════════════ */
#ma-mp3-{{ sid }}.ma-mp3 {
  position: relative;
  background-color: var(--pm-bg);
  color: var(--pm-ink);
  font-family: 'Cormorant Garamond', Georgia, serif;
  overflow: hidden;
  border-top: {{ section.settings.grid_line_thickness }}px {{ section.settings.grid_line_style }} var(--pm-line);
  border-bottom: {{ section.settings.grid_line_thickness }}px {{ section.settings.grid_line_style }} var(--pm-line);
  margin-top: 0px;
  margin-bottom: 0px;
  padding: {{ section.settings.mobile_padding_top | default: 40 }}px {{ section.settings.mobile_padding_side | default: 20 }}px {{ section.settings.mobile_padding_bottom | default: 40 }}px;
}

{% if section.settings.enable_texture %}
#ma-mp3-{{ sid }} .ma-mp3__grain {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='{{ section.settings.noise_strength | default: 0.8 }}' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='{{ section.settings.texture_opacity | divided_by: 100.0 }}'/%3E%3C/svg%3E");
  opacity: {{ section.settings.texture_opacity | divided_by: 100.0 }};
  pointer-events: none;
  z-index: 1;
}
{% endif %}

/* ═══════════════════════════════════════
   3. ARCHITECTURAL WATERMARK LOGO
═══════════════════════════════════════ */
#ma-mp3-{{ sid }} .ma-mp3__watermark {
  display: {{ wm_display }};
  position: absolute;
  right: {{ section.settings.wm_pos_x | default: 8 }}%;
  top: {{ section.settings.wm_pos_y | default: 35 }}%;
  transform: translate(50%, -50%) scale({{ section.settings.wm_scale | default: 75 | divided_by: 100.0 }}) rotate({{ section.settings.wm_rotation | default: 0 }}deg);
  width: min({{ section.settings.wm_width | default: 70 }}%, 680px);
  opacity: {{ section.settings.watermark_opacity | divided_by: 100.0 }};
  filter: blur({{ section.settings.wm_blur | default: 0 }}px);
  pointer-events: none;
  z-index: 1;
  user-select: none;
  align-items: center;
  justify-content: center;
  mix-blend-mode: {{ section.settings.wm_blend_mode | default: 'multiply' }};
}
#ma-mp3-{{ sid }} .ma-mp3__watermark img {
  width: 100%;
  height: auto;
  display: block;
}

/* ═══════════════════════════════════════
   4. DESKTOP SPREAD (100% PRESERVED & UNTOUCHED)
═══════════════════════════════════════ */
@media (min-width: 900px) {
  #ma-mp3-{{ sid }}.ma-mp3 {
    padding: 0 !important;
    min-height: {{ section.settings.min_height | default: 680 }}px;
    display: flex;
    align-items: stretch !important;
  }

  #ma-mp3-{{ sid }} .ma-mp3__wrap {
    width: 100%;
    max-width: {{ section.settings.section_width }}px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 60px);
    display: grid;
    grid-template-columns: {{ section.settings.left_column_width }}% 1fr;
    column-gap: {{ section.settings.column_gap }}px;
    align-items: stretch !important;
    position: relative;
    z-index: 2;
  }

  #ma-mp3-{{ sid }} .ma-mp3__img-col {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 100%;
    margin: 0;
    border-radius: {{ section.settings.img_radius | default: 0 }}px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    {% if section.settings.img_shadow %}box-shadow: 0 30px 60px -15px rgba(0,0,0,0.18);{% endif %}
    {% if section.settings.enable_fade %}
    -webkit-mask-image: linear-gradient(to right, rgba(0,0,0,1) 0%, rgba(0,0,0,1) calc(100% - {{ section.settings.fade_width | default: 40 }}%), rgba(0,0,0,0) 100%);
    mask-image: linear-gradient(to right, rgba(0,0,0,1) 0%, rgba(0,0,0,1) calc(100% - {{ section.settings.fade_width | default: 40 }}%), rgba(0,0,0,0) 100%);
    {% endif %}
  }

  {% if section.settings.full_bleed_left %}
  #ma-mp3-{{ sid }} .ma-mp3__img-col {
    margin-left: calc(-50vw + 50%);
    width: calc(100% + 50vw - 50%);
    border-radius: 0 {{ section.settings.img_radius | default: 0 }}px {{ section.settings.img_radius | default: 0 }}px 0;
  }
  {% endif %}

  #ma-mp3-{{ sid }} .ma-mp3__img-col img.ma-mp3__img-desktop {
    width: 100% !important;
    height: 100% !important;
    max-height: none !important;
    object-fit: {{ section.settings.object_fit | default: 'cover' }} !important;
    object-position: {{ section.settings.img_x | default: 50 }}% {{ section.settings.img_y | default: 50 }}% !important;
    transform: scale({{ section.settings.img_scale | default: 100 | divided_by: 100.0 }}) translate({{ section.settings.img_offset_x | default: 0 }}px, {{ section.settings.img_offset_y | default: 0 }}px) !important;
    display: block !important;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #ma-mp3-{{ sid }} .ma-mp3__img-col img.ma-mp3__img-mobile { display: none !important; }

  {% if section.settings.overlay_strength > 0 %}
  #ma-mp3-{{ sid }} .ma-mp3__img-col::after {
    content: ''; position: absolute; inset: 0; background: {{ section.settings.overlay_color | default: '#000000' }};
    opacity: {{ section.settings.overlay_strength | divided_by: 100.0 }}; pointer-events: none; z-index: 1;
  }
  {% endif %}

  {% if section.settings.enable_lighting %}
  #ma-mp3-{{ sid }} .ma-mp3__img-col::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(circle at 30% 30%, rgba(255,255,255,{{ section.settings.highlights | default: 15 | divided_by: 100.0 }}) 0%, rgba(0,0,0,{{ section.settings.shadow_strength | default: 20 | divided_by: 100.0 }}) 100%);
    mix-blend-mode: overlay; pointer-events: none; z-index: 2;
  }
  {% endif %}

  #ma-mp3-{{ sid }} .ma-mp3__right {
    position: relative; z-index: 2; display: flex; flex-direction: column; justify-content: {{ section.settings.valign | default: 'center' }};
    height: 100%; width: 100%; max-width: {{ section.settings.content_max_width | default: 760 }}px; margin: 0 auto;
    padding: {{ section.settings.desktop_padding_top | default: 50 }}px 0 {{ section.settings.desktop_padding_bottom | default: 50 }}px;
    text-align: {{ text_align }};
    transform: translate({{ section.settings.content_offset_x | default: 0 }}px, {{ section.settings.content_offset_y | default: 0 }}px);
  }

  #ma-mp3-{{ sid }} .ma-mp3__c-left,
  #ma-mp3-{{ sid }} .ma-mp3__c-right { display: flex; flex-direction: column; align-items: inherit; width: 100%; }

  /* ── 1. PROMISE CARD HOVER (DESKTOP ONLY) ── */
  {% if section.settings.enable_card_hover %}
    #ma-mp3-{{ sid }} .ma-mp3__c {
      transition: transform {{ section.settings.card_hover_duration | default: 450 }}ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow {{ section.settings.card_hover_duration | default: 450 }}ms ease !important;
    }
    #ma-mp3-{{ sid }} .ma-mp3__c:hover {
      transform: translateY(-{{ section.settings.hover_lift_distance | default: 4 }}px) !important;
      box-shadow: 0 16px 36px -10px rgba(0, 0, 0, {{ section.settings.card_shadow_strength | default: 12 | divided_by: 100.0 }}) !important;
      z-index: 3 !important;
    }
  {% endif %}

  /* ── 3. IMAGE MOTION (DESKTOP ONLY) ── */
  {% if section.settings.enable_img_hover_zoom %}
    #ma-mp3-{{ sid }} .ma-mp3__img-col:hover img.ma-mp3__img-desktop {
      transform: scale(calc({{ section.settings.img_scale | default: 100 | divided_by: 100.0 }} * {{ section.settings.hover_scale_pct | default: 102 | divided_by: 100.0 }})) translate({{ section.settings.img_offset_x | default: 0 }}px, {{ section.settings.img_offset_y | default: 0 }}px) !important;
    }
  {% endif %}
}

/* ═══════════════════════════════════════
   5. TYPOGRAPHY HIERARCHY
═══════════════════════════════════════ */
#ma-mp3-{{ sid }} .ma-mp3__head { position: relative; z-index: 2; margin-bottom: 36px; }

#ma-mp3-{{ sid }} .ma-mp3__k {
  font-family: {{ section.settings.eyebrow_font.family | default: 'Marcellus' }}, Georgia, serif;
  font-size: {{ section.settings.eyebrow_size | default: 11 }}px;
  font-weight: {{ section.settings.eyebrow_weight | default: '400' }};
  letter-spacing: {{ section.settings.eyebrow_spacing | default: 3.5 }}px;
  text-transform: uppercase;
  color: var(--pm-gold);
  margin: 0 0 14px;
  display: block;
}

#ma-mp3-{{ sid }} .ma-mp3__rule {
  display: flex; align-items: center; gap: 12px; justify-content: {{ rule_justify }}; margin-bottom: 20px;
  opacity: {{ section.settings.divider_opacity_pct | default: 18 | divided_by: 100.0 }};
  width: {{ section.settings.divider_width_pct | default: 100 }}%;
  margin-left: auto; margin-right: auto;
}
#ma-mp3-{{ sid }} .ma-mp3__rule::before,
#ma-mp3-{{ sid }} .ma-mp3__rule::after {
  content: ''; display: block; width: 48px; height: 1px; background: linear-gradient(90deg, transparent, var(--pm-gold), transparent);
}
#ma-mp3-{{ sid }} .ma-mp3__rule-icon { color: var(--pm-gold); font-size: 11px; line-height: 1; }

#ma-mp3-{{ sid }} .ma-mp3__h {
  font-family: {{ section.settings.heading_font.family | default: 'Cormorant Garamond' }}, Georgia, serif !important;
  font-size: clamp({{ section.settings.mobile_heading_size }}px, 4vw, {{ section.settings.heading_size }}px);
  font-weight: {{ section.settings.heading_weight | default: '400' }} !important;
  letter-spacing: {{ section.settings.heading_spacing | default: 0 }}px;
  line-height: {{ section.settings.heading_line_height | default: 108 | divided_by: 100.0 }};
  text-transform: {{ section.settings.heading_transform | default: 'none' }} !important;
  color: var(--pm-ink);
  margin: 0 0 18px;
}

#ma-mp3-{{ sid }} .ma-mp3__s {
  font-family: {{ section.settings.body_font.family | default: 'Cormorant Garamond' }}, Georgia, serif;
  font-size: clamp({{ section.settings.mobile_body_size }}px, 2vw, {{ section.settings.body_size }}px);
  font-weight: {{ section.settings.body_weight | default: '400' }};
  font-style: italic;
  line-height: {{ section.settings.body_line_height | default: 145 | divided_by: 100.0 }};
  letter-spacing: {{ section.settings.body_spacing | default: 0 }}px;
  color: var(--pm-ink2);
  max-width: {{ section.settings.intro_max_width | default: 52 }}ch;
  margin: 0 auto;
}
@media (min-width: 900px) {
  #ma-mp3-{{ sid }} .ma-mp3__s {
    margin: {% if text_align == 'center' %}0 auto{% elsif text_align == 'right' %}0 0 0 auto{% else %}0{% endif %};
  }
}

/* ═══════════════════════════════════════
   6. PROMISE 2×2 EDITORIAL GRID
═══════════════════════════════════════ */
#ma-mp3-{{ sid }} .ma-mp3__cards {
  display: grid;
  grid-template-columns: 1fr;
  gap: {{ section.settings.row_gap | default: 0 }}px 0px;
  border-top: {{ section.settings.grid_line_thickness }}px {{ section.settings.grid_line_style }} var(--pm-line);
  border-bottom: {{ section.settings.grid_line_thickness }}px {{ section.settings.grid_line_style }} var(--pm-line);
  position: relative;
  z-index: 2;
}
@media (min-width: 600px) {
  #ma-mp3-{{ sid }} .ma-mp3__cards { grid-template-columns: 1fr 1fr; }
}

#ma-mp3-{{ sid }} .ma-mp3__c {
  position: relative;
  overflow: hidden;
  padding: {{ section.settings.feature_padding | default: 32 }}px 24px;
  text-align: {{ text_align }};
  display: flex;
  flex-direction: column;
  align-items: {% case section.settings.card_content_align %}{% when 'center' %}center{% else %}flex-start{% endcase %};
  justify-content: {% case section.settings.card_content_align %}{% when 'center' %}center{% else %}flex-start{% endcase %};
  border-bottom: {{ section.settings.grid_line_thickness }}px {{ section.settings.grid_line_style }} var(--pm-line);
  max-width: {{ section.settings.card_max_width | default: 340 }}px;
  margin-left: auto;
  margin-right: auto;
  width: 100%;
}
@media (min-width: 600px) {
  #ma-mp3-{{ sid }} .ma-mp3__c:nth-child(odd) { border-right: {{ section.settings.grid_line_thickness }}px {{ section.settings.grid_line_style }} var(--pm-line); }
  #ma-mp3-{{ sid }} .ma-mp3__c:nth-child(3),
  #ma-mp3-{{ sid }} .ma-mp3__c:nth-child(4) { border-bottom: 0; }
}

#ma-mp3-{{ sid }} .ma-mp3__num {
  position: absolute; right: 12px; bottom: -14px;
  font-family: {{ section.settings.heading_font.family | default: 'Cormorant Garamond' }}, Georgia, serif;
  font-weight: 600; font-size: 76px; line-height: 1; color: var(--pm-ink); 
  opacity: {% if section.settings.show_ed_numbers %}{{ section.settings.num_opacity | default: 8 | divided_by: 100.0 }}{% else %}0.035{% endif %}; 
  transform: scale({{ section.settings.num_scale | default: 100 | divided_by: 100.0 }});
  pointer-events: none; user-select: none; z-index: 0;
}

#ma-mp3-{{ sid }} .ma-mp3__ic {
  position: relative; z-index: 1; display: block; margin-bottom: 14px;
  color: {{ section.settings.icon_color | default: '#A8894E' }};
}
#ma-mp3-{{ sid }} .ma-mp3__ic svg {
  width: {{ section.settings.icon_size | default: 28 }}px; height: {{ section.settings.icon_size | default: 28 }}px;
  display: block; fill: none; stroke: currentColor; stroke-width: {{ section.settings.stroke_width | default: 1.1 }}; stroke-linecap: round; stroke-linejoin: round;
}

#ma-mp3-{{ sid }} .ma-mp3__c-right {
  display: flex;
  flex-direction: column;
  gap: {{ section.settings.internal_card_gap | default: 20 }}px;
}

#ma-mp3-{{ sid }} .ma-mp3__kick {
  position: relative; z-index: 1; font-family: {{ section.settings.eyebrow_font.family | default: 'Marcellus' }}, Georgia, serif;
  font-size: {{ section.settings.promise_kicker_size | default: 9.5 }}px; letter-spacing: 0.26em; text-transform: uppercase; color: var(--pm-gold); margin: 0 0 6px;
}

#ma-mp3-{{ sid }} .ma-mp3__t {
  position: relative; z-index: 1; font-family: {{ section.settings.promise_title_font.family | default: 'Cormorant Garamond' }}, Georgia, serif;
  font-size: clamp({{ section.settings.promise_title_size_mobile }}px, 1.8vw, {{ section.settings.promise_title_size_desktop }}px);
  font-weight: 600; line-height: 1.15; color: var(--pm-ink); margin: 0 0 8px;
}

#ma-mp3-{{ sid }} .ma-mp3__d {
  position: relative; z-index: 1; font-family: {{ section.settings.promise_body_font.family | default: 'Cormorant Garamond' }}, Georgia, serif;
  font-size: clamp({{ section.settings.promise_body_size_mobile }}px, 1.4vw, {{ section.settings.promise_body_size_desktop }}px);
  font-weight: {{ section.settings.promise_body_weight | default: '400' }}; line-height: 1.45;
  color: var(--pm-ink2); margin: 0; max-width: 36ch;
}

/* ═══════════════════════════════════════
   7. FOUNDER SEAL & CTA BUTTON
═══════════════════════════════════════ */
#ma-mp3-{{ sid }} .ma-mp3__seal { 
  position: relative; z-index: 2; 
  text-align: {{ section.settings.sig_align | default: 'center' | downcase }}; 
  padding: {{ section.settings.sig_top_spacing | default: 32 }}px 0 10px; 
  margin-top: 10px; 
}
#ma-mp3-{{ sid }} .ma-mp3__seal-rule { 
  display: flex; align-items: center; gap: 16px; 
  justify-content: {% if section.settings.sig_align == 'Left' %}flex-start{% elsif section.settings.sig_align == 'Right' %}flex-end{% else %}center{% endif %}; 
  margin-bottom: 14px; 
}
#ma-mp3-{{ sid }} .ma-mp3__seal-rule::before,
#ma-mp3-{{ sid }} .ma-mp3__seal-rule::after { 
  content: ''; display: block; height: 1px; width: 90px; background: linear-gradient(90deg, transparent, var(--pm-gold), transparent); 
}
#ma-mp3-{{ sid }} .ma-mp3__seal-mark { font-size: 18px; color: var(--pm-gold); line-height: 1; letter-spacing: 0.15em; }
#ma-mp3-{{ sid }} .ma-mp3__sign { font-family: {{ section.settings.heading_font.family | default: 'Cormorant Garamond' }}, Georgia, serif; font-size: {{ section.settings.sig_font_size | default: 20 }}px; font-weight: 500; color: var(--pm-ink); }
#ma-mp3-{{ sid }} .ma-mp3__sign em { font-weight: 400; font-style: italic; color: var(--pm-burg); }

/* CALL TO ACTION BUTTON */
#ma-mp3-{{ sid }} .ma-mp3__cta-wrap { text-align: {{ text_align }}; margin-top: {{ section.settings.cta_margin_top | default: 26 }}px; position: relative; z-index: 2; }
#ma-mp3-{{ sid }} .ma-mp3__cta-btn {
  display: inline-block; padding: {{ section.settings.cta_pad_y | default: 16 }}px {{ section.settings.cta_pad_x | default: 36 }}px;
  background-color: var(--pm-cta-bg); color: var(--pm-cta-ink); font-family: {{ section.settings.eyebrow_font.family | default: 'Marcellus' }}, Georgia, serif;
  font-size: {{ section.settings.cta_font_size | default: 12 }}px; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase;
  text-decoration: none; border-radius: {{ section.settings.cta_radius | default: 0 }}px; transition: opacity 0.3s ease, transform 0.3s ease; box-shadow: 0 12px 30px -8px rgba(0,0,0,0.2);
}
#ma-mp3-{{ sid }} .ma-mp3__cta-btn:hover { opacity: 0.88; transform: translateY(-2px); }

/* ═══════════════════════════════════════
   8. DEDICATED MOBILE HERO SPREAD (<900px)
   Hero above divider built as 2 independent layers (Image + Content).
   Feature cards below divider kept 100% untouched as requested.
═══════════════════════════════════════ */
@media (max-width: 899px) {
  #ma-mp3-{{ sid }} .ma-mp3__wrap {
    display: block !important;
    position: relative !important;
    z-index: 2 !important;
    padding-top: {{ section.settings.mob_hero_height | default: 560 }}px !important;
  }

  /* LAYER 1: Independent Floating Left Artwork Stage */
  #ma-mp3-{{ sid }} .ma-mp3__img-col {
    display: {% if section.settings.mob_hero_img_enable != false %}block{% else %}none{% endif %} !important;
    position: absolute !important;
    top: {{ section.settings.mob_hero_img_y | default: 0 }}px !important;
    left: {{ section.settings.mob_hero_img_x | default: 0 }}px !important;
    width: {{ section.settings.mob_hero_img_w | default: 60 }}% !important;
    height: {{ section.settings.mob_hero_img_h | default: 520 }}px !important;
    z-index: 1 !important;
    border-radius: {{ section.settings.mob_hero_img_rad | default: 0 }}px !important;
    overflow: hidden !important;
    margin: 0 !important;
    {% if section.settings.mobile_img_shadow %}box-shadow: 0 20px 45px -10px rgba(0,0,0,0.18) !important;{% endif %}
  }

  #ma-mp3-{{ sid }} .ma-mp3__img-col img.ma-mp3__img-desktop { display: none !important; }
  #ma-mp3-{{ sid }} .ma-mp3__img-col img.ma-mp3__img-mobile {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    max-height: none !important;
    object-fit: {{ section.settings.mob_hero_img_fit | default: 'cover' }} !important;
    object-position: {{ section.settings.mob_hero_img_pos_x | default: 50 }}% {{ section.settings.mob_hero_img_pos_y | default: 50 }}% !important;
    transform: scale({{ section.settings.mob_hero_img_scale | default: 100 | divided_by: 100.0 }}) rotate({{ section.settings.mob_hero_img_rot | default: 0 }}deg) !important;
  }

  /* Dual Horizontal & Bottom Feathered Fade Overlay */
  {% if section.settings.mob_hero_fade_enable %}
  #ma-mp3-{{ sid }} .ma-mp3__img-col{

    -webkit-mask-image:
    linear-gradient(
        to right,
        black 0%,
        black 55%,
        rgba(0,0,0,.85) 70%,
        rgba(0,0,0,.45) 82%,
        transparent 100%
    );

    mask-image:
    linear-gradient(
        to right,
        black 0%,
        black 55%,
        rgba(0,0,0,.85) 70%,
        rgba(0,0,0,.45) 82%,
        transparent 100%
    );
}
  #ma-mp3-{{ sid }} .ma-mp3__img-col::before {
    content: '';
    position: absolute !important;
    left: 0 !important; right: 0 !important; bottom: 0 !important;
    height: {{ section.settings.mob_hero_fade_h | default: 35 }}% !important;
    background: linear-gradient(to bottom, rgba(244,238,225,0) 0%, {{ section.settings.mob_hero_fade_color | default: 'var(--pm-bg)' }} 100%) !important;
    opacity: {{ section.settings.mob_hero_fade_str | default: 95 | divided_by: 100.0 }} !important;
    pointer-events: none !important;
    z-index: 2 !important;
  }
  {% endif %}

  /* Atmospheric Upper-Right Watermark Behind Heading */
  #ma-mp3-{{ sid }} .ma-mp3__watermark {
    display: {% if section.settings.mob_wm_enable != false %}flex{% else %}none{% endif %} !important;
    right: {{ section.settings.mob_wm_x | default: -5 }}% !important;
    top: {{ section.settings.mob_wm_y | default: 15 }}% !important;
    width: {{ section.settings.mob_wm_w | default: 75 }}% !important;
    height: {{ section.settings.mob_wm_h | default: 320 }}px !important;
    transform: translate(0%, -50%) rotate({{ section.settings.mob_wm_rot | default: 0 }}deg) !important;
    opacity: 0.05 !important;
    z-index: 2 !important;
    align-items: center !important;
    justify-content: center !important;
  }

  /* LAYER 2: Independent Magazine Cover Content Stage in Clean Negative Space */
  #ma-mp3-{{ sid }} .ma-mp3__head {
    position: absolute !important;
    top: {{ section.settings.mob_cont_y | default: 25 }}px !important;
    left: {{ section.settings.mob_cont_x | default: 42 }}% !important;
    width: {{ section.settings.mob_cont_w | default: 56 }}% !important;
    z-index: 3 !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: {{ section.settings.mob_cont_valign | default: 'flex-start' }} !important;
    align-items: {% if section.settings.mob_cont_align == 'left' %}flex-start{% elsif section.settings.mob_cont_align == 'right' %}flex-end{% else %}center{% endif %} !important;
    text-align: {{ section.settings.mob_cont_align | default: 'center' }} !important;
    margin: 0 !important;
    padding: 0 clamp(8px, 2vw, 16px) !important;
  }

  #ma-mp3-{{ sid }} .ma-mp3__k {
    font-size: {{ section.settings.mobile_eyebrow_size | default: 10 }}px !important;
    letter-spacing: {{ section.settings.mobile_eyebrow_spacing | default: 3 }}px !important;
    margin-top: {{ section.settings.mobile_eyebrow_margin_top | default: 8 }}px !important;
    margin-bottom: 14px !important;
  }

  /* Centered Decorative Ornament Divider */
  #ma-mp3-{{ sid }} .ma-mp3__rule {
    width: {{ section.settings.mob_orn_w | default: 48 }}px !important;
    margin-bottom: 14px !important;
    justify-content: center !important;
  }
  #ma-mp3-{{ sid }} .ma-mp3__rule-icon { color: {{ section.settings.mob_orn_color | default: 'var(--pm-gold)' }} !important; }
  #ma-mp3-{{ sid }} .ma-mp3__rule::before,
  #ma-mp3-{{ sid }} .ma-mp3__rule::after {
    background: linear-gradient(90deg, transparent, {{ section.settings.mob_orn_color | default: 'var(--pm-gold)' }}, transparent) !important;
  }

  /* Overlapping Right-Side Hierarchy */
  #ma-mp3-{{ sid }} .ma-mp3__h {
    width: 100% !important;
    max-width: none !important;
    font-size: {{ section.settings.mobile_heading_size | default: 34 }}px !important;
    font-weight: {{ section.settings.mobile_heading_weight | default: '400' }} !important;
    line-height: {{ section.settings.mobile_heading_line_height | default: 106 | divided_by: 100.0 }} !important;
    letter-spacing: {{ section.settings.mobile_heading_spacing | default: 0 }}px !important;
    margin-bottom: {{ section.settings.mobile_heading_margin_bottom | default: 16 }}px !important;
  }

  #ma-mp3-{{ sid }} .ma-mp3__s {
    font-size: {{ section.settings.mobile_body_size | default: 17 }}px !important;
    line-height: {{ section.settings.mobile_body_line_height | default: 145 | divided_by: 100.0 }} !important;
    max-width: {{ section.settings.mob_para_w | default: 36 }}ch !important;
    margin: 0 auto !important;
  }

  /* Feature Cards Below First Divider (Kept 100% Untouched in Normal Flow as Requested) */
  #ma-mp3-{{ sid }} .ma-mp3__right {
    position: static !important;
    width: 100% !important;
    transform: none !important;
    padding: 0 !important;
  }

  #ma-mp3-{{ sid }} .ma-mp3__cards {
    display: flex !important;
    flex-direction: column !important;
    gap: 0px !important;
    margin-top: 10px !important;
    border-top: {{ section.settings.mobile_divider_thickness | default: 1 }}px solid rgba(23,19,16,0.1) !important;
    border-bottom: {{ section.settings.mobile_divider_thickness | default: 1 }}px solid rgba(23,19,16,0.1) !important;
    position: relative !important;
    z-index: 4 !important;
  }
  #ma-mp3-{{ sid }} .ma-mp3__c {
    display: grid !important;
    grid-template-columns: {{ section.settings.mobile_card_left_width | default: 30 }}% 1fr !important;
    column-gap: 14px !important;
    padding: {{ section.settings.mobile_card_padding_y | default: 26 }}px clamp(12px, 3vw, 24px) !important;
    border-bottom: {{ section.settings.mobile_divider_thickness | default: 1 }}px solid rgba(23,19,16,0.1) !important;
    border-right: 0 !important;
    align-items: flex-start !important;
    text-align: left !important;
  }
  #ma-mp3-{{ sid }} .ma-mp3__c:last-child { border-bottom: 0 !important; }
  #ma-mp3-{{ sid }} .ma-mp3__c-left { display: flex !important; flex-direction: column !important; align-items: center !important; text-align: center !important; padding-top: 2px !important; }
  #ma-mp3-{{ sid }} .ma-mp3__c-right { display: flex !important; flex-direction: column !important; align-items: flex-start !important; text-align: left !important; }
  
  #ma-mp3-{{ sid }} .ma-mp3__ic { margin-bottom: 8px !important; transform: none !important; }
  #ma-mp3-{{ sid }} .ma-mp3__ic svg { width: {{ section.settings.mobile_icon_size | default: 30 }}px !important; height: {{ section.settings.mobile_icon_size | default: 30 }}px !important; }
  #ma-mp3-{{ sid }} .ma-mp3__kick { font-size: {{ section.settings.mobile_kicker_size | default: 8.5 }}px !important; letter-spacing: 2px !important; margin: 0 !important; line-height: 1.3 !important; }
  #ma-mp3-{{ sid }} .ma-mp3__t { font-size: {{ section.settings.promise_title_size_mobile | default: 19 }}px !important; font-weight: {{ section.settings.mobile_title_weight | default: '600' }} !important; margin: 0 0 6px !important; line-height: 1.15 !important; }
  #ma-mp3-{{ sid }} .ma-mp3__d { font-size: {{ section.settings.promise_body_size_mobile | default: 13.5 }}px !important; line-height: 1.45 !important; margin: 0 !important; max-width: 100% !important; }
  #ma-mp3-{{ sid }} .ma-mp3__num { display: none !important; }

  /* Founder Seal & CTA on Mobile */
  #ma-mp3-{{ sid }} .ma-mp3__seal { padding: {{ section.settings.mobile_seal_padding_y | default: 28 }}px 0 10px !important; margin-top: 6px !important; }
  #ma-mp3-{{ sid }} .ma-mp3__seal-mark { font-size: 18px !important; }
  #ma-mp3-{{ sid }} .ma-mp3__sign { font-size: 18px !important; }
  #ma-mp3-{{ sid }} .ma-mp3__cta-wrap { margin-top: {{ section.settings.mobile_cta_margin_top | default: 22 }}px !important; }
  #ma-mp3-{{ sid }} .ma-mp3__cta-btn { padding: 15px 32px !important; font-size: 11.5px !important; width: auto !important; }
}

/* ═══════════════════════════════════════
   9. EDITORIAL ANIMATIONS & REVEALS
═══════════════════════════════════════ */
{% if section.settings.enable_animations %}
  #ma-mp3-{{ sid }} .ma-mp3__anim {
    opacity: 0;
    {% if section.settings.anim_type == 'fade_up' %}transform: translateY(22px);{% endif %}
    transition: opacity {{ section.settings.anim_speed | default: 700 }}ms ease, transform {{ section.settings.anim_speed | default: 700 }}ms cubic-bezier(0.16,1,0.3,1);
  }
  #ma-mp3-{{ sid }} .ma-mp3__anim.is-visible { opacity: 1; transform: none; }
  #ma-mp3-{{ sid }} .ma-mp3__anim:nth-child(2) { transition-delay: 100ms; }
  #ma-mp3-{{ sid }} .ma-mp3__anim:nth-child(3) { transition-delay: 200ms; }

  /* ── 2. CARD REVEAL ANIMATION (ENTRANCE ONLY) ── */
  {% if section.settings.enable_card_cascade %}
    #ma-mp3-{{ sid }} .ma-mp3__c {
      opacity: 0;
      {% if section.settings.card_reveal_anim == 'fade_up' %}
        transform: translateY(24px);
      {% elsif section.settings.card_reveal_anim == 'scale' %}
        transform: scale(0.94);
      {% else %}
        transform: none;
      {% endif %}
      transition: opacity {{ section.settings.card_anim_duration | default: 700 }}ms ease, transform {{ section.settings.card_anim_duration | default: 700 }}ms cubic-bezier(0.16,1,0.3,1);
    }
    #ma-mp3-{{ sid }} .ma-mp3__c.is-visible { opacity: 1; transform: none; }
    #ma-mp3-{{ sid }} .ma-mp3__c:nth-child(1) { transition-delay: 0ms; }
    #ma-mp3-{{ sid }} .ma-mp3__c:nth-child(2) { transition-delay: {{ section.settings.card_stagger_delay | default: 60 }}ms; }
    #ma-mp3-{{ sid }} .ma-mp3__c:nth-child(3) { transition-delay: {{ section.settings.card_stagger_delay | default: 60 | times: 2 }}ms; }
    #ma-mp3-{{ sid }} .ma-mp3__c:nth-child(4) { transition-delay: {{ section.settings.card_stagger_delay | default: 60 | times: 3 }}ms; }
  {% else %}
    #ma-mp3-{{ sid }} .ma-mp3__c { opacity: 0; transform: translateY(18px); transition: opacity 0.65s ease, transform 0.65s cubic-bezier(0.16,1,0.3,1); }
    #ma-mp3-{{ sid }} .ma-mp3__c.is-visible { opacity: 1; transform: none; }
    #ma-mp3-{{ sid }} .ma-mp3__c:nth-child(2) { transition-delay: 90ms; }
    #ma-mp3-{{ sid }} .ma-mp3__c:nth-child(3) { transition-delay: 180ms; }
    #ma-mp3-{{ sid }} .ma-mp3__c:nth-child(4) { transition-delay: 270ms; }
  {% endif %}
{% endif %}

@media (prefers-reduced-motion: reduce) {
  #ma-mp3-{{ sid }} * { transition: none !important; animation: none !important; }
}
</style>

