{% comment %} Quiz Invite — Maison Amiir homepage teaser. Architecture unchanged from prior
  version (video background, click-through banner, aspect-ratio responsive structure).
  This pass refines only the overlay design system: typography, spacing, info row,
  CTA, scrim, and motion — per the "private consultation, not a quiz" direction.
  All prior schema IDs preserved for backward compatibility. {% endcomment %}

{%- assign bg_url = '' -%}
{%- if section.settings.bg_image != blank -%}
  {%- assign bg_url = section.settings.bg_image | image_url: width: 1800 -%}
{%- endif -%}

<style>
  #maqi-{{ section.id }} {
    --qi-bg:   #c2ccd4;
    --qi-ink:  #ffffff;
    --qi-mut:  rgba(255,255,255,0.86);
    --qi-gold: {{ section.settings.accent_color | default: '#D9B779' }};
    --qi-brand-gold: {{ section.settings.brand_line_color | default: '#C9AB79' }};
    --qi-line: rgba(255,255,255,0.32);
    background: #1c2530;
    color: var(--qi-ink);
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: {{ section.settings.content_alignment | default: 'center' }};
  }
  #maqi-{{ section.id }} * { box-sizing: border-box; }

  /* ── Background media ────────────────────────────── */
  .qi__media {
    position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none;
  }
  .qi__coverlink {
    position: absolute; inset: 0; z-index: 1;
    display: block; text-indent: -9999px; overflow: hidden;
    cursor: pointer;
  }
  .qi__media img, .qi__media video {
    width: 100%; height: 100%; object-fit: cover;
    opacity: {{ section.settings.media_opacity | default: 100 | divided_by: 100.0 }};
    transform: scale(1.05);
    filter: blur({{ section.settings.overlay_blur | default: 0 }}px);
    animation: qiKen {{ section.settings.video_speed_multiplier | default: 80 | times: 0.35 }}s ease-in-out infinite alternate;
  }
  @keyframes qiKen {
    from { transform: scale(1.05) translate3d(0,0,0); }
    to   { transform: scale({{ section.settings.background_scale | default: 112 | times: 1.0 | divided_by: 100 }}) translate3d(-{{ section.settings.video_zoom_strength | default: 1.5 }}%, -{{ section.settings.video_zoom_strength | default: 1.5 | times: 1.0 }}%, 0); }
  }
  /* readability scrim — refined: separately tunable radial focus + top/bottom gradient */
  .qi__media::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(75% 65% at 50% 52%, {{ section.settings.overlay_color | default: '#000000' }} 0%, rgba(0,0,0,{{ section.settings.overlay_strength | default: 60 | times: 1.0 | divided_by: 175 }}) 46%, rgba(0,0,0,0) 80%),
      linear-gradient(to bottom, rgba(0,0,0,{{ section.settings.overlay_gradient_strength | default: 45 | times: 1.0 | divided_by: 150 }}) 0%, rgba(0,0,0,0) 30%, rgba(0,0,0,0) 70%, rgba(0,0,0,{{ section.settings.overlay_gradient_strength | default: 45 | times: 1.0 | divided_by: 150 }}) 100%);
  }
  {% if section.settings.overlay_strength > 0 %}
  .qi__media::after { background-blend-mode: normal; }
  {% endif %}

  /* ── Content ─────────────────────────────────────── */
  .qi__inner {
    position: relative; z-index: 2;
    width: 100%; max-width: {{ section.settings.content_max_width | default: 720 }}px;
    padding: 32px 28px 36px;
    display: flex;
    flex-direction: column;
    align-items: {% if section.settings.content_alignment == 'left' %}flex-start{% elsif section.settings.content_alignment == 'right' %}flex-end{% else %}center{% endif %};
    transform: translate({{ section.settings.horizontal_offset | default: 0 }}px, {{ section.settings.vertical_offset | default: 0 }}px);
    animation: qiSlideUp {{ section.settings.reveal_duration | default: 1000 | times: 1.0 | divided_by: 1000 }}s cubic-bezier(.19,.75,.24,1) {{ section.settings.reveal_delay | default: 100 }}ms both;
    pointer-events: none;
  }
  .qi__cta { pointer-events: auto; }
  @keyframes qiSlideUp {
    from { opacity: 0; transform: translateY({{ section.settings.reveal_distance | default: 20 }}px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Brand line: refined — smaller, tighter, softer gold, thinner rules ── */
  .qi__brand {
    font-family: var(--font-body--family, sans-serif);
    font-size: {{ section.settings.brand_line_size | default: 11 }}px;
    letter-spacing: {{ section.settings.brand_line_letter_spacing | default: 5 }}px;
    text-transform: uppercase;
    color: var(--qi-brand-gold); margin: 0 0 12px;
    display: flex; align-items: center; justify-content: center; gap: 12px;
    opacity: 0.92;
  }
  .qi__brand::before, .qi__brand::after {
    content: ''; display: block; width: 22px; height: 1px; background: var(--qi-brand-gold); opacity: 0.4;
  }

  .qi__eyebrow {
    font-family: {{ section.settings.eyebrow_font.family | default: 'sans-serif' }}, sans-serif;
    font-size: {{ section.settings.eyebrow_size | default: 13 }}px;
    letter-spacing: {{ section.settings.eyebrow_letter_spacing | default: 4.5 }}px;
    text-transform: uppercase;
    color: var(--qi-mut); opacity: 0.82; margin: 0 0 22px;
    text-shadow: 0 1px 8px rgba(0,0,0,0.5);
  }

  .qi__headline {
    font-family: var(--font-heading--family, serif);
    font-weight: 400;
    font-size: clamp(28px, 4.5vw, {{ section.settings.headline_size | default: 52 }}px);
    line-height: {{ section.settings.headline_line_height | default: 1.1 }};
    letter-spacing: {{ section.settings.headline_letter_spacing | default: 0 }}px;
    max-width: {{ section.settings.headline_max_width | default: 620 }}px;
    margin: 0 0 18px; color: var(--qi-ink);
    text-shadow: 0 2px 20px rgba(0,0,0,0.55), 0 1px 3px rgba(0,0,0,0.5);
  }
  .qi__headline em { font-style: italic; color: var(--qi-gold); }

  .qi__sub {
    font-family: var(--font-body--family, sans-serif);
    font-weight: 400;
    font-size: {{ section.settings.body_size | default: 14 }}px;
    line-height: {{ section.settings.body_line_height | default: 1.6 }};
    color: {{ section.settings.body_color | default: 'rgba(255,255,255,0.86)' }};
    max-width: {{ section.settings.body_max_width | default: 460 }}px;
    margin: 0 auto 32px;
    text-shadow: 0 1px 10px rgba(0,0,0,0.5);
  }

  /* ── Information row: editorial divider (default) or legacy pills ── */
  .qi__pills {
    display: flex; align-items: center; flex-wrap: wrap;
    gap: {{ section.settings.info_gap | default: 10 }}px;
    justify-content: center; margin: 0 auto 32px;
  }
  .qi__pills--editorial {
    font-family: var(--font-body--family, sans-serif);
    font-size: {{ section.settings.info_font_size | default: 11 }}px;
    letter-spacing: {{ section.settings.info_letter_spacing | default: 2 }}px;
    text-transform: uppercase;
    color: rgba(255,255,255,0.78);
  }
  .qi__pills--editorial .qi__pill {
    border: none; background: none; padding: 0; backdrop-filter: none;
    font-size: inherit; letter-spacing: inherit; color: inherit;
  }
  .qi__pills--editorial .qi__pill-dot {
    display: none;
  }
  .qi__pills--editorial .qi__divider {
    color: {{ section.settings.divider_color | default: 'rgba(255,255,255,0.4)' }};
  }
  .qi__pill {
    display: inline-flex; align-items: center; gap: 7px;
    font-family: var(--font-body--family, sans-serif);
    font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
    color: #fff;
    border: 1px solid var(--qi-line);
    border-radius: 30px; padding: 8px 16px;
    background: rgba(0,0,0,0.22);
    backdrop-filter: blur(4px);
  }
  .qi__pills--classic .qi__pill { border-radius: 30px; }
  .qi__pills--minimal .qi__pill { border-radius: 4px; background: rgba(0,0,0,0.14); border-color: rgba(255,255,255,0.2); }
  .qi__pill-dot {
    width: 5px; height: 5px; border-radius: 50%; background: var(--qi-gold);
    flex-shrink: 0;
    box-shadow: 0 0 6px var(--qi-gold);
  }

  /* ── CTA: luxury button, configurable style ── */
  .qi__cta {
    position: relative; overflow: hidden; display: inline-block;
    font-family: var(--font-body--family, sans-serif);
    font-size: 12px; font-weight: 500; letter-spacing: 0.26em; text-transform: uppercase;
    text-decoration: none; cursor: pointer; border-style: solid; border-width: 1px;
    padding: {{ section.settings.button_padding_y | default: 16 }}px {{ section.settings.button_padding_x | default: 44 }}px;
    border-radius: {{ section.settings.button_radius | default: 2 }}px;
    transition: transform {{ section.settings.hover_speed | default: 350 }}ms {{ section.settings.hover_easing | default: 'ease' }},
                box-shadow {{ section.settings.hover_speed | default: 350 }}ms {{ section.settings.hover_easing | default: 'ease' }},
                background {{ section.settings.hover_speed | default: 350 }}ms {{ section.settings.hover_easing | default: 'ease' }},
                color {{ section.settings.hover_speed | default: 350 }}ms {{ section.settings.hover_easing | default: 'ease' }};
    {% if section.settings.button_shadow_strength > 0 %}box-shadow: 0 {{ section.settings.button_shadow_strength }}px {{ section.settings.button_shadow_strength | times: 2 }}px -10px rgba(0,0,0,0.5);{% endif %}
  }
  .qi__cta--filled {
    background: {{ section.settings.cta_bg_color | default: '#f4eee1' }};
    color: {{ section.settings.cta_text_color | default: '#171310' }};
    border-color: {{ section.settings.cta_border_color | default: '#c9ab79' }};
  }
  .qi__cta--outline {
    background: transparent;
    color: {{ section.settings.cta_text_color | default: '#f4eee1' }};
    border-color: {{ section.settings.cta_border_color | default: '#c9ab79' }};
  }
  .qi__cta--ghost {
    background: transparent;
    color: {{ section.settings.cta_text_color | default: '#f4eee1' }};
    border-color: transparent;
  }
  .qi__cta:hover {
    background: {{ section.settings.cta_hover_bg_color | default: '#c9ab79' }};
    color: {{ section.settings.cta_hover_text_color | default: '#171310' }};
    border-color: {{ section.settings.cta_hover_bg_color | default: '#c9ab79' }};
    {% if section.settings.hover_style == 'lift' %}transform: translateY(-2px);{% endif %}
  }
  {% if section.settings.hover_style == 'glow' %}
  .qi__cta:hover { box-shadow: 0 0 26px 2px rgba(201,171,121,0.45); }
  {% endif %}

  .qi__hint {
    margin-top: 16px;
    font-family: var(--font-body--family, sans-serif);
    font-size: 13px; letter-spacing: 0.08em;
    color: rgba(255,255,255,0.68);
    text-shadow: 0 1px 8px rgba(0,0,0,0.5);
  }

  /* ── Decorative rule ─────────────────────────────── */
  .qi__rule {
    position: absolute; bottom: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(to right, transparent, var(--qi-line) 30%, var(--qi-line) 70%, transparent);
  }

  /* ── Mobile ─────────────────────────── */
  @media (max-width: 767px) {
    #maqi-{{ section.id }} { aspect-ratio: 1 / 1.05; }
    .qi__inner { padding: 20px 18px 24px; }
    .qi__headline { font-size: clamp(23px, 7.5vw, 32px); margin-bottom: 12px; }
    .qi__sub { font-size: 13px; margin-bottom: 22px; }
    .qi__pills { gap: 8px; margin-bottom: 22px; }
    .qi__pill { padding: 7px 13px; font-size: 9px; }
    .qi__cta { padding: 14px 34px; font-size: 11px; }
    .qi__brand { font-size: 10px; margin-bottom: 8px; }
    .qi__eyebrow { font-size: 12px; margin-bottom: 16px; }
    .qi__hint { font-size: 11px; margin-top: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .qi__media img, .qi__media video { animation: none; }
    .qi__inner { animation: none; }
  }
</style>

<div id="maqi-{{ section.id }}">

  <div class="qi__media">
    {%- if section.settings.bg_video != blank -%}
      {{ section.settings.bg_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
    {%- elsif bg_url != '' -%}
      <img src="{{ bg_url }}" alt="" loading="lazy">
    {%- endif -%}
  </div>

  <a class="qi__coverlink"
     href="{{ section.settings.quiz_url | default: '/pages/find-your-signature' }}"
     aria-label="{{ section.settings.cta_label | default: 'Find My Signature' }}">
    {{ section.settings.cta_label | default: 'Find My Signature' }}
  </a>

  <div class="qi__inner">

    {%- if section.settings.brand_line != blank -%}
      <p class="qi__brand">{{ section.settings.brand_line }}</p>
    {%- endif -%}

    {%- if section.settings.eyebrow != blank -%}
      <p class="qi__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h2 class="qi__headline">{{ section.settings.headline | default: 'Discover your <em>signature scent</em>.' }}</h2>

    {%- if section.settings.subtext != blank -%}
      <p class="qi__sub">{{ section.settings.subtext }}</p>
    {%- endif -%}

    {%- assign has_pills = false -%}
    {%- if section.settings.pill1 != blank or section.settings.pill2 != blank or section.settings.pill3 != blank -%}{%- assign has_pills = true -%}{%- endif -%}
    {%- if has_pills -%}
      {%- assign info_style = section.settings.info_style | default: 'editorial_divider' -%}
      <div class="qi__pills qi__pills--{% if info_style == 'editorial_divider' %}editorial{% elsif info_style == 'minimal_pills' %}minimal{% else %}classic{% endif %}">
        {%- if info_style == 'editorial_divider' -%}
          {%- if section.settings.pill1 != blank -%}<span class="qi__pill">{{ section.settings.pill1 }}</span>{%- endif -%}
          {%- if section.settings.pill2 != blank -%}<span class="qi__divider">•</span><span class="qi__pill">{{ section.settings.pill2 }}</span>{%- endif -%}
          {%- if section.settings.pill3 != blank -%}<span class="qi__divider">•</span><span class="qi__pill">{{ section.settings.pill3 }}</span>{%- endif -%}
        {%- else -%}
          {%- if section.settings.pill1 != blank -%}<span class="qi__pill"><span class="qi__pill-dot"></span>{{ section.settings.pill1 }}</span>{%- endif -%}
          {%- if section.settings.pill2 != blank -%}<span class="qi__pill"><span class="qi__pill-dot"></span>{{ section.settings.pill2 }}</span>{%- endif -%}
          {%- if section.settings.pill3 != blank -%}<span class="qi__pill"><span class="qi__pill-dot"></span>{{ section.settings.pill3 }}</span>{%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}

    <a class="qi__cta qi__cta--{{ section.settings.button_style | default: 'filled' }}" href="{{ section.settings.quiz_url | default: '/pages/find-your-signature' }}">
      {{ section.settings.cta_label | default: 'Find My Signature' }}
    </a>

    {%- if section.settings.hint != blank -%}
      <p class="qi__hint">{{ section.settings.hint }}</p>
    {%- endif -%}

  </div>

  <div class="qi__rule"></div>

</div>

{% schema %}
{
  "name": "Quiz Invite",
  "tag": "section",
  "class": "ma-quiz-invite",
  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image or GIF" },
    { "type": "video", "id": "bg_video", "label": "Background video" },
    { "type": "range", "id": "media_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Media opacity", "default": 100 },

    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "brand_line", "label": "Brand line (above headline)", "default": "The Fragrance Finder" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Personal Fragrance Concierge" },
    { "type": "text", "id": "headline", "label": "Headline (use <em>text</em> for gold italic)", "default": "Discover your <em>signature scent</em>." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Tell us what you enjoy wearing, and we'll recommend fragrances carefully matched to your preferences, personality and everyday rituals." },
    { "type": "text", "id": "pill1", "label": "Info item 1", "default": "Six Questions" },
    { "type": "text", "id": "pill2", "label": "Info item 2", "default": "Around Two Minutes" },
    { "type": "text", "id": "pill3", "label": "Info item 3 (optional)" },
    { "type": "text", "id": "hint", "label": "Hint text below button", "default": "No account required" },

    { "type": "header", "content": "Fonts" },
    { "type": "font_picker", "id": "eyebrow_font", "label": "Eyebrow font", "default": "helvetica_n4" },
    { "type": "font_picker", "id": "headline_font", "label": "Headline font", "default": "playfair_display_n4" },
    { "type": "font_picker", "id": "subtext_font", "label": "Subtitle/paragraph font", "default": "helvetica_n4" },
    { "type": "font_picker", "id": "cta_font", "label": "CTA font", "default": "helvetica_n4" },

    { "type": "header", "content": "Button" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Find My Signature" },
    { "type": "url", "id": "quiz_url", "label": "Quiz page URL" },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "accent_color", "label": "Accent / gold (headline em, dots)", "default": "#D9B779" },

    { "type": "header", "content": "Typography — Brand line" },
    { "type": "range", "id": "brand_line_size", "label": "Size", "min": 9, "max": 16, "step": 1, "default": 11, "unit": "px" },
    { "type": "range", "id": "brand_line_letter_spacing", "label": "Letter spacing", "min": 2, "max": 8, "step": 0.5, "default": 5, "unit": "px" },
    { "type": "color", "id": "brand_line_color", "label": "Color", "default": "#C9AB79" },

    { "type": "header", "content": "Typography — Eyebrow" },
    { "type": "range", "id": "eyebrow_size", "label": "Size", "min": 10, "max": 18, "step": 1, "default": 13, "unit": "px" },
    { "type": "range", "id": "eyebrow_letter_spacing", "label": "Letter spacing", "min": 2, "max": 8, "step": 0.5, "default": 4.5, "unit": "px" },

    { "type": "header", "content": "Typography — Headline" },
    { "type": "range", "id": "headline_size", "label": "Max size (desktop)", "min": 36, "max": 64, "step": 2, "default": 52, "unit": "px" },
    { "type": "range", "id": "headline_line_height", "label": "Line height", "min": 1.0, "max": 1.3, "step": 0.1, "default": 1.1 },
    { "type": "range", "id": "headline_letter_spacing", "label": "Letter spacing", "min": -1, "max": 2, "step": 0.5, "default": 0, "unit": "px" },
    { "type": "range", "id": "headline_max_width", "label": "Max width", "min": 400, "max": 800, "step": 20, "default": 620, "unit": "px" },

    { "type": "header", "content": "Typography — Body" },
    { "type": "range", "id": "body_size", "label": "Size", "min": 12, "max": 18, "step": 1, "default": 14, "unit": "px" },
    { "type": "range", "id": "body_line_height", "label": "Line height", "min": 1.3, "max": 1.9, "step": 0.1, "default": 1.6 },
    { "type": "range", "id": "body_max_width", "label": "Max width", "min": 320, "max": 600, "step": 20, "default": 460, "unit": "px" },
    { "type": "color", "id": "body_color", "label": "Color", "default": "#ffffff" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "content_max_width", "label": "Content max width", "min": 500, "max": 900, "step": 20, "default": 720, "unit": "px" },
    { "type": "select", "id": "content_alignment", "label": "Content alignment", "default": "center", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }
    ]},
    { "type": "range", "id": "vertical_offset", "label": "Vertical offset", "min": -80, "max": 80, "step": 5, "default": 0, "unit": "px" },
    { "type": "range", "id": "horizontal_offset", "label": "Horizontal offset", "min": -80, "max": 80, "step": 5, "default": 0, "unit": "px" },

    { "type": "header", "content": "Video overlay" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_strength", "label": "Overlay strength", "min": 0, "max": 90, "step": 5, "default": 60, "unit": "%" },
    { "type": "range", "id": "overlay_gradient_strength", "label": "Top/bottom gradient strength", "min": 0, "max": 100, "step": 5, "default": 45, "unit": "%" },
    { "type": "range", "id": "overlay_blur", "label": "Background blur", "min": 0, "max": 12, "step": 1, "default": 0, "unit": "px" },
    { "type": "range", "id": "background_scale", "label": "Ken Burns end scale", "min": 106, "max": 130, "step": 2, "default": 112, "unit": "%" },
    { "type": "range", "id": "video_zoom_strength", "label": "Pan strength", "min": 0, "max": 4, "step": 0.5, "default": 1.5 },

    { "type": "header", "content": "Information row" },
    { "type": "select", "id": "info_style", "label": "Style", "default": "editorial_divider", "options": [
      { "value": "editorial_divider", "label": "Editorial divider (recommended)" },
      { "value": "minimal_pills", "label": "Minimal pills" },
      { "value": "classic_pills", "label": "Classic pills" }
    ]},
    { "type": "range", "id": "info_gap", "label": "Gap", "min": 4, "max": 20, "step": 2, "default": 10, "unit": "px" },
    { "type": "range", "id": "info_font_size", "label": "Font size (editorial style)", "min": 9, "max": 14, "step": 1, "default": 11, "unit": "px" },
    { "type": "range", "id": "info_letter_spacing", "label": "Letter spacing (editorial style)", "min": 1, "max": 4, "step": 0.5, "default": 2, "unit": "px" },
    { "type": "color", "id": "divider_color", "label": "Divider dot color", "default": "#ffffff" },

    { "type": "header", "content": "CTA style" },
    { "type": "select", "id": "button_style", "label": "Button style", "default": "filled", "options": [
      { "value": "filled", "label": "Filled — ivory, gold border" },
      { "value": "outline", "label": "Outline — gold border" },
      { "value": "ghost", "label": "Ghost — no border" }
    ]},
    { "type": "color", "id": "cta_bg_color", "label": "Background (filled)", "default": "#f4eee1" },
    { "type": "color", "id": "cta_text_color", "label": "Text color", "default": "#171310" },
    { "type": "color", "id": "cta_border_color", "label": "Border color", "default": "#c9ab79" },
