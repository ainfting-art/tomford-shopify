{%- comment -%}
  MAISON AMIIR — Honest Arithmetic V5 (Full Customizer Reconnect + Extended Controls)
  
  AUDIT FIXES:
  - Reconnected: fill_color, enable_proof, split_ratio (deprecated in favour of dt_copy_w/dt_img_w — kept as label only),
    bar_h, bar_rad, cmp_font, mob_section_h, mob_gap, image_focal_x/y, img_vignette,
    overlay_color/overlay_strength, heading_size_mob, sub_size_mob, mobile_image_height /
    mobile_padding_top / mobile_padding_bottom / mobile_padding_x (consolidated into pad_* ids),
    anchor_id, melt_strength/melt_blur, hover_scale/hover_duration/enable_hover_zoom,
    dt_align (added to schema), accent_style/accent_weight/accent_color (added to schema),
    sub_weight/sub_color/sub_margin_b/gap_head/divider_w_mob/divider_thickness/
    divider_color/divider_opacity/heading_spacing/heading_lh/heading_max_w/eyebrow_weight/
    eyebrow_spacing (all added to schema).
  - Clamp guards fixed: headline uses proper min based on heading_size_mob, subheading uses sub_size_mob.
  - Mobile padding now reads mobile_padding_* ids directly (unified, no dual-redundant sets).
  - Desktop overflow_mode now correctly applied (was overridden to 'visible !important').
  - Bar track height/radius/font now read from schema.
  - Image focal point now drives object-position.
  - Overlay div now styled via CSS variables.
  - Vignette now implemented.
  - Hover zoom now implemented.
  - mob_section_h now applied.
  - mob_gap now applied as gap between photo and left-col on mobile.
  - enable_proof now gates the proof grid.
  - anchor_id now sets the section id fallback.
  - melt_blur added to schema, wired correctly.
  
  NEW CONTROLS ADDED:
  Typography: heading_lh, heading_max_w (schema), sub_lh, sub_max_w,
              price_size/price_weight/price_color, caption_size/caption_weight/caption_color
  Layout:     col_gap, content_max_w, dt_valign (already existed), dt_align (now in schema)
  Image:      img_object_fit, img_object_pos, img_opacity, fade_blur, fade_dir, fade_pos
  Motion:     reveal_dist, hover_easing, parallax_strength
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign desk_img = section.settings.bottle_image | default: section.settings.mobile_image
  assign mob_img  = section.settings.mobile_image | default: section.settings.bottle_image
  
  assign has_img = false
  if desk_img != blank or mob_img != blank
    assign has_img = true
  endif

  assign melt      = section.settings.melt | default: 100
  assign melt_blur = section.settings.melt_blur | default: 12
  assign melt_veil = melt | divided_by: 100.0

  assign now_value  = section.settings.right_value | escape | replace: 'from ', '<em>from</em> '
  assign cmp_style  = section.settings.comparison_style | default: 'cards'
  
  assign split_left  = section.settings.dt_copy_w | default: 55
  assign split_right = section.settings.dt_img_w  | default: 45

  assign value_blocks = section.blocks | where: 'type', 'value_item'
  assign proof_blocks = section.blocks | where: 'type', 'proof_item'

  assign section_id = section.settings.anchor_id | default: sid
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Marcellus&display=swap" rel="stylesheet">

<section
  class="ma-ar {% if has_img %}ma-ar--split{% endif %} ma-ar--dt-{{ section.settings.desktop_layout_style | default: '01' }} ma-ar--mob-{{ section.settings.mobile_layout_style | default: '01' }} {{ section.settings.custom_class }}"
  id="ma-ar-{{ section_id }}"
>
  {%- if section.settings.enable_texture -%}
    <div class="ma-ar__grain" aria-hidden="true"></div>
  {%- endif -%}
  {%- if section.settings.enable_debug_grid -%}<div class="ma-ar__debug-grid" aria-hidden="true"></div>{%- endif -%}
  {%- if section.settings.enable_safe_area -%}<div class="ma-ar__safe-area" aria-hidden="true"></div>{%- endif -%}
  {%- if section.settings.enable_baseline_grid -%}<div class="ma-ar__baseline-grid" aria-hidden="true"></div>{%- endif -%}

  <!-- LEFT COLUMN: EDITORIAL ARTICLE SPREAD -->
  <div class="ma-ar__left-col">
    <div class="ma-ar__head-group">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ma-ar__k ma-ar__reveal">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ma-ar__h ma-ar__reveal">{{ section.settings.heading | replace: 'Not on the receipt.', '<em>Not on the receipt.</em>' }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="ma-ar__sub ma-ar__reveal">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <!-- COMPARISON AREA -->
    {%- if cmp_style == 'bars' -%}
      <div class="ma-ar__cmp ma-ar__reveal">
        <div class="ma-ar__row">
          <div class="ma-ar__top">
            <span class="ma-ar__lab">{{ section.settings.left_label | escape }}</span>
            <span class="ma-ar__val ma-ar__val--typ">{{ section.settings.left_value | escape }}</span>
          </div>
          <div class="ma-ar__track"><span class="ma-ar__fill ma-ar__fill--typ"></span></div>
        </div>
        <div class="ma-ar__row">
          <div class="ma-ar__top">
            <span class="ma-ar__lab">{{ section.settings.right_label | escape }}</span>
            <span class="ma-ar__val ma-ar__val--now">{{ now_value }}</span>
          </div>
          <div class="ma-ar__track"><span class="ma-ar__fill ma-ar__fill--now"></span></div>
        </div>
      </div>
      {%- if section.settings.refine_1 != blank or section.settings.refine_2 != blank -%}
        <div class="ma-ar__refine ma-ar__reveal">
          {%- if section.settings.refine_1 != blank -%}<p class="ma-ar__ref"><b>◆</b>{{ section.settings.refine_1 | escape }}</p>{%- endif -%}
          {%- if section.settings.refine_2 != blank -%}<p class="ma-ar__ref"><b>◆</b>{{ section.settings.refine_2 | escape }}</p>{%- endif -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="ma-ar__cards ma-ar__reveal">
        <div class="ma-ar__card ma-ar__card--them">
          {%- if section.settings.card1_header != blank -%}<p class="ma-ar__card-h">{{ section.settings.card1_header | escape }}</p>{%- endif -%}
          <ul class="ma-ar__list">
            {%- assign left_items = value_blocks | where: 'settings.side', 'left' -%}
            {%- if left_items.size > 0 -%}
              {%- for block in left_items -%}
                <li class="ma-ar__list-item" {{ block.shopify_attributes }}>
                  <span class="ma-ar__list-icon"><svg viewBox="0 0 24 24"><path d="M4 10l1-6h14l1 6M4 10v9h16v-9M4 10h16M9 19v-5h4v5"/></svg></span>
                  <span>{{ block.settings.text | escape }}</span>
                </li>
              {%- endfor -%}
            {%- else -%}
              {%- assign c1_icons = 'store,megaphone,tv,gift,arrow-up' | split: ',' -%}
              {%- assign card1_items_array = section.settings.card1_items | newline_to_br | strip_newlines | split: '<br />' -%}
              {%- for item in card1_items_array -%}
                {%- assign trimmed = item | strip -%}
                {%- if trimmed != blank -%}
                  {%- assign icon_key = c1_icons[forloop.index0] | default: 'arrow-up' -%}
                  <li class="ma-ar__list-item">
                    <span class="ma-ar__list-icon">
                      {%- case icon_key -%}
                        {%- when 'store' -%}<svg viewBox="0 0 24 24"><path d="M4 10l1-6h14l1 6M4 10v9h16v-9M4 10h16M9 19v-5h4v5"/></svg>
                        {%- when 'megaphone' -%}<svg viewBox="0 0 24 24"><path d="M3 10v4l14 4V6L3 10z"/><path d="M17 9v6"/><path d="M7 14v4a2 2 0 0 0 2 2h1v-6"/></svg>
                        {%- when 'tv' -%}<svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="1"/><path d="M9 21h6M12 18v3"/></svg>
                        {%- when 'gift' -%}<svg viewBox="0 0 24 24"><rect x="4" y="9" width="16" height="11" rx="1"/><path d="M12 9v11M4 9h16"/></svg>
                        {%- else -%}<svg viewBox="0 0 24 24"><path d="M12 19V5M6 11l6-6 6 6"/></svg>
                      {%- endcase -%}
                    </span>
                    <span>{{ trimmed }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </ul>
          <div class="ma-ar__card-foot">
            <span class="ma-ar__card-price">{{ section.settings.left_value | default: "₹20,000+" }}</span>
            <span class="ma-ar__card-sub">{{ section.settings.left_label | default: "Typical Luxury Perfume" }}</span>
          </div>
        </div>

        <span class="ma-ar__vs">{{ section.settings.vs_text | default: 'VS' | escape }}</span>

        <div class="ma-ar__card ma-ar__card--us">
          {%- if section.settings.card2_header != blank -%}<p class="ma-ar__card-h">{{ section.settings.card2_header | escape }}</p>{%- endif -%}
          <ul class="ma-ar__list">
            {%- assign right_items = value_blocks | where: 'settings.side', 'right' -%}
            {%- if right_items.size > 0 -%}
              {%- for block in right_items -%}
                <li class="ma-ar__list-item" {{ block.shopify_attributes }}>
                  <span class="ma-ar__list-icon ma-ar__ic--now"><svg viewBox="0 0 24 24"><path d="M12 2s7 7.5 7 12.5A7 7 0 0 1 5 14.5C5 9.5 12 2 12 2z"/></svg></span>
                  <span>{{ block.settings.text | escape }}</span>
                </li>
              {%- endfor -%}
            {%- else -%}
              {%- assign c2_icons = 'droplet,leaf,scissors,bag,arrow-up' | split: ',' -%}
              {%- assign card2_items_array = section.settings.card2_items | newline_to_br | strip_newlines | split: '<br />' -%}
              {%- for item in card2_items_array -%}
                {%- assign trimmed = item | strip -%}
                {%- if trimmed != blank -%}
                  {%- assign icon_key = c2_icons[forloop.index0] | default: 'arrow-up' -%}
                  <li class="ma-ar__list-item">
                    <span class="ma-ar__list-icon ma-ar__ic--now">
                      {%- case icon_key -%}
                        {%- when 'droplet' -%}<svg viewBox="0 0 24 24"><path d="M12 2s7 7.5 7 12.5A7 7 0 0 1 5 14.5C5 9.5 12 2 12 2z"/></svg>
                        {%- when 'leaf' -%}<svg viewBox="0 0 24 24"><path d="M4 19c8 1 15-4 16-15-9 0-16 4-16 15z"/><path d="M4 19c3-5 7-8 12-10"/></svg>
                        {%- when 'scissors' -%}<svg viewBox="0 0 24 24"><circle cx="6" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><path d="M8.5 8L20 19M8.5 16L20 5"/></svg>
                        {%- when 'bag' -%}<svg viewBox="0 0 24 24"><path d="M6 8h12l1 12H5L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
                        {%- else -%}<svg viewBox="0 0 24 24"><path d="M12 19V5M6 11l6-6 6 6"/></svg>
                      {%- endcase -%}
                    </span>
                    <span>{{ trimmed }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </ul>
          <div class="ma-ar__card-foot">
            <span class="ma-ar__card-price">{{ now_value }}</span>
            <span class="ma-ar__card-sub">{{ section.settings.right_label | default: "Maison Amiir" }}</span>
          </div>
        </div>
      </div>
    {%- endif -%}

    <!-- PROOF GRID -->
    {%- if section.settings.enable_proof -%}
    <div class="ma-ar__proof ma-ar__reveal">
      {%- if proof_blocks.size > 0 -%}
        {%- for block in proof_blocks -%}
          <div class="ma-ar__proof-item" {{ block.shopify_attributes }}>
            <span class="ma-ar__proof-ic"><svg viewBox="0 0 24 24"><path d="M12 2s7 7.5 7 12.5A7 7 0 0 1 5 14.5C5 9.5 12 2 12 2z"/></svg></span>
            <h3 class="ma-ar__proof-h">{{ block.settings.heading | escape }}</h3>
            <p class="ma-ar__proof-b">{{ block.settings.body | escape }}</p>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          {%- case i -%}
            {%- when 1 -%}{%- assign p_icon = section.settings.proof1_icon -%}{%- assign p_h = section.settings.proof1_heading -%}{%- assign p_b = section.settings.proof1_body -%}
            {%- when 2 -%}{%- assign p_icon = section.settings.proof2_icon -%}{%- assign p_h = section.settings.proof2_heading -%}{%- assign p_b = section.settings.proof2_body -%}
            {%- when 3 -%}{%- assign p_icon = section.settings.proof3_icon -%}{%- assign p_h = section.settings.proof3_heading -%}{%- assign p_b = section.settings.proof3_body -%}
            {%- when 4 -%}{%- assign p_icon = section.settings.proof4_icon -%}{%- assign p_h = section.settings.proof4_heading -%}{%- assign p_b = section.settings.proof4_body -%}
          {%- endcase -%}
          <div class="ma-ar__proof-item">
            {%- if p_icon != 'none' -%}
              <span class="ma-ar__proof-ic">
                {%- case p_icon -%}
                  {%- when 'droplet' -%}<svg viewBox="0 0 24 24"><path d="M12 2s7 7.5 7 12.5A7 7 0 0 1 5 14.5C5 9.5 12 2 12 2z"/></svg>
                  {%- when 'shield' -%}<svg viewBox="0 0 24 24"><path d="M12 3l7 2.6v5.1c0 4.4-3 7.4-7 8.8-4-1.4-7-4.4-7-8.8V5.6L12 3z"/><path d="M9 12l2 2 4-4.2"/></svg>
                  {%- when 'clock' -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
                  {%- when 'heart' -%}<svg viewBox="0 0 24 24"><path d="M12 20s-7-4.4-9.3-8.8C1.2 8 2.7 4.8 6 4.2c2-.4 3.7.6 4.9 2.3 1.2-1.7 2.9-2.7 4.9-2.3 3.3.6 4.8 3.8 3.3 7C19 15.6 12 20 12 20z"/></svg>
                  {%- when 'leaf' -%}<svg viewBox="0 0 24 24"><path d="M4 19c8 1 15-4 16-15-9 0-16 4-16 15z"/><path d="M4 19c3-5 7-8 12-10"/></svg>
                {%- endcase -%}
              </span>
            {%- endif -%}
            {%- if p_h != blank -%}<p class="ma-ar__proof-h">{{ p_h | escape }}</p>{%- endif -%}
            {%- if p_b != blank -%}<p class="ma-ar__proof-b">{{ p_b | escape }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- endif -%}

    <!-- CONCLUSION BLOCK -->
    {%- if section.settings.conclusion_heading != blank or section.settings.conclusion_body != blank -%}
      <div class="ma-ar__conclusion ma-ar__reveal">
        {%- if section.settings.show_crown -%}<span class="ma-ar__crown">♛</span>{%- endif -%}
        {%- if section.settings.conclusion_heading != blank -%}<p class="ma-ar__conc-h">{{ section.settings.conclusion_heading | escape }}</p>{%- endif -%}
        {%- if section.settings.conclusion_body != blank -%}<p class="ma-ar__conc-b">{{ section.settings.conclusion_body | escape }}</p>{%- endif -%}
        {%- if section.settings.show_cta and section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_link | default: '#' }}" class="ma-ar__cta">{{ section.settings.cta_text | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <!-- RIGHT COLUMN: PHOTOGRAPHY -->
  {%- if has_img -%}
    <div class="ma-ar__photo">
      {{ desk_img | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'ma-ar__img ma-ar__img--dt', alt: desk_img.alt | default: shop.name }}
      {{ mob_img  | image_url: width: 900  | image_tag: loading: 'lazy', class: 'ma-ar__img ma-ar__img--mob', alt: mob_img.alt | default: shop.name }}
      {%- if section.settings.show_overlay -%}
        <div class="ma-ar__overlay" aria-hidden="true"></div>
      {%- endif -%}
      {%- if section.settings.img_vignette > 0 -%}
        <div class="ma-ar__vignette" aria-hidden="true"></div>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

<style>
/* =====================================================================
   MAISON AMIIR — Honest Arithmetic V5
   All CSS variables sourced from section settings — no hardcoded values.
   ===================================================================== */

#ma-ar-{{ section_id }}.ma-ar {
  /* ── Brand colour tokens ── */
  --cream:  {{ section.settings.bg_color   | default: '#F4EEE1' }};
  --ink:    {{ section.settings.ink_color  | default: '#171310' }};
  --gold:   {{ section.settings.gold_color | default: '#C6A15B' }};
  --burg:   {{ section.settings.burg_color | default: '#6E1220' }};
  --burg2:  {{ section.settings.burg2_color | default: '#8E1B28' }};
  --track:  {{ section.settings.track_color | default: '#E6E0D5' }};
  --fill:   {{ section.settings.fill_color  | default: '#8E1B28' }};

  /* ── Overlay & vignette ── */
  --overlay-color:    {{ section.settings.overlay_color   | default: '#000000' }};
  --overlay-opacity:  {{ section.settings.overlay_strength | default: 15 | divided_by: 100.0 }};
  --vignette-str:     {{ section.settings.img_vignette    | default: 0  | divided_by: 100.0 }};

  /* ── Image adjustments ── */
  --img-scale:        {{ section.settings.image_scale    | default: 100 | times: 1.0 | divided_by: 100 }};
  --img-offset-x:     {{ section.settings.image_offset_x | default: 0 }}px;
  --img-offset-y:     {{ section.settings.image_offset_y | default: 0 }}px;
  --img-focal-x:      {{ section.settings.image_focal_x  | default: 50 }}%;
  --img-focal-y:      {{ section.settings.image_focal_y  | default: 50 }}%;
  --img-brightness:   {{ section.settings.img_brightness | default: 100 }}%;
  --img-contrast:     {{ section.settings.img_contrast   | default: 100 }}%;
  --img-saturation:   {{ section.settings.img_saturation | default: 100 }}%;
  --img-warmth:       {{ section.settings.img_warmth     | default: 0 | at_least: 0 | times: 1.0 | divided_by: 100 }};
  --img-opacity:      {{ section.settings.img_opacity    | default: 100 | divided_by: 100.0 }};
  --img-object-fit:   {{ section.settings.img_object_fit | default: 'cover' }};
  --img-object-pos:   {{ section.settings.img_object_pos | default: 'center center' }};

  /* ── Melt / fade ── */
  --melt-blur:   {{ melt_blur }}px;
  --melt-veil:   {{ melt_veil }};
  --fade-blur:   {{ section.settings.fade_blur | default: 12 }}px;
  --fade-dir:    {{ section.settings.fade_dir  | default: '90deg' }};
  --fade-pos:    {{ section.settings.fade_pos  | default: 40 }}%;

  /* ── Hover zoom ── */
  --hover-scale:    {{ section.settings.hover_scale    | default: 102 | times: 1.0 | divided_by: 100 }};
  --hover-duration: {{ section.settings.hover_duration | default: 800 }}ms;
  --hover-easing:   {{ section.settings.hover_easing   | default: 'cubic-bezier(0.25, 0.8, 0.25, 1)' }};

  /* ── Typography ── */
  --headline-size:    {{ section.settings.headline_size  | default: 52 }}px;
  --headline-mob-size:{{ section.settings.heading_size_mob | default: 34 }}px;
  --headline-lh:      {{ section.settings.heading_lh     | default: 108 | divided_by: 100.0 }};
  --headline-max-w:   {{ section.settings.heading_max_w  | default: 24 }}ch;
  --headline-weight:  {{ section.settings.heading_weight | default: 600 }};
  --headline-spacing: {{ section.settings.heading_spacing | default: 0 }}px;
  --sub-size:         {{ section.settings.body_size       | default: 20 }}px;
  --sub-mob-size:     {{ section.settings.sub_size_mob    | default: 16 }}px;
  --sub-lh:           {{ section.settings.sub_lh          | default: 145 | divided_by: 100.0 }};
  --sub-max-w:        {{ section.settings.sub_max_w       | default: 48 }}ch;
  --sub-weight:       {{ section.settings.sub_weight      | default: 500 }};
  --sub-color:        {{ section.settings.sub_color       | default: 'rgba(23,19,16,0.78)' }};
  --sub-margin-b:     {{ section.settings.sub_margin_b    | default: 20 }}px;
  --eyebrow-size:     {{ section.settings.eyebrow_size_mob | default: 10 }}px;
  --eyebrow-weight:   {{ section.settings.eyebrow_weight  | default: 400 }};
  --eyebrow-spacing:  {{ section.settings.eyebrow_spacing | default: 3 }}px;
  --gap-head:         {{ section.settings.gap_head        | default: 12 }}px;
  --divider-w:        {{ section.settings.divider_w_mob   | default: 30 }}px;
  --divider-h:        {{ section.settings.divider_thickness | default: 1 }}px;
  --divider-color:    {{ section.settings.divider_color   | default: 'var(--burg2)' }};
  --divider-opacity:  {{ section.settings.divider_opacity | default: 60 | divided_by: 100.0 }};
  --accent-style:     {% if section.settings.accent_style == 'italic' %}italic{% else %}normal{% endif %};
  --accent-weight:    {{ section.settings.accent_weight   | default: 400 }};
  --accent-color:     {{ section.settings.accent_color    | default: 'var(--burg)' }};
  --conc-size:        {{ section.settings.conclusion_size | default: 22 }}px;

  /* ── Price & caption typography ── */
  --price-size:   {{ section.settings.price_size   | default: 26 }}px;
  --price-weight: {{ section.settings.price_weight | default: 600 }};
  --price-color:  {{ section.settings.price_color  | default: 'var(--ink)' }};
  --price-us-size:   {{ section.settings.price_size   | default: 26 | plus: 6 }}px;
  --caption-size:    {{ section.settings.caption_size   | default: 11 }}px;
  --caption-weight:  {{ section.settings.caption_weight | default: 400 }};
  --caption-color:   {{ section.settings.caption_color  | default: 'rgba(23,19,16,0.55)' }};

  /* ── Comparison bar ── */
  --bar-h:    {{ section.settings.bar_h   | default: 4 }}px;
  --bar-rad:  {{ section.settings.bar_rad | default: 2 }}px;
  --cmp-font: {{ section.settings.cmp_font.family | default: 'Marcellus' }}, Georgia, serif;

  /* ── Layout ── */
  --col-gap:       {{ section.settings.col_gap        | default: 0 }}px;
  --content-max-w: {{ section.settings.content_max_w  | default: 'none' }};

  /* ── Motion ── */
  --reveal-dist:       {{ section.settings.reveal_dist      | default: 12 }}px;
  --anim-duration:     {{ section.settings.animation_duration | default: 600 }}ms;
  --anim-stagger:      {{ section.settings.animation_stagger | default: 80 }}ms;
  --parallax-strength: {{ section.settings.parallax_strength | default: 0 }};

  /* ── Proof icon ── */
  --proof-icon-size: {{ section.settings.proof_icon_size | default: 22 }}px;

  /* ── Internal ── */
  --ma-hdr: 0px;

  /* ── Applied base styles ── */
  background:    var(--cream);
  color:         var(--ink);
  font-family:   'Cormorant Garamond', Georgia, serif;
  position:      relative;
  overflow:      {{ section.settings.overflow_mode | default: 'hidden' }};
  box-sizing:    border-box;
  margin-top:    {{ section.settings.margin_t | default: 0 }}px;
  margin-bottom: {{ section.settings.margin_b | default: 0 }}px;
}

/* ── Paper texture ── */
{% if section.settings.enable_texture %}
#ma-ar-{{ section_id }}.ma-ar::before {
  content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none;
  opacity: {{ section.settings.texture_opacity | default: 4 | divided_by: 100.0 }};
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='{{ section.settings.noise_amount | default: 4 | divided_by: 5.0 }}' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
}
{% endif %}

/* ── Debug utilities ── */
{% if section.settings.enable_debug_grid %}
#ma-ar-{{ section_id }} .ma-ar__debug-grid {
  position: absolute; inset: 0; pointer-events: none; z-index: 99;
  background-size: 50px 50px;
  background-image: linear-gradient(to right, rgba(0,255,255,0.15) 1px, transparent 1px),
                    linear-gradient(to bottom, rgba(0,255,255,0.15) 1px, transparent 1px);
}
{% endif %}
{% if section.settings.enable_safe_area %}
#ma-ar-{{ section_id }} .ma-ar__safe-area {
  position: absolute; inset: 5%; pointer-events: none; z-index: 99;
  border: 2px dashed rgba(255,0,128,0.4);
}
{% endif %}
{% if section.settings.enable_baseline_grid %}
#ma-ar-{{ section_id }} .ma-ar__baseline-grid {
  position: absolute; inset: 0; pointer-events: none; z-index: 99;
  background-size: 100% 8px;
  background-image: linear-gradient(to bottom, rgba(0,128,255,0.2) 1px, transparent 1px);
}
{% endif %}

/* ── Left column ── */
#ma-ar-{{ section_id }} .ma-ar__left-col {
  box-sizing: border-box;
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  justify-content: {% if section.settings.dt_valign == 'top' %}flex-start{% elsif section.settings.dt_valign == 'bottom' %}flex-end{% elsif section.settings.dt_valign == 'center' %}center{% else %}space-between{% endif %};
  align-items: {% if section.settings.dt_align == 'center' %}center{% else %}flex-start{% endif %};
  max-width: var(--content-max-w);
  transform: translate({{ section.settings.content_offset_x_dt | default: 0 }}px, {{ section.settings.content_offset_y_dt | default: 0 }}px);
}

/* ── Eyebrow ── */
#ma-ar-{{ section_id }} .ma-ar__k {
  font-family:    {{ section.settings.eyebrow_font.family | default: 'Marcellus' }}, Georgia, serif;
  font-size:      var(--eyebrow-size);
  font-weight:    var(--eyebrow-weight);
  letter-spacing: var(--eyebrow-spacing);
  text-transform: uppercase;
  color:          var(--burg2);
  margin:         0 0 var(--gap-head);
  display:        flex;
  align-items:    center;
  gap:            12px;
  justify-content: {% if section.settings.dt_align == 'center' %}center{% else %}flex-start{% endif %};
}
#ma-ar-{{ section_id }} .ma-ar__k::before {
  content:    "";
  width:      var(--divider-w);
  height:     var(--divider-h);
  background: var(--divider-color);
  flex:       0 0 auto;
  opacity:    var(--divider-opacity);
}

/* ── Headline ── */
#ma-ar-{{ section_id }} .ma-ar__h {
  font-family:    {{ section.settings.heading_font.family | default: 'Cormorant Garamond' }}, Georgia, serif !important;
  font-weight:    var(--headline-weight) !important;
  text-transform: none !important;
  letter-spacing: var(--headline-spacing) !important;
  font-size:      clamp(var(--headline-mob-size), min(4vw, 5.2vh), var(--headline-size));
  line-height:    var(--headline-lh);
  margin:         0 0 12px;
  color:          var(--ink);
  max-width:      var(--headline-max-w);
  text-align:     {% if section.settings.dt_align == 'center' %}center{% else %}left{% endif %};
}
#ma-ar-{{ section_id }} .ma-ar__h em {
  font-style:  var(--accent-style);
  font-weight: var(--accent-weight);
  color:       var(--accent-color);
}

/* ── Sub-line ── */
#ma-ar-{{ section_id }} .ma-ar__sub {
  font-family: {{ section.settings.sub_font.family | default: 'Cormorant Garamond' }}, Georgia, serif;
  font-style:  italic;
  font-weight: var(--sub-weight);
  font-size:   clamp(var(--sub-mob-size), 2vh, var(--sub-size));
  line-height: var(--sub-lh);
  color:       var(--sub-color);
  margin:      0 0 var(--sub-margin-b);
  max-width:   var(--sub-max-w);
  text-align:  {% if section.settings.dt_align == 'center' %}center{% else %}left{% endif %};
}

/* ── Comparison bars ── */
#ma-ar-{{ section_id }} .ma-ar__cmp  { margin: 0; width: 100%; }
#ma-ar-{{ section_id }} .ma-ar__row  { padding: 10px 0 0; border-top: 1px solid rgba(23,19,16,.14); }
#ma-ar-{{ section_id }} .ma-ar__top  { display: flex; justify-content: space-between; align-items: baseline; gap: 14px; }
#ma-ar-{{ section_id }} .ma-ar__lab  { font-family: var(--cmp-font); font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: rgba(23,19,16,.7); }
#ma-ar-{{ section_id }} .ma-ar__val  { font-family: 'Cormorant Garamond',Georgia,serif; white-space: nowrap; }
#ma-ar-{{ section_id }} .ma-ar__val--typ { font-size: clamp(18px,2.8vh,24px); font-weight: 500; color: rgba(23,19,16,.44); text-decoration: line-through; text-decoration-thickness: 1.5px; }
#ma-ar-{{ section_id }} .ma-ar__val--now { font-size: clamp(26px,min(8vw,4.8vh),42px); font-weight: 600; color: var(--burg2); }
#ma-ar-{{ section_id }} .ma-ar__val--now em { font-style: italic; font-weight: 400; font-size: .52em; color: var(--burg); margin-right: 2px; }
#ma-ar-{{ section_id }} .ma-ar__track {
  display: block;
  height:  var(--bar-h);
  background: rgba(23,19,16,.08);
  border-radius: var(--bar-rad);
  overflow: hidden;
  margin: 8px 0 10px;
}
#ma-ar-{{ section_id }} .ma-ar__fill { display: block; height: 100%; width: 0; border-radius: var(--bar-rad); }
#ma-ar-{{ section_id }} .ma-ar__fill--typ { background: rgba(23,19,16,.55); transition: width 1.4s cubic-bezier(.25,.8,.25,1) .1s; }
#ma-ar-{{ section_id }} .ma-ar__fill--now { background: var(--fill); transition: width 1.1s cubic-bezier(.25,.8,.25,1) .7s; }
#ma-ar-{{ section_id }}.is-in .ma-ar__fill--typ { width: 100%; }
#ma-ar-{{ section_id }}.is-in .ma-ar__fill--now { width: 12%; }
#ma-ar-{{ section_id }} .ma-ar__refine { margin: 12px 0 0; display: flex; flex-direction: column; gap: 6px; }
#ma-ar-{{ section_id }} .ma-ar__ref   { font-size: 15px; font-weight: 500; color: rgba(23,19,16,.85); line-height: 1.4; margin: 0; }
#ma-ar-{{ section_id }} .ma-ar__ref b { color: var(--gold); font-weight: 400; margin-right: 8px; }

/* ── Comparison cards ── */
#ma-ar-{{ section_id }} .ma-ar__cards {
  position: relative;
  display: flex;
  gap: clamp(12px, 1.5vw, {{ section.settings.card_gap | default: 24 }}px);
}
#ma-ar-{{ section_id }} .ma-ar__card {
  flex: 1 1 0; min-width: 0;
  padding: clamp(14px, 2vh, {{ section.settings.card_padding | default: 20 }}px);
  border-radius: {{ section.settings.card_radius | default: 8 }}px;
  background: {{ section.settings.card_bg_col | default: '#F0EAE1' }};
  border: 1px solid {{ section.settings.card_border_color | default: '#E2DCD3' }};
  transition: transform 0.35s var(--hover-easing), box-shadow 0.35s ease;
  {% if section.settings.card_shadow_strength > 0 %}
  box-shadow: 0 {{ section.settings.card_shadow_strength }}px {{ section.settings.card_shadow_strength | times: 2 }}px rgba(23,19,16,{{ section.settings.card_shadow_strength | times: 1.0 | divided_by: 200 }});
  {% endif %}
}
{% if section.settings.enable_card_hover %}
#ma-ar-{{ section_id }} .ma-ar__card:hover {
  transform: translateY(-{{ section.settings.hover_lift | default: 4 }}px);
  box-shadow: 0 16px 36px -10px rgba(23,19,16,0.12);
}
{% endif %}
#ma-ar-{{ section_id }} .ma-ar__card--us {
  background: linear-gradient(145deg, rgba(244,238,225,0.98), rgba(244,238,225,0.68));
  border-color: rgba(198,161,91,0.5);
  box-shadow: 0 14px 34px -10px rgba(0,0,0,0.08);
}
#ma-ar-{{ section_id }} .ma-ar__card-h {
  font-family: var(--cmp-font); font-size: 10px; letter-spacing: .14em; text-transform: uppercase;
  color: rgba(23,19,16,.65); margin: 0 0 10px; padding-bottom: 8px; border-bottom: 1px solid rgba(23,19,16,.12);
}
#ma-ar-{{ section_id }} .ma-ar__card--us .ma-ar__card-h { color: var(--burg2); border-color: rgba(198,161,91,0.28); }
#ma-ar-{{ section_id }} .ma-ar__list { list-style: none; margin: 0 0 10px; padding: 0; display: flex; flex-direction: column; gap: 6px; }
#ma-ar-{{ section_id }} .ma-ar__list-item { display: flex; align-items: center; gap: 8px; font-size: clamp(14px,1.8vh,16px); color: rgba(23,19,16,.85); }
#ma-ar-{{ section_id }} .ma-ar__list-icon { flex: 0 0 auto; width: 15px; height: 15px; color: var(--gold); display: flex; align-items: center; }
#ma-ar-{{ section_id }} .ma-ar__card--them .ma-ar__list-icon { color: rgba(23,19,16,0.4); }
#ma-ar-{{ section_id }} .ma-ar__list-icon svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
#ma-ar-{{ section_id }} .ma-ar__card-foot { padding-top: 8px; border-top: 1px solid rgba(23,19,16,.12); display: flex; flex-direction: column; gap: 2px; }
#ma-ar-{{ section_id }} .ma-ar__card--us .ma-ar__card-foot { border-color: rgba(198,161,91,0.28); }

/* Price typography — driven by settings */
#ma-ar-{{ section_id }} .ma-ar__card-price {
  font-family:  'Cormorant Garamond', Georgia, serif;
  font-size:    clamp(20px, 2.6vh, var(--price-size));
  font-weight:  var(--price-weight);
  line-height:  1;
  color:        var(--price-color);
}
#ma-ar-{{ section_id }} .ma-ar__card--us .ma-ar__card-price {
  color:      var(--burg2);
  font-size:  clamp(24px, 3vh, var(--price-us-size));
}
#ma-ar-{{ section_id }} .ma-ar__card--us .ma-ar__card-price em { font-style: italic; font-weight: 400; font-size: .6em; color: var(--burg); }

/* Caption typography */
#ma-ar-{{ section_id }} .ma-ar__card-sub,
#ma-ar-{{ section_id }} .ma-ar__caption {
  display:     block;
  font-size:   var(--caption-size);
  font-weight: var(--caption-weight);
  color:       var(--caption-color);
  margin-top:  2px;
}

#ma-ar-{{ section_id }} .ma-ar__vs {
  position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%);
  font-family: var(--cmp-font); font-size: 12px; letter-spacing: .08em; color: var(--gold);
  background: var(--cream); padding: 4px 8px; border-radius: 50%; z-index: 2;
}

/* ── Proof grid ── */
#ma-ar-{{ section_id }} .ma-ar__proof {
  display: grid;
  gap: clamp(8px, 1.2vw, {{ section.settings.proof_gap | default: 16 }}px);
  {% if section.settings.proof_divider %}border-top: 1px solid rgba(23,19,16,.12); padding-top: 12px;{% endif %}
}
#ma-ar-{{ section_id }} .ma-ar__proof-item { display: flex; flex-direction: column; gap: 3px; padding-right: 6px; }
#ma-ar-{{ section_id }} .ma-ar__proof-ic { display: block; width: var(--proof-icon-size); height: var(--proof-icon-size); color: var(--gold); margin-bottom: 6px; }
#ma-ar-{{ section_id }} .ma-ar__proof-ic svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }
#ma-ar-{{ section_id }} .ma-ar__proof-h { font-family: 'Cormorant Garamond',Georgia,serif; font-weight: 600; font-size: clamp(17px,2.2vh,20px); margin: 0 0 4px; color: var(--ink); line-height: 1.2; }
#ma-ar-{{ section_id }} .ma-ar__proof-b { font-size: clamp(13.5px,1.6vh,15px); line-height: 1.4; color: rgba(23,19,16,.75); margin: 0; }

/* ── Conclusion ── */
#ma-ar-{{ section_id }} .ma-ar__conclusion { text-align: center; padding-top: 10px; border-top: 1px solid rgba(23,19,16,.12); }
#ma-ar-{{ section_id }} .ma-ar__crown { display: block; font-size: 16px; color: var(--gold); margin-bottom: 2px; }
#ma-ar-{{ section_id }} .ma-ar__conc-h { font-family: 'Cormorant Garamond',Georgia,serif; font-size: clamp(18px,2.2vh,var(--conc-size)); font-weight: 600; margin: 0 0 2px; color: var(--ink); line-height: 1.2; }
#ma-ar-{{ section_id }} .ma-ar__conc-b { font-style: italic; font-size: clamp(13px,1.6vh,15px); color: var(--burg); margin: 0; }

/* ── Reveal animation ── */
{% if section.settings.enable_animation %}
#ma-ar-{{ section_id }} .ma-ar__reveal {
  opacity: 0;
  transform: translateY(var(--reveal-dist));
  transition: opacity var(--anim-duration) ease,
              transform var(--anim-duration) cubic-bezier(.22,1,.36,1);
}
#ma-ar-{{ section_id }}.is-in .ma-ar__reveal  { opacity: 1; transform: none; }
#ma-ar-{{ section_id }}.is-in .ma-ar__cards   { transition-delay: 0ms; }
#ma-ar-{{ section_id }}.is-in .ma-ar__proof   { transition-delay: var(--anim-stagger); }
#ma-ar-{{ section_id }}.is-in .ma-ar__conclusion { transition-delay: calc(var(--anim-stagger) * 2); }
{% endif %}

/* ── Photo column ── */
#ma-ar-{{ section_id }} .ma-ar__photo { overflow: hidden; position: relative; width: 100%; height: 100%; }

#ma-ar-{{ section_id }} .ma-ar__img {
  width: 100%; height: 100%; display: block;
  object-fit:      var(--img-object-fit);
  object-position: var(--img-focal-x) var(--img-focal-y);
  opacity:         var(--img-opacity);
  transform:       scale(var(--img-scale)) translate(var(--img-offset-x), var(--img-offset-y));
  filter: brightness(var(--img-brightness))
          contrast(var(--img-contrast))
          saturate(var(--img-saturation))
          sepia(var(--img-warmth));
}

/* Hover zoom on photo */
{% if section.settings.enable_hover_zoom %}
#ma-ar-{{ section_id }} .ma-ar__photo:hover .ma-ar__img {
  transform: scale(var(--hover-scale)) translate(var(--img-offset-x), var(--img-offset-y));
  transition: transform var(--hover-duration) var(--hover-easing);
}
{% endif %}

#ma-ar-{{ section_id }} .ma-ar__img--dt  { display: block; }
#ma-ar-{{ section_id }} .ma-ar__img--mob { display: none;  }

/* Overlay */
#ma-ar-{{ section_id }} .ma-ar__overlay {
  position: absolute; inset: 0; z-index: 4; pointer-events: none;
  background: var(--overlay-color);
  opacity: var(--overlay-opacity);
}
/* Vignette */
#ma-ar-{{ section_id }} .ma-ar__vignette {
  position: absolute; inset: 0; z-index: 5; pointer-events: none;
  background: radial-gradient(ellipse at center, transparent 40%, rgba(0,0,0,var(--vignette-str)) 100%);
}

/* ================================================================
   MOBILE  < 900px
   ================================================================ */
@media (max-width: 899px) {
  #ma-ar-{{ section_id }}.ma-ar {
    display: flex;
    flex-direction: column;
    height: auto;
    max-height: none;
    overflow: visible;
    min-height: {{ section.settings.mob_section_h | default: 0 }}px;
  }
  #ma-ar-{{ section_id }} .ma-ar__left-col {
    flex: 0 0 auto;
    justify-content: flex-start;
    align-items: flex-start;
    padding: {{ section.settings.mobile_padding_top | default: 35 }}px {{ section.settings.mobile_padding_x | default: 20 }}px {{ section.settings.mobile_padding_bottom | default: 45 }}px;
    transform: translate({{ section.settings.content_offset_x_mob | default: 0 }}px, {{ section.settings.content_offset_y_mob | default: 0 }}px);
    gap: {{ section.settings.mob_gap | default: 0 }}px;
  }
  #ma-ar-{{ section_id }} .ma-ar__photo {
    order: {% if section.settings.mobile_image_first %}-1{% else %}1{% endif %};
    height: {{ section.settings.mobile_image_height | default: 380 }}px;
    width: 100%;
    display: block !important;
  }
  #ma-ar-{{ section_id }} .ma-ar__img--dt  { display: none !important; }
  #ma-ar-{{ section_id }} .ma-ar__img--mob { display: block !important; }

  #ma-ar-{{ section_id }} .ma-ar__cards { flex-direction: column; gap: 16px; }
  #ma-ar-{{ section_id }} .ma-ar__vs {
    position: relative; left: auto; top: auto; transform: none;
    margin: -6px auto; display: block; width: fit-content;
  }
  #ma-ar-{{ section_id }} .ma-ar__proof {
    grid-template-columns: repeat({{ section.settings.proof_cols_mob | default: '2' }}, 1fr);
    gap: 16px;
  }

  /* Mobile melt */
  {%- if melt > 0 -%}
  #ma-ar-{{ section_id }} .ma-ar__photo::before {
    content: ""; position: absolute; z-index: 2; left: 0; right: 0; bottom: 0;
    height: 34%; pointer-events: none;
    backdrop-filter: blur({{ section.settings.fade_blur | default: melt_blur }}px);
    -webkit-backdrop-filter: blur({{ section.settings.fade_blur | default: melt_blur }}px);
    -webkit-mask-image: linear-gradient(0deg, #000 0, transparent 100%);
            mask-image: linear-gradient(0deg, #000 0, transparent 100%);
  }
  #ma-ar-{{ section_id }} .ma-ar__photo::after {
    content: ""; position: absolute; z-index: 3; inset: 0; pointer-events: none;
    opacity: var(--melt-veil);
    background: linear-gradient(0deg, var(--cream) 0%, rgba(244,238,225,.55) 14%, rgba(244,238,225,0) 46%);
  }
  {%- endif -%}
}

/* ================================================================
   DESKTOP  >= 900px
   ================================================================ */
@media (min-width: 900px) {
  #ma-ar-{{ section_id }}.ma-ar {
    display: grid !important;
    grid-template-columns: {{ split_left }}% {{ split_right }}% !important;
    column-gap: var(--col-gap) !important;
    height: auto !important;
    min-height: {{ section.settings.dt_height | default: 720 }}px !important;
    overflow: {{ section.settings.overflow_mode | default: 'hidden' }} !important;
    max-width: {{ section.settings.dt_max_w | default: 1440 }}px;
    margin-left: auto;
    margin-right: auto;
  }
  #ma-ar-{{ section_id }} .ma-ar__left-col {
    height: auto !important;
    max-height: none !important;
    padding: {{ section.settings.padding_top | default: 24 }}px {{ section.settings.padding_x | default: 48 }}px {{ section.settings.padding_bottom | default: 24 }}px {{ section.settings.padding_x | default: 48 }}px !important;
    overflow: visible !important;
    box-sizing: border-box !important;
  }
  #ma-ar-{{ section_id }} .ma-ar__proof {
    grid-template-columns: repeat({{ section.settings.proof_cols_dt | default: '4' }}, 1fr) !important;
  }
  #ma-ar-{{ section_id }} .ma-ar__proof-item:not(:last-child) {
    border-right: 1px solid rgba(23,19,16,.08);
  }
  #ma-ar-{{ section_id }} .ma-ar__photo {
    height: 100% !important; width: 100% !important;
    position: relative !important; overflow: hidden !important; display: block !important;
  }
  #ma-ar-{{ section_id }} .ma-ar__img--dt  { display: block !important; height: 100% !important; width: 100% !important; }
  #ma-ar-{{ section_id }} .ma-ar__img--mob { display: none !important; }

  /* Desktop melt / fade */
  {%- if melt > 0 -%}
  #ma-ar-{{ section_id }} .ma-ar__photo::before {
    content: ""; position: absolute; z-index: 2; top: 0; bottom: 0; left: 0;
    width: {{ section.settings.melt_width | default: 40 }}%; pointer-events: none;
    backdrop-filter: blur(var(--melt-blur));
    -webkit-backdrop-filter: blur(var(--melt-blur));
    -webkit-mask-image: linear-gradient(90deg, #000 0, transparent 100%);
            mask-image: linear-gradient(90deg, #000 0, transparent 100%);
  }
  #ma-ar-{{ section_id }} .ma-ar__photo::after {
    content: ""; position: absolute; z-index: 3; inset: 0; pointer-events: none;
    opacity: var(--melt-veil);
    background: linear-gradient(90deg, var(--cream) 0%, rgba(244,238,225,.6) 12%, rgba(244,238,225,0) 48%);
  }
  {%- endif -%}
}

/* ── Reduced motion ── */
@media (prefers-reduced-motion: reduce) {
  #ma-ar-{{ section_id }} .ma-ar__fill { transition: none !important; }
  #ma-ar-{{ section_id }} .ma-ar__fill--typ { width: 100% !important; }
  #ma-ar-{{ section_id }} .ma-ar__fill--now { width: 12% !important; }
  #ma-ar-{{ section_id }} .ma-ar__reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
}
</style>

<script>
(function () {
  var sid = 'ma-ar-{{ section_id }}';
  var s = document.getElementById(sid);
  if (!s) return;

  /* ── Sticky-header offset ── */
  function fitHeader() {
    var off = 0;
    ['sticky-header', '.shopify-section-group-header-group', '.section-header', 'header'].some(function (sel) {
      var el = document.querySelector(sel);
      if (!el) return false;
      var cs = getComputedStyle(el);
      if (cs.position === 'sticky' || cs.position === 'fixed') {
        off = el.getBoundingClientRect().height;
        return true;
      }
      return false;
    });
    s.style.setProperty('--ma-hdr', off + 'px');
  }
  fitHeader();
  window.addEventListener('resize', fitHeader);

  /* ── Scroll parallax (if enabled) ── */
  var parallaxStrength = parseFloat(s.style.getPropertyValue('--parallax-strength')) || {{ section.settings.parallax_strength | default: 0 }};
  if (parallaxStrength > 0) {
    var photo = s.querySelector('.ma-ar__photo');
    if (photo) {
      function applyParallax() {
        var rect = s.getBoundingClientRect();
        var progress = (window.innerHeight - rect.top) / (window.innerHeight + rect.height);
        var shift = (progress - 0.5) * parallaxStrength * 60;
        photo.style.transform = 'translateY(' + shift + 'px)';
      }
      window.addEventListener('scroll', applyParallax, { passive: true });
      applyParallax();
    }
  }

  /* ── IntersectionObserver for animations + bar fills ── */
  {% if request.design_mode %}
    s.classList.add('is-in');
    return;
  {% endif %}

  if (!('IntersectionObserver' in window)) { s.classList.add('is-in'); return; }

  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) s.classList.add('is-in');
      else s.classList.remove('is-in');
    });
  }, { threshold: 0.3 });
  io.observe(s);
})();
</script>

