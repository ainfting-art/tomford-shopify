{%- comment -%}
  MAISON AMIIR — Home · Honest Arithmetic V3.
  Rebuilt architecture per blueprint: true single-viewport 2-column editorial split
  (never stacked on desktop), icon-list comparison cards with VS divider, 4-across
  proof grid, conclusion line, image melts full-height into cream on the right.
  Mobile is independently stacked (image → eyebrow → headline → subheading →
  comparison → proof → conclusion). ALL existing schema IDs preserved:
  bottle_image, melt, eyebrow, heading, subheading, left_label, left_value,
  right_label, right_value, refine_1, refine_2 — legacy content carries over.
{%- endcomment -%}

{%- assign has_img = false -%}
{%- if section.settings.bottle_image != blank -%}{%- assign has_img = true -%}{%- endif -%}
{%- assign melt = section.settings.melt | default: 100 -%}
{%- assign melt_blur = melt | times: 9.0 | divided_by: 100.0 -%}
{%- assign melt_veil = melt | divided_by: 100.0 -%}
{%- assign now_value = section.settings.right_value | escape | replace: 'from ', '<em>from</em> ' -%}
{%- assign split = section.settings.split_ratio | default: '55/45' -%}
{%- assign split_parts = split | split: '/' -%}
{%- assign split_left = split_parts[0] -%}
{%- assign split_right = split_parts[1] -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Marcellus&display=swap" rel="stylesheet">

{%- capture icon_svg -%}
  {%- case icon_key -%}
    {%- when 'store' -%}<path d="M4 10l1-6h14l1 6M4 10v9h16v-9M4 10h16M9 19v-5h4v5"/>
    {%- when 'megaphone' -%}<path d="M3 10v4l14 4V6L3 10z"/><path d="M17 9v6"/><path d="M7 14v4a2 2 0 0 0 2 2h1v-6"/>
    {%- when 'tv' -%}<rect x="3" y="6" width="18" height="12" rx="1"/><path d="M9 21h6M12 18v3"/>
    {%- when 'gift' -%}<rect x="4" y="9" width="16" height="11" rx="1"/><path d="M12 9v11M4 9h16M12 9c-1.5-4-6-4-6-1.5S9 9 12 9z"/>
    {%- when 'arrow-up' -%}<path d="M12 19V5M6 11l6-6 6 6"/>
    {%- when 'droplet' -%}<path d="M12 2s7 7.5 7 12.5A7 7 0 0 1 5 14.5C5 9.5 12 2 12 2z"/><path d="M9.3 15.8a2.7 2.7 0 0 0 2.2 2.5"/>
    {%- when 'leaf' -%}<path d="M4 19c8 1 15-4 16-15-9 0-16 4-16 15z"/><path d="M4 19c3-5 7-8 12-10"/>
    {%- when 'scissors' -%}<circle cx="6" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><path d="M8.5 8L20 19M8.5 16L20 5"/>
    {%- when 'bag' -%}<path d="M6 8h12l1 12H5L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
    {%- when 'shield' -%}<path d="M12 3l7 2.6v5.1c0 4.4-3 7.4-7 8.8-4-1.4-7-4.4-7-8.8V5.6L12 3z"/><path d="M9 12l2 2 4-4.2"/>
    {%- when 'clock' -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>
    {%- when 'heart' -%}<path d="M12 20s-7-4.4-9.3-8.8C1.2 8 2.7 4.8 6 4.2c2-.4 3.7.6 4.9 2.3 1.2-1.7 2.9-2.7 4.9-2.3 3.3.6 4.8 3.8 3.3 7C19 15.6 12 20 12 20z"/>
    {%- else -%}
  {%- endcase -%}
{%- endcapture -%}

<section class="ma-ar {% if has_img %}ma-ar--split{% endif %}" id="ma-ar-{{ section.id }}">
  <div class="ma-ar__copy">
    {%- if section.settings.eyebrow != blank -%}
      <p class="ma-ar__k">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="ma-ar__h">{{ section.settings.heading | escape | replace: 'Not on the receipt.', '<em>Not on the receipt.</em>' }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="ma-ar__sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    {%- if section.settings.comparison_style == 'bars' -%}
      <div class="ma-ar__cmp">
        <div class="ma-ar__row">
          <div class="ma-ar__top">
            <span class="ma-ar__lab">{{ section.settings.left_label | escape }}</span>
            <span class="ma-ar__val ma-ar__val--typ">{{ section.settings.left_value | escape }}</span>
          </div>
          <div class="ma-ar__track"><span class="ma-ar__fill ma-ar__fill--typ"></span></div>
        </div>
        <div class="ma-ar__row">
          <div class="ma-ar__top">
            <span class="ma-ar__lab">{{ section.settings.right_label | escape }}</span>
            <span class="ma-ar__val ma-ar__val--now">{{ now_value }}</span>
          </div>
          <div class="ma-ar__track"><span class="ma-ar__fill ma-ar__fill--now"></span></div>
        </div>
      </div>
      {%- if section.settings.refine_1 != blank or section.settings.refine_2 != blank -%}
        <div class="ma-ar__refine">
          {%- if section.settings.refine_1 != blank -%}<p class="ma-ar__ref"><b>◆</b>{{ section.settings.refine_1 | escape }}</p>{%- endif -%}
          {%- if section.settings.refine_2 != blank -%}<p class="ma-ar__ref"><b>◆</b>{{ section.settings.refine_2 | escape }}</p>{%- endif -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="ma-ar__cards ma-ar__reveal">
        <div class="ma-ar__card">
          {%- if section.settings.card1_header != blank -%}<p class="ma-ar__card-h">{{ section.settings.card1_header | escape }}</p>{%- endif -%}
          <ul class="ma-ar__list">
            {%- assign c1_icons = 'store,megaphone,tv,gift,arrow-up' | split: ',' -%}
            {%- assign card1_items_array = section.settings.card1_items | newline_to_br | strip_newlines | split: '<br />' -%}
            {%- for item in card1_items_array -%}
              {%- assign trimmed = item | strip -%}
              {%- if trimmed != blank -%}
                {%- assign icon_key = c1_icons[forloop.index0] | default: 'arrow-up' -%}
                <li><span class="ma-ar__ic">{% capture icon_svg %}{%- case icon_key -%}{%- when 'store' -%}<path d="M4 10l1-6h14l1 6M4 10v9h16v-9M4 10h16M9 19v-5h4v5"/>{%- when 'megaphone' -%}<path d="M3 10v4l14 4V6L3 10z"/><path d="M17 9v6"/><path d="M7 14v4a2 2 0 0 0 2 2h1v-6"/>{%- when 'tv' -%}<rect x="3" y="6" width="18" height="12" rx="1"/><path d="M9 21h6M12 18v3"/>{%- when 'gift' -%}<rect x="4" y="9" width="16" height="11" rx="1"/><path d="M12 9v11M4 9h16M12 9c-1.5-4-6-4-6-1.5S9 9 12 9z"/>{%- when 'arrow-up' -%}<path d="M12 19V5M6 11l6-6 6 6"/>{%- endcase -%}{% endcapture %}<svg viewBox="0 0 24 24">{{ icon_svg }}</svg></span>{{ trimmed }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          <div class="ma-ar__card-price">
            <span class="ma-ar__price ma-ar__price--typ">{{ section.settings.left_value | escape }}</span>
            <span class="ma-ar__caption">{{ section.settings.left_label | escape }}</span>
          </div>
        </div>

        <span class="ma-ar__vs">{{ section.settings.vs_text | default: 'VS' | escape }}</span>

        <div class="ma-ar__card ma-ar__card--now">
          {%- if section.settings.card2_header != blank -%}<p class="ma-ar__card-h">{{ section.settings.card2_header | escape }}</p>{%- endif -%}
          <ul class="ma-ar__list">
            {%- assign c2_icons = 'droplet,leaf,scissors,bag,arrow-up' | split: ',' -%}
            {%- assign card2_items_array = section.settings.card2_items | newline_to_br | strip_newlines | split: '<br />' -%}
            {%- for item in card2_items_array -%}
              {%- assign trimmed = item | strip -%}
              {%- if trimmed != blank -%}
                {%- assign icon_key = c2_icons[forloop.index0] | default: 'arrow-up' -%}
                <li><span class="ma-ar__ic ma-ar__ic--now">{% capture icon_svg %}{%- case icon_key -%}{%- when 'droplet' -%}<path d="M12 2s7 7.5 7 12.5A7 7 0 0 1 5 14.5C5 9.5 12 2 12 2z"/><path d="M9.3 15.8a2.7 2.7 0 0 0 2.2 2.5"/>{%- when 'leaf' -%}<path d="M4 19c8 1 15-4 16-15-9 0-16 4-16 15z"/><path d="M4 19c3-5 7-8 12-10"/>{%- when 'scissors' -%}<circle cx="6" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><path d="M8.5 8L20 19M8.5 16L20 5"/>{%- when 'bag' -%}<path d="M6 8h12l1 12H5L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>{%- when 'arrow-up' -%}<path d="M12 19V5M6 11l6-6 6 6"/>{%- endcase -%}{% endcapture %}<svg viewBox="0 0 24 24">{{ icon_svg }}</svg></span>{{ trimmed }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          <div class="ma-ar__card-price">
            <span class="ma-ar__price ma-ar__price--now">{{ now_value }}</span>
            <span class="ma-ar__caption">{{ section.settings.right_label | escape }}</span>
          </div>
        </div>
      </div>

      <div class="ma-ar__proof ma-ar__reveal">
        {%- for i in (1..4) -%}
          {%- case i -%}
            {%- when 1 -%}{%- assign p_icon = section.settings.proof1_icon -%}{%- assign p_h = section.settings.proof1_heading -%}{%- assign p_b = section.settings.proof1_body -%}
            {%- when 2 -%}{%- assign p_icon = section.settings.proof2_icon -%}{%- assign p_h = section.settings.proof2_heading -%}{%- assign p_b = section.settings.proof2_body -%}
            {%- when 3 -%}{%- assign p_icon = section.settings.proof3_icon -%}{%- assign p_h = section.settings.proof3_heading -%}{%- assign p_b = section.settings.proof3_body -%}
            {%- when 4 -%}{%- assign p_icon = section.settings.proof4_icon -%}{%- assign p_h = section.settings.proof4_heading -%}{%- assign p_b = section.settings.proof4_body -%}
          {%- endcase -%}
          <div class="ma-ar__proof-item">
            {%- if p_icon != 'none' -%}
              <span class="ma-ar__proof-ic">{% capture icon_svg %}{%- case p_icon -%}{%- when 'droplet' -%}<path d="M12 2s7 7.5 7 12.5A7 7 0 0 1 5 14.5C5 9.5 12 2 12 2z"/><path d="M9.3 15.8a2.7 2.7 0 0 0 2.2 2.5"/>{%- when 'shield' -%}<path d="M12 3l7 2.6v5.1c0 4.4-3 7.4-7 8.8-4-1.4-7-4.4-7-8.8V5.6L12 3z"/><path d="M9 12l2 2 4-4.2"/>{%- when 'clock' -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>{%- when 'heart' -%}<path d="M12 20s-7-4.4-9.3-8.8C1.2 8 2.7 4.8 6 4.2c2-.4 3.7.6 4.9 2.3 1.2-1.7 2.9-2.7 4.9-2.3 3.3.6 4.8 3.8 3.3 7C19 15.6 12 20 12 20z"/>{%- when 'leaf' -%}<path d="M4 19c8 1 15-4 16-15-9 0-16 4-16 15z"/><path d="M4 19c3-5 7-8 12-10"/>{%- endcase -%}{% endcapture %}<svg viewBox="0 0 24 24">{{ icon_svg }}</svg></span>
            {%- endif -%}
            {%- if p_h != blank -%}<p class="ma-ar__proof-h">{{ p_h | escape }}</p>{%- endif -%}
            {%- if p_b != blank -%}<p class="ma-ar__proof-b">{{ p_b | escape }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.conclusion_heading != blank or section.settings.conclusion_body != blank -%}
        <div class="ma-ar__conclusion ma-ar__reveal">
          {%- if section.settings.conclusion_heading != blank -%}<p class="ma-ar__conc-h">{{ section.settings.conclusion_heading | escape }}</p>{%- endif -%}
          {%- if section.settings.conclusion_body != blank -%}<p class="ma-ar__conc-b">{{ section.settings.conclusion_body | escape }}</p>{%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>

  {%- if has_img -%}
    <div class="ma-ar__photo">
      {{ section.settings.bottle_image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'ma-ar__img', alt: section.settings.bottle_image.alt | default: shop.name }}
    </div>
  {%- endif -%}
</section>

<style>
  #ma-ar-{{ section.id }}.ma-ar{
    --cream:{{ section.settings.bg_color | default: '#F4EEE1' }}; --ink:#171310; --gold:#C6A15B; --burg:#6E1220; --burg2:#8E1B28;
    --ma-hdr:0px;
    height:calc(100vh - var(--ma-hdr));
    max-height:calc(100vh - var(--ma-hdr));
    overflow:hidden;
    display:flex; flex-direction:column;
    background:var(--cream); color:var(--ink);
    font-family:'Cormorant Garamond',Georgia,serif;
  }

  {% if section.settings.enable_texture %}
  #ma-ar-{{ section.id }}.ma-ar::before{
    content:''; position:absolute; inset:0; z-index:0; pointer-events:none;
    background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='{{ section.settings.texture_opacity | divided_by: 100.0 }}'/%3E%3C/svg%3E");
  }
  {% endif %}

  #ma-ar-{{ section.id }} .ma-ar__copy{
    flex:1 1 auto; min-height:0; box-sizing:border-box; position:relative; z-index:1;
    display:flex; flex-direction:column;
    justify-content:center; justify-content:safe center;
    padding:18px 24px 14px;
  }
  #ma-ar-{{ section.id }} .ma-ar__k{
    font-family:'Marcellus',serif; font-size:11px; letter-spacing:.26em;
    text-transform:uppercase; color:var(--burg2); margin:0 0 14px;
    display:flex; align-items:center; gap:12px;
  }
  #ma-ar-{{ section.id }} .ma-ar__k::before{ content:""; width:34px; height:2px; background:var(--burg2); flex:0 0 auto; }
  #ma-ar-{{ section.id }} .ma-ar__h{
    font-family:'Cormorant Garamond',Georgia,serif;
    font-weight:600 !important; text-transform:none !important; letter-spacing:0 !important;
    font-size:clamp(26px, min(9.2vw, 5.2svh), {{ section.settings.headline_size | default: 54 }}px); line-height:1.12; margin:0 0 10px; color:var(--ink);
  }
  #ma-ar-{{ section.id }} .ma-ar__h em{ font-style:italic; color:var(--burg); }
  #ma-ar-{{ section.id }} .ma-ar__sub{
    font-style:italic; font-weight:500; font-size:clamp(14px, 2.4svh, {{ section.settings.body_size | default: 19 }}px); line-height:1.45;
    color:rgba(23,19,16,.74); margin:0 0 clamp(8px,2svh,18px); max-width:44ch;
  }

  /* ---- legacy bar comparison (comparison_style = bars) ---- */
  #ma-ar-{{ section.id }} .ma-ar__cmp{ margin:0; width:100%; }
  #ma-ar-{{ section.id }} .ma-ar__row{ padding:13px 0 0; border-top:1px solid rgba(23,19,16,.14); }
  #ma-ar-{{ section.id }} .ma-ar__top{ display:flex; justify-content:space-between; align-items:baseline; gap:14px; }
  #ma-ar-{{ section.id }} .ma-ar__lab{ font-family:'Marcellus',serif; font-size:10px; letter-spacing:.18em; text-transform:uppercase; color:rgba(23,19,16,.7); }
  #ma-ar-{{ section.id }} .ma-ar__val{ font-family:'Cormorant Garamond',Georgia,serif; white-space:nowrap; }
  #ma-ar-{{ section.id }} .ma-ar__val--typ{ font-size:clamp(20px, 3.2svh, 27px); font-weight:500; color:rgba(23,19,16,.44); text-decoration:line-through; text-decoration-thickness:1.5px; }
  #ma-ar-{{ section.id }} .ma-ar__val--now{ font-size:clamp(30px, min(10.5vw, 5.6svh), 48px); font-weight:600; color:var(--burg2); }
  #ma-ar-{{ section.id }} .ma-ar__val--now em{ font-style:italic; font-weight:400; font-size:.52em; color:var(--burg); margin-right:2px; }
  #ma-ar-{{ section.id }} .ma-ar__track{ display:block; height:4px; background:rgba(23,19,16,.08); border-radius:2px; overflow:hidden; margin:10px 0 12px; }
  #ma-ar-{{ section.id }} .ma-ar__fill{ display:block; height:100%; width:0; border-radius:2px; }
  #ma-ar-{{ section.id }} .ma-ar__fill--typ{ background:rgba(23,19,16,.55); transition:width 1.4s cubic-bezier(.25,.8,.25,1) .1s; }
  #ma-ar-{{ section.id }} .ma-ar__fill--now{ background:var(--burg2); transition:width 1.1s cubic-bezier(.25,.8,.25,1) .7s; }
  #ma-ar-{{ section.id }}.is-in .ma-ar__fill--typ{ width:100%; }
  #ma-ar-{{ section.id }}.is-in .ma-ar__fill--now{ width:12%; }
  #ma-ar-{{ section.id }} .ma-ar__refine{ margin:16px 0 0; display:flex; flex-direction:column; gap:8px; }
  #ma-ar-{{ section.id }} .ma-ar__ref{ font-size:16.5px; font-weight:500; color:rgba(23,19,16,.85); line-height:1.5; margin:0; }
  #ma-ar-{{ section.id }} .ma-ar__ref b{ color:var(--gold); font-weight:400; margin-right:8px; }

  /* ---- new: comparison cards (comparison_style = cards) ---- */
  #ma-ar-{{ section.id }} .ma-ar__cards{
    position:relative; display:flex; gap:{{ section.settings.card_gap | default: 32 }}px;
    margin-top:{{ section.settings.section_gap | default: 20 }}px;
  }
  #ma-ar-{{ section.id }} .ma-ar__card{
    flex:1 1 0; min-width:0; padding:{{ section.settings.card_padding | default: 24 }}px;
    border-radius:{{ section.settings.card_radius | default: 10 }}px;
    background:rgba(23,19,16,.035);
    border:1px solid {{ section.settings.card_border_color | default: '#e8e0d0' }};
    {% if section.settings.card_shadow_strength > 0 %}box-shadow:0 {{ section.settings.card_shadow_strength }}px {{ section.settings.card_shadow_strength | times: 2 }}px rgba(23,19,16,{{ section.settings.card_shadow_strength | times: 1.0 | divided_by: 200 }});{% endif %}
  }
  #ma-ar-{{ section.id }} .ma-ar__card-h{
    font-family:'Marcellus',serif; font-size:10.5px; letter-spacing:.14em; text-transform:uppercase;
    color:rgba(23,19,16,.6); margin:0 0 14px; padding-bottom:10px; border-bottom:1px solid rgba(23,19,16,.12);
  }
  #ma-ar-{{ section.id }} .ma-ar__list{ list-style:none; margin:0 0 14px; padding:0; display:flex; flex-direction:column; gap:9px; }
  #ma-ar-{{ section.id }} .ma-ar__list li{ display:flex; align-items:center; gap:9px; font-size:14px; color:rgba(23,19,16,.8); }
  #ma-ar-{{ section.id }} .ma-ar__ic{ flex:0 0 auto; width:16px; height:16px; color:rgba(23,19,16,.5); }
  #ma-ar-{{ section.id }} .ma-ar__ic--now{ color:var(--gold); }
  #ma-ar-{{ section.id }} .ma-ar__ic svg{ width:100%; height:100%; fill:none; stroke:currentColor; stroke-width:1.6; stroke-linecap:round; stroke-linejoin:round; }
  #ma-ar-{{ section.id }} .ma-ar__card-price{ padding-top:12px; border-top:1px solid rgba(23,19,16,.12); }
  #ma-ar-{{ section.id }} .ma-ar__price{ display:block; font-family:'Cormorant Garamond',Georgia,serif; font-size:26px; font-weight:600; }
  #ma-ar-{{ section.id }} .ma-ar__price--typ{ color:rgba(23,19,16,.55); }
  #ma-ar-{{ section.id }} .ma-ar__price--now{ color:var(--burg2); }
  #ma-ar-{{ section.id }} .ma-ar__caption{ display:block; font-size:12px; color:rgba(23,19,16,.55); margin-top:2px; }
  #ma-ar-{{ section.id }} .ma-ar__vs{
    position:absolute; left:50%; top:50%; transform:translate(-50%,-50%);
    font-family:'Marcellus',serif; font-size:13px; letter-spacing:.08em; color:rgba(23,19,16,.5);
    background:var(--cream); padding:6px 10px; border-radius:50%; z-index:2;
  }

  /* ---- proof grid ---- */
  #ma-ar-{{ section.id }} .ma-ar__proof{
    display:grid; grid-template-columns:1fr; gap:{{ section.settings.proof_gap | default: 28 }}px;
    margin-top:{{ section.settings.section_gap | default: 20 }}px;
    {% if section.settings.proof_divider %}border-top:1px solid rgba(23,19,16,.14); padding-top:{{ section.settings.section_gap | default: 20 }}px;{% endif %}
  }
  #ma-ar-{{ section.id }} .ma-ar__proof-ic{ display:block; width:{{ section.settings.proof_icon_size | default: 28 }}px; height:{{ section.settings.proof_icon_size | default: 28 }}px; color:var(--gold); margin-bottom:10px; }
  #ma-ar-{{ section.id }} .ma-ar__proof-ic svg{ width:100%; height:100%; fill:none; stroke:currentColor; stroke-width:1.2; stroke-linecap:round; stroke-linejoin:round; }
  #ma-ar-{{ section.id }} .ma-ar__proof-h{ font-family:'Cormorant Garamond',Georgia,serif; font-weight:600; font-size:16px; margin:0 0 6px; color:var(--ink); }
  #ma-ar-{{ section.id }} .ma-ar__proof-b{ font-size:13px; line-height:1.45; color:rgba(23,19,16,.65); margin:0; }

  /* ---- conclusion ---- */
  #ma-ar-{{ section.id }} .ma-ar__conclusion{ text-align:center; margin-top:{{ section.settings.section_gap | default: 20 }}px; padding-top:{{ section.settings.section_gap | default: 20 }}px; border-top:1px solid rgba(23,19,16,.14); }
  #ma-ar-{{ section.id }} .ma-ar__conc-h{ font-family:'Cormorant Garamond',Georgia,serif; font-size:{{ section.settings.conclusion_size | default: 24 }}px; font-weight:500; margin:0 0 4px; color:var(--ink); }
  #ma-ar-{{ section.id }} .ma-ar__conc-b{ font-style:italic; font-size:15px; color:var(--burg); margin:0; }

  /* ---- reveal animation ---- */
  {% if section.settings.enable_animation %}
    #ma-ar-{{ section.id }} .ma-ar__reveal{
      opacity:0; transform:translateY(16px);
      transition:opacity {{ section.settings.animation_duration | default: 600 }}ms ease, transform {{ section.settings.animation_duration | default: 600 }}ms cubic-bezier(.22,1,.36,1);
    }
    #ma-ar-{{ section.id }}.is-in .ma-ar__reveal{ opacity:1; transform:none; }
    #ma-ar-{{ section.id }}.is-in .ma-ar__cards{ transition-delay:0ms; }
    #ma-ar-{{ section.id }}.is-in .ma-ar__proof{ transition-delay:{{ section.settings.animation_stagger | default: 80 }}ms; }
    #ma-ar-{{ section.id }}.is-in .ma-ar__conclusion{ transition-delay:{{ section.settings.animation_stagger | default: 80 | times: 2 }}ms; }
  {% endif %}

  /* ---- photo, melted into the cream ---- */
  #ma-ar-{{ section.id }} .ma-ar__photo{ flex:0 0 29svh; min-height:0; overflow:hidden; position:relative; }
  #ma-ar-{{ section.id }} .ma-ar__img{
    width:100%; height:100%; object-fit:cover; display:block;
    object-position:{{ section.settings.image_focal_x | default: 50 }}% {{ section.settings.image_focal_y | default: 50 }}%;
    transform:scale({{ section.settings.image_scale | default: 100 | times: 1.0 | divided_by: 100 }}) translate({{ section.settings.image_offset_x | default: 0 }}px, {{ section.settings.image_offset_y | default: 0 }}px);
    filter:brightness({{ section.settings.img_brightness | default: 100 }}%) contrast({{ section.settings.img_contrast | default: 100 }}%) saturate({{ section.settings.img_saturation | default: 100 }}%) sepia({{ section.settings.img_warmth | default: 0 | at_least: 0 | times: 1.0 | divided_by: 100 }});
  }
  {% if section.settings.img_vignette > 0 %}
  #ma-ar-{{ section.id }} .ma-ar__photo::after{
    content:''; position:absolute; inset:0; pointer-events:none; z-index:2;
    background:radial-gradient(ellipse at center, transparent 55%, rgba(0,0,0,{{ section.settings.img_vignette | times: 1.0 | divided_by: 100 }}) 100%);
  }
  {% endif %}
  {%- if melt > 0 -%}
  #ma-ar-{{ section.id }} .ma-ar__photo::before{
    content:""; position:absolute; z-index:2; left:0; right:0; top:0; height:34%;
    backdrop-filter:blur({{ melt_blur }}px); -webkit-backdrop-filter:blur({{ melt_blur }}px);
    -webkit-mask-image:linear-gradient(180deg,#000 0,transparent 100%);
            mask-image:linear-gradient(180deg,#000 0,transparent 100%);
  }
  #ma-ar-{{ section.id }} .ma-ar__photo::after{
    content:""; position:absolute; z-index:3; inset:0; opacity:{{ melt_veil }};
    background:linear-gradient(180deg,var(--cream) 0%,rgba(244,238,225,.55) 14%,rgba(244,238,225,0) 46%);
  }
  {%- endif -%}

  /* ---- MOBILE: independent stack (< 900px) ---- */
  @media (max-width:899px){
    #ma-ar-{{ section.id }}.ma-ar{ height:auto; max-height:none; overflow:visible; }
    #ma-ar-{{ section.id }} .ma-ar__copy{
      flex:0 0 auto; justify-content:flex-start;
      padding:{{ section.settings.mobile_padding_top | default: 24 }}px {{ section.settings.mobile_padding_x | default: 24 }}px {{ section.settings.mobile_padding_bottom | default: 32 }}px;
    }
    #ma-ar-{{ section.id }} .ma-ar__photo{
      order:{% if section.settings.mobile_image_first %}-1{% else %}1{% endif %};
      flex-basis:{{ section.settings.mobile_image_height | default: 260 }}px;
    }
    #ma-ar-{{ section.id }} .ma-ar__cards{ flex-direction:column; }
    #ma-ar-{{ section.id }} .ma-ar__vs{ position:relative; left:auto; top:auto; transform:none; margin:4px auto; display:block; width:fit-content; }
    #ma-ar-{{ section.id }} .ma-ar__proof{ grid-template-columns:1fr 1fr; }
    {%- if melt > 0 -%}
    #ma-ar-{{ section.id }} .ma-ar__photo::before{
      top:auto; bottom:0; height:34%;
      -webkit-mask-image:linear-gradient(0deg,#000 0,transparent 100%);
              mask-image:linear-gradient(0deg,#000 0,transparent 100%);
    }
    #ma-ar-{{ section.id }} .ma-ar__photo::after{
      background:linear-gradient(0deg,var(--cream) 0%,rgba(244,238,225,.55) 14%,rgba(244,238,225,0) 46%);
    }
    {%- endif -%}
  }

  /* ---- DESKTOP: single-viewport true split, never stacked (>= 900px) ---- */
  @media (min-width:900px){
    #ma-ar-{{ section.id }}.ma-ar--split{ flex-direction:row; }
    #ma-ar-{{ section.id }} .ma-ar__copy{
      width:{{ split_left }}%;
      padding:{{ section.settings.padding_top | default: 0 }}px {{ section.settings.padding_x | default: 64 }}px {{ section.settings.padding_bottom | default: 0 }}px {{ section.settings.padding_x | default: 64 | times: 1.05 }}px;
      overflow-y:auto;
    }
    #ma-ar-{{ section.id }} .ma-ar__k{ margin-bottom:clamp(10px,2svh,18px); font-size:12px; }
    #ma-ar-{{ section.id }} .ma-ar__h{ font-size:clamp(30px, min(4vw, 6svh), {{ section.settings.headline_size | default: 54 }}px); max-width:16ch; margin-bottom:12px; }
    #ma-ar-{{ section.id }} .ma-ar__sub{ font-size:clamp(15px, 2.5svh, {{ section.settings.body_size | default: 19 }}px); margin-bottom:clamp(12px,3svh,24px); }
    #ma-ar-{{ section.id }} .ma-ar__row{ padding:clamp(10px,2svh,17px) 0 0; }
    #ma-ar-{{ section.id }} .ma-ar__lab{ font-size:11px; }
    #ma-ar-{{ section.id }} .ma-ar__val--typ{ font-size:clamp(22px, 3.4svh, 30px); }
    #ma-ar-{{ section.id }} .ma-ar__val--now{ font-size:clamp(34px, min(4.2vw, 6.4svh), 58px); }
    #ma-ar-{{ section.id }} .ma-ar__refine{ margin-top:24px; flex-direction:row; gap:34px; flex-wrap:wrap; }
    #ma-ar-{{ section.id }} .ma-ar__ref{ font-size:17px; }
    #ma-ar-{{ section.id }} .ma-ar__proof{ grid-template-columns:repeat(4,1fr); }
    #ma-ar-{{ section.id }} .ma-ar__photo{ flex:0 0 {{ split_right }}%; height:100%; }
    {%- if melt > 0 -%}
    #ma-ar-{{ section.id }} .ma-ar__photo::before{
      top:0; bottom:0; left:0; right:auto; width:{{ section.settings.melt_width | default: 40 }}%; height:auto;
      -webkit-mask-image:linear-gradient(90deg,#000 0,transparent 100%);
              mask-image:linear-gradient(90deg,#000 0,transparent 100%);
    }
    #ma-ar-{{ section.id }} .ma-ar__photo::after{
      background:linear-gradient(90deg,var(--cream) 0%,rgba(244,238,225,.6) 12%,rgba(244,238,225,0) 48%);
    }
    {%- endif -%}
  }

  @media (prefers-reduced-motion:reduce){
    #ma-ar-{{ section.id }} .ma-ar__fill{ transition:none !important; }
    #ma-ar-{{ section.id }} .ma-ar__fill--typ{ width:100% !important; }
    #ma-ar-{{ section.id }} .ma-ar__fill--now{ width:12% !important; }
    #ma-ar-{{ section.id }} .ma-ar__reveal{ opacity:1 !important; transform:none !important; transition:none !important; }
  }
</style>

<script>
  (function(){
    var s = document.getElementById('ma-ar-{{ section.id }}');
    if(!s) return;

    function fitHeader(){
      var off = 0;
      ['sticky-header','.shopify-section-group-header-group','.section-header','header'].some(function(sel){
        var el = document.querySelector(sel);
        if(!el) return false;
        var cs = getComputedStyle(el);
        if(cs.position === 'sticky' || cs.position === 'fixed'){ off = el.getBoundingClientRect().height; return true; }
        return false;
      });
      s.style.setProperty('--ma-hdr', off + 'px');
    }
    fitHeader();
    window.addEventListener('resize', fitHeader);

    {% if request.design_mode %}
      s.classList.add('is-in'); return;
    {% endif %}
    if(!('IntersectionObserver' in window)){ s.classList.add('is-in'); return; }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){ s.classList.add('is-in'); }
        else { s.classList.remove('is-in'); }
      });
    }, { threshold: 0.45 });
    io.observe(s);
  })();
</script>

