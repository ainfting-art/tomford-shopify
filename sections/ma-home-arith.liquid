{%- comment -%}
  MAISON AMIIR — Home · Honest Arithmetic V4.
  Rebuilt architecture per blueprint: true single-viewport 2-column editorial split
  (never stacked on desktop), icon-list comparison cards with VS divider, 4-across
  proof grid, conclusion line, image melts full-height into cream on the right.
  Mobile is independently stacked (image → eyebrow → headline → subheading →
  comparison → proof → conclusion). ALL existing schema IDs preserved:
  bottle_image, melt, eyebrow, heading, subheading, left_label, left_value,
  right_label, right_value, refine_1, refine_2 — legacy content carries over.
{%- endcomment -%}

{%- assign has_img = false -%}
{%- if section.settings.bottle_image != blank or section.settings.mobile_image != blank -%}
  {%- assign has_img = true -%}
{%- endif -%}

{%- assign melt = section.settings.melt | default: 100 -%}
{%- assign melt_strength = section.settings.melt_strength | default: melt -%}
{%- assign melt_blur = section.settings.melt_blur | default: 12 -%}
{%- assign melt_veil = melt_strength | divided_by: 100.0 -%}
{%- assign now_value = section.settings.right_value | escape | replace: 'from ', '<em>from</em> ' -%}
{%- assign split = section.settings.split_ratio | default: '55/45' -%}
{%- assign split_parts = split | split: '/' -%}
{%- assign split_left = split_parts[0] -%}
{%- assign split_right = split_parts[1] -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Marcellus&display=swap" rel="stylesheet">

<section class="ma-ar {% if has_img %}ma-ar--split{% endif %} {{ section.settings.custom_class }}" id="ma-ar-{{ section.id }}">
  {%- if section.settings.enable_texture or section.settings.show_texture -%}
    <div class="ma-ar__grain" aria-hidden="true"></div>
  {%- endif -%}

  <!-- LEFT COLUMN (~55% DESKTOP): EDITORIAL ARTICLE SPREAD -->
  <div class="ma-ar__left-col">
    <div class="ma-ar__head-group">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ma-ar__k ma-ar__reveal">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ma-ar__h ma-ar__reveal">{{ section.settings.heading | escape | replace: 'Not on the receipt.', '<em>Not on the receipt.</em>' }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="ma-ar__sub ma-ar__reveal">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <!-- COMPARISON AREA (BARS OR CARDS) -->
    {%- if section.settings.comparison_style == 'bars' -%}
      <div class="ma-ar__cmp ma-ar__reveal">
        <div class="ma-ar__row">
          <div class="ma-ar__top">
            <span class="ma-ar__lab">{{ section.settings.left_label | escape }}</span>
            <span class="ma-ar__val ma-ar__val--typ">{{ section.settings.left_value | escape }}</span>
          </div>
          <div class="ma-ar__track"><span class="ma-ar__fill ma-ar__fill--typ"></span></div>
        </div>
        <div class="ma-ar__row">
          <div class="ma-ar__top">
            <span class="ma-ar__lab">{{ section.settings.right_label | escape }}</span>
            <span class="ma-ar__val ma-ar__val--now">{{ now_value }}</span>
          </div>
          <div class="ma-ar__track"><span class="ma-ar__fill ma-ar__fill--now"></span></div>
        </div>
      </div>
      {%- if section.settings.refine_1 != blank or section.settings.refine_2 != blank -%}
        <div class="ma-ar__refine ma-ar__reveal">
          {%- if section.settings.refine_1 != blank -%}<p class="ma-ar__ref"><b>◆</b>{{ section.settings.refine_1 | escape }}</p>{%- endif -%}
          {%- if section.settings.refine_2 != blank -%}<p class="ma-ar__ref"><b>◆</b>{{ section.settings.refine_2 | escape }}</p>{%- endif -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <!-- Style B: VS Comparison Cards -->
      <div class="ma-ar__cards ma-ar__reveal">
        <div class="ma-ar__card ma-ar__card--them">
          {%- if section.settings.card1_header != blank -%}<p class="ma-ar__card-h">{{ section.settings.card1_header | escape }}</p>{%- endif -%}
          <ul class="ma-ar__list">
            {%- assign c1_icons = 'store,megaphone,tv,gift,arrow-up' | split: ',' -%}
            {%- assign card1_items_array = section.settings.card1_items | newline_to_br | strip_newlines | split: '<br />' -%}
            {%- for item in card1_items_array -%}
              {%- assign trimmed = item | strip -%}
              {%- if trimmed != blank -%}
                {%- assign icon_key = c1_icons[forloop.index0] | default: 'arrow-up' -%}
                <li>
                  <span class="ma-ar__ic">
                    {%- case icon_key -%}
                      {%- when 'store' -%}<svg viewBox="0 0 24 24"><path d="M4 10l1-6h14l1 6M4 10v9h16v-9M4 10h16M9 19v-5h4v5"/></svg>
                      {%- when 'megaphone' -%}<svg viewBox="0 0 24 24"><path d="M3 10v4l14 4V6L3 10z"/><path d="M17 9v6"/><path d="M7 14v4a2 2 0 0 0 2 2h1v-6"/></svg>
                      {%- when 'tv' -%}<svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="1"/><path d="M9 21h6M12 18v3"/></svg>
                      {%- when 'gift' -%}<svg viewBox="0 0 24 24"><rect x="4" y="9" width="16" height="11" rx="1"/><path d="M12 9v11M4 9h16"/></svg>
                      {%- else -%}<svg viewBox="0 0 24 24"><path d="M12 19V5M6 11l6-6 6 6"/></svg>
                    {%- endcase -%}
                  </span>
                  <span>{{ trimmed }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          <div class="ma-ar__card-price">
            <span class="ma-ar__price ma-ar__price--typ">{{ section.settings.left_value | escape }}</span>
            <span class="ma-ar__caption">{{ section.settings.left_label | escape }}</span>
          </div>
        </div>

        <span class="ma-ar__vs">{{ section.settings.vs_text | default: 'VS' | escape }}</span>

        <div class="ma-ar__card ma-ar__card--now">
          {%- if section.settings.card2_header != blank -%}<p class="ma-ar__card-h">{{ section.settings.card2_header | escape }}</p>{%- endif -%}
          <ul class="ma-ar__list">
            {%- assign c2_icons = 'droplet,leaf,scissors,bag,arrow-up' | split: ',' -%}
            {%- assign card2_items_array = section.settings.card2_items | newline_to_br | strip_newlines | split: '<br />' -%}
            {%- for item in card2_items_array -%}
              {%- assign trimmed = item | strip -%}
              {%- if trimmed != blank -%}
                {%- assign icon_key = c2_icons[forloop.index0] | default: 'arrow-up' -%}
                <li>
                  <span class="ma-ar__ic ma-ar__ic--now">
                    {%- case icon_key -%}
                      {%- when 'droplet' -%}<svg viewBox="0 0 24 24"><path d="M12 2s7 7.5 7 12.5A7 7 0 0 1 5 14.5C5 9.5 12 2 12 2z"/></svg>
                      {%- when 'leaf' -%}<svg viewBox="0 0 24 24"><path d="M4 19c8 1 15-4 16-15-9 0-16 4-16 15z"/><path d="M4 19c3-5 7-8 12-10"/></svg>
                      {%- when 'scissors' -%}<svg viewBox="0 0 24 24"><circle cx="6" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><path d="M8.5 8L20 19M8.5 16L20 5"/></svg>
                      {%- when 'bag' -%}<svg viewBox="0 0 24 24"><path d="M6 8h12l1 12H5L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
                      {%- else -%}<svg viewBox="0 0 24 24"><path d="M12 19V5M6 11l6-6 6 6"/></svg>
                    {%- endcase -%}
                  </span>
                  <span>{{ trimmed }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          <div class="ma-ar__card-price">
            <span class="ma-ar__price ma-ar__price--now">{{ now_value }}</span>
            <span class="ma-ar__caption">{{ section.settings.right_label | escape }}</span>
          </div>
        </div>
      </div>
    {%- endif -%}

    <!-- PROOF GRID (4 COLUMNS HORIZONTAL ON DESKTOP) -->
    <div class="ma-ar__proof ma-ar__reveal">
      {%- for i in (1..4) -%}
        {%- case i -%}
          {%- when 1 -%}{%- assign p_icon = section.settings.proof1_icon -%}{%- assign p_h = section.settings.proof1_heading -%}{%- assign p_b = section.settings.proof1_body -%}
          {%- when 2 -%}{%- assign p_icon = section.settings.proof2_icon -%}{%- assign p_h = section.settings.proof2_heading -%}{%- assign p_b = section.settings.proof2_body -%}
          {%- when 3 -%}{%- assign p_icon = section.settings.proof3_icon -%}{%- assign p_h = section.settings.proof3_heading -%}{%- assign p_b = section.settings.proof3_body -%}
          {%- when 4 -%}{%- assign p_icon = section.settings.proof4_icon -%}{%- assign p_h = section.settings.proof4_heading -%}{%- assign p_b = section.settings.proof4_body -%}
        {%- endcase -%}
        <div class="ma-ar__proof-item">
          {%- if p_icon != 'none' -%}
            <span class="ma-ar__proof-ic">
              {%- case p_icon -%}
                {%- when 'droplet' -%}<svg viewBox="0 0 24 24"><path d="M12 2s7 7.5 7 12.5A7 7 0 0 1 5 14.5C5 9.5 12 2 12 2z"/></svg>
                {%- when 'shield' -%}<svg viewBox="0 0 24 24"><path d="M12 3l7 2.6v5.1c0 4.4-3 7.4-7 8.8-4-1.4-7-4.4-7-8.8V5.6L12 3z"/><path d="M9 12l2 2 4-4.2"/></svg>
                {%- when 'clock' -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
                {%- when 'heart' -%}<svg viewBox="0 0 24 24"><path d="M12 20s-7-4.4-9.3-8.8C1.2 8 2.7 4.8 6 4.2c2-.4 3.7.6 4.9 2.3 1.2-1.7 2.9-2.7 4.9-2.3 3.3.6 4.8 3.8 3.3 7C19 15.6 12 20 12 20z"/></svg>
                {%- when 'leaf' -%}<svg viewBox="0 0 24 24"><path d="M4 19c8 1 15-4 16-15-9 0-16 4-16 15z"/><path d="M4 19c3-5 7-8 12-10"/></svg>
              {%- endcase -%}
            </span>
          {%- endif -%}
          {%- if p_h != blank -%}<p class="ma-ar__proof-h">{{ p_h | escape }}</p>{%- endif -%}
          {%- if p_b != blank -%}<p class="ma-ar__proof-b">{{ p_b | escape }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <!-- CONCLUSION BLOCK -->
    {%- if section.settings.conclusion_heading != blank or section.settings.conclusion_body != blank -%}
      <div class="ma-ar__conclusion ma-ar__reveal">
        <span class="ma-ar__crown">♛</span>
        {%- if section.settings.conclusion_heading != blank -%}<p class="ma-ar__conc-h">{{ section.settings.conclusion_heading | escape }}</p>{%- endif -%}
        {%- if section.settings.conclusion_body != blank -%}<p class="ma-ar__conc-b">{{ section.settings.conclusion_body | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <!-- RIGHT COLUMN (~45% DESKTOP): FULL HEIGHT PHOTOGRAPHY -->
  {%- if has_img -%}
    <div class="ma-ar__photo">
      {%- assign desk_img = section.settings.bottle_image | default: section.settings.mobile_image -%}
      {%- assign mob_img = section.settings.mobile_image | default: section.settings.bottle_image -%}
      {{ desk_img | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'ma-ar__img ma-ar__img--dt', alt: desk_img.alt | default: shop.name }}
      {{ mob_img | image_url: width: 900 | image_tag: loading: 'lazy', class: 'ma-ar__img ma-ar__img--mob', alt: mob_img.alt | default: shop.name }}
    </div>
  {%- endif -%}
</section>

<style>
  #ma-ar-{{ section.id }}.ma-ar{
    --cream: {{ section.settings.bg_color | default: '#F4EEE1' }};
    --ink: {{ section.settings.ink_color | default: '#171310' }};
    --gold: {{ section.settings.gold_color | default: '#C6A15B' }};
    --burg: {{ section.settings.burg_color | default: '#6E1220' }};
    --burg2: {{ section.settings.burg2_color | default: '#8E1B28' }};
    --track: {{ section.settings.track_color | default: '#E6E0D5' }};
    --fill: {{ section.settings.fill_color | default: '#8E1B28' }};
    --ma-hdr: 0px;

    background: var(--cream);
    color: var(--ink);
    font-family: 'Cormorant Garamond', Georgia, serif;
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
  }

  {% if section.settings.enable_texture or section.settings.show_texture %}
  #ma-ar-{{ section.id }}.ma-ar::before{
    content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none;
    opacity: {{ section.settings.texture_opacity | default: 4 | divided_by: 100.0 }};
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='{{ section.settings.noise_amount | default: 4 | divided_by: 5.0 }}' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }
  {% endif %}

  /* ---- Copy / Left Column Styling ---- */
  #ma-ar-{{ section.id }} .ma-ar__left-col{
    box-sizing: border-box;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transform: translate({{ section.settings.content_offset_x_dt | default: 0 }}px, {{ section.settings.content_offset_y_dt | default: 0 }}px);
  }
  #ma-ar-{{ section.id }} .ma-ar__k{
    font-family: {{ section.settings.eyebrow_font.family | default: 'Marcellus' }}, Georgia, serif;
    font-size: {{ section.settings.eyebrow_size_mob | default: 10 }}px;
    font-weight: {{ section.settings.eyebrow_weight | default: '400' }};
    letter-spacing: {{ section.settings.eyebrow_spacing | default: 3 }}px;
    text-transform: uppercase;
    color: var(--burg2);
    margin: 0 0 {{ section.settings.gap_head | default: 12 }}px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  #ma-ar-{{ section.id }} .ma-ar__k::before{
    content: "";
    width: {{ section.settings.divider_w_mob | default: 30 }}px;
    height: {{ section.settings.divider_thickness | default: 1 }}px;
    background: {{ section.settings.divider_color | default: 'var(--burg2)' }};
    flex: 0 0 auto;
    opacity: {{ section.settings.divider_opacity | default: 60 | divided_by: 100.0 }};
  }
  #ma-ar-{{ section.id }} .ma-ar__h{
    font-family: {{ section.settings.heading_font.family | default: 'Cormorant Garamond' }}, Georgia, serif !important;
    font-weight: {{ section.settings.heading_weight | default: '600' }} !important;
    text-transform: none !important;
    letter-spacing: {{ section.settings.heading_spacing | default: 0 }}px !important;
    font-size: clamp(28px, min(4vw, 5.2vh), {{ section.settings.headline_size | default: 52 }}px);
    line-height: {{ section.settings.heading_lh | default: 108 | divided_by: 100.0 }};
    margin: 0 0 8px;
    color: var(--ink);
    max-width: {{ section.settings.heading_max_w | default: 24 }}ch;
  }
  #ma-ar-{{ section.id }} .ma-ar__h em{
    font-style: {% if section.settings.accent_style == 'italic' %}italic{% else %}normal{% endif %};
    font-weight: {{ section.settings.accent_weight | default: '400' }};
    color: {{ section.settings.accent_color | default: 'var(--burg)' }};
  }
  #ma-ar-{{ section.id }} .ma-ar__sub{
    font-family: {{ section.settings.sub_font.family | default: 'Cormorant Garamond' }}, Georgia, serif;
    font-style: italic;
    font-weight: {{ section.settings.sub_weight | default: '500' }};
    font-size: clamp(14px, 2vh, {{ section.settings.body_size | default: 18 }}px);
    line-height: 1.4;
    color: {{ section.settings.sub_color | default: 'rgba(23,19,16,0.78)' }};
    margin: 0 0 14px;
    max-width: 48ch;
  }

  /* ---- Comparison Cards ---- */
  #ma-ar-{{ section.id }} .ma-ar__cmp{ margin: 0; width: 100%; }
  #ma-ar-{{ section.id }} .ma-ar__row{ padding: 10px 0 0; border-top: 1px solid rgba(23,19,16,.14); }
  #ma-ar-{{ section.id }} .ma-ar__top{ display: flex; justify-content: space-between; align-items: baseline; gap: 14px; }
  #ma-ar-{{ section.id }} .ma-ar__lab{ font-family: 'Marcellus',serif; font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: rgba(23,19,16,.7); }
  #ma-ar-{{ section.id }} .ma-ar__val{ font-family: 'Cormorant Garamond',Georgia,serif; white-space: nowrap; }
  #ma-ar-{{ section.id }} .ma-ar__val--typ{ font-size: clamp(18px, 2.8vh, 24px); font-weight: 500; color: rgba(23,19,16,.44); text-decoration: line-through; text-decoration-thickness: 1.5px; }
  #ma-ar-{{ section.id }} .ma-ar__val--now{ font-size: clamp(26px, min(8vw, 4.8vh), 42px); font-weight: 600; color: var(--burg2); }
  #ma-ar-{{ section.id }} .ma-ar__val--now em{ font-style: italic; font-weight: 400; font-size: .52em; color: var(--burg); margin-right: 2px; }
  #ma-ar-{{ section.id }} .ma-ar__track{ display: block; height: 4px; background: rgba(23,19,16,.08); border-radius: 2px; overflow: hidden; margin: 8px 0 10px; }
  #ma-ar-{{ section.id }} .ma-ar__fill{ display: block; height: 100%; width: 0; border-radius: 2px; }
  #ma-ar-{{ section.id }} .ma-ar__fill--typ{ background: rgba(23,19,16,.55); transition: width 1.4s cubic-bezier(.25,.8,.25,1) .1s; }
  #ma-ar-{{ section.id }} .ma-ar__fill--now{ background: var(--burg2); transition: width 1.1s cubic-bezier(.25,.8,.25,1) .7s; }
  #ma-ar-{{ section.id }}.is-in .ma-ar__fill--typ{ width: 100%; }
  #ma-ar-{{ section.id }}.is-in .ma-ar__fill--now{ width: 12%; }
  #ma-ar-{{ section.id }} .ma-ar__refine{ margin: 12px 0 0; display: flex; flex-direction: column; gap: 6px; }
  #ma-ar-{{ section.id }} .ma-ar__ref{ font-size: 15px; font-weight: 500; color: rgba(23,19,16,.85); line-height: 1.4; margin: 0; }
  #ma-ar-{{ section.id }} .ma-ar__ref b{ color: var(--gold); font-weight: 400; margin-right: 8px; }

  #ma-ar-{{ section.id }} .ma-ar__cards{
    position: relative; display: flex; gap: clamp(12px, 1.5vw, {{ section.settings.card_gap | default: 24 }}px);
  }
  #ma-ar-{{ section.id }} .ma-ar__card{
    flex: 1 1 0; min-width: 0; padding: clamp(14px, 2vh, {{ section.settings.card_padding | default: 20 }}px);
    border-radius: {{ section.settings.card_radius | default: 8 }}px;
    background: {{ section.settings.card_bg_col | default: '#F0EAE1' }};
    border: 1px solid {{ section.settings.card_border_color | default: '#E2DCD3' }};
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease;
    {% if section.settings.card_shadow_strength > 0 %}box-shadow: 0 {{ section.settings.card_shadow_strength }}px {{ section.settings.card_shadow_strength | times: 2 }}px rgba(23,19,16,{{ section.settings.card_shadow_strength | times: 1.0 | divided_by: 200 }});{% endif %}
  }
  #ma-ar-{{ section.id }} .ma-ar__card:hover {
    transform: translateY(-{{ section.settings.hover_lift | default: 3 }}px);
    box-shadow: 0 12px 28px -8px rgba(0,0,0,0.08);
  }
  #ma-ar-{{ section.id }} .ma-ar__card--us {
    background: linear-gradient(145deg, rgba(244,238,225,0.95), rgba(244,238,225,0.65));
    border-color: rgba(198,161,91,0.45);
    box-shadow: 0 12px 30px -10px rgba(0,0,0,0.08);
  }
  #ma-ar-{{ section.id }} .ma-ar__card-h{
    font-family: 'Marcellus',serif; font-size: 10px; letter-spacing: .14em; text-transform: uppercase;
    color: rgba(23,19,16,.65); margin: 0 0 10px; padding-bottom: 8px; border-bottom: 1px solid rgba(23,19,16,.12);
  }
  #ma-ar-{{ section.id }} .ma-ar__card--us .ma-ar__card-h { color: var(--burg2); border-color: rgba(198,161,91,0.25); }
  #ma-ar-{{ section.id }} .ma-ar__list{ list-style: none; margin: 0 0 10px; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  #ma-ar-{{ section.id }} .ma-ar__list-item{ display: flex; align-items: center; gap: 8px; font-size: clamp(12px, 1.4vh, 13.5px); color: rgba(23,19,16,.85); }
  #ma-ar-{{ section.id }} .ma-ar__list-icon{ flex: 0 0 auto; width: 15px; height: 15px; color: var(--gold); display: flex; align-items: center; }
  #ma-ar-{{ section.id }} .ma-ar__card--them .ma-ar__list-icon{ color: rgba(23,19,16,0.4); }
  #ma-ar-{{ section.id }} .ma-ar__list-icon svg{ width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  #ma-ar-{{ section.id }} .ma-ar__card-foot{ padding-top: 8px; border-top: 1px solid rgba(23,19,16,.12); display: flex; flex-direction: column; gap: 2px; }
  #ma-ar-{{ section.id }} .ma-ar__card--us .ma-ar__card-foot { border-color: rgba(198,161,91,0.25); }
  #ma-ar-{{ section.id }} .ma-ar__card-price{ font-family: 'Cormorant Garamond',Georgia,serif; font-size: clamp(22px, 2.8vh, 26px); font-weight: 600; line-height: 1; color: var(--ink); }
  #ma-ar-{{ section.id }} .ma-ar__card--us .ma-ar__card-price { color: var(--burg2); font-size: clamp(26px, 3.2vh, 32px); }
  #ma-ar-{{ section.id }} .ma-ar__card-sub{ font-size: 11px; color: rgba(23,19,16,.65); font-style: italic; }
  #ma-ar-{{ section.id }} .ma-ar__vs{
    position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%);
    font-family: 'Marcellus',serif; font-size: 12px; letter-spacing: .08em; color: var(--gold);
    background: var(--cream); padding: 4px 8px; border-radius: 50%; z-index: 2;
  }

  /* ---- Proof Grid ---- */
  #ma-ar-{{ section.id }} .ma-ar__proof{
    display: grid; gap: clamp(8px, 1.2vw, {{ section.settings.proof_gap | default: 16 }}px);
    {% if section.settings.proof_divider %}border-top: 1px solid rgba(23,19,16,.12); padding-top: 12px;{% endif %}
  }
  #ma-ar-{{ section.id }} .ma-ar__proof-item{ display: flex; flex-direction: column; gap: 3px; padding-right: 6px; }
  #ma-ar-{{ section.id }} .ma-ar__proof-ic{ display: block; width: {{ section.settings.proof_icon_size | default: 22 }}px; height: {{ section.settings.proof_icon_size | default: 22 }}px; color: var(--gold); margin-bottom: 6px; }
  #ma-ar-{{ section.id }} .ma-ar__proof-ic svg{ width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }
  #ma-ar-{{ section.id }} .ma-ar__proof-h{ font-family: 'Cormorant Garamond',Georgia,serif; font-weight: 600; font-size: clamp(14px, 1.8vh, 16px); margin: 0 0 2px; color: var(--ink); line-height: 1.2; }
  #ma-ar-{{ section.id }} .ma-ar__proof-b{ font-size: clamp(11.5px, 1.3vh, 12.5px); line-height: 1.35; color: rgba(23,19,16,.7); margin: 0; }

  /* ---- Conclusion ---- */
  #ma-ar-{{ section.id }} .ma-ar__conclusion{ text-align: center; padding-top: 10px; border-top: 1px solid rgba(23,19,16,.12); }
  #ma-ar-{{ section.id }} .ma-ar__crown{ display: block; font-size: 16px; color: var(--gold); margin-bottom: 2px; }
  #ma-ar-{{ section.id }} .ma-ar__conc-h{ font-family: 'Cormorant Garamond',Georgia,serif; font-size: clamp(18px, 2.2vh, {{ section.settings.conclusion_size | default: 22 }}px); font-weight: 600; margin: 0 0 2px; color: var(--ink); line-height: 1.2; }
  #ma-ar-{{ section.id }} .ma-ar__conc-b{ font-style: italic; font-size: clamp(13px, 1.6vh, 15px); color: var(--burg); margin: 0; }

  /* ---- Reveal Animation ---- */
  {% if section.settings.enable_animation %}
    #ma-ar-{{ section.id }} .ma-ar__reveal{
      opacity: 0; transform: translateY(12px);
      transition: opacity {{ section.settings.animation_duration | default: 600 }}ms ease, transform {{ section.settings.animation_duration | default: 600 }}ms cubic-bezier(.22,1,.36,1);
    }
    #ma-ar-{{ section.id }}.is-in .ma-ar__reveal{ opacity: 1; transform: none; }
    #ma-ar-{{ section.id }}.is-in .ma-ar__cards{ transition-delay: 0ms; }
    #ma-ar-{{ section.id }}.is-in .ma-ar__proof{ transition-delay: {{ section.settings.animation_stagger | default: 80 }}ms; }
    #ma-ar-{{ section.id }}.is-in .ma-ar__conclusion{ transition-delay: {{ section.settings.animation_stagger | default: 80 | times: 2 }}ms; }
  {% endif %}

  /* ---- Photo & Melt Engine ---- */
  #ma-ar-{{ section.id }} .ma-ar__photo{ overflow: hidden; position: relative; }
  #ma-ar-{{ section.id }} .ma-ar__img{
    width: 100%; height: 100%; object-fit: cover; display: block;
    object-position: {{ section.settings.image_focal_x | default: 50 }}% {{ section.settings.image_focal_y | default: 50 }}%;
    transform: scale({{ section.settings.image_scale | default: 100 | times: 1.0 | divided_by: 100 }}) translate({{ section.settings.image_offset_x | default: 0 }}px, {{ section.settings.image_offset_y | default: 0 }}px);
    filter: brightness({{ section.settings.img_brightness | default: 100 }}%) contrast({{ section.settings.img_contrast | default: 100 }}%) saturate({{ section.settings.img_saturation | default: 100 }}%) sepia({{ section.settings.img_warmth | default: 0 | at_least: 0 | times: 1.0 | divided_by: 100 }});
    transition: transform {{ section.settings.hover_duration | default: 800 }}ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  {% if section.settings.enable_hover_zoom %}
    #ma-ar-{{ section.id }}:hover .ma-ar__img {
      transform: scale(calc({{ section.settings.image_scale | default: 100 | times: 1.0 | divided_by: 100 }} * {{ section.settings.hover_scale | default: 102 | divided_by: 100.0 }})) translate({{ section.settings.image_offset_x | default: 0 }}px, {{ section.settings.image_offset_y | default: 0 }}px);
    }
  {% endif %}

  /* ---- MOBILE (< 900px): Stacked Layout ---- */
  @media (max-width: 899px){
    #ma-ar-{{ section.id }}.ma-ar{ display: flex; flex-direction: column; height: auto; max-height: none; overflow: visible; }
    #ma-ar-{{ section.id }} .ma-ar__left-col{
      flex: 0 0 auto; justify-content: flex-start;
      padding: {{ section.settings.mobile_padding_top | default: 24 }}px {{ section.settings.mobile_padding_x | default: 24 }}px {{ section.settings.mobile_padding_bottom | default: 32 }}px;
      transform: translate({{ section.settings.content_offset_x_mob | default: 0 }}px, {{ section.settings.content_offset_y_mob | default: 0 }}px);
    }
    #ma-ar-{{ section.id }} .ma-ar__photo{
      order: {% if section.settings.mobile_image_first %}-1{% else %}1{% endif %};
      height: {{ section.settings.mobile_image_height | default: 280 }}px; width: 100%;
    }
    #ma-ar-{{ section.id }} .ma-ar__cards{ flex-direction: column; gap: 16px; }
    #ma-ar-{{ section.id }} .ma-ar__vs{ position: relative; left: auto; top: auto; transform: none; margin: -6px auto; display: block; width: fit-content; }
    #ma-ar-{{ section.id }} .ma-ar__proof{ grid-template-columns: 1fr 1fr; gap: 16px; }
    {%- if melt > 0 -%}
    #ma-ar-{{ section.id }} .ma-ar__photo::before{
      content: ""; position: absolute; z-index: 2; left: 0; right: 0; bottom: 0; height: 34%; pointer-events: none;
      backdrop-filter: blur({{ melt_blur }}px); -webkit-backdrop-filter: blur({{ melt_blur }}px);
      -webkit-mask-image: linear-gradient(0deg,#000 0,transparent 100%);
              mask-image: linear-gradient(0deg,#000 0,transparent 100%);
    }
    #ma-ar-{{ section.id }} .ma-ar__photo::after{
      content: ""; position: absolute; z-index: 3; inset: 0; pointer-events: none; opacity: {{ melt_veil }};
      background: linear-gradient(0deg,var(--cream) 0%,rgba(244,238,225,.55) 14%,rgba(244,238,225,0) 46%);
    }
    {%- endif -%}
  }

  /* ---- DESKTOP (>= 900px): SINGLE VIEWPORT 100VH TWO-COLUMN MAGAZINE SPREAD ---- */
  @media (min-width: 900px){
    #ma-ar-{{ section.id }}.ma-ar{
      display: grid !important;
      grid-template-columns: {{ split_left }}% {{ split_right }}% !important;
      height: calc(100vh - var(--ma-hdr)) !important;
      max-height: calc(100vh - var(--ma-hdr)) !important;
      overflow: hidden !important;
    }
    #ma-ar-{{ section.id }} .ma-ar__left-col{
      height: 100% !important; max-height: 100% !important;
      padding: {{ section.settings.padding_top | default: 24 }}px {{ section.settings.padding_x | default: 48 }}px {{ section.settings.padding_bottom | default: 24 }}px {{ section.settings.padding_x | default: 48 | times: 1.1 }}px !important;
      overflow: hidden !important; box-sizing: border-box !important;
    }
    #ma-ar-{{ section.id }} .ma-ar__proof{
      grid-template-columns: repeat({{ section.settings.proof_cols_dt | default: 4 }}, 1fr) !important;
    }
    #ma-ar-{{ section.id }} .ma-ar__proof-item:not(:last-child){
      border-right: 1px solid rgba(23,19,16,.08);
    }
    #ma-ar-{{ section.id }} .ma-ar__photo{
      height: 100% !important; width: 100% !important; position: relative !important; overflow: hidden !important;
    }
    {%- if melt > 0 -%}
    #ma-ar-{{ section.id }} .ma-ar__photo::before{
      content: ""; position: absolute; z-index: 2; top: 0; bottom: 0; left: 0; width: {{ section.settings.melt_width | default: 40 }}%; pointer-events: none;
      backdrop-filter: blur({{ melt_blur }}px); -webkit-backdrop-filter: blur({{ melt_blur }}px);
      -webkit-mask-image: linear-gradient(90deg,#000 0,transparent 100%);
              mask-image: linear-gradient(90deg,#000 0,transparent 100%);
    }
    #ma-ar-{{ section.id }} .ma-ar__photo::after{
      content: ""; position: absolute; z-index: 3; inset: 0; pointer-events: none; opacity: {{ melt_veil }};
      background: linear-gradient(90deg,var(--cream) 0%,rgba(244,238,225,.6) 12%,rgba(244,238,225,0) 48%);
    }
    {%- endif -%}
  }

  @media (prefers-reduced-motion: reduce){
    #ma-ar-{{ section.id }} .ma-ar__fill{ transition: none !important; }
    #ma-ar-{{ section.id }} .ma-ar__fill--typ{ width: 100% !important; }
    #ma-ar-{{ section.id }} .ma-ar__fill--now{ width: 12% !important; }
    #ma-ar-{{ section.id }} .ma-ar__reveal{ opacity: 1 !important; transform: none !important; transition: none !important; }
  }
</style>

<script>
  (function(){
    var s = document.getElementById('ma-ar-{{ section.id }}');
    if(!s) return;

    function fitHeader(){
      var off = 0;
      ['sticky-header','.shopify-section-group-header-group','.section-header','header'].some(function(sel){
        var el = document.querySelector(sel);
        if(!el) return false;
        var cs = getComputedStyle(el);
        if(cs.position === 'sticky' || cs.position === 'fixed'){ off = el.getBoundingClientRect().height; return true; }
        return false;
      });
      s.style.setProperty('--ma-hdr', off + 'px');
    }
    fitHeader();
    window.addEventListener('resize', fitHeader);

    {% if request.design_mode %}
      s.classList.add('is-in'); return;
    {% endif %}
    if(!('IntersectionObserver' in window)){ s.classList.add('is-in'); return; }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){ s.classList.add('is-in'); }
        else { s.classList.remove('is-in'); }
      });
    }, { threshold: 0.3 });
    io.observe(s);
  })();
</script>

