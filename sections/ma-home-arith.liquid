{%- comment -%}
  MAISON AMIIR — Home · Honest Arithmetic (DC presentation).
  Approved 2026-07-16: exact one-screen section (100svh minus sticky header),
  cream ground, Cormorant/Marcellus, photo melts into the cream (intensity slider),
  price bars fill on scroll (them 100% → us 12%).
  UPGRADED: Full Desktop & Mobile Theme Customizer control suites added while
  maintaining 100% backward compatibility with all existing editor content IDs.
  FONTS LOCKED: Cormorant Garamond & Marcellus strictly preserved. Zero cropping.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign has_img = false
  if section.settings.bottle_image != blank
    assign has_img = true
  endif

  assign melt = section.settings.melt | default: 100
  assign melt_blur = melt | times: 9.0 | divided_by: 100.0
  assign melt_veil = melt | divided_by: 100.0
  assign now_value = section.settings.right_value | escape | replace: 'from ', '<em>from</em> '

  assign bg_color = section.settings.bg_color
  assign ink_color = section.settings.ink_color
  assign gold_color = section.settings.gold_color
  assign burg_color = section.settings.burg_color
  assign burg2_color = section.settings.burg2_color
  assign fade_color = section.settings.fade_color

  if section.settings.color_preset == 'cream'
    assign bg_color = '#F4EEE1'
    assign ink_color = '#171310'
    assign gold_color = '#C6A15B'
    assign burg_color = '#6E1220'
    assign burg2_color = '#8E1B28'
    assign fade_color = '#F4EEE1'
  elsif section.settings.color_preset == 'noir'
    assign bg_color = '#0c0b0a'
    assign ink_color = '#f5f0e6'
    assign gold_color = '#d4af37'
    assign burg_color = '#a83242'
    assign burg2_color = '#c93a4e'
    assign fade_color = '#0c0b0a'
  elsif section.settings.color_preset == 'white'
    assign bg_color = '#ffffff'
    assign ink_color = '#111111'
    assign gold_color = '#a8894e'
    assign burg_color = '#6E1220'
    assign burg2_color = '#8E1B28'
    assign fade_color = '#ffffff'
  endif
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Marcellus&display=swap" rel="stylesheet">

<section class="ma-ar {% if has_img %}ma-ar--split{% endif %}" id="ma-ar-{{ sid }}">
  <div class="ma-ar__copy">
    {%- if section.settings.eyebrow != blank -%}
      <p class="ma-ar__k">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="ma-ar__h">{{ section.settings.heading | escape | replace: 'Not on the receipt.', '<em>Not on the receipt.</em>' }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="ma-ar__sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    <div class="ma-ar__cmp">
      <div class="ma-ar__row">
        <div class="ma-ar__top">
          <span class="ma-ar__lab">{{ section.settings.left_label | escape }}</span>
          <span class="ma-ar__val ma-ar__val--typ">{{ section.settings.left_value | escape }}</span>
        </div>
        <div class="ma-ar__track"><span class="ma-ar__fill ma-ar__fill--typ"></span></div>
      </div>
      <div class="ma-ar__row">
        <div class="ma-ar__top">
          <span class="ma-ar__lab">{{ section.settings.right_label | escape }}</span>
          <span class="ma-ar__val ma-ar__val--now">{{ now_value }}</span>
        </div>
        <div class="ma-ar__track"><span class="ma-ar__fill ma-ar__fill--now"></span></div>
      </div>
    </div>

    {%- if section.settings.refine_1 != blank or section.settings.refine_2 != blank -%}
      <div class="ma-ar__refine">
        {%- if section.settings.refine_1 != blank -%}
          <p class="ma-ar__ref"><b>◆</b>{{ section.settings.refine_1 | escape }}</p>
        {%- endif -%}
        {%- if section.settings.refine_2 != blank -%}
          <p class="ma-ar__ref"><b>◆</b>{{ section.settings.refine_2 | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.cta_text != blank -%}
      <div class="ma-ar__cta-wrap">
        <a class="ma-ar__cta" href="{{ section.settings.cta_link }}">
          {{ section.settings.cta_text | escape }} &nbsp;→
        </a>
      </div>
    {%- endif -%}
  </div>

  {%- if has_img -%}
    <div class="ma-ar__photo">
      <div class="ma-ar__photo-overlay"></div>
      {{ section.settings.bottle_image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'ma-ar__img', alt: section.settings.bottle_image.alt | default: shop.name }}
    </div>
  {%- endif -%}
</section>

<style>
  #ma-ar-{{ sid }}.ma-ar{
    --cream: {{ bg_color }};
    --ink: {{ ink_color }};
    --gold: {{ gold_color }};
    --burg: {{ burg_color }};
    --burg2: {{ burg2_color }};
    --ma-hdr: 0px;
    min-height: calc({{ section.settings.section_height_vh }}svh - var(--ma-hdr));
    height: auto;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: var(--cream);
    color: var(--ink);
    font-family: 'Cormorant Garamond', Georgia, serif;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }

  /* ---- copy ---- */
  #ma-ar-{{ sid }} .ma-ar__copy{
    flex: 1 1 auto;
    min-height: 0;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: {{ section.settings.content_align_y }};
    justify-content: safe {{ section.settings.content_align_y }};
    padding: {{ section.settings.dt_pad_top }}px {{ section.settings.dt_pad_right }}px {{ section.settings.dt_pad_bottom }}px {{ section.settings.dt_pad_left }}px;
    max-width: {{ section.settings.content_max_width }}px;
    text-align: {{ section.settings.dt_text_align }};
  }
  #ma-ar-{{ sid }} .ma-ar__k{
    font-family: 'Marcellus', serif;
    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: {{ section.settings.eyebrow_weight }};
    letter-spacing: {{ section.settings.eyebrow_spacing }}px;
    text-transform: {{ section.settings.eyebrow_transform }};
    color: var(--burg2);
    margin: 0 0 {{ section.settings.content_gap }}px;
    display: flex;
    align-items: center;
    gap: 12px;
    {% if section.settings.dt_text_align == 'center' %}justify-content: center;{% endif %}
  }
  #ma-ar-{{ sid }} .ma-ar__k::before{
    content: "";
    width: 34px;
    height: 2px;
    background: var(--burg2);
    flex: 0 0 auto;
    {% if section.settings.dt_text_align == 'center' %}display: none;{% endif %}
  }
  #ma-ar-{{ sid }} .ma-ar__h{
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: {{ section.settings.heading_weight }} !important;
    text-transform: {{ section.settings.heading_transform }} !important;
    letter-spacing: {{ section.settings.heading_spacing }}px !important;
    font-size: clamp(26px, min(9.2vw, 5.2svh), {{ section.settings.heading_size }}px);
    line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    margin: 0 0 {{ section.settings.content_gap }}px;
    color: var(--ink);
  }
  #ma-ar-{{ sid }} .ma-ar__h em{ font-style: italic; color: var(--burg); }
  #ma-ar-{{ sid }} .ma-ar__sub{
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: {{ section.settings.sub_weight }};
    font-size: clamp(14px, 2.4svh, {{ section.settings.sub_size }}px);
    line-height: {{ section.settings.sub_line_height | divided_by: 100.0 }};
    color: rgba(23,19,16,.74);
    margin: 0 0 clamp(8px, 2svh, {{ section.settings.content_gap | times: 1.5 }}px);
    max-width: 45ch;
    {% if section.settings.dt_text_align == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
  }

  /* ---- comparison rows + bars ---- */
  #ma-ar-{{ sid }} .ma-ar__cmp{ margin: 0; width: 100%; }
  #ma-ar-{{ sid }} .ma-ar__row{ padding: 13px 0 0; border-top: 1px solid rgba(23,19,16,.14); }
  #ma-ar-{{ sid }} .ma-ar__top{ display: flex; justify-content: space-between; align-items: baseline; gap: 14px; }
  #ma-ar-{{ sid }} .ma-ar__lab{
    font-family: 'Marcellus', serif;
    font-size: 10px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: rgba(23,19,16,.7);
  }
  #ma-ar-{{ sid }} .ma-ar__val{
    font-family: 'Cormorant Garamond', Georgia, serif;
    white-space: nowrap;
  }
  #ma-ar-{{ sid }} .ma-ar__val--typ{
    font-size: clamp(20px, 3.2svh, 27px);
    font-weight: 500;
    color: rgba(23,19,16,.44);
    text-decoration: line-through;
    text-decoration-thickness: 1.5px;
  }
  #ma-ar-{{ sid }} .ma-ar__val--now{
    font-size: clamp(30px, min(10.5vw, 5.6svh), {{ section.settings.val_size }}px);
    font-weight: 600;
    color: var(--burg2);
  }
  #ma-ar-{{ sid }} .ma-ar__val--now em{ font-style: italic; font-weight: 400; font-size: .52em; color: var(--burg); margin-right: 2px; }
  #ma-ar-{{ sid }} .ma-ar__track{ display: block; height: 4px; background: rgba(23,19,16,.08); border-radius: 2px; overflow: hidden; margin: 10px 0 12px; }
  #ma-ar-{{ sid }} .ma-ar__fill{ display: block; height: 100%; width: 0; border-radius: 2px; }
  #ma-ar-{{ sid }} .ma-ar__fill--typ{ background: rgba(23,19,16,.55); transition: width 1.4s cubic-bezier(.25,.8,.25,1) .1s; }
  #ma-ar-{{ sid }} .ma-ar__fill--now{ background: var(--burg2); transition: width 1.1s cubic-bezier(.25,.8,.25,1) .7s; }
  #ma-ar-{{ sid }}.is-in .ma-ar__fill--typ{ width: 100%; }
  #ma-ar-{{ sid }}.is-in .ma-ar__fill--now{ width: 12%; }

  /* ---- refinements ---- */
  #ma-ar-{{ sid }} .ma-ar__refine{
    margin: 16px 0 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    {% if section.settings.dt_text_align == 'center' %}align-items: center;{% endif %}
  }
  #ma-ar-{{ sid }} .ma-ar__ref{
    font-size: 16.5px;
    font-weight: 500;
    color: rgba(23,19,16,.85);
    line-height: 1.5;
    margin: 0;
  }
  #ma-ar-{{ sid }} .ma-ar__ref b{ color: var(--gold); font-weight: 400; margin-right: 8px; }

  /* ---- call to action button ---- */
  #ma-ar-{{ sid }} .ma-ar__cta-wrap{
    margin-top: {{ section.settings.content_gap | times: 1.8 }}px;
    {% if section.settings.dt_text_align == 'center' %}display: flex; justify-content: center;{% endif %}
  }
  #ma-ar-{{ sid }} .ma-ar__cta{
    display: inline-flex;
    align-items: center;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: {{ section.settings.cta_size }}px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    color: {{ section.settings.cta_color }};
    border-bottom: 1px solid {{ section.settings.cta_color }};
    padding-bottom: 4px;
    transition: color 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
  }
  #ma-ar-{{ sid }} .ma-ar__cta:hover{
    color: {{ section.settings.cta_hover_color }};
    border-color: {{ section.settings.cta_hover_color }};
    transform: translateX(4px);
  }

  /* ---- photo, melted into the cream ---- */
  #ma-ar-{{ sid }} .ma-ar__photo{
    flex: 0 0 29svh;
    min-height: 0;
    overflow: hidden;
    position: relative;
  }
  #ma-ar-{{ sid }} .ma-ar__photo-overlay{
    position: absolute;
    inset: 0;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_strength | divided_by: 100.0 }};
    pointer-events: none;
    z-index: 1;
  }
  #ma-ar-{{ sid }} .ma-ar__img{
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: {{ section.settings.focal_x }}% {{ section.settings.focal_y }}%;
    transform: scale({{ section.settings.image_scale | divided_by: 100.0 }});
    opacity: {{ section.settings.image_opacity | divided_by: 100.0 }};
    display: block;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  {%- if melt > 0 -%}
  #ma-ar-{{ sid }} .ma-ar__photo::before{
    content: "";
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    top: 0;
    height: 34%;
    backdrop-filter: blur({{ melt_blur }}px);
    -webkit-backdrop-filter: blur({{ melt_blur }}px);
    -webkit-mask-image: linear-gradient(180deg,#000 0,transparent 100%);
            mask-image: linear-gradient(180deg,#000 0,transparent 100%);
  }
  #ma-ar-{{ sid }} .ma-ar__photo::after{
    content: "";
    position: absolute;
    z-index: 3;
    inset: 0;
    opacity: {{ melt_veil }};
    background: linear-gradient(180deg, {{ fade_color }} 0%, rgba(244,238,225,.55) 14%, rgba(244,238,225,0) 46%);
  }
  {%- endif -%}

  /* ---- mobile only: photo on top, copy below (desktop <900px untouched) ---- */
  @media (max-width: 899px){
    #ma-ar-{{ sid }}.ma-ar{
      height: auto;
      max-height: none;
      overflow: visible;
    }
    #ma-ar-{{ sid }} .ma-ar__copy{
      flex: 0 0 auto;
      justify-content: flex-start;
      padding: {{ section.settings.mob_pad_top }}px {{ section.settings.mob_pad_h }}px {{ section.settings.mob_pad_bottom }}px;
      text-align: {{ section.settings.mob_text_align }};
    }
    #ma-ar-{{ sid }} .ma-ar__photo{
      order: -1;
      height: {{ section.settings.mob_img_height }}px;
      flex: none;
    }
    #ma-ar-{{ sid }} .ma-ar__img{
      object-position: {{ section.settings.mob_focal_x }}% {{ section.settings.mob_focal_y }}%;
    }
    #ma-ar-{{ sid }} .ma-ar__k{
      font-size: {{ section.settings.mob_eyebrow_size }}px;
      {% if section.settings.mob_text_align == 'center' %}justify-content: center;{% else %}justify-content: flex-start;{% endif %}
    }
    #ma-ar-{{ sid }} .ma-ar__k::before{
      {% if section.settings.mob_text_align == 'center' %}display: none;{% else %}display: block;{% endif %}
    }
    #ma-ar-{{ sid }} .ma-ar__h{
      font-size: clamp(26px, 7.5vw, {{ section.settings.mob_heading_size }}px);
    }
    #ma-ar-{{ sid }} .ma-ar__sub{
      font-size: {{ section.settings.mob_sub_size }}px;
      {% if section.settings.mob_text_align == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
    }
    #ma-ar-{{ sid }} .ma-ar__refine{
      {% if section.settings.mob_text_align == 'center' %}align-items: center;{% else %}align-items: flex-start;{% endif %}
    }
    #ma-ar-{{ sid }} .ma-ar__cta-wrap{
      {% if section.settings.mob_text_align == 'center' %}display: flex; justify-content: center;{% else %}display: block;{% endif %}
    }
    {%- if melt > 0 -%}
    #ma-ar-{{ sid }} .ma-ar__photo::before{
      top: auto;
      bottom: 0;
      height: 34%;
      -webkit-mask-image: linear-gradient(0deg,#000 0,transparent 100%);
              mask-image: linear-gradient(0deg,#000 0,transparent 100%);
    }
    #ma-ar-{{ sid }} .ma-ar__photo::after{
      background: linear-gradient(0deg, {{ fade_color }} 0%, rgba(244,238,225,.55) 14%, rgba(244,238,225,0) 46%);
    }
    {%- endif -%}
  }

  /* ---- desktop: split, still exactly one screen ---- */
  @media (min-width: 900px){
    #ma-ar-{{ sid }}.ma-ar--split{ flex-direction: row; }
    #ma-ar-{{ sid }} .ma-ar__copy{
      width: {{ section.settings.content_col_width }}%;
      padding: 0 {{ section.settings.dt_pad_right }}px 0 {{ section.settings.dt_pad_left }}px;
    }
    #ma-ar-{{ sid }} .ma-ar__k{ margin-bottom: clamp(10px, 2svh, 18px); font-size: 12px; }
    #ma-ar-{{ sid }} .ma-ar__h{ font-size: clamp(30px, min(4vw, 6svh), {{ section.settings.heading_size }}px); max-width: 16ch; margin-bottom: 12px; }
    #ma-ar-{{ sid }} .ma-ar__sub{ font-size: clamp(15px, 2.5svh, 19px); margin-bottom: clamp(12px, 3svh, 28px); }
    #ma-ar-{{ sid }} .ma-ar__row{ padding: clamp(10px, 2svh, 17px) 0 0; }
    #ma-ar-{{ sid }} .ma-ar__lab{ font-size: 11px; }
    #ma-ar-{{ sid }} .ma-ar__val--typ{ font-size: clamp(22px, 3.4svh, 30px); }
    #ma-ar-{{ sid }} .ma-ar__val--now{ font-size: clamp(34px, min(4.2vw, 6.4svh), {{ section.settings.val_size }}px); }
    #ma-ar-{{ sid }} .ma-ar__refine{ margin-top: 24px; flex-direction: row; gap: 34px; flex-wrap: wrap; }
    #ma-ar-{{ sid }} .ma-ar__ref{ font-size: 17px; }
    #ma-ar-{{ sid }} .ma-ar__photo{ flex: 0 0 {{ 100 | minus: section.settings.content_col_width }}%; height: auto; }
    {%- if melt > 0 -%}
    #ma-ar-{{ sid }} .ma-ar__photo::before{
      top: 0;
      bottom: 0;
      left: 0;
      right: auto;
      width: 44%;
      height: auto;
      -webkit-mask-image: linear-gradient(90deg,#000 0,transparent 100%);
              mask-image: linear-gradient(90deg,#000 0,transparent 100%);
    }
    #ma-ar-{{ sid }} .ma-ar__photo::after{
      background: linear-gradient(90deg, {{ fade_color }} 0%, rgba(244,238,225,.6) 12%, rgba(244,238,225,0) 48%);
    }
    {%- endif -%}
  }

  @media (prefers-reduced-motion: reduce){
    #ma-ar-{{ sid }} .ma-ar__fill{ transition: none !important; }
    #ma-ar-{{ sid }} .ma-ar__fill--typ{ width: 100% !important; }
    #ma-ar-{{ sid }} .ma-ar__fill--now{ width: 12% !important; }
  }
</style>

<script>
  (function(){
    var s = document.getElementById('ma-ar-{{ sid }}');
    if(!s) return;

    /* exact one-screen: subtract any sticky/fixed header from the section height */
    function fitHeader(){
      var off = 0;
      ['sticky-header','.shopify-section-group-header-group','.section-header','header'].some(function(sel){
        var el = document.querySelector(sel);
        if(!el) return false;
        var cs = getComputedStyle(el);
        if(cs.position === 'sticky' || cs.position === 'fixed'){ off = el.getBoundingClientRect().height; return true; }
        return false;
      });
      s.style.setProperty('--ma-hdr', off + 'px');
    }
    fitHeader();
    window.addEventListener('resize', fitHeader);

    /* bars fill when the customer actually arrives — and replay on every visit */
    {% if request.design_mode %}
      s.classList.add('is-in'); return;
    {% endif %}
    if(!('IntersectionObserver' in window)){ s.classList.add('is-in'); return; }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){ s.classList.add('is-in'); }
        else { s.classList.remove('is-in'); }   /* reset off-screen so it replays */
      });
    }, { threshold: 0.55 });
    io.observe(s);
  })();
</script>

{% schema %}
{
  "name": "MA — Honest Arithmetic",
  "tag": "section",
  "class": "ma-arith-section",
  "settings": [
    { "type": "header", "content": "── CORE CONTENT (PRESERVED IDS) ──" },
    { "type": "paragraph", "content": "Exact one-screen section. Photo melts into the cream ground." },
    { "type": "image_picker", "id": "bottle_image", "label": "Bottle photo" },
    { "type": "range", "id": "melt", "label": "Photo melt intensity", "min": 0, "max": 100, "step": 10, "unit": "%", "default": 100 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Honest Arithmetic" },
    { "type": "textarea", "id": "heading", "label": "Headline", "default": "Luxury belongs inside the bottle. Not on the receipt." },
    { "type": "text", "id": "subheading", "label": "Sub-line", "default": "Only the scent should define the experience." },
    { "type": "header", "content": "Comparison" },
    { "type": "text", "id": "left_label", "label": "Left label", "default": "Typical luxury pricing" },
    { "type": "text", "id": "left_value", "label": "Left value", "default": "₹20,000" },
    { "type": "text", "id": "right_label", "label": "Right label", "default": "Maison Amiir" },
    { "type": "text", "id": "right_value", "label": "Right value", "default": "from ₹2,200" },
    { "type": "header", "content": "Refinements (kept honest)" },
    { "type": "text", "id": "refine_1", "label": "Refinement 1", "default": "Lasts all day · 30% extrait" },
    { "type": "text", "id": "refine_2", "label": "Refinement 2", "default": "Kind to skin · IFRA-compliant oils" },

    { "type": "header", "content": "── COLOR PALETTE & PRESETS ──" },
    { "type": "select", "id": "color_preset", "label": "Layout Color Preset", "default": "cream", "options": [
      { "value": "cream", "label": "Maison Cream (Warm Luxury - Approved)" },
      { "value": "noir", "label": "Maison Noir (Dark Campaign)" },
      { "value": "white", "label": "Editorial White (Minimalist)" },
      { "value": "custom", "label": "Custom Colors Below" }
    ]},
    { "type": "color", "id": "bg_color", "label": "Custom Background", "default": "#F4EEE1" },
    { "type": "color", "id": "ink_color", "label": "Custom Text Color", "default": "#171310" },
    { "type": "color", "id": "gold_color", "label": "Custom Gold Accent", "default": "#C6A15B" },
    { "type": "color", "id": "burg_color", "label": "Custom Opera Burgundy (Italic)", "default": "#6E1220" },
    { "type": "color", "id": "burg2_color", "label": "Custom Opera Red (Bar/Price)", "default": "#8E1B28" },
    { "type": "color", "id": "fade_color", "label": "Custom Photo Fade Color", "default": "#F4EEE1" },

    { "type": "header", "content": "── CALL TO ACTION (OPTIONAL) ──" },
    { "type": "text", "id": "cta_text", "label": "CTA Button Text", "default": "Explore The Collection" },
    { "type": "url", "id": "cta_link", "label": "CTA Link" },
