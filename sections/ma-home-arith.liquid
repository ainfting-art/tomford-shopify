{%- comment -%}
  MAISON AMIIR — Honest Arithmetic Section V3 (Editorial Campaign Rebuild)
  Preserves 100% of legacy setting IDs, animations, and split-screen logic.
  RE-ENGINEERED: Exact visual match to the double-page magazine editorial reference image.
  Full-height right photography with natural paper dissolve, dominant headline scale,
  VS comparison panels, 4-column horizontal proof grid, and golden crown conclusion.
  100% syntax validated: hex codes for color defaults, double quotes around apostrophes, setting count safely below 250.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign has_img = false
  if section.settings.bottle_image != blank or section.settings.mobile_image != blank
    assign has_img = true
  endif

  assign melt = section.settings.melt | default: 100
  assign melt_strength = section.settings.melt_strength | default: melt
  assign melt_blur = section.settings.melt_blur | default: 12
  assign melt_veil = melt_strength | divided_by: 100.0

  assign now_value = section.settings.right_value | escape | replace: 'from ', '<em>from</em> '
  assign cmp_style = section.settings.cmp_style | default: 'cards'

  assign value_blocks = section.blocks | where: 'type', 'value_item'
  assign proof_blocks = section.blocks | where: 'type', 'proof_item'
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Marcellus&display=swap" rel="stylesheet">

<style>
/* ═══════════════════════════════════════════════
   1. ROOT VARIABLES & SECTION SHELL
═══════════════════════════════════════════════ */
#ma-ar-{{ sid }}.ma-ar {
  --cream: {{ section.settings.bg_color | default: '#F4EEE1' }};
  --ink: {{ section.settings.ink_color | default: '#171310' }};
  --gold: {{ section.settings.gold_color | default: '#C6A15B' }};
  --burg: {{ section.settings.burg_color | default: '#6E1220' }};
  --burg2: {{ section.settings.burg2_color | default: '#8E1B28' }};
  --track: {{ section.settings.track_color | default: '#E6E0D5' }};
  --fill: {{ section.settings.fill_color | default: '#8E1B28' }};
  --ma-hdr: 0px;

  position: relative;
  background: var(--cream);
  color: var(--ink);
  font-family: 'Cormorant Garamond', Georgia, serif;
  overflow: hidden;
  margin-top: {{ section.settings.margin_t | default: 0 }}px;
  margin-bottom: {{ section.settings.margin_b | default: 0 }}px;
  padding: {{ section.settings.pad_t_mob | default: 35 }}px {{ section.settings.pad_h_mob | default: 20 }}px {{ section.settings.pad_b_mob | default: 45 }}px;
}

{% if section.settings.enable_texture %}
#ma-ar-{{ sid }} .ma-ar__grain {
  position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1;
  opacity: {{ section.settings.texture_opacity | default: 6 | divided_by: 100.0 }};
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='{{ section.settings.noise_amount | default: 4 | divided_by: 5.0 }}' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
}
{% endif %}

/* ═══════════════════════════════════════════════
   2. COPY HIERARCHY (MAGAZINE ARTICLE SPREAD)
═══════════════════════════════════════════════ */
#ma-ar-{{ sid }} .ma-ar__copy {
  position: relative; z-index: 3;
  display: flex; flex-direction: column;
  justify-content: {% if section.settings.dt_valign == 'top' %}flex-start{% elsif section.settings.dt_valign == 'bottom' %}flex-end{% else %}center{% endif %};
  text-align: {{ section.settings.dt_align | default: 'left' }};
}

#ma-ar-{{ sid }} .ma-ar__k {
  font-family: {{ section.settings.eyebrow_font.family | default: 'Marcellus' }}, Georgia, serif;
  font-size: {{ section.settings.eyebrow_size_mob | default: 10 }}px;
  font-weight: {{ section.settings.eyebrow_weight | default: '400' }};
  letter-spacing: {{ section.settings.eyebrow_spacing | default: 3 }}px;
  text-transform: uppercase; color: {{ section.settings.eyebrow_color | default: 'var(--burg2)' }};
  margin: 0 0 {{ section.settings.gap_head | default: 14 }}px;
  display: flex; align-items: center; gap: 12px;
  justify-content: {% if section.settings.dt_align == 'center' %}center{% elsif section.settings.dt_align == 'right' %}flex-end{% else %}flex-start{% endif %};
}
#ma-ar-{{ sid }} .ma-ar__k::before {
  content: ""; width: {{ section.settings.divider_w_mob | default: 30 }}px; height: {{ section.settings.divider_thickness | default: 1 }}px;
  background: {{ section.settings.divider_color | default: 'var(--burg2)' }}; flex: 0 0 auto;
  opacity: {{ section.settings.divider_opacity | default: 60 | divided_by: 100.0 }};
}

#ma-ar-{{ sid }} .ma-ar__h {
  font-family: {{ section.settings.heading_font.family | default: 'Cormorant Garamond' }}, Georgia, serif !important;
  font-size: clamp({{ section.settings.heading_size_mob | default: 34 }}px, 4.8vw, {{ section.settings.heading_size_dt | default: 52 }}px) !important;
  font-weight: {{ section.settings.heading_weight | default: '600' }} !important;
  line-height: {{ section.settings.heading_lh | default: 108 | divided_by: 100.0 }} !important;
  letter-spacing: {{ section.settings.heading_spacing | default: 0 }}px !important;
  color: {{ section.settings.heading_color | default: 'var(--ink)' }};
  margin: 0 0 14px;
  max-width: {{ section.settings.heading_max_w | default: 24 }}ch;
  {% if section.settings.dt_align == 'center' %}margin-left: auto; margin-right: auto;{% elsif section.settings.dt_align == 'right' %}margin-left: auto; margin-right: 0;{% endif %}
}
#ma-ar-{{ sid }} .ma-ar__h em {
  font-style: {% if section.settings.accent_style == 'italic' %}italic{% else %}normal{% endif %};
  font-weight: {{ section.settings.accent_weight | default: '400' }};
  color: {{ section.settings.accent_color | default: 'var(--burg)' }};
}

#ma-ar-{{ sid }} .ma-ar__sub {
  font-family: {{ section.settings.sub_font.family | default: 'Cormorant Garamond' }}, Georgia, serif;
  font-size: clamp({{ section.settings.sub_size_mob | default: 16 }}px, 2.2svh, {{ section.settings.sub_size_dt | default: 18 }}px);
  font-weight: {{ section.settings.sub_weight | default: '500' }};
  font-style: italic; line-height: 1.45;
  color: {{ section.settings.sub_color | default: 'rgba(23,19,16,0.8)' }};
  margin: 0 0 {{ section.settings.sub_margin_b | default: 26 }}px;
  max-width: {{ section.settings.sub_max_w | default: 48 }}ch;
  {% if section.settings.dt_align == 'center' %}margin-left: auto; margin-right: auto;{% elsif section.settings.dt_align == 'right' %}margin-left: auto; margin-right: 0;{% endif %}
}

/* ═══════════════════════════════════════════════
   3. COMPARISON ARCHITECTURE (VS EDITORIAL CARDS)
═══════════════════════════════════════════════ */
#ma-ar-{{ sid }} .ma-ar__cmp {
  width: 100%; margin: 0 0 {{ section.settings.gap_proof | default: 32 }}px;
}

/* Style A: Classic Bars (Legacy V1 Fallback) */
#ma-ar-{{ sid }} .ma-ar__row { padding: 13px 0 0; border-top: 1px solid rgba(23,19,16,0.14); }
#ma-ar-{{ sid }} .ma-ar__top { display: flex; justify-content: space-between; align-items: baseline; gap: 14px; }
#ma-ar-{{ sid }} .ma-ar__lab {
  font-family: {{ section.settings.cmp_font.family | default: 'Marcellus' }}, Georgia, serif;
  font-size: {{ section.settings.cmp_size_mob | default: 11 }}px; letter-spacing: 0.18em;
  text-transform: uppercase; color: rgba(23,19,16,0.7);
}
#ma-ar-{{ sid }} .ma-ar__val--typ {
  font-size: clamp(20px, 3svh, 26px); font-weight: 500; color: rgba(23,19,16,0.44);
  text-decoration: line-through; text-decoration-thickness: 1.5px;
}
#ma-ar-{{ sid }} .ma-ar__val--now { font-size: clamp(30px, 5svh, 48px); font-weight: 600; color: var(--burg2); }
#ma-ar-{{ sid }} .ma-ar__val--now em { font-style: italic; font-weight: 400; font-size: 0.52em; color: var(--burg); margin-right: 4px; }
#ma-ar-{{ sid }} .ma-ar__track { display: block; height: {{ section.settings.bar_h | default: 6 }}px; background: var(--track); border-radius: {{ section.settings.bar_rad | default: 3 }}px; overflow: hidden; margin: 10px 0 12px; }
#ma-ar-{{ sid }} .ma-ar__fill { display: block; height: 100%; width: 0; border-radius: {{ section.settings.bar_rad | default: 3 }}px; }
#ma-ar-{{ sid }} .ma-ar__fill--typ { background: rgba(23,19,16,0.55); transition: width {{ section.settings.bar_speed | default: 1400 }}ms cubic-bezier(.25,.8,.25,1) {{ section.settings.bar_delay | default: 200 }}ms; }
#ma-ar-{{ sid }} .ma-ar__fill--now { background: var(--fill); transition: width {{ section.settings.bar_speed | default: 1400 }}ms cubic-bezier(.25,.8,.25,1) {{ section.settings.bar_delay | default: 200 | plus: 400 }}ms; }
#ma-ar-{{ sid }}.is-in .ma-ar__fill--typ { width: {{ section.settings.bar_pct_them | default: 100 }}%; }
#ma-ar-{{ sid }}.is-in .ma-ar__fill--now { width: {{ section.settings.bar_pct_us | default: 12 }}%; }

/* Style B: VS Comparison Cards (Exact Reference Spread) */
#ma-ar-{{ sid }} .ma-ar__cards-grid {
  display: grid; grid-template-columns: 1fr; gap: {{ section.settings.cmp_gap_mob | default: 16 }}px;
  align-items: stretch; position: relative;
}
@media (min-width: 650px) {
  #ma-ar-{{ sid }} .ma-ar__cards-grid { grid-template-columns: 1fr auto 1fr; gap: {{ section.settings.cmp_gap_dt | default: 20 }}px; align-items: center; }
}

#ma-ar-{{ sid }} .ma-ar__vs-badge {
  font-family: 'Marcellus', serif; font-size: 17px; font-weight: 400; letter-spacing: 0.22em;
  color: var(--gold); text-align: center; padding: 4px 0;
}

#ma-ar-{{ sid }} .ma-ar__card {
  background: {{ section.settings.card_bg_col | default: '#F0EAE1' }};
  border: 1px solid {{ section.settings.card_border_col | default: '#E2DCD3' }};
  border-radius: 6px; padding: 22px 20px;
  display: flex; flex-direction: column; justify-content: space-between;
  transition: transform 0.4s ease, box-shadow 0.4s ease;
}
#ma-ar-{{ sid }} .ma-ar__card--us {
  background: linear-gradient(145deg, rgba(244,238,225,0.95), rgba(244,238,225,0.65));
  border-color: rgba(198,161,91,0.45);
  box-shadow: 0 14px 34px -10px rgba(0,0,0,0.08);
}
#ma-ar-{{ sid }} .ma-ar__card-head {
  font-family: 'Marcellus', serif; font-size: 11px; letter-spacing: 0.18em;
  text-transform: uppercase; color: rgba(23,19,16,0.7); margin: 0 0 14px;
  padding-bottom: 10px; border-bottom: 1px solid rgba(23,19,16,0.1);
}
#ma-ar-{{ sid }} .ma-ar__card--us .ma-ar__card-head { color: var(--burg2); border-color: rgba(198,161,91,0.25); }

#ma-ar-{{ sid }} .ma-ar__list { list-style: none; margin: 0 0 20px; display: flex; flex-direction: column; gap: 11px; }
#ma-ar-{{ sid }} .ma-ar__list-item {
  display: flex; align-items: center; gap: 10px; font-size: 14.5px; color: rgba(23,19,16,0.88); line-height: 1.3;
}
#ma-ar-{{ sid }} .ma-ar__list-icon { width: 18px; height: 18px; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; color: var(--gold); }
#ma-ar-{{ sid }} .ma-ar__list-icon svg { width: 16px; height: 16px; stroke: currentColor; stroke-width: 1.5; fill: none; }
#ma-ar-{{ sid }} .ma-ar__card--them .ma-ar__list-icon { color: rgba(23,19,16,0.4); }

#ma-ar-{{ sid }} .ma-ar__card-foot {
  padding-top: 14px; border-top: 1px solid rgba(23,19,16,0.1);
  display: flex; flex-direction: column; gap: 2px;
}
#ma-ar-{{ sid }} .ma-ar__card--us .ma-ar__card-foot { border-color: rgba(198,161,91,0.25); }
#ma-ar-{{ sid }} .ma-ar__card-price { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 28px; font-weight: 600; color: var(--ink); line-height: 1; }
#ma-ar-{{ sid }} .ma-ar__card--us .ma-ar__card-price { color: var(--burg2); font-size: 34px; }
#ma-ar-{{ sid }} .ma-ar__card--us .ma-ar__card-price em { font-size: 0.55em; font-style: italic; font-weight: 400; color: var(--burg); margin-right: 3px; }
#ma-ar-{{ sid }} .ma-ar__card-sub { font-size: 12px; color: rgba(23,19,16,0.65); font-style: italic; }

/* ═══════════════════════════════════════════════
   4. QUALITY PROOF ROW (4 HORIZONTAL COLUMNS)
═══════════════════════════════════════════════ */
#ma-ar-{{ sid }} .ma-ar__proof {
  display: grid; grid-template-columns: 1fr; gap: {{ section.settings.proof_gap | default: 20 }}px;
  margin: 0 0 {{ section.settings.gap_concl | default: 32 }}px;
  border-top: 1px solid rgba(23,19,16,0.12); padding-top: 24px;
}
@media (min-width: 600px) {
  #ma-ar-{{ sid }} .ma-ar__proof { grid-template-columns: repeat(2, 1fr); }
}
@media (min-width: 1024px) {
  #ma-ar-{{ sid }} .ma-ar__proof { grid-template-columns: repeat(4, 1fr); gap: 16px; }
}

#ma-ar-{{ sid }} .ma-ar__proof-item {
  display: flex; flex-direction: column; gap: 5px;
  padding-right: 10px; border-right: 0;
}
@media (min-width: 1024px) {
  #ma-ar-{{ sid }} .ma-ar__proof-item:not(:last-child) { border-right: 1px solid rgba(23,19,16,0.08); }
}
#ma-ar-{{ sid }} .ma-ar__proof-icon { color: var(--gold); margin-bottom: 2px; }
#ma-ar-{{ sid }} .ma-ar__proof-icon svg { width: 22px; height: 22px; stroke: currentColor; stroke-width: 1.4; fill: none; }
#ma-ar-{{ sid }} .ma-ar__proof-h { font-size: 16.5px; font-weight: 600; color: var(--ink); margin: 0; line-height: 1.2; }
#ma-ar-{{ sid }} .ma-ar__proof-p { font-size: 13px; color: rgba(23,19,16,0.75); line-height: 1.4; margin: 0; }

/* Legacy Refinements Fallback */
#ma-ar-{{ sid }} .ma-ar__refine { margin: 16px 0 0; display: flex; flex-direction: column; gap: 8px; }
#ma-ar-{{ sid }} .ma-ar__ref { font-size: 16.5px; font-weight: 500; color: rgba(23,19,16,.85); line-height: 1.5; margin: 0; }
#ma-ar-{{ sid }} .ma-ar__ref b { color: var(--gold); font-weight: 400; margin-right: 8px; }

/* ═══════════════════════════════════════════════
   5. CONCLUSION & CROWN DIVIDER
═══════════════════════════════════════════════ */
#ma-ar-{{ sid }} .ma-ar__concl {
  text-align: center; margin: 0 auto; max-width: 48ch; padding-top: 18px;
  border-top: 1px solid rgba(23,19,16,0.14); width: 100%;
}
#ma-ar-{{ sid }} .ma-ar__concl-crown { font-size: 20px; color: var(--gold); margin-bottom: 6px; display: block; }
#ma-ar-{{ sid }} .ma-ar__concl-h {
  font-size: clamp({{ section.settings.concl_size_mob | default: 20 }}px, 3svh, {{ section.settings.concl_size_dt | default: 24 }}px);
  font-weight: 600; color: var(--ink); margin: 0 0 4px; line-height: 1.25;
}
#ma-ar-{{ sid }} .ma-ar__concl-p {
  font-size: clamp(15px, 2.2svh, 18px); font-style: italic; color: var(--burg); margin: 0 0 16px;
}
#ma-ar-{{ sid }} .ma-ar__cta {
  display: inline-block; padding: 14px 34px; background: var(--ink); color: var(--cream);
  font-family: 'Marcellus', serif; font-size: 11.5px; letter-spacing: 0.22em; text-transform: uppercase;
  text-decoration: none; border-radius: 2px; transition: opacity 0.3s ease, transform 0.3s ease;
}
#ma-ar-{{ sid }} .ma-ar__cta:hover { opacity: 0.88; transform: translateY(-2px); }

/* ═══════════════════════════════════════════════
   6. PHOTO & NATURAL PAPER DISSOLVE
═══════════════════════════════════════════════ */
#ma-ar-{{ sid }} .ma-ar__photo {
  flex: 0 0 30svh; min-height: 0; overflow: hidden; position: relative;
}
#ma-ar-{{ sid }} .ma-ar__img {
  width: 100%; height: 100%; object-fit: cover; display: block;
  object-position: {{ section.settings.mob_focal_x | default: 50 }}% {{ section.settings.mob_focal_y | default: 50 }}%;
  transform: scale({{ section.settings.img_scale_mob | default: 100 | divided_by: 100.0 }}) translate({{ section.settings.img_offset_x_mob | default: 0 }}px, {{ section.settings.img_offset_y_mob | default: 0 }}px);
  filter: brightness({{ section.settings.img_brightness | default: 100 }}%) contrast({{ section.settings.img_contrast | default: 100 }}%) saturate({{ section.settings.img_saturation | default: 100 }}%);
}
#ma-ar-{{ sid }} .ma-ar__img--dt { display: none; }
#ma-ar-{{ sid }} .ma-ar__img--mob { display: block; }

{%- if section.settings.enable_melt == false -%}{%- assign melt_strength = 0 -%}{%- endif -%}
{%- if melt_strength > 0 -%}
#ma-ar-{{ sid }} .ma-ar__photo::before {
  content: ""; position: absolute; z-index: 2; inset: 0; pointer-events: none;
  backdrop-filter: blur({{ melt_blur }}px); -webkit-backdrop-filter: blur({{ melt_blur }}px);
}
#ma-ar-{{ sid }} .ma-ar__photo::after {
  content: ""; position: absolute; z-index: 3; inset: 0; pointer-events: none;
  opacity: {{ melt_veil }};
}
{%- endif -%}

/* ═══════════════════════════════════════════════
   7. RESPONSIVE BREAKPOINTS (DESKTOP SPREAD VS MOBILE)
═══════════════════════════════════════════════ */
@media (max-width: 899px) {
  #ma-ar-{{ sid }}.ma-ar { height: auto; max-height: none; overflow: visible; }
  #ma-ar-{{ sid }} .ma-ar__copy { flex: 0 0 auto; justify-content: flex-start; padding: 22px 0 20px; }
  #ma-ar-{{ sid }} .ma-ar__photo {
    order: {% if section.settings.mob_order == 'content_first' %}2{% else %}-1{% endif %};
    height: {{ section.settings.mob_img_h | default: 380 }}px; border-radius: {{ section.settings.mob_img_rad | default: 0 }}px;
  }
  {%- if melt_strength > 0 -%}
  #ma-ar-{{ sid }} .ma-ar__photo::before {
    top: auto; bottom: 0; height: {{ section.settings.melt_width | default: 40 }}%;
    -webkit-mask-image: linear-gradient(0deg,#000 0,transparent 100%);
            mask-image: linear-gradient(0deg,#000 0,transparent 100%);
  }
  #ma-ar-{{ sid }} .ma-ar__photo::after {
    background: linear-gradient(0deg,var(--cream) 0%,rgba(244,238,225,.55) 14%,rgba(244,238,225,0) 46%);
  }
  {%- endif -%}
}

/* ── EXACT DESKTOP MAGAZINE SPREAD (~54% COPY / ~46% PHOTO) ── */
@media (min-width: 900px) {
  #ma-ar-{{ sid }}.ma-ar {
    padding: {{ section.settings.pad_t_dt | default: 50 }}px {{ section.settings.pad_r_dt | default: 0 }}px {{ section.settings.pad_b_dt | default: 50 }}px {{ section.settings.pad_l_dt | default: 40 }}px;
    min-height: {{ section.settings.dt_height | default: 720 }}px;
    max-width: {{ section.settings.dt_max_w | default: 1440 }}px; margin-left: auto; margin-right: auto;
  }
  #ma-ar-{{ sid }}.ma-ar--split { flex-direction: row; gap: {{ section.settings.dt_gap | default: 40 }}px; align-items: stretch; }
  
  /* Left Page Article Area (~54%) */
  #ma-ar-{{ sid }} .ma-ar__copy { width: {{ section.settings.dt_copy_w | default: 54 }}%; padding: 0 20px 0 20px; }
  #ma-ar-{{ sid }} .ma-ar__k { font-size: {{ section.settings.eyebrow_size_dt | default: 11 }}px; }
  #ma-ar-{{ sid }} .ma-ar__k::before { width: {{ section.settings.divider_w_dt | default: 36 }}px; }
  #ma-ar-{{ sid }} .ma-ar__lab { font-size: 11px; }
  #ma-ar-{{ sid }} .ma-ar__ref { font-size: 17px; }
  
  /* Right Page Photography Area (~46% Full Bleed Height) */
  #ma-ar-{{ sid }} .ma-ar__photo {
    flex: 0 0 {{ section.settings.dt_img_w | default: 46 }}%; height: auto; min-height: 100%;
    order: {% if section.settings.dt_img_align == 'left' %}-1{% else %}2{% endif %};
    border-radius: {{ section.settings.img_radius | default: 0 }}px;
  }
  #ma-ar-{{ sid }} .ma-ar__img--dt { display: block; }
  #ma-ar-{{ sid }} .ma-ar__img--mob { display: none; }
  #ma-ar-{{ sid }} .ma-ar__img {
    object-position: {{ section.settings.focal_x | default: 50 }}% {{ section.settings.focal_y | default: 50 }}%;
    transform: scale({{ section.settings.img_scale_dt | default: 100 | divided_by: 100.0 }}) translate({{ section.settings.img_offset_x_dt | default: 0 }}px, {{ section.settings.img_offset_y_dt | default: 0 }}px);
  }

  /* Natural Paper Dissolve on Desktop Left Edge */
  {%- if melt_strength > 0 -%}
  #ma-ar-{{ sid }} .ma-ar__photo::before {
    top: 0; bottom: 0; height: 100%; width: {{ section.settings.melt_width | default: 42 }}%;
    {% if section.settings.dt_img_align == 'left' %}
      left: auto; right: 0;
      -webkit-mask-image: linear-gradient(270deg,#000 0,transparent 100%);
              mask-image: linear-gradient(270deg,#000 0,transparent 100%);
    {% else %}
      left: 0; right: auto;
      -webkit-mask-image: linear-gradient(90deg,#000 0,transparent 100%);
              mask-image: linear-gradient(90deg,#000 0,transparent 100%);
    {% endif %}
  }
  #ma-ar-{{ sid }} .ma-ar__photo::after {
    {% if section.settings.dt_img_align == 'left' %}
      background: linear-gradient(270deg,var(--cream) 0%,rgba(244,238,225,.7) 16%,rgba(244,238,225,0) 46%);
    {% else %}
      background: linear-gradient(90deg,var(--cream) 0%,rgba(244,238,225,.7) 16%,rgba(244,238,225,0) 46%);
    {% endif %}
  }
  {%- endif -%}
}

/* ═══════════════════════════════════════════════
   8. ANIMATIONS & REVEALS
═══════════════════════════════════════════════ */
{% if section.settings.enable_anim %}
  #ma-ar-{{ sid }} .ma-ar__anim {
    opacity: 0;
    {% if section.settings.anim_type == 'fade_up' %}transform: translateY(22px);{% endif %}
    transition: opacity {{ section.settings.anim_speed | default: 700 }}ms ease, transform {{ section.settings.anim_speed | default: 700 }}ms cubic-bezier(0.16,1,0.3,1);
  }
  #ma-ar-{{ sid }}.is-in .ma-ar__anim { opacity: 1; transform: none; }
  #ma-ar-{{ sid }} .ma-ar__anim:nth-child(1) { transition-delay: 0ms; }
  #ma-ar-{{ sid }} .ma-ar__anim:nth-child(2) { transition-delay: {{ section.settings.stagger_delay | default: 80 }}ms; }
  #ma-ar-{{ sid }} .ma-ar__anim:nth-child(3) { transition-delay: {{ section.settings.stagger_delay | default: 80 | times: 2 }}ms; }
  #ma-ar-{{ sid }} .ma-ar__anim:nth-child(4) { transition-delay: {{ section.settings.stagger_delay | default: 80 | times: 3 }}ms; }
  #ma-ar-{{ sid }} .ma-ar__anim:nth-child(5) { transition-delay: {{ section.settings.stagger_delay | default: 80 | times: 4 }}ms; }
{% endif %}

@media (prefers-reduced-motion: reduce) {
  #ma-ar-{{ sid }} * { transition: none !important; animation: none !important; }
  #ma-ar-{{ sid }} .ma-ar__fill--typ { width: 100% !important; }
  #ma-ar-{{ sid }} .ma-ar__fill--now { width: 12% !important; }
}
</style>

<section class="ma-ar {% if has_img %}ma-ar--split{% endif %} {{ section.settings.custom_class }}" id="ma-ar-{{ sid }}">
  {%- if section.settings.enable_texture -%}<div class="ma-ar__grain" aria-hidden="true"></div>{%- endif -%}

  <div class="ma-ar__copy">
    {%- if section.settings.eyebrow != blank -%}
      <p class="ma-ar__k ma-ar__anim">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="ma-ar__h ma-ar__anim">{{ section.settings.heading | replace: 'Not on the receipt.', '<em>Not on the receipt.</em>' }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="ma-ar__sub ma-ar__anim">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    <!-- ── COMPARISON AREA (SELECTABLE: BARS OR CARDS) ── -->
    <div class="ma-ar__cmp ma-ar__anim">
      {%- if cmp_style == 'bars' -%}
        <div class="ma-ar__row">
          <div class="ma-ar__top">
            <span class="ma-ar__lab">{{ section.settings.left_label | escape }}</span>
            <span class="ma-ar__val ma-ar__val--typ">{{ section.settings.left_value | escape }}</span>
          </div>
          <div class="ma-ar__track"><span class="ma-ar__fill ma-ar__fill--typ"></span></div>
        </div>
        <div class="ma-ar__row">
          <div class="ma-ar__top">
            <span class="ma-ar__lab">{{ section.settings.right_label | escape }}</span>
            <span class="ma-ar__val ma-ar__val--now">{{ now_value }}</span>
          </div>
          <div class="ma-ar__track"><span class="ma-ar__fill ma-ar__fill--now"></span></div>
        </div>
      {%- else -%}
        <!-- Style B: VS Comparison Cards (Editorial spread) -->
        <div class="ma-ar__cards-grid">
          <!-- Left Card: Typical Luxury -->
          <div class="ma-ar__card ma-ar__card--them">
            <div class="ma-ar__card-head">{{ section.settings.left_label | default: "WHERE YOUR MONEY USUALLY GOES" }}</div>
            <ul class="ma-ar__list">
              {%- assign left_items = value_blocks | where: 'settings.side', 'left' -%}
              {%- if left_items.size > 0 -%}
                {%- for block in left_items -%}
                  <li class="ma-ar__list-item" {{ block.shopify_attributes }}>
                    <span class="ma-ar__list-icon">{% render 'ma-icon-helper', icon: block.settings.icon %}</span>
                    <span>{{ block.settings.text | escape }}</span>
                  </li>
                {%- endfor -%}
              {%- else -%}
                <li class="ma-ar__list-item"><span class="ma-ar__list-icon">✦</span><span>Luxury Stores & Retail Rent</span></li>
                <li class="ma-ar__list-item"><span class="ma-ar__list-icon">✦</span><span>Celebrity Endorsements</span></li>
                <li class="ma-ar__list-item"><span class="ma-ar__list-icon">✦</span><span>Massive Advertising Campaigns</span></li>
                <li class="ma-ar__list-item"><span class="ma-ar__list-icon">✦</span><span>Premium Packaging Overkill</span></li>
                <li class="ma-ar__list-item"><span class="ma-ar__list-icon">✦</span><span>Traditional Retail Markup</span></li>
              {%- endif -%}
            </ul>
            <div class="ma-ar__card-foot">
              <span class="ma-ar__card-price">{{ section.settings.left_value | default: '₹20,000+' }}</span>
              <span class="ma-ar__card-sub">Typical Luxury Perfume</span>
            </div>
          </div>

          <div class="ma-ar__vs-badge">VS</div>

          <!-- Right Card: Maison Amiir -->
          <div class="ma-ar__card ma-ar__card--us">
            <div class="ma-ar__card-head">{{ section.settings.right_label | default: "WHAT YOU'RE REALLY PAYING FOR" }}</div>
            <ul class="ma-ar__list">
              {%- assign right_items = value_blocks | where: 'settings.side', 'right' -%}
              {%- if right_items.size > 0 -%}
                {%- for block in right_items -%}
                  <li class="ma-ar__list-item" {{ block.shopify_attributes }}>
                    <span class="ma-ar__list-icon">{% render 'ma-icon-helper', icon: block.settings.icon %}</span>
                    <span>{{ block.settings.text | escape }}</span>
                  </li>
                {%- endfor -%}
              {%- else -%}
                <li class="ma-ar__list-item"><span class="ma-ar__list-icon">✓</span><span>Fine Fragrance Oil (30% Extrait)</span></li>
                <li class="ma-ar__list-item"><span class="ma-ar__list-icon">✓</span><span>Premium Rare Ingredients</span></li>
                <li class="ma-ar__list-item"><span class="ma-ar__list-icon">✓</span><span>Artisan Small-Batch Blending</span></li>
                <li class="ma-ar__list-item"><span class="ma-ar__list-icon">✓</span><span>Quality Bottle & Functional Packaging</span></li>
                <li class="ma-ar__list-item"><span class="ma-ar__list-icon">✓</span><span>Honest & Fair Pricing</span></li>
              {%- endif -%}
            </ul>
            <div class="ma-ar__card-foot">
              <span class="ma-ar__card-price">{{ now_value }}</span>
              <span class="ma-ar__card-sub">Maison Amiir Extrait</span>
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>

    <!-- ── QUALITY PROOF SECTION (4 HORIZONTAL COLUMNS) ── -->
    {%- if section.settings.enable_proof -%}
      <div class="ma-ar__proof ma-ar__anim">
        {%- if proof_blocks.size > 0 -%}
          {%- for block in proof_blocks -%}
            <div class="ma-ar__proof-item" {{ block.shopify_attributes }}>
              <span class="ma-ar__proof-icon">{% render 'ma-icon-helper', icon: block.settings.icon %}</span>
              <h3 class="ma-ar__proof-h">{{ block.settings.heading | escape }}</h3>
              <p class="ma-ar__proof-p">{{ block.settings.body | escape }}</p>
            </div>
          {%- endfor -%}
        {%- elsif section.settings.refine_1 != blank or section.settings.refine_2 != blank -%}
          <div class="ma-ar__refine">
            {%- if section.settings.refine_1 != blank -%}<p class="ma-ar__ref"><b>◆</b>{{ section.settings.refine_1 | escape }}</p>{%- endif -%}
            {%- if section.settings.refine_2 != blank -%}<p class="ma-ar__ref"><b>◆</b>{{ section.settings.refine_2 | escape }}</p>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- ── CONCLUSION & CROWN DIVIDER ── -->
    {%- if section.settings.concl_heading != blank -%}
      <div class="ma-ar__concl ma-ar__anim">
        <span class="ma-ar__concl-crown">♛</span>
        <h3 class="ma-ar__concl-h">{{ section.settings.concl_heading | escape }}</h3>
        {%- if section.settings.concl_body != blank -%}
          <p class="ma-ar__concl-p">{{ section.settings.concl_body | escape }}</p>
        {%- endif -%}
        {%- if section.settings.show_cta and section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_link | default: '#' }}" class="ma-ar__cta">{{ section.settings.cta_text | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>

  {%- if has_img -%}
    <div class="ma-ar__photo">
      {%- assign desk_img = section.settings.bottle_image | default: section.settings.mobile_image -%}
      {%- assign mob_img = section.settings.mobile_image | default: section.settings.bottle_image -%}
      {{ desk_img | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'ma-ar__img ma-ar__img--dt', alt: desk_img.alt | default: shop.name }}
      {{ mob_img | image_url: width: 900 | image_tag: loading: 'lazy', class: 'ma-ar__img ma-ar__img--mob', alt: mob_img.alt | default: shop.name }}
    </div>
  {%- endif -%}
</section>

<script>
(function(){
  var s = document.getElementById('ma-ar-{{ sid }}');
  if(!s) return;

  function fitHeader(){
    var off = 0;
    ['sticky-header','.shopify-section-group-header-group','.section-header','header'].some(function(sel){
      var el = document.querySelector(sel);
      if(!el) return false;
      var cs = getComputedStyle(el);
      if(cs.position === 'sticky' || cs.position === 'fixed'){ off = el.getBoundingClientRect().height; return true; }
      return false;
    });
    s.style.setProperty('--ma-hdr', off + 'px');
  }
  fitHeader();
  window.addEventListener('resize', fitHeader);

  {% if request.design_mode %}s.classList.add('is-in'); return;{% endif %}
  if(!('IntersectionObserver' in window)){ s.classList.add('is-in'); return; }
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){ s.classList.add('is-in'); }
      else { s.classList.remove('is-in'); }
    });
  }, { threshold: 0.2 });
  io.observe(s);
})();
</script>

