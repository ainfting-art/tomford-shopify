{%- comment -%}
  MA Atelier Editorial — standalone luxury storytelling section.
  Desktop V3: Two-column editorial layout with customizable motion controls,
  independent mobile/desktop spacing, custom content/image offsets, width controls, 
  fine-tuned mask-fade settings, and Theme Customizer motion panel.
  Mobile V6: Perfected setting persistence with explicit Liquid default filters across all mobile properties to prevent post-save spacing collapse.
{%- endcomment -%}

{% style %}
  #shopify-section-{{ section.id }} .ma-atelier {
    position: relative;
    overflow: hidden;
    background: {{ section.settings.background_color }};
    margin-top: {{ section.settings.margin_top | default: 0 }}px;
    margin-bottom: {{ section.settings.margin_bottom | default: 0 }}px;
  }

  /* ---------- Media (image) ---------- */
  #shopify-section-{{ section.id }} .ma-atelier__media {
    position: relative;
    width: 100%;
    height: {{ section.settings.mobile_image_height | default: 480 }}px;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .ma-atelier__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_sizing }};
    object-position: {{ section.settings.image_position_x }}% {{ section.settings.image_position_y }}%;
    transform: scale({{ section.settings.image_scale | times: 1.0 | divided_by: 100 }}) translate({{ section.settings.image_offset_x | default: 0 }}px, {{ section.settings.image_offset_y | default: 0 }}px);
    transform-origin: {{ section.settings.image_zoom_origin | default: 'center' }};
    opacity: {{ section.settings.image_opacity | times: 1.0 | divided_by: 100 }};
    will-change: transform;
    transition: transform {{ section.settings.hover_duration | default: 800 }}ms ease;
  }
  
  /* Desktop image hover zoom */
  {% if section.settings.enable_motion and section.settings.enable_image_hover_zoom %}
    @media (min-width: 750px) {
      #shopify-section-{{ section.id }} .ma-atelier:hover .ma-atelier__media img {
        transform: scale(calc({{ section.settings.image_scale | times: 1.0 | divided_by: 100 }} * {{ section.settings.hover_scale | default: 103 | divided_by: 100.0 }})) translate({{ section.settings.image_offset_x | default: 0 }}px, {{ section.settings.image_offset_y | default: 0 }}px);
      }
    }
  {% endif %}

  #shopify-section-{{ section.id }} .ma-atelier__overlay {
    position: absolute;
    inset: 0;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_strength | times: 1.0 | divided_by: 100 }};
    pointer-events: none;
  }

  /* Fade System with Masking and Blur */
  #shopify-section-{{ section.id }} .ma-atelier__fade {
    position: absolute;
    inset: 0;
    background: {{ section.settings.fade_color }};
    opacity: {{ section.settings.mobile_fade_strength | default: 60 | times: 1.0 | divided_by: 100 }};
    pointer-events: none;
    {% if section.settings.fade_blur > 0 %}
      filter: blur({{ section.settings.fade_blur }}px);
      -webkit-filter: blur({{ section.settings.fade_blur }}px);
    {% endif %}
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, black 100%);
  }

  /* ---------- Content (mobile: margin-top 0 to prevent clipping label, explicit defaults to prevent collapse) ---------- */
  #shopify-section-{{ section.id }} .ma-atelier__content {
    position: relative;
    z-index: 2;
    margin-top: 0;
    padding: {{ section.settings.mobile_padding_top | default: 30 }}px {{ section.settings.mobile_padding_x | default: 24 }}px {{ section.settings.mobile_padding_bottom | default: 45 }}px;
    text-align: {{ section.settings.mobile_content_align | default: 'left' }};
    max-width: none;
  }

  /* Editorial Text Reveal */
  {% if section.settings.enable_motion and section.settings.enable_text_reveal %}
    #shopify-section-{{ section.id }} .ma-atelier__label,
    #shopify-section-{{ section.id }} .ma-atelier__headline,
    #shopify-section-{{ section.id }} .ma-atelier__paragraph,
    #shopify-section-{{ section.id }} .ma-atelier__cta {
      opacity: 0;
      transform: translateY({{ section.settings.reveal_distance | default: 18 }}px);
      transition: opacity {{ section.settings.reveal_duration | default: 0.9 }}s cubic-bezier(0.22, 1, 0.36, 1), transform {{ section.settings.reveal_duration | default: 0.9 }}s cubic-bezier(0.22, 1, 0.36, 1);
      will-change: opacity, transform;
    }

    #shopify-section-{{ section.id }} .ma-atelier.is-revealed .ma-atelier__label {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 0ms;
    }
    #shopify-section-{{ section.id }} .ma-atelier.is-revealed .ma-atelier__headline {
      opacity: 1;
      transform: translateY(0);
      transition-delay: {{ section.settings.stagger_delay | default: 80 }}ms;
    }
    #shopify-section-{{ section.id }} .ma-atelier.is-revealed .ma-atelier__paragraph {
      opacity: 1;
      transform: translateY(0);
      transition-delay: {{ section.settings.stagger_delay | default: 80 | times: 2 }}ms;
    }
    #shopify-section-{{ section.id }} .ma-atelier.is-revealed .ma-atelier__cta {
      opacity: 1;
      transform: translateY(0);
      transition-delay: {{ section.settings.stagger_delay | default: 80 | times: 3 }}ms;
    }
  {% endif %}

  #shopify-section-{{ section.id }} .ma-atelier__label {
    font-family: {{ section.settings.label_font.family }}, sans-serif;
    font-weight: {{ section.settings.label_weight }};
    font-size: {{ section.settings.label_size_mobile | default: 11 }}px;
    color: {{ section.settings.label_color }};
    letter-spacing: {{ section.settings.label_letter_spacing }}px;
    text-transform: {{ section.settings.label_transform }};
    margin: 0 0 {{ section.settings.label_bottom_margin | default: section.settings.content_spacing | default: 20 }}px;
  }

  #shopify-section-{{ section.id }} .ma-atelier__headline {
    font-family: {{ section.settings.headline_font.family }}, serif;
    font-weight: {{ section.settings.headline_weight }};
    font-size: {{ section.settings.headline_size_mobile | default: 30 }}px;
    color: {{ section.settings.headline_color }};
    letter-spacing: {{ section.settings.headline_letter_spacing }}px;
    line-height: {{ section.settings.headline_line_height }};
    margin: 0 0 {{ section.settings.heading_bottom_margin | default: section.settings.content_spacing | default: 20 }}px;
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} .ma-atelier__paragraph {
    font-family: {{ section.settings.paragraph_font.family }}, sans-serif;
    font-size: {{ section.settings.paragraph_size_mobile | default: 14 }}px;
    color: {{ section.settings.paragraph_color }};
    line-height: {{ section.settings.paragraph_line_height }};
    margin: 0 0 {{ section.settings.paragraph_bottom_margin | default: section.settings.content_spacing | default: 20 }}px;
    max-width: 100%;
  }

  /* CTA Hover Interaction */
  #shopify-section-{{ section.id }} .ma-atelier__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: {{ section.settings.cta_font.family }}, sans-serif;
    font-size: {{ section.settings.cta_size }}px;
    letter-spacing: {{ section.settings.cta_letter_spacing }}px;
    text-transform: uppercase;
    color: {{ section.settings.cta_color }};
    text-decoration: none;
    position: relative;
    padding-bottom: 3px;
    margin-top: {{ section.settings.cta_top_margin | default: 0 }}px;
    transition: color {{ section.settings.underline_duration | default: 250 }}ms ease-out;
  }
  #shopify-section-{{ section.id }} .ma-atelier__cta::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0%;
    height: 1px;
    background: currentColor;
    transition: width {{ section.settings.underline_duration | default: 250 }}ms ease-out;
  }
  #shopify-section-{{ section.id }} .ma-atelier__cta:hover {
    color: {{ section.settings.cta_hover_color }};
  }
  {% if section.settings.enable_motion and section.settings.enable_cta_hover %}
    #shopify-section-{{ section.id }} .ma-atelier__cta:hover::after {
      width: 100%;
    }
    #shopify-section-{{ section.id }} .ma-atelier__cta-arrow {
      transition: transform {{ section.settings.underline_duration | default: 250 }}ms ease-out;
    }
    #shopify-section-{{ section.id }} .ma-atelier__cta:hover .ma-atelier__cta-arrow {
      transform: translateX({{ section.settings.arrow_slide_distance | default: 4 }}px);
    }
  {% endif %}

  /* ══════════════════════════════════════════════════════════════
     MOBILE EDITORIAL LAYOUT EXPANSION (< 750px)
     Strictly encapsulated to mobile screens. Zero impact on desktop.
  ══════════════════════════════════════════════════════════════ */
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .ma-atelier__wrapper {
      display: flex;
      flex-direction: column;
    }
    #shopify-section-{{ section.id }} .ma-atelier--mobile-01 .ma-atelier__content-col {
      order: 1;
    }
    #shopify-section-{{ section.id }} .ma-atelier--mobile-01 .ma-atelier__media-col {
      order: 2;
    }
    #shopify-section-{{ section.id }} .ma-atelier--mobile-01 .ma-atelier__media {
      transform: translateY({{ section.settings.mobile_story_top_offset | default: 0 }}px);
    }
    
    #shopify-section-{{ section.id }} .ma-atelier--mobile-02 .ma-atelier__media-col {
      order: 1;
    }
    #shopify-section-{{ section.id }} .ma-atelier--mobile-02 .ma-atelier__content-col {
      order: 2;
    }
    #shopify-section-{{ section.id }} .ma-atelier--mobile-02 .ma-atelier__media {
      height: {{ section.settings.mobile_image_height_portrait | default: 360 }}px;
      margin-bottom: {{ section.settings.mobile_image_bottom_spacing | default: 24 }}px;
    }
    #shopify-section-{{ section.id }} .ma-atelier--mobile-02 .ma-atelier__media img {
      object-position: center {{ section.settings.mobile_image_position | default: 'center' }};
    }
  }

  /* ---------- Desktop: two-column editorial split layout ---------- */
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .ma-atelier {
      min-height: {{ section.settings.section_height }}px;
      display: flex;
      align-items: {% case section.settings.text_position_y %}{% when 'top' %}flex-start{% when 'bottom' %}flex-end{% else %}center{% endcase %};
      justify-content: flex-start;
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
    
    #shopify-section-{{ section.id }} .ma-atelier__wrapper {
      display: flex;
      width: 100%;
      height: 100%;
      min-height: {{ section.settings.section_height }}px;
      position: relative;
    }

    #shopify-section-{{ section.id }} .ma-atelier__content-col {
      width: {{ section.settings.content_width | default: 42 }}%;
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      justify-content: {% case section.settings.text_position_y %}{% when 'top' %}flex-start{% when 'bottom' %}flex-end{% else %}center{% endcase %};
      padding: 0 {{ section.settings.content_padding_desktop }}px;
      position: relative;
      z-index: 2;
      transform: translate({{ section.settings.content_offset_x | default: 0 }}px, {{ section.settings.content_offset_y | default: 0 }}px);
    }

    #shopify-section-{{ section.id }} .ma-atelier__media-col {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .ma-atelier__media {
      position: absolute;
      inset: -15%;
      height: 130%;
      width: 130%;
      will-change: transform;
    }

    #shopify-section-{{ section.id }} .ma-atelier__fade {
      {% if section.settings.fade_blur > 0 %}
        filter: blur({{ section.settings.fade_blur }}px);
        -webkit-filter: blur({{ section.settings.fade_blur }}px);
      {% endif %}
      background: linear-gradient(
        to {% if section.settings.fade_direction == 'left' %}right{% else %}left{% endif %},
        {{ section.settings.fade_color }} 0%,
        transparent {{ section.settings.fade_strength }}%
      );
      width: {{ section.settings.fade_width | default: 600 }}px;
      height: 100%;
      transform: translateX({{ section.settings.fade_position | default: 0 }}px);
      -webkit-mask-image: linear-gradient(to {% if section.settings.fade_direction == 'left' %}right{% else %}left{% endif %}, black 0%, transparent 100%);
      mask-image: linear-gradient(to {% if section.settings.fade_direction == 'left' %}right{% else %}left{% endif %}, black 0%, transparent 100%);
    }

    #shopify-section-{{ section.id }} .ma-atelier__content {
      position: relative;
      z-index: 2;
      width: 100%;
      max-width: {{ section.settings.content_max_width }}px;
      margin-top: 0;
      padding: 0;
      text-align: {{ section.settings.content_alignment | default: 'left' }};
    }

    #shopify-section-{{ section.id }} .ma-atelier__label {
      font-size: {{ section.settings.label_size }}px;
      margin-bottom: {{ section.settings.label_bottom_margin | default: section.settings.content_spacing }}px;
    }
    #shopify-section-{{ section.id }} .ma-atelier__headline {
      font-size: {{ section.settings.headline_size }}px;
      max-width: {{ section.settings.headline_max_width }}px;
      margin-bottom: {{ section.settings.heading_bottom_margin | default: section.settings.content_spacing }}px;
    }
    #shopify-section-{{ section.id }} .ma-atelier__paragraph {
      font-size: {{ section.settings.paragraph_size }}px;
      max-width: {{ section.settings.paragraph_max_width }}px;
      margin-bottom: {{ section.settings.paragraph_bottom_margin | default: section.settings.content_spacing }}px;
    }
    #shopify-section-{{ section.id }} .ma-atelier__cta {
      margin-top: {{ section.settings.cta_top_margin | default: 0 }}px;
    }
  }

  /* Accessibility & Reduced Motion Support */
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .ma-atelier__label,
    #shopify-section-{{ section.id }} .ma-atelier__headline,
    #shopify-section-{{ section.id }} .ma-atelier__paragraph,
    #shopify-section-{{ section.id }} .ma-atelier__cta {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    #shopify-section-{{ section.id }} .ma-atelier__media img {
      transform: scale({{ section.settings.image_scale | times: 1.0 | divided_by: 100 }}) translate({{ section.settings.image_offset_x | default: 0 }}px, {{ section.settings.image_offset_y | default: 0 }}px) !important;
      transition: none !important;
    }
    #shopify-section-{{ section.id }} .ma-atelier__media {
      transform: none !important;
    }
  }
{% endstyle %}

<section class="ma-atelier{% unless section.settings.enable_motion %} is-revealed{% endunless %} ma-atelier--mobile-{{ section.settings.mobile_layout_style | default: '01' }}" id="atelier-section-{{ section.id }}">
  <div class="ma-atelier__wrapper">
    <div class="ma-atelier__content-col">
      <div class="ma-atelier__content">
        {%- if section.settings.label != blank -%}
          <p class="ma-atelier__label">{{ section.settings.label }}</p>
        {%- endif -%}

        {%- if section.settings.headline != blank -%}
          <h2 class="ma-atelier__headline">{{ section.settings.headline }}</h2>
        {%- endif -%}

        {%- if section.settings.paragraph != blank -%}
          <p class="ma-atelier__paragraph">{{ section.settings.paragraph }}</p>
        {%- endif -%}

        {%- if section.settings.cta_text != blank -%}
          <a class="ma-atelier__cta" href="{{ section.settings.cta_link | default: '#' }}">
            <span>{{ section.settings.cta_text }}</span>
            <span class="ma-atelier__cta-arrow">→</span>
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="ma-atelier__media-col">
      <div class="ma-atelier__media" id="atelier-media-{{ section.id }}">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1800 }}"
            alt="{{ section.settings.image.alt | default: section.settings.headline | escape }}"
            loading="lazy"
          >
        {%- endif -%}
        <div class="ma-atelier__overlay"></div>
        <div class="ma-atelier__fade"></div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const sectionEl = document.getElementById("atelier-section-{{ section.id }}");
    if (!sectionEl) return;

    {% if section.settings.enable_motion %}
      // 1. Text Reveal Observer
      {% if section.settings.enable_text_reveal %}
        const observerOptions = {
          root: null,
          threshold: 0.15
        };

        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              sectionEl.classList.add("is-revealed");
              observer.unobserve(entry.target);
            }
          });
        }, observerOptions);

        revealObserver.observe(sectionEl);
      {% else %}
        sectionEl.classList.add("is-revealed");
      {% endif %}

      // 2. Parallax Scroll
      {% if section.settings.parallax_strength > 0 %}
        const mediaCol = sectionEl.querySelector(".ma-atelier__media");
        if (mediaCol && window.innerWidth >= 750) {
          const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          
          if (!prefersReducedMotion) {
            let ticking = false;
            const pStrength = {{ section.settings.parallax_strength | default: 12 }};

            function updateParallax() {
              const rect = sectionEl.getBoundingClientRect();
              const windowHeight = window.innerHeight;

              if (rect.top <= windowHeight && rect.bottom >= 0) {
                const scrollProgress = (windowHeight - rect.top) / (windowHeight + rect.height);
                const yOffset = (scrollProgress - 0.5) * (pStrength * 6.67);
                mediaCol.style.transform = `translate3d(0, ${yOffset.toFixed(2)}px, 0)`;
              }
              ticking = false;
            }

            window.addEventListener("scroll", function () {
              if (!ticking) {
                window.requestAnimationFrame(updateParallax);
                ticking = true;
              }
            }, { passive: true });

            updateParallax();
          }
        }
      {% endif %}
    {% else %}
      sectionEl.classList.add("is-revealed");
    {% endif %}
  });
</script>

{% schema %}
{
  "name": "MA Atelier Editorial",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Motion & Interactions"
    },
    { "type": "checkbox", "id": "enable_motion", "label": "Enable Motion", "default": true },
    { "type": "range", "id": "parallax_strength", "label": "Parallax Strength", "min": 0, "max": 25, "step": 1, "default": 12 },
    { "type": "checkbox", "id": "enable_text_reveal", "label": "Enable Text Reveal", "default": true },
    { "type": "range", "id": "reveal_distance", "label": "Reveal Distance", "min": 0, "max": 40, "step": 1, "default": 18, "unit": "px" },
    { "type": "range", "id": "reveal_duration", "label": "Reveal Duration", "min": 0.4, "max": 1.5, "step": 0.1, "default": 0.9, "unit": "s" },
    { "type": "range", "id": "stagger_delay", "label": "Element Stagger Delay", "min": 0, "max": 200, "step": 10, "default": 80, "unit": "ms" },
    { "type": "checkbox", "id": "enable_image_hover_zoom", "label": "Enable Image Hover Zoom", "default": true },
    { "type": "range", "id": "hover_scale", "label": "Image Hover Scale", "min": 100, "max": 108, "step": 1, "default": 103, "unit": "%" },
    { "type": "range", "id": "hover_duration", "label": "Image Hover Duration", "min": 200, "max": 1500, "step": 50, "default": 800, "unit": "ms" },
    { "type": "checkbox", "id": "enable_cta_hover", "label": "Enable CTA Hover Animation", "default": true },
    { "type": "range", "id": "arrow_slide_distance", "label": "Arrow Slide Distance", "min": 0, "max": 10, "step": 1, "default": 4, "unit": "px" },
    { "type": "range", "id": "underline_duration", "label": "Underline Duration", "min": 100, "max": 600, "step": 10, "default": 250, "unit": "ms" },

    {
      "type": "header",
      "content": "Content"
    },
    { "type": "text", "id": "label", "label": "Label", "default": "THE ATELIER" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Perfume is the most intense form of memory." },
    { "type": "textarea", "id": "paragraph", "label": "Paragraph", "default": "Each Maison Amiir fragrance is crafted in limited batches at extrait concentration — every drop carrying the weight of its intention. Luxury, made to be lived in rather than locked away." },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "OUR STORY" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },

    {
      "type": "header",
      "content": "Image Controls"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_sizing", "label": "Image sizing", "default": "cover", "options": [
      { "value": "cover", "label": "Cover (fill, crop)" },
      { "value": "contain", "label": "Contain (fit, no crop)" }
    ]},
    { "type": "range", "id": "image_scale", "label": "Image scale", "min": 100, "max": 160, "step": 2, "default": 100, "unit": "%" },
    { "type": "select", "id": "image_zoom_origin", "label": "Image Zoom Origin", "default": "center", "options": [
      { "value": "center", "label": "Center" },
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" },
      { "value": "top", "label": "Top" },
      { "value": "bottom", "label": "Bottom" }
    ]},
    { "type": "range", "id": "image_position_x", "label": "Image focal point — X", "min": 0, "max": 100, "step": 5, "default": 50, "unit": "%" },
    { "type": "range", "id": "image_position_y", "label": "Image focal point — Y", "min": 0, "max": 100, "step": 5, "default": 50, "unit": "%" },
    { "type": "range", "id": "image_offset_x", "label": "Image Offset X", "min": -250, "max": 250, "step": 10, "default": 0, "unit": "px" },
    { "type": "range", "id": "image_offset_y", "label": "Image Offset Y", "min": -250, "max": 250, "step": 10, "default": 0, "unit": "px" },
    { "type": "range", "id": "image_opacity", "label": "Image opacity", "min": 40, "max": 100, "step": 5, "default": 100, "unit": "%" },
    { "type": "paragraph", "content": "Image Safe Area Preview: Adjust focal point and offsets above to maintain primary visual subjects within the safe crop zone." },

    {
      "type": "header",
      "content": "Fade Controls"
    },
    { "type": "range", "id": "fade_width", "label": "Fade Width", "min": 100, "max": 900, "step": 50, "default": 600, "unit": "px" },
    { "type": "range", "id": "fade_blur", "label": "Fade Blur", "min": 0, "max": 300, "step": 10, "default": 0, "unit": "px" },
    { "type": "range", "id": "fade_position", "label": "Fade Position", "min": -200, "max": 200, "step": 10, "default": 0, "unit": "px" },
    { "type": "range", "id": "fade_strength", "label": "Fade strength (desktop, side)", "min": 0, "max": 100, "step": 5, "default": 70, "unit": "%" },
    { "type": "range", "id": "mobile_fade_strength", "label": "Fade strength (mobile, bottom)", "min": 0, "max": 100, "step": 5, "default": 60, "unit": "%" },
    { "type": "color", "id": "fade_color", "label": "Fade color", "default": "#0c0b0a" },
    { "type": "select", "id": "fade_direction", "label": "Desktop fade direction", "default": "left", "options": [
      { "value": "left", "label": "Text on left — fade from left" },
      { "value": "right", "label": "Text on right — fade from right" }
    ]},

    {
