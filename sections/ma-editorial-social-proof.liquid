{%- comment -%}
  MAISON AMIIR — Editorial Social Proof Section
  Preserves 100% of existing Judge.me review logic, auto-fetching, and rotation.
  Transforms presentation into a Celine / MFK luxury fashion house editorial spread.
  FIXED: Active auto-rotation loop restored with manual pause/reset on arrow clicks.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign accent_color = section.settings.accent_color
  assign fade_color = section.settings.fade_color

  if section.settings.color_preset == 'ivory'
    assign bg_color = '#f8f6f0'
    assign text_color = '#1a1510'
    assign accent_color = '#a8894e'
    assign fade_color = '#f8f6f0'
  elsif section.settings.color_preset == 'noir'
    assign bg_color = '#0c0b0a'
    assign text_color = '#f5f0e6'
    assign accent_color = '#d4af37'
    assign fade_color = '#0c0b0a'
  elsif section.settings.color_preset == 'editorial'
    assign bg_color = '#ffffff'
    assign text_color = '#111111'
    assign accent_color = '#888888'
    assign fade_color = '#ffffff'
  endif
-%}

{%- style -%}
  {{ section.settings.eyebrow_font | font_face: font_display: 'swap' }}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.sub_font | font_face: font_display: 'swap' }}
  {{ section.settings.quote_font | font_face: font_display: 'swap' }}
  {{ section.settings.meta_font | font_face: font_display: 'swap' }}
{%- endstyle -%}

<style>
/* ═══════════════════════════════════════════════
   RESET & BASE
═══════════════════════════════════════════════ */
#shopify-section-{{ sid }} { opacity: 1 !important; transform: none !important; }

#shopify-section-{{ sid }} .ma-esp {
  position: relative;
  background: {{ bg_color }};
  color: {{ text_color }};
  overflow: hidden;
  margin-top: {{ section.settings.margin_top }}px;
  margin-bottom: {{ section.settings.margin_bottom }}px;
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
}
#shopify-section-{{ sid }} .ma-esp *,
#shopify-section-{{ sid }} .ma-esp *::before,
#shopify-section-{{ sid }} .ma-esp *::after { box-sizing: border-box; }

/* ═══════════════════════════════════════════════
   LEFT IMAGE PANEL & FADE ENGINE
═══════════════════════════════════════════════ */
#shopify-section-{{ sid }} .ma-esp__visual {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}
#shopify-section-{{ sid }} .ma-esp__img {
  width: 100%;
  height: 100%;
  object-fit: {{ section.settings.image_fit }};
  object-position: {{ section.settings.focal_x }}% {{ section.settings.focal_y }}%;
  display: block;
  transform: scale({{ section.settings.image_scale | divided_by: 100.0 }});
  opacity: {{ section.settings.image_opacity | divided_by: 100.0 }};
  filter: brightness({{ section.settings.image_brightness | divided_by: 100.0 }}) contrast({{ section.settings.image_contrast | divided_by: 100.0 }}) saturate({{ section.settings.image_saturation | divided_by: 100.0 }});
  transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
}
#shopify-section-{{ sid }} .ma-esp__fade {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 2;
  background: linear-gradient(to right, transparent {{ 100 | minus: section.settings.fade_strength }}%, {{ fade_color }} 100%);
}
#shopify-section-{{ sid }} .ma-esp__overlay {
  position: absolute;
  inset: 0;
  background: {{ section.settings.overlay_color }};
  opacity: {{ section.settings.overlay_strength | divided_by: 100.0 }};
  pointer-events: none;
  z-index: 1;
}

/* ═══════════════════════════════════════════════
   TYPOGRAPHY HIERARCHY (COMPACT SPACING)
═══════════════════════════════════════════════ */
#shopify-section-{{ sid }} .ma-esp__eyebrow {
  font-family: {{ section.settings.eyebrow_font.family }}, sans-serif;
  font-size: {{ section.settings.eyebrow_size }}px;
  font-weight: {{ section.settings.eyebrow_weight }};
  letter-spacing: {{ section.settings.eyebrow_spacing }}px;
  text-transform: uppercase;
  color: {{ accent_color }};
  display: block;
  margin-bottom: 12px;
}
#shopify-section-{{ sid }} .ma-sproof__h2.ma-esp__heading {
  font-family: {{ section.settings.heading_font.family }}, serif;
  font-size: {{ section.settings.heading_size }}px;
  font-weight: {{ section.settings.heading_weight }};
  letter-spacing: {{ section.settings.heading_spacing }}px;
  line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
  color: {{ text_color }};
  margin: 0 0 12px;
}
#shopify-section-{{ sid }} .ma-esp__divider-vert {
  width: 1px;
  height: 24px;
  background: {{ accent_color }};
  opacity: 0.4;
  margin: 0 auto 12px;
}
#shopify-section-{{ sid }} .ma-sproof__sub.ma-esp__subline {
  font-family: {{ section.settings.sub_font.family }}, serif;
  font-size: {{ section.settings.sub_size }}px;
  font-weight: {{ section.settings.sub_weight }};
  font-style: italic;
  letter-spacing: 0;
  text-transform: none;
  color: {{ text_color }};
  opacity: 0.85;
  margin: 0 0 20px;
}

/* ═══════════════════════════════════════════════
   LOCKED REVIEW STAGE (GENEROUS HEIGHT - ZERO CLIPPING)
═══════════════════════════════════════════════ */
#shopify-section-{{ sid }} .ma-sproof__grid.ma-esp__grid {
  display: grid !important;
  grid-template-columns: 1fr !important;
  max-width: 680px !important;
  margin: 0 auto !important;
  gap: 0 !important;
  position: relative !important;
  height: {{ section.settings.stage_height }}px !important;
  min-height: {{ section.settings.stage_height }}px !important;
  max-height: {{ section.settings.stage_height }}px !important;
  overflow: hidden !important;
  align-items: center !important;
}

/* Strip borders & boxes, style as clean editorial quote */
#shopify-section-{{ sid }} .ma-sproof__card {
  border: none !important;
  background: transparent !important;
  box-shadow: none !important;
  padding: 0 !important;
  margin: 0 auto !important;
  width: 100% !important;
  max-width: 640px !important;
  height: 100% !important;
  text-align: center !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;
  transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1) !important;
}

/* Stars styling */
#shopify-section-{{ sid }} .ma-sproof__stars {
  font-size: 14px !important;
  letter-spacing: 4px !important;
  color: {{ accent_color }} !important;
  margin-bottom: 10px !important;
  line-height: 1 !important;
  flex: 0 0 auto !important;
}

/* Review Title styling */
#shopify-section-{{ sid }} .ma-sproof__title {
  font-family: {{ section.settings.meta_font.family }}, sans-serif !important;
  font-size: 13px !important;
  font-weight: 600 !important;
  letter-spacing: 0.16em !important;
  text-transform: uppercase !important;
  color: {{ text_color }} !important;
  margin: 0 0 14px !important;
  line-height: 1.4 !important;
  flex: 0 0 auto !important;
}

/* ── OVERSIZED ARCHITECTURAL GOLD INVERTED COMMAS ── */
#shopify-section-{{ sid }} .ma-sproof__quote {
  position: relative !important;
  font-family: {{ section.settings.quote_font.family }}, serif !important;
  font-size: {{ section.settings.quote_size }}px !important;
  font-weight: {{ section.settings.quote_weight }} !important;
  font-style: italic !important;
  line-height: {{ section.settings.quote_line_height | divided_by: 100.0 }} !important;
  color: {{ text_color }} !important;
  margin: 0 auto 24px !important;
  max-width: 580px !important;
  border: none !important;
  padding: 0 24px !important;
  flex: 0 1 auto !important;
  /* Line clamp ensures long reviews never push the author thumbnail out of frame */
  display: -webkit-box !important;
  -webkit-line-clamp: 4 !important;
  -webkit-box-orient: vertical !important;
  overflow: hidden !important;
}

/* Upper-left oversized gold quote */
#shopify-section-{{ sid }} .ma-sproof__quote::before {
  content: '“';
  position: absolute;
  top: -18px;
  left: -14px;
  font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
  font-size: 56px;
  font-style: normal;
  font-weight: 400;
  line-height: 1;
  color: {{ accent_color }};
  opacity: 0.85;
  pointer-events: none;
}

/* Bottom-right oversized gold quote */
#shopify-section-{{ sid }} .ma-sproof__quote::after {
  content: '”';
  position: relative;
  display: inline-block;
  margin-left: 6px;
  top: 10px;
  font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
  font-size: 56px;
  font-style: normal;
  font-weight: 400;
  line-height: 0.4;
  color: {{ accent_color }};
  opacity: 0.85;
  pointer-events: none;
}

/* Footer / Product Thumbnail styling (FLEX-PROTECTED AGAINST CLIPPING) */
#shopify-section-{{ sid }} .ma-sproof__foot {
  border-top: none !important;
  padding-top: 0 !important;
  margin-top: 0 !important;
  display: flex !important;
  justify-content: center !important;
  width: 100% !important;
  flex: 0 0 auto !important;
}
#shopify-section-{{ sid }} .ma-sproof__prod {
  display: inline-flex !important;
  align-items: center !important;
  gap: 14px !important;
  text-decoration: none !important;
}
#shopify-section-{{ sid }} .ma-sproof__prod-img {
  width: 44px !important;
  height: 44px !important;
  object-fit: cover !important;
  border-radius: 4px !important;
  box-shadow: 0 4px 14px rgba(0,0,0,0.12) !important;
  display: block !important;
  flex-shrink: 0 !important;
}
#shopify-section-{{ sid }} .ma-sproof__prod-meta {
  text-align: left !important;
  flex-shrink: 0 !important;
}
#shopify-section-{{ sid }} .ma-sproof__attr {
  display: block !important;
  font-family: {{ section.settings.meta_font.family }}, sans-serif !important;
  font-size: {{ section.settings.meta_size }}px !important;
  font-weight: 600 !important;
  letter-spacing: 0.18em !important;
  text-transform: uppercase !important;
  color: {{ accent_color }} !important;
  margin-bottom: 2px !important;
}
#shopify-section-{{ sid }} .ma-sproof__prod-title {
  display: block !important;
  font-family: {{ section.settings.meta_font.family }}, sans-serif !important;
  font-size: {{ section.settings.meta_size | minus: 2 }}px !important;
  font-weight: 400 !important;
  letter-spacing: 0.12em !important;
  text-transform: uppercase !important;
  color: {{ text_color }} !important;
  opacity: 0.7 !important;
  border-bottom: 1px solid transparent !important;
  padding-bottom: 1px !important;
  margin-top: 0 !important;
  transition: border-color 0.3s ease !important;
}
#shopify-section-{{ sid }} .ma-sproof__prod:hover .ma-sproof__prod-title {
  border-color: {{ text_color }} !important;
}

/* ── PRESERVED JS ROTATION STATES ── */
#shopify-section-{{ sid }} .ma-sproof__card:nth-child(n+2) { display: none !important; }
#shopify-section-{{ sid }} .ma-sproof__grid.ma-sproof--js .ma-sproof__card { display: none !important; opacity: 0; transform: translateY(12px); }

/* Allow active card to display immediately */
#shopify-section-{{ sid }} .ma-sproof__grid.ma-sproof--js .ma-sproof__card.is-live {
  display: flex !important;
  opacity: 1;
  transform: none;
}
/* Guarantee only the first active card shows if JS activates multiple */
#shopify-section-{{ sid }} .ma-sproof__grid.ma-sproof--js .ma-sproof__card.is-live ~ .ma-sproof__card.is-live {
  display: none !important;
}
#shopify-section-{{ sid }} .ma-sproof__grid.ma-sproof--js .ma-sproof__card.is-out {
  display: flex !important;
  opacity: 0;
  transform: translateY(-12px);
  position: absolute !important;
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
}

/* ═══════════════════════════════════════════════
   MANUAL NAVIGATION ARROWS & DOTS
═══════════════════════════════════════════════ */
#shopify-section-{{ sid }} .ma-esp__nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32px;
  margin-top: 16px;
  z-index: 10;
  position: relative;
}
#shopify-section-{{ sid }} .ma-esp__arrow {
  background: transparent;
  border: none;
  color: {{ accent_color }};
  font-size: 20px;
  cursor: pointer;
  padding: 8px 14px;
  transition: opacity 0.3s ease, transform 0.3s ease;
  user-select: none;
}
#shopify-section-{{ sid }} .ma-esp__arrow:hover {
  opacity: 0.6;
  transform: scale(1.15);
}
#shopify-section-{{ sid }} .ma-esp__dots {
  display: flex;
  gap: 10px;
  align-items: center;
}
#shopify-section-{{ sid }} .ma-esp__dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: transparent;
  border: 1px solid {{ accent_color }};
  padding: 0;
  cursor: pointer;
  transition: background 0.3s ease, transform 0.3s ease;
}
#shopify-section-{{ sid }} .ma-esp__dot.is-active {
  background: {{ accent_color }};
  transform: scale(1.3);
}

/* ═══════════════════════════════════════════════
   ████████████████  DESKTOP  ████████████████
═══════════════════════════════════════════════ */
@media (min-width: 750px) {
  #shopify-section-{{ sid }} .ma-esp__inner {
    display: grid;
    grid-template-columns: {{ section.settings.image_col_width }}% {{ 100 | minus: section.settings.image_col_width }}%;
    height: {{ section.settings.desktop_height }}px;
    max-height: {{ section.settings.desktop_height }}px;
    max-width: {{ section.settings.dt_max_width }}px;
    margin: 0 auto;
    align-items: center;
    overflow: hidden;
  }
  #shopify-section-{{ sid }} .ma-esp__visual {
    height: {{ section.settings.desktop_height }}px;
  }
  #shopify-section-{{ sid }} .ma-esp__content {
    padding: {{ section.settings.dt_pad_top }}px {{ section.settings.dt_pad_right }}px {{ section.settings.dt_pad_bottom }}px {{ section.settings.dt_pad_left }}px;
    text-align: center;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: {{ section.settings.desktop_height }}px;
  }
}

/* ═══════════════════════════════════════════════
   ████████████████  MOBILE  ████████████████
═══════════════════════════════════════════════ */
@media (max-width: 749px) {
  #shopify-section-{{ sid }} .ma-esp__inner {
    display: flex;
    flex-direction: column;
  }
  #shopify-section-{{ sid }} .ma-esp__visual {
    width: 100%;
    height: {{ section.settings.mob_img_height }}px;
    flex: 0 0 auto;
  }
  #shopify-section-{{ sid }} .ma-esp__fade {
    background: linear-gradient(to bottom, transparent {{ 100 | minus: section.settings.fade_strength }}%, {{ fade_color }} 100%);
  }
  #shopify-section-{{ sid }} .ma-esp__content {
    padding: {{ section.settings.mob_pad_top }}px {{ section.settings.mob_pad_h }}px {{ section.settings.mob_pad_bottom }}px;
    text-align: center;
    margin-top: -20px;
    z-index: 3;
  }
  #shopify-section-{{ sid }} .ma-esp__eyebrow { font-size: {{ section.settings.mob_eyebrow_size }}px; }
  #shopify-section-{{ sid }} .ma-sproof__h2.ma-esp__heading { font-size: {{ section.settings.mob_heading_size }}px; }
  #shopify-section-{{ sid }} .ma-sproof__sub.ma-esp__subline { font-size: {{ section.settings.mob_sub_size }}px; margin-bottom: 20px; }
  #shopify-section-{{ sid }} .ma-sproof__grid.ma-esp__grid {
    height: {{ section.settings.mob_stage_height }}px !important;
    min-height: {{ section.settings.mob_stage_height }}px !important;
    max-height: {{ section.settings.mob_stage_height }}px !important;
  }
  #shopify-section-{{ sid }} .ma-sproof__quote { 
    font-size: {{ section.settings.mob_quote_size }}px !important;
    padding: 0 16px !important;
  }
  #shopify-section-{{ sid }} .ma-sproof__quote::before {
    font-size: 42px;
    top: -14px;
    left: -6px;
  }
  #shopify-section-{{ sid }} .ma-sproof__quote::after {
    font-size: 42px;
    top: 8px;
    margin-left: 4px;
  }
  #shopify-section-{{ sid }} .ma-sproof__attr { font-size: {{ section.settings.mob_meta_size }}px; }
}
</style>

<!-- ── PRESERVED HTML STRUCTURE FOR ma-social-proof.js ── -->
<div class="ma-sproof ma-esp" id="ma-esp-{{ sid }}">
  <div class="ma-esp__inner">
    
    <!-- LEFT IMAGE PANEL -->
    <div class="ma-esp__visual">
      <div class="ma-esp__overlay"></div>
      <div class="ma-esp__fade"></div>
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.heading, class: 'ma-esp__img' }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'ma-esp__img' }}
      {%- endif -%}
    </div>

    <!-- RIGHT CONTENT AREA -->
    <div class="ma-esp__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="ma-esp__eyebrow ma-home-reveal">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}

      <h2 class="ma-sproof__h2 ma-esp__heading ma-home-reveal">{{ section.settings.heading }}</h2>

      <div class="ma-esp__divider-vert ma-home-reveal"></div>

      {%- if section.settings.subline != blank -%}
        <p class="ma-sproof__sub ma-esp__subline ma-home-reveal">{{ section.settings.subline | escape }}</p>
      {%- endif -%}

      <!-- EXACT PRESERVED GRID AND CARDS FOR ma-social-proof.js -->
      <div class="ma-sproof__grid ma-esp__grid" id="ma-sproof-grid-{{ section.id }}">
        {%- for block in section.blocks -%}
          <figure class="ma-sproof__card ma-home-reveal{% if forloop.first %} is-live is-active{% endif %}" {{ block.shopify_attributes }}>
            <div class="ma-sproof__stars" aria-label="{{ block.settings.stars }} out of 5 stars">
              {%- assign full = block.settings.stars -%}
              {%- for i in (1..5) -%}{%- if i <= full -%}★{%- else -%}☆{%- endif -%}{%- endfor -%}
            </div>
            {%- if block.settings.heading != blank -%}
              <p class="ma-sproof__title">{{ block.settings.heading }}</p>
            {%- endif -%}
            
            <blockquote class="ma-sproof__quote">{{ block.settings.quote }}</blockquote>
            
            <figcaption class="ma-sproof__foot">
              {%- assign prod = block.settings.product -%}
              {%- if prod != blank -%}
                <a class="ma-sproof__prod" href="{{ prod.url }}">
                  {%- if prod.featured_image -%}
                    {{ prod.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: prod.title, class: 'ma-sproof__prod-img', width: 48, height: 48 }}
                  {%- endif -%}
                  <span class="ma-sproof__prod-meta">
                    <span class="ma-sproof__attr">{{ block.settings.author }}</span>
                    <span class="ma-sproof__prod-title">{{ prod.title }}</span>
                  </span>
                </a>
              {%- else -%}
                <span class="ma-sproof__attr">{{ block.settings.author }}</span>
              {%- endif -%}
            </figcaption>
          </figure>
        {%- endfor -%}
      </div>

      <!-- MANUAL NAVIGATION ARROWS & DOTS -->
      <div class="ma-esp__nav">
        <button class="ma-esp__arrow ma-esp__arrow--prev" aria-label="Previous review">&#8592;</button>
        <div class="ma-esp__dots" id="ma-esp-dots-{{ sid }}"></div>
        <button class="ma-esp__arrow ma-esp__arrow--next" aria-label="Next review">&#8594;</button>
      </div>

    </div>
  </div>
</div>

<!-- EXTERNAL SCRIPT PRESERVED FOR AUTO-FETCHING AND ROTATION -->
<script src="{{ 'ma-social-proof.js' | asset_url }}" defer></script>

<!-- NAVIGATION CONTROLLER, AUTO-ROTATION & INLINE QUOTE STRIPPER -->
<script>
(function() {
  var sec = document.getElementById('ma-esp-{{ sid }}');
  if (!sec) return;

  var grid = document.getElementById('ma-sproof-grid-{{ section.id }}');
  var dotsWrap = document.getElementById('ma-esp-dots-{{ sid }}');
  var prevBtn = sec.querySelector('.ma-esp__arrow--prev');
  var nextBtn = sec.querySelector('.ma-esp__arrow--next');

  var cards = [];
  var dots = [];
  var currentIndex = 0;
  var timer = null;
  var speed = {{ section.settings.rotate_seconds | default: 6 | times: 1000 }};

  function stripInlineQuotes() {
    var quotes = sec.querySelectorAll('.ma-sproof__quote');
    quotes.forEach(function(el) {
      var txt = el.innerHTML.trim();
      txt = txt.replace(/^(&ldquo;|&quot;|“|"|‘|')\s*/i, '');
      txt = txt.replace(/\s*(&rdquo;|&quot;|”|"|’|')$/i, '');
      if (el.innerHTML !== txt) el.innerHTML = txt;
    });
  }

  function initNav() {
    if (!grid) return;
    stripInlineQuotes();
    cards = Array.from(grid.querySelectorAll('.ma-sproof__card'));
    if (cards.length < 2) {
      if (sec.querySelector('.ma-esp__nav')) sec.querySelector('.ma-esp__nav').style.display = 'none';
      return;
    }

    if (dotsWrap && dotsWrap.children.length === 0) {
      cards.forEach(function(_, idx) {
        var btn = document.createElement('button');
        btn.className = 'ma-esp__dot' + (idx === 0 ? ' is-active' : '');
        btn.setAttribute('aria-label', 'Go to review ' + (idx + 1));
        btn.addEventListener('click', function() { clearInterval(timer); goToSlide(idx); startAuto(); });
        dotsWrap.appendChild(btn);
        dots.push(btn);
      });
    } else if (dotsWrap) {
      dots = Array.from(dotsWrap.querySelectorAll('.ma-esp__dot'));
    }
    startAuto();
  }

  function goToSlide(idx) {
    if (!cards.length) initNav();
    if (!cards.length) return;

    currentIndex = (idx + cards.length) % cards.length;

    cards.forEach(function(card, i) {
      if (i === currentIndex) {
        card.classList.add('is-live', 'is-active');
        card.classList.remove('is-out');
        card.style.setProperty('display', 'flex', 'important');
        card.style.setProperty('opacity', '1', 'important');
        card.style.setProperty('transform', 'none', 'important');
        card.style.setProperty('position', 'relative', 'important');
      } else {
        card.classList.remove('is-live', 'is-active');
        card.classList.add('is-out');
        card.style.setProperty('display', 'none', 'important');
        card.style.setProperty('opacity', '0', 'important');
      }
    });

    dots.forEach(function(dot, i) {
      if (i === currentIndex) dot.classList.add('is-active');
      else dot.classList.remove('is-active');
    });
  }

  function next() { goToSlide(currentIndex + 1); }
  function prev() { goToSlide(currentIndex - 1); }

  function startAuto() {
    clearInterval(timer);
    if (speed > 0) {
      timer = setInterval(next, speed);
    }
  }

  if (prevBtn) prevBtn.addEventListener('click', function() { clearInterval(timer); prev(); startAuto(); });
  if (nextBtn) nextBtn.addEventListener('click', function() { clearInterval(timer); next(); startAuto(); });

  /* Background Observer: Keeps dots synchronized if external ma-social-proof.js modifies DOM */
  if (grid && 'MutationObserver' in window) {
    var mo = new MutationObserver(function() { stripInlineQuotes(); initNav(); });
    mo.observe(grid, { childList: true, subtree: true });
  }

  setTimeout(initNav, 400);
})();
</script>

