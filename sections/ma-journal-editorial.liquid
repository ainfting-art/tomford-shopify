    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Notes on Craft & Scent" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Thoughts on scent, craft and culture." },
    { "type": "range", "id": "heading_max_width", "label": "Heading Max Width", "min": 300, "max": 900, "step": 20, "default": 520, "unit": "px" },
    { "type": "textarea", "id": "editorial_description", "label": "Editorial Description", "default": "Exploring the world of fragrance through stories that inspire, inform and elevate the everyday." },
    { "type": "range", "id": "intro_content_width", "label": "Intro Content Width (Paragraph)", "min": 280, "max": 700, "step": 10, "default": 420, "unit": "px" },
    { "type": "select", "id": "editorial_alignment", "label": "Editorial Alignment", "default": "top", "options": [
      { "value": "top", "label": "Top (Align with Hero Image)" },
      { "value": "center", "label": "Center" },
      { "value": "bottom", "label": "Bottom" }
    ]},
    { "type": "range", "id": "editorial_intro_top_offset", "label": "Editorial Intro Top Offset", "min": -200, "max": 100, "step": 5, "default": 0, "unit": "px" },
    { "type": "range", "id": "intro_offset_x", "label": "Intro Horizontal Offset", "min": -200, "max": 200, "step": 10, "default": 0, "unit": "px" },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Explore the Journal" },
    { "type": "url", "id": "cta_link", "label": "CTA link (defaults to blog)" },
    { "type": "checkbox", "id": "cta_underline", "label": "Underline CTA", "default": true },
    { "type": "range", "id": "cta_underline_thickness", "label": "CTA Underline Thickness", "min": 1, "max": 4, "step": 1, "default": 1, "unit": "px" },
    { "type": "range", "id": "cta_hover_duration", "label": "CTA Hover Duration", "min": 100, "max": 800, "step": 50, "default": 650, "unit": "ms" },
    { "type": "select", "id": "cta_style", "label": "CTA Style", "default": "underline", "options": [
      { "value": "underline", "label": "Underline" },
      { "value": "underline_arrow", "label": "Underline + Arrow" },
      { "value": "arrow_only", "label": "Arrow Only" },
      { "value": "minimal", "label": "Minimal" }
    ]},
    { "type": "checkbox", "id": "enable_editorial_meta", "label": "Enable Editorial Metadata", "default": true },
    { "type": "text", "id": "meta_volume", "label": "Volume Label", "default": "Volume 01" },
    { "type": "text", "id": "meta_issue", "label": "Issue Label", "default": "Issue 04" },
    { "type": "text", "id": "meta_freq", "label": "Frequency Label", "default": "Updated Weekly" },

    {
      "type": "header",
      "content": "8. Editorial Scroll Animation"
    },
    { "type": "checkbox", "id": "enable_scroll_animation", "label": "Enable Scroll Animation", "default": true },
    { "type": "range", "id": "animation_strength", "label": "Animation Strength", "min": 0, "max": 80, "step": 2, "default": 50, "unit": "px" },
    { "type": "range", "id": "animation_smoothness", "label": "Animation Smoothness", "min": 0.1, "max": 0.5, "step": 0.1, "default": 0.1 },

    {
      "type": "header",
      "content": "2. Featured Story"
    },
    { "type": "range", "id": "featured_image_height", "label": "Featured Hero Image Height", "min": 280, "max": 600, "step": 10, "default": 420, "unit": "px" },
    { "type": "select", "id": "featured_image_ratio", "label": "Featured Image Ratio", "default": "landscape", "options": [
      { "value": "landscape", "label": "Landscape (16:9)" },
      { "value": "wide", "label": "Wide (21:9)" },
      { "value": "cinematic", "label": "Cinematic (2.35:1)" },
      { "value": "original", "label": "Original Aspect" }
    ]},
    { "type": "range", "id": "featured_title_max_width", "label": "Featured Title Max Width", "min": 400, "max": 900, "step": 10, "default": 720, "unit": "px" },
    { "type": "range", "id": "featured_content_width", "label": "Featured Content Width", "min": 300, "max": 700, "step": 10, "default": 520, "unit": "px" },
    { "type": "range", "id": "featured_image_bottom_spacing", "label": "Featured Image Bottom Spacing", "min": 10, "max": 80, "step": 2, "default": 32, "unit": "px" },
    { "type": "range", "id": "featured_image_radius", "label": "Featured Image Radius", "min": 0, "max": 30, "step": 2, "default": 10, "unit": "px" },
    { "type": "select", "id": "featured_content_position", "label": "Featured Content Position", "default": "center_left", "options": [
      { "value": "top_left", "label": "Top Left" },
