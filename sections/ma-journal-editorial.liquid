    { "type": "range", "id": "supporting_thumbnail_size", "label": "Supporting Thumbnail Size (Height)", "min": 80, "max": 180, "step": 5, "default": 140, "unit": "px" },
    { "type": "range", "id": "supporting_thumbnail_radius", "label": "Supporting Thumbnail Radius", "min": 0, "max": 30, "step": 2, "default": 12, "unit": "px" },
    { "type": "range", "id": "supporting_overlay_opacity", "label": "Bottom Image Overlay", "min": 0, "max": 80, "step": 5, "default": 10, "unit": "%" },
    { "type": "select", "id": "supporting_content_position", "label": "Bottom Content Position", "default": "top_left", "options": [
      { "value": "top_left", "label": "Top Left" },
      { "value": "center_left", "label": "Center Left" },
      { "value": "bottom_left", "label": "Bottom Left" }
    ]},

    {
      "type": "header",
      "content": "4. Typography"
