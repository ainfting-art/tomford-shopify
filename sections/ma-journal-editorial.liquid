    { "type": "range", "id": "featured_overlay_opacity", "label": "Featured Overlay Opacity", "min": 0, "max": 80, "step": 5, "default": 20, "unit": "%" },
    { "type": "color", "id": "featured_overlay_color", "label": "Featured Overlay Color", "default": "#000000" },
    { "type": "range", "id": "featured_pad_top", "label": "Featured Padding Top", "min": 0, "max": 100, "step": 5, "default": 35, "unit": "px" },
    { "type": "range", "id": "featured_pad_bot", "label": "Featured Padding Bottom", "min": 0, "max": 100, "step": 5, "default": 35, "unit": "px" },
