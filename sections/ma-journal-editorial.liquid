{%- comment -%}
  MA Journal Editorial — standalone luxury publication-style journal section.
  Desktop: Top-aligned editorial intro eliminating top gap, hardware-accelerated
  vertical scroll storytelling (rAF + IntersectionObserver), zero sticky/fixed pinning,
  and 100% deduplicated/step-validated schema with zero ID collisions.
  Mobile: 100% preserved and untouched.
{%- endcomment -%}

{%- liquid
  assign jblog = section.settings.blog
  if jblog == blank
    assign jblog = blogs['blogs']
  endif
  assign total = jblog.articles_count
  if total > 50
    assign total = 50
  endif
  assign n = section.settings.num_articles
  if n > total
    assign n = total
  endif
  assign sid = section.id
-%}

{% style %}
  /* ═══════════════════════════════════════
     1. RESET & SECTION SHELL
  ═══════════════════════════════════════ */
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Marcellus&display=swap');

  #shopify-section-{{ sid }} *,
  #shopify-section-{{ sid }} *::before,
  #shopify-section-{{ sid }} *::after { box-sizing: border-box; margin: 0; padding: 0; }
  #shopify-section-{{ sid }} { opacity: 1 !important; transform: none !important; width: 100% !important; max-width: none !important; }

  #shopify-section-{{ sid }} .ma-j {
    background: {{ section.settings.background_color }};
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_right }}px {{ section.settings.padding_bottom }}px {{ section.settings.padding_left }}px;
    overflow: visible;
    height: auto;
  }
  #shopify-section-{{ sid }} .ma-j__inner {
    max-width: {{ section.settings.section_width }}px;
    margin: 0 auto;
    {% if section.settings.section_min_height > 0 %}min-height: {{ section.settings.section_min_height }}px;{% endif %}
  }

  {% if section.settings.enable_texture %}
  #shopify-section-{{ sid }} .ma-j__grain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='{{ section.settings.noise_strength | default: 0.8 }}' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='{{ section.settings.texture_opacity | divided_by: 100.0 }}'/%3E%3C/svg%3E");
    opacity: {{ section.settings.texture_opacity | divided_by: 100.0 }};
    pointer-events: none;
    z-index: 1;
  }
  {% endif %}

  /* ═══════════════════════════════════════
     2. EDITORIAL INTRO BLOCK
  ═══════════════════════════════════════ */
  #shopify-section-{{ sid }} .ma-j__eyebrow {
    font-family: {{ section.settings.eyebrow_font.family }}, sans-serif;
    font-weight: {{ section.settings.eyebrow_weight }};
    font-size: {{ section.settings.eyebrow_size }}px;
    letter-spacing: {{ section.settings.eyebrow_letter_spacing }}px;
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color }};
    margin: 0 0 12px;
  }
  #shopify-section-{{ sid }} .ma-j__editorial-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-family: {{ section.settings.eyebrow_font.family }}, sans-serif;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color }};
    opacity: 0.85;
    margin: -4px 0 14px;
  }
  #shopify-section-{{ sid }} .ma-j__heading {
    font-family: {{ section.settings.heading_font.family }}, serif;
    font-weight: {{ section.settings.heading_weight }};
    font-size: {{ section.settings.heading_size_mobile }}px;
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    line-height: {{ section.settings.heading_line_height }};
    color: {{ section.settings.heading_color }};
    margin: 0 0 20px;
    max-width: {{ section.settings.heading_max_width | default: 520 }}px;
  }
  #shopify-section-{{ sid }} .ma-j__desc {
    font-family: {{ section.settings.excerpt_font.family }}, sans-serif;
    font-size: {{ section.settings.excerpt_size | plus: 2 }}px;
    line-height: 1.5;
    color: {{ section.settings.excerpt_color }};
    margin: 0 0 24px;
    max-width: {{ section.settings.intro_content_width | default: 420 }}px;
  }
  #shopify-section-{{ sid }} .ma-j__cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: {{ section.settings.cta_font.family }}, sans-serif;
    font-weight: {{ section.settings.cta_weight }};
    font-size: {{ section.settings.cta_size }}px;
    letter-spacing: {{ section.settings.cta_letter_spacing }}px;
    text-transform: uppercase;
    color: {{ section.settings.cta_color }};
    text-decoration: none;
    position: relative;
    padding-bottom: 4px;
    transition: color {{ section.settings.hover_duration | default: 650 }}ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  {% if section.settings.cta_underline %}
  #shopify-section-{{ sid }} .ma-j__cta {
    border-bottom: 1px solid rgba(168, 137, 78, 0.3);
  }
  #shopify-section-{{ sid }} .ma-j__cta::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 0;
    height: 1px;
    background: currentColor;
    transition: width {{ section.settings.hover_duration | default: 650 }}ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  #shopify-section-{{ sid }} .ma-j__cta:hover::after { width: 100%; }
  {% endif %}
  #shopify-section-{{ sid }} .ma-j__cta:hover { color: {{ section.settings.cta_hover_color }}; }
  #shopify-section-{{ sid }} .ma-j__cta-arrow { transition: transform {{ section.settings.hover_duration | default: 650 }}ms cubic-bezier(0.16, 1, 0.3, 1); }
  #shopify-section-{{ sid }} .ma-j__cta:hover .ma-j__cta-arrow { transform: translateX(4px); }

  /* ═══════════════════════════════════════
     3. SHARED CARD & MEDIA
  ═══════════════════════════════════════ */
  #shopify-section-{{ sid }} .ma-j__card {
    display: block;
    text-decoration: none;
    background: transparent;
    color: {{ section.settings.card_text_color }};
    border: 0;
    border-radius: 0;
    overflow: visible;
    transition: background 0.35s ease, color 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
  }
  #shopify-section-{{ sid }} .ma-j__stories--magazine_cards .ma-j__card {
    background: {{ section.settings.card_bg_color }};
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
    {% if section.settings.card_shadow_strength > 0 %}box-shadow: 0 {{ section.settings.card_shadow_strength }}px {{ section.settings.card_shadow_strength | times: 2 }}px rgba(0,0,0,{{ section.settings.card_shadow_strength | times: 1.0 | divided_by: 100 }});{% endif %}
  }
  #shopify-section-{{ sid }} .ma-j__stories--magazine_cards .ma-j__card:hover {
    background: {{ section.settings.card_hover_bg_color }};
    border-color: {{ section.settings.card_hover_border_color }};
  }
  #shopify-section-{{ sid }} .ma-j__stories--magazine_cards .ma-j__name,
  #shopify-section-{{ sid }} .ma-j__stories--magazine_cards .ma-j__excerpt,
  #shopify-section-{{ sid }} .ma-j__stories--magazine_cards .ma-j__date,
  #shopify-section-{{ sid }} .ma-j__stories--magazine_cards .ma-j__authorsssss,
  #shopify-section-{{ sid }} .ma-j__stories--magazine_cards .ma-j__read {
    color: #1a1a1a;
  }
  #shopify-section-{{ sid }} .ma-j__media {
    position: relative;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    overflow: hidden;
    background: rgba(0,0,0,0.06);
    border-radius: {{ section.settings.image_radius }}px;
  }
  #shopify-section-{{ sid }} .ma-j__media img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_crop }};
    object-position: {{ section.settings.image_position_x | default: 'center' }} {{ section.settings.image_position_y | default: 'center' }};
    transform: scale({{ section.settings.image_scale | default: 100 | divided_by: 100.0 }});
    display: block;
    transition: transform {{ section.settings.hover_duration | default: 650 }}ms cubic-bezier(0.16, 1, 0.3, 1), filter {{ section.settings.hover_duration | default: 650 }}ms ease;
  }
  {% if section.settings.hover_zoom %}
    #shopify-section-{{ sid }} .ma-j__card:hover .ma-j__media img {
      transform: scale({{ section.settings.hover_zoom_amount | default: 102 | divided_by: 100.0 }});
    }
  {% endif %}
  {% if section.settings.hover_darken %}
    #shopify-section-{{ sid }} .ma-j__card:hover .ma-j__media img { filter: brightness(0.85); }
  {% endif %}

  #shopify-section-{{ sid }} .ma-j__body {
    padding: {{ section.settings.text_spacing }}px {{ section.settings.text_spacing | times: 1.4 }}px;
  }
  #shopify-section-{{ sid }} .ma-j__category {
    display: block;
    font-family: {{ section.settings.category_font.family }}, sans-serif;
    font-size: {{ section.settings.category_size }}px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: {{ section.settings.category_color }};
    margin: 0 0 10px;
  }
  #shopify-section-{{ sid }} .ma-j__name {
    display: block;
    font-family: {{ section.settings.title_font.family }}, serif;
    font-weight: {{ section.settings.title_weight }};
    font-size: {{ section.settings.title_size }}px;
    color: {{ section.settings.title_color }};
    line-height: 1.3;
    margin: 0 0 12px;
    transition: color {{ section.settings.hover_duration | default: 650 }}ms ease;
  }
  #shopify-section-{{ sid }} .ma-j__card:hover .ma-j__name { color: var(--pm-gold, #a8894e); }
  #shopify-section-{{ sid }} .ma-j__excerpt {
    display: block;
    font-family: {{ section.settings.excerpt_font.family }}, sans-serif;
    font-size: {{ section.settings.excerpt_size }}px;
    line-height: {{ section.settings.excerpt_line_height }};
    color: {{ section.settings.excerpt_color }};
    margin: 0 0 14px;
  }
  
  #shopify-section-{{ sid }} .ma-j__meta {
    display: flex;
    gap: 10px;
    margin: 0 0 12px;
  }
  #shopify-section-{{ sid }} .ma-j__date {
    font-size: {{ section.settings.date_size | default: 12 }}px !important;
    color: {{ section.settings.date_color }};
    opacity: {{ section.settings.date_opacity | default: 70 | divided_by: 100.0 }};
  }
  #shopify-section-{{ sid }} .ma-j__authorsssss {
    font-size: {{ section.settings.date_size | default: 12 }}px !important;
    color: {{ section.settings.authorsssss_color }};
    opacity: {{ section.settings.date_opacity | default: 70 | divided_by: 100.0 }};
  }
  
  #shopify-section-{{ sid }} .ma-j__read {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    position: relative;
    padding-bottom: 3px;
    border-bottom: 1px solid rgba(168, 137, 78, 0.25);
    transition: color {{ section.settings.hover_duration | default: 650 }}ms ease;
  }
  #shopify-section-{{ sid }} .ma-j__read::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 0;
    height: 1px;
    background: currentColor;
    transition: width {{ section.settings.hover_duration | default: 650 }}ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  #shopify-section-{{ sid }} .ma-j__card:hover .ma-j__read::after { width: 100%; }
  #shopify-section-{{ sid }} .ma-j__read-arrow { transition: transform {{ section.settings.hover_duration | default: 650 }}ms cubic-bezier(0.16, 1, 0.3, 1); }
  #shopify-section-{{ sid }} .ma-j__card:hover .ma-j__read-arrow { transform: translateX(4px); }

  #shopify-section-{{ sid }} .ma-j__divider {
    height: 1px;
    background: {{ section.settings.divider_color }};
    margin: 0 auto;
  }

  {% if section.settings.fade_in_animation %}
    #shopify-section-{{ sid }} .ma-j__reveal {
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.16,1,0.3,1);
    }
    #shopify-section-{{ sid }} .ma-j__reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
  {% endif %}

  /* ══════════════════════════════════════════════════════════════
     MOBILE LAYOUT (< 750px) — 100% PRESERVED AND UNTOUCHED
  ══════════════════════════════════════════════════════════════ */
  #shopify-section-{{ sid }} .ma-j__intro { margin-bottom: {{ section.settings.content_spacing }}px; }

  #shopify-section-{{ sid }} .ma-j__stories--editorial_stack .ma-j__card {
    display: flex; flex-direction: column; margin-bottom: {{ section.settings.story_spacing }}px;
  }
  #shopify-section-{{ sid }} .ma-j__stories--editorial_stack .ma-j__media { aspect-ratio: {{ section.settings.image_aspect_ratio }}; }

  #shopify-section-{{ sid }} .ma-j__stories--magazine_cards .ma-j__card {
    margin-bottom: {{ section.settings.story_spacing }}px;
  }

  #shopify-section-{{ sid }} .ma-j__stories--full_editorial .ma-j__card:first-child .ma-j__media { aspect-ratio: 4 / 5; }
  #shopify-section-{{ sid }} .ma-j__stories--full_editorial .ma-j__card:first-child .ma-j__name { font-size: {{ section.settings.title_size | plus: 4 }}px; }
  #shopify-section-{{ sid }} .ma-j__stories--full_editorial .ma-j__card { margin-bottom: {{ section.settings.story_spacing }}px; }
  #shopify-section-{{ sid }} .ma-j__stories--full_editorial .ma-j__card:not(:first-child) { display: flex; align-items: center; }
  #shopify-section-{{ sid }} .ma-j__stories--full_editorial .ma-j__card:not(:first-child) .ma-j__media { flex: 0 0 96px; aspect-ratio: 1/1; }
  #shopify-section-{{ sid }} .ma-j__stories--full_editorial .ma-j__card:not(:first-child) .ma-j__body { flex: 1; padding: 12px 14px; }

  #shopify-section-{{ sid }} .ma-j__stories--horizontal_scroll {
    display: flex; gap: {{ section.settings.mobile_card_gap }}px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 6px; -webkit-overflow-scrolling: touch;
  }
  #shopify-section-{{ sid }} .ma-j__stories--horizontal_scroll .ma-j__card {
    flex: 0 0 {{ section.settings.mobile_card_width }}px; scroll-snap-align: start;
  }

  #shopify-section-{{ sid }} .ma-j__stories { display: block; }

  /* ══════════════════════════════════════════════════════════════
     DESKTOP EDITORIAL EXPERIENCE (≥ 750px) — NATURAL SCROLL STORYTELLING
  ══════════════════════════════════════════════════════════════ */
  @media (min-width: 750px) {
    #shopify-section-{{ sid }} .ma-j {
      overflow: visible;
      height: auto;
    }

    /* Proportional Outer Grid: Left Intro | Right Articles (Top aligned by default) */
    #shopify-section-{{ sid }} .ma-j__inner {
      display: grid;
      grid-template-columns: {{ section.settings.intro_width }}px 1fr;
      gap: {{ section.settings.content_spacing }}px;
      align-items: start !important;
      height: auto;
      overflow: visible;
    }

    /* Hardware-Accelerated Vertical Scroll Storytelling (--scroll-y) & Top Alignment */
    #shopify-section-{{ sid }} .ma-j__intro {
      --scroll-y: 0px;
      position: relative;
      margin-bottom: 0;
      transform: translate3d(0px, calc({{ section.settings.editorial_intro_top_offset | default: -80 }}px - var(--scroll-y, 0px)), 0);
      will-change: transform;
    }
    #shopify-section-{{ sid }} .ma-j__heading {
      font-size: {{ section.settings.heading_size }}px;
    }

    /* Desktop layout styles (Classic Editorial, Magazine Grid, Feature Left/Right) */
    #shopify-section-{{ sid }} .ma-j__stories {
      display: grid !important;
      grid-template-columns: repeat({{ section.settings.desktop_columns }}, 1fr);
      gap: {{ section.settings.card_gap }}px;
      overflow: visible;
      height: auto;
    }

    #shopify-section-{{ sid }} .ma-j__stories .ma-j__card {
      display: flex;
      flex-direction: column;
      flex: none;
      margin-bottom: 0;
      overflow: visible;
      height: 100%;
    }

    #shopify-section-{{ sid }} .ma-j__stories .ma-j__media {
      aspect-ratio: {{ section.settings.image_aspect_ratio }};
      height: {{ section.settings.desktop_image_height | default: 220 }}px;
      max-height: none;
      width: 100%;
      flex-shrink: 0;
    }

    #shopify-section-{{ sid }} .ma-j__stories .ma-j__body {
      padding: 18px 0 0 0;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }

    #shopify-section-{{ sid }} .ma-j__stories .ma-j__category {
      margin-bottom: 8px;
    }

    #shopify-section-{{ sid }} .ma-j__stories .ma-j__name {
      font-size: {{ section.settings.title_size }}px;
      line-height: 1.3;
      margin-bottom: 12px;
      display: -webkit-box;
      -webkit-line-clamp: {{ section.settings.title_line_clamp | default: 3 }};
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    #shopify-section-{{ sid }} .ma-j__stories .ma-j__excerpt {
      margin-bottom: 16px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    #shopify-section-{{ sid }} .ma-j__stories .ma-j__meta {
      display: flex;
      margin-top: auto;
      padding-top: 10px;
    }

    #shopify-section-{{ sid }} .ma-j__stories .ma-j__read {
      margin-top: auto;
      align-self: flex-start;
    }

    /* Featured Story Editorial Hierarchy (Active on Desktop when ON) */
    {% if section.settings.show_featured_story %}
      #shopify-section-{{ sid }} .ma-j__stories .ma-j__card--featured {
        grid-column: span 2;
        display: grid;
        grid-template-columns: {{ section.settings.featured_story_width | default: 55 }}% 1fr;
        gap: 32px;
        align-items: center;
      }
      @media (max-width: 1050px) {
        #shopify-section-{{ sid }} .ma-j__stories .ma-j__card--featured {
          grid-template-columns: 1fr;
          gap: 18px;
        }
      }
      #shopify-section-{{ sid }} .ma-j__stories .ma-j__card--featured .ma-j__media {
        aspect-ratio: {{ section.settings.featured_image_aspect | default: '4 / 5' }};
        height: {{ section.settings.featured_image_height | default: 380 }}px;
      }
      #shopify-section-{{ sid }} .ma-j__stories .ma-j__card--featured .ma-j__body {
        padding: 0;
        justify-content: center;
      }
      #shopify-section-{{ sid }} .ma-j__stories .ma-j__card--featured .ma-j__name {
        font-size: {{ section.settings.title_size | plus: 6 }}px;
        line-height: 1.25;
        -webkit-line-clamp: 4;
      }
      #shopify-section-{{ sid }} .ma-j__stories .ma-j__card--featured .ma-j__excerpt {
        font-size: {{ section.settings.excerpt_size | plus: 1 }}px;
        -webkit-line-clamp: 4;
      }
    {% endif %}

    /* Reset mobile Full Editorial overrides on desktop */
    #shopify-section-{{ sid }} .ma-j__stories--full_editorial .ma-j__card:first-child .ma-j__media {
      aspect-ratio: {{ section.settings.image_aspect_ratio }};
      height: {{ section.settings.desktop_image_height | default: 220 }}px;
    }
    #shopify-section-{{ sid }} .ma-j__stories--full_editorial .ma-j__card:first-child .ma-j__name {
      font-size: {{ section.settings.title_size }}px;
    }
    #shopify-section-{{ sid }} .ma-j__stories--full_editorial .ma-j__card:not(:first-child) {
      display: flex;
      align-items: normal;
    }
    #shopify-section-{{ sid }} .ma-j__stories--full_editorial .ma-j__card:not(:first-child) .ma-j__media {
      flex: none;
      aspect-ratio: {{ section.settings.image_aspect_ratio }};
      height: {{ section.settings.desktop_image_height | default: 220 }}px;
    }
    #shopify-section-{{ sid }} .ma-j__stories--full_editorial .ma-j__card:not(:first-child) .ma-j__body {
      flex: 1;
      padding: 18px 0 0 0;
    }
  }
{% endstyle %}

{%- if total > 0 and n > 0 -%}
  {%- liquid
    assign days = section.settings.rotation_days
    assign win_len = days | times: 86400
    assign now_s = 'now' | date: '%s' | plus: 0
    assign window = now_s | divided_by: win_len
    assign hop = total | divided_by: n
    if hop < 1
      assign hop = 1
    endif
    assign start = window | times: 7 | plus: 1 | modulo: total
  -%}

  <section class="ma-j">
    <div class="ma-j__inner">
      <div class="ma-j__intro ma-j__reveal">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ma-j__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- if section.settings.enable_editorial_meta -%}
          <div class="ma-j__editorial-meta">
            {%- if section.settings.meta_volume != blank -%}<span>{{ section.settings.meta_volume }}</span>{%- endif -%}
            {%- if section.settings.meta_issue != blank -%}<span>{{ section.settings.meta_issue }}</span>{%- endif -%}
            {%- if section.settings.meta_freq != blank -%}<span>{{ section.settings.meta_freq }}</span>{%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="ma-j__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.editorial_description != blank -%}
          <p class="ma-j__desc">{{ section.settings.editorial_description }}</p>
        {%- endif -%}

        {%- if section.settings.cta_text != blank -%}
          <a class="ma-j__cta" href="{{ section.settings.cta_link | default: jblog.url }}">
            <span>{{ section.settings.cta_text }}</span>
            <span class="ma-j__cta-arrow">→</span>
          </a>
        {%- endif -%}
      </div>

      <div class="ma-j__stories ma-j__stories--{{ section.settings.mobile_layout }}">
        {%- for i in (1..n) -%}
          {%- assign step_offset = forloop.index0 | times: hop -%}
          {%- assign idx = start | plus: step_offset | modulo: total -%}
          {%- assign article = jblog.articles[idx] -%}
          {%- if article -%}
            <a class="ma-j__card ma-j__reveal{% if section.settings.show_featured_story and forloop.first %} ma-j__card--featured{% endif %}" href="{{ article.url }}">
              {%- if section.settings.show_featured_image -%}
                <span class="ma-j__media">
                  {%- if article.image -%}
                    {{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: article.title }}
                  {%- endif -%}
                </span>
              {%- endif -%}
              <span class="ma-j__body">
                {%- if section.settings.show_category and article.tags.size > 0 -%}
                  <span class="ma-j__category">{{ article.tags.first }}</span>
                {%- endif -%}
                {%- if section.settings.show_title -%}
                  <span class="ma-j__name">{{ article.title }}</span>
                {%- endif -%}
                {%- if section.settings.show_excerpt and article.excerpt != blank -%}
                  <span class="ma-j__excerpt">{{ article.excerpt | strip_html | truncate: 120 }}</span>
                {%- endif -%}
                {%- if section.settings.show_date or section.settings.show_authorsssss -%}
                  <span class="ma-j__meta">
                    {%- if section.settings.show_date -%}
                      <span class="ma-j__date">{{ article.published_at | date: '%e %b %Y' | lstrip | upcase }}</span>
                    {%- endif -%}
                    {%- if section.settings.show_authorsssss -%}
                      <span class="ma-j__authorsssss">{{ article.authorsssss }}</span>
                    {%- endif -%}
                  </span>
                {%- endif -%}
                {%- if section.settings.show_cta -%}
                  <span class="ma-j__read">
                    <span>Read Article</span>
                    <span class="ma-j__read-arrow">→</span>
                  </span>
                {%- endif -%}
              </span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {% if section.settings.fade_in_animation or section.settings.reveal_on_scroll %}
    <script>
      (function () {
        var els = document.querySelectorAll('#shopify-section-{{ sid }} .ma-j__reveal');
        if (!els.length || !('IntersectionObserver' in window)) {
          els.forEach(function (el) { el.classList.add('is-visible'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  {% endif %}

  {% if section.settings.enable_scroll_animation %}
    <script>
      (function () {
        if (window.innerWidth < 750) return;
        var sec = document.getElementById('shopify-section-{{ sid }}');
        if (!sec) return;
        var intro = sec.querySelector('.ma-j__intro');
        if (!intro) return;

        var maxStrength = {{ section.settings.animation_strength | default: 50 }};
        var smoothness = {{ section.settings.animation_smoothness | default: 0.1 }};
        var currentY = 0;
        var targetY = 0;
        var isVisible = false;
        var ticking = false;

        function update() {
          if (window.innerWidth < 750) {
            intro.style.setProperty('--scroll-y', '0px');
            ticking = false;
            return;
          }
          if (!isVisible && Math.abs(targetY - currentY) < 0.1) {
            ticking = false;
            return;
          }
          var rect = sec.getBoundingClientRect();
          var vh = window.innerHeight || document.documentElement.clientHeight;
          
          var totalScroll = (rect.height || 1000) + vh * 0.5;
          var scrolled = vh - rect.top;
          var progress = Math.max(0, Math.min(1, scrolled / totalScroll));
          
          targetY = Math.max(0, Math.min(maxStrength, progress * maxStrength * 1.3));
          currentY += (targetY - currentY) * smoothness;
          
          intro.style.setProperty('--scroll-y', currentY.toFixed(2) + 'px');
          
          if (isVisible || Math.abs(targetY - currentY) >= 0.1) {
            requestAnimationFrame(update);
          } else {
            ticking = false;
          }
        }

        function onScroll() {
          if (isVisible && !ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        }

        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              isVisible = entry.isIntersecting;
              if (isVisible && !ticking) {
                ticking = true;
                requestAnimationFrame(update);
              }
            });
          }, { threshold: 0 });
          io.observe(sec);
        } else {
          isVisible = true;
        }

        window.addEventListener('scroll', onScroll, { passive: true });
      })();
    </script>
  {% endif %}

  {% if section.settings.parallax_image %}
    <script>
      (function () {
        var imgs = document.querySelectorAll('#shopify-section-{{ sid }} .ma-j__media img');
        if (!imgs.length) return;
        var ticking = false;
        function update() {
          imgs.forEach(function (img) {
            var rect = img.parentElement.getBoundingClientRect();
            var vh = window.innerHeight || document.documentElement.clientHeight;
            var progress = (vh - rect.top) / (vh + rect.height);
            var offset = (progress - 0.5) * 20;
            img.style.transform = 'translateY(' + offset + 'px) scale({{ section.settings.image_scale | default: 100 | divided_by: 100.0 }})';
          });
          ticking = false;
        }
        window.addEventListener('scroll', function () {
          if (!ticking) {
            requestAnimationFrame(update);
            ticking = true;
          }
        }, { passive: true });
        update();
      })();
    </script>
  {% endif %}
{%- endif -%}

