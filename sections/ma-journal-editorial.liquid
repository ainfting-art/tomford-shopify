    { "type": "font_picker", "id": "eyebrow_font", "label": "Eyebrow Font", "default": "helvetica_n4" },
    { "type": "select", "id": "eyebrow_weight", "label": "Eyebrow Weight", "default": "500", "options": [
      { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semibold" }
    ]},
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow Size", "min": 10, "max": 22, "step": 1, "default": 12, "unit": "px" },
    { "type": "range", "id": "eyebrow_letter_spacing", "label": "Eyebrow Letter Spacing", "min": 0, "max": 6, "step": 0.5, "default": 3, "unit": "px" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow Color", "default": "#a8894e" },

    { "type": "font_picker", "id": "heading_font", "label": "Heading Font", "default": "playfair_display_n4" },
    { "type": "select", "id": "heading_weight", "label": "Heading Weight", "default": "400", "options": [
      { "value": "300", "label": "Light" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semibold" }
    ]},
    { "type": "range", "id": "heading_size", "label": "Heading Size (desktop)", "min": 28, "max": 72, "step": 1, "default": 44, "unit": "px" },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading Size (mobile)", "min": 22, "max": 48, "step": 1, "default": 32, "unit": "px" },
    { "type": "range", "id": "heading_letter_spacing", "label": "Heading Letter Spacing", "min": -1, "max": 3, "step": 0.5, "default": 0, "unit": "px" },
