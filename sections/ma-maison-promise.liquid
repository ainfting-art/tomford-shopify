{%- comment -%}
  MAISON AMIIR — The Maison Promise
  High-converting trust manifesto section.
  Desktop: 2-column stretch split (Left visual fills 100% height / Right centered manifesto + 2x2 grid).
  Mobile: Independent editorial split hero + horizontal row stack.
  FIXED: Full vertical image stretching, centered grid cells, Title Case protection, diamond ornament.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign image_blocks = section.blocks | where: 'type', 'image'
  assign promise_blocks = section.blocks | where: 'type', 'promise'
  assign img_count = image_blocks | size
  assign use_slider = false
  if img_count > 1
    assign use_slider = true
  endif

  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign heading_color = section.settings.heading_color
  assign eyebrow_color = section.settings.eyebrow_color
  assign icon_color = section.settings.icon_color
  assign divider_color = section.settings.divider_color
  assign watermark_color = section.settings.watermark_color
  assign emblem_color = section.settings.emblem_color

  if section.settings.color_preset == 'ivory'
    assign bg_color = '#F4EEE1'
    assign text_color = '#171310'
    assign heading_color = '#171310'
    assign eyebrow_color = '#A8894E'
    assign icon_color = '#A8894E'
    assign divider_color = 'rgba(23, 19, 16, 0.14)'
    assign watermark_color = '#171310'
    assign emblem_color = '#A8894E'
  elsif section.settings.color_preset == 'noir'
    assign bg_color = '#0C0B0A'
    assign text_color = '#F5F0E6'
    assign heading_color = '#F5F0E6'
    assign eyebrow_color = '#D4AF37'
    assign icon_color = '#D4AF37'
    assign divider_color = 'rgba(245, 240, 230, 0.15)'
    assign watermark_color = '#F5F0E6'
    assign emblem_color = '#D4AF37'
  elsif section.settings.color_preset == 'editorial_light'
    assign bg_color = '#FFFFFF'
    assign text_color = '#111111'
    assign heading_color = '#111111'
    assign eyebrow_color = '#888888'
    assign icon_color = '#111111'
    assign divider_color = 'rgba(0, 0, 0, 0.1)'
    assign watermark_color = '#000000'
    assign emblem_color = '#111111'
  elsif section.settings.color_preset == 'editorial_dark'
    assign bg_color = '#141414'
    assign text_color = '#E0E0E0'
    assign heading_color = '#FFFFFF'
    assign eyebrow_color = '#A0A0A0'
    assign icon_color = '#FFFFFF'
    assign divider_color = 'rgba(255, 255, 255, 0.12)'
    assign watermark_color = '#FFFFFF'
    assign emblem_color = '#FFFFFF'
  endif
-%}

{%- style -%}
  {{ section.settings.eyebrow_font | font_face: font_display: 'swap' }}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.body_font | font_face: font_display: 'swap' }}
  {{ section.settings.promise_title_font | font_face: font_display: 'swap' }}
  {{ section.settings.promise_body_font | font_face: font_display: 'swap' }}
{%- endstyle -%}

<style>
/* ═══════════════════════════════════════════════
   RESET & BASE
═══════════════════════════════════════════════ */
#shopify-section-{{ sid }} { opacity: 1 !important; transform: none !important; }

#shopify-section-{{ sid }} .ma-mp {
  position: relative;
  background: {{ bg_color }};
  color: {{ text_color }};
  overflow: hidden;
  margin-top: {{ section.settings.margin_top }}px;
  margin-bottom: {{ section.settings.margin_bottom }}px;
  font-family: {{ section.settings.body_font.family }}, 'Cormorant Garamond', Georgia, serif;
}
#shopify-section-{{ sid }} .ma-mp *,
#shopify-section-{{ sid }} .ma-mp *::before,
#shopify-section-{{ sid }} .ma-mp *::after { box-sizing: border-box; }

/* ═══════════════════════════════════════════════
   VISUAL COLUMN & SLIDER ENGINE
═══════════════════════════════════════════════ */
#shopify-section-{{ sid }} .ma-mp__visual {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 100%;
  overflow: hidden;
  background: rgba(0,0,0,0.03);
  display: flex;
}
#shopify-section-{{ sid }} .ma-mp__slider {
  position: relative;
  width: 100%;
  height: 100%;
  flex: 1 1 auto;
  overflow: hidden;
}
#shopify-section-{{ sid }} .ma-mp__slide {
  position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity 0.8s ease;
  pointer-events: none;
}
#shopify-section-{{ sid }} .ma-mp__slide.is-active {
  opacity: 1;
  pointer-events: auto;
  position: relative;
  height: 100%;
}
#shopify-section-{{ sid }} .ma-mp__img {
  width: 100%;
  height: 100%;
  object-fit: {{ section.settings.image_fit }};
  object-position: {{ section.settings.focal_x }}% {{ section.settings.focal_y }}%;
  display: block;
  transform: scale({{ section.settings.image_scale | divided_by: 100.0 }});
  opacity: {{ section.settings.image_opacity | divided_by: 100.0 }};
  border-radius: {{ section.settings.image_radius }}px;
  {% if section.settings.image_shadow %}box-shadow: 0 20px 50px rgba(0,0,0,0.15);{% endif %}
  transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
}

/* Slider Controls */
#shopify-section-{{ sid }} .ma-mp__nav {
  position: absolute;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 16px;
  z-index: 10;
}
#shopify-section-{{ sid }} .ma-mp__arrow {
  background: rgba(255,255,255,0.8);
  border: none;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  color: #000;
  transition: background 0.3s, transform 0.3s;
}
#shopify-section-{{ sid }} .ma-mp__arrow:hover { background: #fff; transform: scale(1.1); }
#shopify-section-{{ sid }} .ma-mp__dots { display: flex; gap: 8px; }
#shopify-section-{{ sid }} .ma-mp__dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: rgba(255,255,255,0.4);
  border: none;
  cursor: pointer;
  padding: 0;
}
#shopify-section-{{ sid }} .ma-mp__dot.is-active { background: #fff; transform: scale(1.3); }

/* Decorative Overlays */
#shopify-section-{{ sid }} .ma-mp__deco {
  position: absolute;
  pointer-events: none;
  z-index: 5;
  transition: transform 0.5s ease;
}
#shopify-section-{{ sid }} .ma-mp__deco img {
  display: block;
  width: 100%;
  height: auto;
}

/* ═══════════════════════════════════════════════
   WATERMARK LOGO (REUSED REFERENCE)
═══════════════════════════════════════════════ */
#shopify-section-{{ sid }} .ma-mp__watermark {
  position: absolute;
  left: {{ section.settings.wm_pos_x }}%;
  top: {{ section.settings.wm_pos_y }}%;
  transform: translate(-50%, -50%) scale({{ section.settings.wm_scale | divided_by: 100.0 }}) rotate({{ section.settings.wm_rotate }}deg);
  opacity: {{ section.settings.wm_opacity | divided_by: 100.0 }};
  filter: blur({{ section.settings.wm_blur }}px);
  pointer-events: none;
  z-index: 0;
  width: min(85%, 540px);
}
#shopify-section-{{ sid }} .ma-mp__watermark img {
  width: 100%;
  height: auto;
  display: block;
}

/* ═══════════════════════════════════════════════
   TYPOGRAPHY & CONTENT
═══════════════════════════════════════════════ */
#shopify-section-{{ sid }} .ma-mp__content {
  position: relative;
  z-index: 2;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
#shopify-section-{{ sid }} .ma-mp__eyebrow {
  font-family: {{ section.settings.eyebrow_font.family }}, 'Marcellus', sans-serif;
  font-size: {{ section.settings.eyebrow_size }}px;
  font-weight: {{ section.settings.eyebrow_weight }};
  letter-spacing: {{ section.settings.eyebrow_spacing }}px;
  text-transform: uppercase;
  color: {{ eyebrow_color }};
  display: block;
  margin-bottom: 8px;
}

/* Luxury Diamond Ornament */
#shopify-section-{{ sid }} .ma-mp__diamond {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  margin: 0 auto 16px;
  color: {{ eyebrow_color }};
  opacity: 0.7;
}
#shopify-section-{{ sid }} .ma-mp__diamond::before,
#shopify-section-{{ sid }} .ma-mp__diamond::after {
  content: '';
  width: 32px;
  height: 1px;
  background: currentColor;
}
#shopify-section-{{ sid }} .ma-mp__diamond-icon {
  font-size: 10px;
  line-height: 1;
}

#shopify-section-{{ sid }} .ma-mp__heading {
  font-family: {{ section.settings.heading_font.family }}, 'Cormorant Garamond', serif !important;
  font-size: {{ section.settings.heading_size }}px !important;
  font-weight: {{ section.settings.heading_weight }} !important;
  letter-spacing: {{ section.settings.heading_spacing }}px !important;
  line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }} !important;
  text-transform: none !important;
  color: {{ heading_color }} !important;
  margin: 0 0 16px !important;
}
#shopify-section-{{ sid }} .ma-mp__intro {
  font-family: {{ section.settings.body_font.family }}, serif;
  font-size: {{ section.settings.body_size }}px;
  font-weight: {{ section.settings.body_weight }};
  letter-spacing: {{ section.settings.body_spacing }}px;
  line-height: {{ section.settings.body_line_height | divided_by: 100.0 }};
  color: {{ text_color }};
  font-style: italic;
  opacity: 0.9;
  margin: 0 auto 40px;
  max-width: 52ch;
}

/* ═══════════════════════════════════════════════
   PROMISE BLOCKS (CENTERED IN REFERENCE)
═══════════════════════════════════════════════ */
#shopify-section-{{ sid }} .ma-mp__card {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center !important;
  text-align: center !important;
}
#shopify-section-{{ sid }} .ma-mp__icon {
  width: {{ section.settings.icon_size }}px;
  height: {{ section.settings.icon_size }}px;
  color: {{ icon_color }};
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
}
#shopify-section-{{ sid }} .ma-mp__icon svg,
#shopify-section-{{ sid }} .ma-mp__icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  fill: currentColor;
}
#shopify-section-{{ sid }} .ma-mp__kicker {
  font-family: {{ section.settings.eyebrow_font.family }}, 'Marcellus', sans-serif;
  font-size: 10.5px;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: {{ eyebrow_color }};
  margin-bottom: 8px;
}
#shopify-section-{{ sid }} .ma-mp__title {
  font-family: {{ section.settings.promise_title_font.family }}, 'Cormorant Garamond', serif !important;
  font-size: {{ section.settings.promise_title_size }}px !important;
  font-weight: {{ section.settings.promise_title_weight }} !important;
  text-transform: none !important;
  color: {{ heading_color }} !important;
  margin: 0 0 8px !important;
  line-height: 1.2 !important;
}
#shopify-section-{{ sid }} .ma-mp__desc {
  font-family: {{ section.settings.promise_body_font.family }}, serif;
  font-size: {{ section.settings.promise_body_size }}px;
  font-weight: {{ section.settings.promise_body_weight }};
  line-height: {{ section.settings.promise_body_line_height | divided_by: 100.0 }};
  color: {{ text_color }};
  opacity: 0.8;
  margin: 0 auto;
  max-width: 32ch;
}
#shopify-section-{{ sid }} .ma-mp__num {
  position: absolute;
  font-family: 'Cormorant Garamond', serif;
  font-weight: 600;
  line-height: 1;
  color: {{ text_color }};
  opacity: 0.05;
  pointer-events: none;
  z-index: 0;
}

/* ═══════════════════════════════════════════════
   BOTTOM SIGNATURE EMBLEM
═══════════════════════════════════════════════ */
#shopify-section-{{ sid }} .ma-mp__emblem-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  margin-top: 48px;
  width: 100%;
  position: relative;
  z-index: 2;
}
#shopify-section-{{ sid }} .ma-mp__rule {
  flex: 1;
  max-width: 140px;
  height: {{ section.settings.emblem_line_thickness }}px;
  background: {{ emblem_color }};
  opacity: 0.35;
}
#shopify-section-{{ sid }} .ma-mp__emblem {
  width: {{ section.settings.emblem_size }}px;
  height: {{ section.settings.emblem_size }}px;
  border: 1px solid {{ emblem_color }};
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Cormorant Garamond', serif;
  font-size: {{ section.settings.emblem_size | times: 0.45 }}px;
  color: {{ emblem_color }};
  opacity: {{ section.settings.emblem_opacity | divided_by: 100.0 }};
}

/* ═══════════════════════════════════════════════
   ████████████████  DESKTOP  ████████████████
═══════════════════════════════════════════════ */
@media (min-width: 900px) {
  #shopify-section-{{ sid }} .ma-mp__inner {
    display: grid;
    grid-template-columns: {{ section.settings.col_left_width }}% {{ 100 | minus: section.settings.col_left_width }}%;
    min-height: {{ section.settings.section_height }}px;
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    align-items: stretch; /* FORCES PHOTO COLUMN TO STRETCH 100% OF TEXT HEIGHT */
  }
  #shopify-section-{{ sid }} .ma-mp__content-wrap {
    padding: {{ section.settings.dt_pad_top }}px {{ section.settings.dt_pad_right }}px {{ section.settings.dt_pad_bottom }}px {{ section.settings.dt_pad_left }}px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  
  /* Desktop 2x2 Grid */
  #shopify-section-{{ sid }} .ma-mp__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ section.settings.grid_gap }}px;
    margin-top: 10px;
    border-top: {{ section.settings.div_thickness }}px {{ section.settings.div_style }} {{ divider_color }};
    padding-top: {{ section.settings.grid_gap }}px;
  }
  #shopify-section-{{ sid }} .ma-mp__card {
    padding: 24px 20px;
  }
  /* Hairline grid borders */
  #shopify-section-{{ sid }} .ma-mp__card:nth-child(1),
  #shopify-section-{{ sid }} .ma-mp__card:nth-child(2) {
    border-bottom: {{ section.settings.div_thickness }}px {{ section.settings.div_style }} {{ divider_color }};
    padding-bottom: calc(24px + {{ section.settings.grid_gap | divided_by: 2 }}px);
  }
  #shopify-section-{{ sid }} .ma-mp__card:nth-child(1),
  #shopify-section-{{ sid }} .ma-mp__card:nth-child(3) {
    border-right: {{ section.settings.div_thickness }}px {{ section.settings.div_style }} {{ divider_color }};
    padding-right: calc(24px + {{ section.settings.grid_gap | divided_by: 2 }}px);
  }
  #shopify-section-{{ sid }} .ma-mp__num {
    top: 12px;
    right: 24px;
    font-size: 64px;
  }
  
  /* Hide mobile-only elements */
  #shopify-section-{{ sid }} .ma-mp__mobile-only { display: none !important; }
}

/* ═══════════════════════════════════════════════
   ████████████████  MOBILE  ████████████████
═══════════════════════════════════════════════ */
@media (max-width: 899px) {
  #shopify-section-{{ sid }} .ma-mp__inner {
    display: flex;
    flex-direction: column;
  }
  /* Mobile Split Hero */
  #shopify-section-{{ sid }} .ma-mp__hero-split {
    display: grid;
    grid-template-columns: 42% 58%;
    align-items: stretch;
    min-height: 320px;
    position: relative;
  }
  #shopify-section-{{ sid }} .ma-mp__visual {
    height: 100%;
    min-height: 320px;
  }
  #shopify-section-{{ sid }} .ma-mp__content-wrap {
    padding: {{ section.settings.mob_pad_top }}px {{ section.settings.mob_pad_h }}px 20px {{ section.settings.mob_pad_h }}px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  #shopify-section-{{ sid }} .ma-mp__eyebrow { font-size: {{ section.settings.eyebrow_size | minus: 1 }}px; }
  #shopify-section-{{ sid }} .ma-mp__heading { font-size: clamp(28px, 7vw, 36px) !important; }
  #shopify-section-{{ sid }} .ma-mp__intro { font-size: {{ section.settings.body_size | minus: 1 }}px; margin-bottom: 20px; }
  
  /* Mobile Horizontal Row Stack */
  #shopify-section-{{ sid }} .ma-mp__grid {
    display: flex;
    flex-direction: column;
    padding: 0 {{ section.settings.mob_pad_h }}px {{ section.settings.mob_pad_bottom }}px;
  }
  #shopify-section-{{ sid }} .ma-mp__card {
    display: grid;
    grid-template-columns: 32% 68%;
    align-items: flex-start !important;
    text-align: left !important;
    padding: 24px 0;
    border-top: {{ section.settings.div_thickness }}px {{ section.settings.div_style }} {{ divider_color }};
  }
  #shopify-section-{{ sid }} .ma-mp__card:last-child {
    border-bottom: {{ section.settings.div_thickness }}px {{ section.settings.div_style }} {{ divider_color }};
  }
  #shopify-section-{{ sid }} .ma-mp__col-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-right: 12px;
  }
  #shopify-section-{{ sid }} .ma-mp__col-right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    padding-left: 8px;
  }
  #shopify-section-{{ sid }} .ma-mp__icon { margin-bottom: 8px; }
  #shopify-section-{{ sid }} .ma-mp__title { font-size: {{ section.settings.promise_title_size | minus: 2 }}px !important; }
  #shopify-section-{{ sid }} .ma-mp__desc { font-size: {{ section.settings.promise_body_size | minus: 1 }}px; max-width: 100%; margin: 0; }
  #shopify-section-{{ sid }} .ma-mp__num {
    bottom: 5px;
    left: 10px;
    font-size: 42px;
  }

  /* Hide desktop-only elements */
  #shopify-section-{{ sid }} .ma-mp__desktop-only { display: none !important; }
}
</style>

<!-- ── HTML STRUCTURE ── -->
<div class="ma-mp" id="ma-mp-{{ sid }}">
  <div class="ma-mp__inner">

    <!-- DESKTOP / MOBILE HERO SPLIT AREA -->
    <div class="ma-mp__hero-split">
      
      <!-- LEFT VISUAL COLUMN -->
      <div class="ma-mp__visual">
        <div class="ma-mp__slider" id="ma-mp-slider-{{ sid }}">
          {%- if img_count > 0 -%}
            {%- for block in image_blocks -%}
              <div class="ma-mp__slide{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.heading, class: 'ma-mp__img' }}
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="ma-mp__slide is-active">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'ma-mp__img' }}
            </div>
          {%- endif -%}
        </div>

        {%- if use_slider -%}
          <div class="ma-mp__nav">
            <button class="ma-mp__arrow ma-mp__arrow--prev" aria-label="Previous">&#8592;</button>
            <div class="ma-mp__dots">
              {%- for block in image_blocks -%}
                <button class="ma-mp__dot{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}"></button>
              {%- endfor -%}
            </div>
            <button class="ma-mp__arrow ma-mp__arrow--next" aria-label="Next">&#8594;</button>
          </div>
        {%- endif -%}

        <!-- Optional Decorative Floating Assets -->
        {%- for block in section.blocks -%}
          {%- if block.type == 'deco' and block.settings.image != blank -%}
            <div class="ma-mp__deco" style="top: {{ block.settings.pos_y }}%; left: {{ block.settings.pos_x }}%; width: {{ block.settings.width }}px; opacity: {{ block.settings.opacity | divided_by: 100.0 }};" {{ block.shopify_attributes }}>
              {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy' }}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <!-- RIGHT CONTENT COLUMN (MANIFESTO INTRO) -->
      <div class="ma-mp__content-wrap">
        
        <!-- Reused Live CDN Watermark Logo -->
        {%- if section.settings.show_watermark -%}
          <div class="ma-mp__watermark">
            <img src="https://maisonamiir.com/cdn/shop/files/MAISON-LOGO-NEW.png?v=1775626552&width=800" alt="" aria-hidden="true" loading="lazy">
          </div>
        {%- endif -%}

        <div class="ma-mp__content">
          {%- if section.settings.eyebrow != blank -%}
            <span class="ma-mp__eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          
          <div class="ma-mp__diamond" aria-hidden="true">
            <span class="ma-mp__diamond-icon">◆</span>
          </div>

          {%- if section.settings.heading != blank -%}
            <h2 class="ma-mp__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.intro != blank -%}
            <p class="ma-mp__intro">{{ section.settings.intro | escape }}</p>
          {%- endif -%}
        </div>

        <!-- DESKTOP ONLY: 2x2 PROMISE GRID RENDERS INSIDE RIGHT COLUMN -->
        <div class="ma-mp__grid ma-mp__desktop-only">
          {%- for block in promise_blocks -%}
            <div class="ma-mp__card" {{ block.shopify_attributes }}>
              <span class="ma-mp__num" aria-hidden="true">0{{ forloop.index }}</span>
              <div class="ma-mp__icon">
                {%- if block.settings.svg_code != blank -%}
                  {{ block.settings.svg_code }}
                {%- elsif block.settings.icon_img != blank -%}
                  {{ block.settings.icon_img | image_url: width: 100 | image_tag: loading: 'lazy' }}
                {%- endif -%}
              </div>
              {%- if block.settings.kicker != blank -%}<span class="ma-mp__kicker">{{ block.settings.kicker | escape }}</span>{%- endif -%}
              {%- if block.settings.title != blank -%}<h3 class="ma-mp__title">{{ block.settings.title | escape }}</h3>{%- endif -%}
              {%- if block.settings.body != blank -%}<p class="ma-mp__desc">{{ block.settings.body | escape }}</p>{%- endif -%}
            </div>
          {%- endfor -%}
        </div>

      </div>
    </div>

    <!-- MOBILE ONLY: HORIZONTAL ROW STACK RENDERS BELOW HERO -->
    <div class="ma-mp__grid ma-mp__mobile-only">
      {%- for block in promise_blocks -%}
        <div class="ma-mp__card" {{ block.shopify_attributes }}>
          <span class="ma-mp__num" aria-hidden="true">0{{ forloop.index }}</span>
          <div class="ma-mp__col-left">
            <div class="ma-mp__icon">
              {%- if block.settings.svg_code != blank -%}
                {{ block.settings.svg_code }}
              {%- elsif block.settings.icon_img != blank -%}
                {{ block.settings.icon_img | image_url: width: 100 | image_tag: loading: 'lazy' }}
              {%- endif -%}
            </div>
            {%- if block.settings.kicker != blank -%}<span class="ma-mp__kicker">{{ block.settings.kicker | escape }}</span>{%- endif -%}
          </div>
          <div class="ma-mp__col-right">
            {%- if block.settings.title != blank -%}<h3 class="ma-mp__title">{{ block.settings.title | escape }}</h3>{%- endif -%}
            {%- if block.settings.body != blank -%}<p class="ma-mp__desc">{{ block.settings.body | escape }}</p>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}

      <!-- BOTTOM SIGNATURE EMBLEM -->
      {%- if section.settings.show_emblem -%}
        <div class="ma-mp__emblem-wrap">
          <div class="ma-mp__rule"></div>
          <div class="ma-mp__emblem">M</div>
          <div class="ma-mp__rule"></div>
        </div>
      {%- endif -%}
    </div>

  </div>
</div>

<!-- ── JAVASCRIPT SLIDER ENGINE ── -->
<script>
(function() {
  var sec = document.getElementById('ma-mp-{{ sid }}');
  if (!sec) return;

  var slider = sec.querySelector('#ma-mp-slider-{{ sid }}');
  if (!slider) return;

  var slides = Array.from(slider.querySelectorAll('.ma-mp__slide'));
  if (slides.length < 2) return;

  var current = 0;
  var dots = Array.from(sec.querySelectorAll('.ma-mp__dot'));
  var prevBtn = sec.querySelector('.ma-mp__arrow--prev');
  var nextBtn = sec.querySelector('.ma-mp__arrow--next');

  function showSlide(idx) {
    slides[current].classList.remove('is-active');
    if (dots[current]) dots[current].classList.remove('is-active');
    current = (idx + slides.length) % slides.length;
    slides[current].classList.add('is-active');
    if (dots[current]) dots[current].classList.add('is-active');
  }

  if (prevBtn) prevBtn.addEventListener('click', function() { showSlide(current - 1); });
  if (nextBtn) nextBtn.addEventListener('click', function() { showSlide(current + 1); });

  dots.forEach(function(dot, idx) {
    dot.addEventListener('click', function() { showSlide(idx); });
  });

  /* Touch Swipe Detection */
  var startX = 0, endX = 0;
  slider.addEventListener('touchstart', function(e) { startX = e.changedTouches[0].screenX; }, { passive: true });
  slider.addEventListener('touchend', function(e) {
    endX = e.changedTouches[0].screenX;
    if (Math.abs(startX - endX) > 40) {
      if (startX > endX) showSlide(current + 1);
      else showSlide(current - 1);
    }
  }, { passive: true });
})();
</script>

