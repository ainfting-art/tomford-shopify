{%- comment -%}
  MAISON AMIIR — The Maison Promise (Editorial Desktop Spread)
  A luxury maison manifesto section featuring a 2-column layout:
  Left: Editorial visual area with automatic single-image/slider switching and floating decorative assets.
  Right: Content spread with eyebrow, heading, intro, subtle watermark logo, and a 2x2 Promise Grid.
  Built entirely schema-driven with no hardcoded styling. Desktop priority.
{%- endcomment -%}

{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Marcellus&display=swap');

  #shopify-section-{{ section.id }} {
    opacity: 1 !important;
    transform: none !important;
  }

  #ma-promise-{{ section.id }} {
    /* Color Presets & Controls */
    {% if section.settings.color_preset == 'ivory' %}
      --bg-color: #F4EEE1;
      --text-color: #171310;
      --heading-color: #171310;
      --eyebrow-color: #8C703B;
      --icon-color: #A8894E;
      --border-color: rgba(23, 19, 16, 0.14);
      --watermark-tint: 23, 19, 16;
    {% elsif section.settings.color_preset == 'noir' %}
      --bg-color: #0F0D0C;
      --text-color: #E2DCD3;
      --heading-color: #F4EEE1;
      --eyebrow-color: #C6A15B;
      --icon-color: #C6A15B;
      --border-color: rgba(244, 238, 225, 0.12);
      --watermark-tint: 244, 238, 225;
    {% elsif section.settings.color_preset == 'light' %}
      --bg-color: #FFFFFF;
      --text-color: #222222;
      --heading-color: #000000;
      --eyebrow-color: #666666;
      --icon-color: #111111;
      --border-color: rgba(0, 0, 0, 0.08);
      --watermark-tint: 0, 0, 0;
    {% elsif section.settings.color_preset == 'dark' %}
      --bg-color: #171514;
      --text-color: #A39D96;
      --heading-color: #E5E0D8;
      --eyebrow-color: #9E825E;
      --icon-color: #9E825E;
      --border-color: rgba(229, 224, 216, 0.08);
      --watermark-tint: 229, 224, 216;
    {% else %}
      --bg-color: {{ section.settings.bg_color }};
      --text-color: {{ section.settings.text_color }};
      --heading-color: {{ section.settings.heading_color }};
      --eyebrow-color: {{ section.settings.eyebrow_color }};
      --icon-color: {{ section.settings.icon_color }};
      --border-color: {{ section.settings.grid_border_color }};
      --watermark-tint: 23, 19, 16;
    {% endif %}

    /* Spacing & Layout */
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --padding-left: {{ section.settings.padding_left }}px;
    --padding-right: {{ section.settings.padding_right }}px;
    --margin-top: {{ section.settings.margin_top }}px;
    --margin-bottom: {{ section.settings.margin_bottom }}px;
    --section-width: {% if section.settings.section_width == 'full' %}100%{% else %}{{ section.settings.content_max_width }}px{% endif %};
    --col-gap: {{ section.settings.col_gap }}px;
    --row-gap: {{ section.settings.row_gap }}px;
    --grid-gap: {{ section.settings.grid_gap }}px;
    --left-col-width: {{ section.settings.left_col_width }}%;
    --right-col-width: {{ section.settings.right_col_width }}%;

    /* Typography */
    --font-eyebrow: {{ section.settings.eyebrow_font }}, 'Marcellus', serif;
    --font-heading: {{ section.settings.heading_font }}, 'Cormorant Garamond', Georgia, serif;
    --font-body: {{ section.settings.body_font }}, 'Cormorant Garamond', Georgia, serif;
    --font-promise-title: {{ section.settings.promise_title_font }}, 'Cormorant Garamond', Georgia, serif;
    --font-promise-body: {{ section.settings.promise_body_font }}, 'Cormorant Garamond', Georgia, serif;

    /* Dividers */
    --line-style: {{ section.settings.grid_line_style }};
    --line-thickness: {{ section.settings.grid_line_thickness }}px;
    --line-opacity: {{ section.settings.grid_line_opacity | divided_by: 100.0 }};

    position: relative;
    overflow: hidden;
    background-color: var(--bg-color);
    color: var(--text-color);
    padding: var(--padding-top) var(--padding-right) var(--padding-bottom) var(--padding-left);
    margin-top: var(--margin-top);
    margin-bottom: var(--margin-bottom);
    min-height: {{ section.settings.min_height }}px;
    {% if section.settings.max_height > 0 %}max-height: {{ section.settings.max_height }}px;{% endif %}
    display: flex;
    align-items: {{ section.settings.vertical_alignment }};
    justify-content: center;
  }

  /* Main Container */
  #ma-promise-{{ section.id }} .ma-promise__container {
    width: 100%;
    max-width: var(--section-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: var(--left-col-width) var(--right-col-width);
    column-gap: var(--col-gap);
    align-items: {{ section.settings.vertical_alignment }};
    position: relative;
    z-index: 2;
  }

  /* LEFT COLUMN: Editorial Visual Area */
  #ma-promise-{{ section.id }} .ma-promise__visual {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: {{ section.settings.image_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #ma-promise-{{ section.id }} .ma-promise__slider-wrapper {
    position: relative;
    width: {{ section.settings.image_width }}%;
    height: {{ section.settings.image_height }}px;
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
    box-shadow: {% if section.settings.image_shadow %}0 20px 40px rgba(0,0,0,0.08){% else %}none{% endif %};
    transform: scale({{ section.settings.image_scale | divided_by: 100.0 }}) translate({{ section.settings.image_pos_x }}px, {{ section.settings.image_pos_y }}px);
    opacity: {{ section.settings.image_opacity | divided_by: 100.0 }};
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #ma-promise-{{ section.id }} .ma-promise__slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.8s ease-in-out;
    pointer-events: none;
  }

  #ma-promise-{{ section.id }} .ma-promise__slide.is-active {
    opacity: 1;
    pointer-events: auto;
    position: relative;
  }

  #ma-promise-{{ section.id }} .ma-promise__slide img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.object_fit }};
    object-position: {{ section.settings.object_position }};
    display: block;
  }

  /* Slider Navigation (Only visible if > 1 image) */
  #ma-promise-{{ section.id }} .ma-promise__nav {
    position: absolute;
    bottom: 20px;
    right: 20px;
    display: flex;
    gap: 8px;
    z-index: 5;
  }

  #ma-promise-{{ section.id }} .ma-promise__nav-btn {
    background: rgba(255, 255, 255, 0.8);
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #171310;
    transition: background 0.3s ease;
  }

  #ma-promise-{{ section.id }} .ma-promise__nav-btn:hover {
    background: #FFFFFF;
  }

  /* Floating Decorative Assets */
  #ma-promise-{{ section.id }} .ma-promise__decorative-asset {
    position: absolute;
    z-index: 10;
    pointer-events: none;
    transition: transform 0.4s ease;
  }

  #ma-promise-{{ section.id }} .ma-promise__decorative-asset img {
    display: block;
    max-width: 100%;
    height: auto;
    filter: drop-shadow(0 15px 25px rgba(0,0,0,0.12));
  }

  /* RIGHT COLUMN: Content Spread */
  #ma-promise-{{ section.id }} .ma-promise__content {
    position: relative;
    padding: {{ section.settings.content_spacing }}px 0;
    text-align: {{ section.settings.text_alignment }};
    transform: translate({{ section.settings.content_pos_x }}px, {{ section.settings.content_pos_y }}px);
  }

  /* Watermark Logo Implementation (Reusing Live Reference Code) */
  {% if section.settings.enable_watermark %}
  #ma-promise-{{ section.id }} .ma-promise__watermark {
    position: absolute;
    left: {{ section.settings.watermark_pos_x }}%;
    top: {{ section.settings.watermark_pos_y }}%;
    transform: translate(-50%, -50%) scale({{ section.settings.watermark_scale | divided_by: 100.0 }}) rotate({{ section.settings.watermark_rotation }}deg);
    width: min(85%, 650px);
    opacity: {{ section.settings.watermark_opacity | divided_by: 100.0 }};
    filter: blur({{ section.settings.watermark_blur }}px);
    z-index: 0;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #ma-promise-{{ section.id }} .ma-promise__watermark img {
    width: 100%;
    height: auto;
    display: block;
  }
  {% endif %}

  #ma-promise-{{ section.id }} .ma-promise__header {
    position: relative;
    z-index: 2;
    margin-bottom: 48px;
  }

  #ma-promise-{{ section.id }} .ma-promise__eyebrow {
    font-family: var(--font-eyebrow);
    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: {{ section.settings.eyebrow_weight }};
    color: var(--eyebrow-color);
    letter-spacing: {{ section.settings.eyebrow_letter_spacing }}px;
    text-transform: uppercase;
    margin: 0 0 16px;
    display: flex;
    align-items: center;
    justify-content: {{ section.settings.text_alignment }};
    gap: 12px;
  }

  #ma-promise-{{ section.id }} .ma-promise__heading {
    font-family: var(--font-heading) !important;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }} !important;
    color: var(--heading-color);
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    margin: 0 0 20px;
  }

  #ma-promise-{{ section.id }} .ma-promise__intro {
    font-family: var(--font-body);
    font-size: {{ section.settings.body_size }}px;
    font-weight: {{ section.settings.body_weight }};
    color: var(--text-color);
    letter-spacing: {{ section.settings.body_letter_spacing }}px;
    line-height: {{ section.settings.body_line_height | divided_by: 100.0 }};
    margin: 0 auto;
    max-width: 48ch;
    font-style: italic;
  }

  /* 2x2 Editorial Promise Grid */
  #ma-promise-{{ section.id }} .ma-promise__grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--grid-gap);
    border-top: var(--line-thickness) var(--line-style) rgba(0, 0, 0, var(--line-opacity));
    border-color: var(--border-color);
    margin-top: {{ section.settings.row_gap }}px;
  }

  #ma-promise-{{ section.id }} .ma-promise__card {
    position: relative;
    padding: 36px 28px;
    text-align: {{ section.settings.text_alignment }};
    display: flex;
    flex-direction: column;
    align-items: {% if section.settings.text_alignment == 'center' %}center{% elsif section.settings.text_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
  }

  /* Grid Hairline Borders */
  #ma-promise-{{ section.id }} .ma-promise__card:nth-child(odd) {
    border-right: var(--line-thickness) var(--line-style) var(--border-color);
  }
  #ma-promise-{{ section.id }} .ma-promise__card:nth-child(1),
  #ma-promise-{{ section.id }} .ma-promise__card:nth-child(2) {
    border-bottom: var(--line-thickness) var(--line-style) var(--border-color);
  }

  #ma-promise-{{ section.id }} .ma-promise__card-icon {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    color: var(--icon-color);
    opacity: {{ section.settings.icon_opacity | divided_by: 100.0 }};
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #ma-promise-{{ section.id }} .ma-promise__card-icon svg,
  #ma-promise-{{ section.id }} .ma-promise__card-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.15;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #ma-promise-{{ section.id }} .ma-promise__card-eyebrow {
    font-family: var(--font-eyebrow);
    font-size: 9.5px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--eyebrow-color);
    margin: 0 0 8px;
  }

  #ma-promise-{{ section.id }} .ma-promise__card-title {
    font-family: var(--font-promise-title);
    font-size: {{ section.settings.promise_title_size }}px;
    font-weight: {{ section.settings.promise_title_weight }};
    color: var(--heading-color);
    margin: 0 0 10px;
    line-height: 1.15;
  }

  #ma-promise-{{ section.id }} .ma-promise__card-body {
    font-family: var(--font-promise-body);
    font-size: {{ section.settings.promise_body_size }}px;
    font-weight: {{ section.settings.promise_body_weight }};
    color: var(--text-color);
    line-height: {{ section.settings.promise_body_line_height | divided_by: 100.0 }};
    margin: 0;
    max-width: 32ch;
  }

  /* Optional Animations */
  {% if section.settings.enable_animations %}
  #ma-promise-{{ section.id }} .anim-item {
    opacity: 0;
    transform: translateY(20px);
    animation: maFadeUp {{ section.settings.animation_speed }}s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes maFadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  {% endif %}
{%- endstyle -%}

<section id="ma-promise-{{ section.id }}" class="ma-promise">
  <div class="ma-promise__container">
    
    {%- comment -%} LEFT COLUMN: Editorial Visual Area {%- endcomment -%}
    <div class="ma-promise__visual">
      
      {%- comment -%} Floating Decorative Assets {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'decorative_asset' and block.settings.enable_asset -%}
          <div class="ma-promise__decorative-asset" style="
            top: {{ block.settings.pos_y }}%;
            left: {{ block.settings.pos_x }}%;
            width: {{ block.settings.asset_width }}px;
            transform: rotate({{ block.settings.rotation }}deg);
            opacity: {{ block.settings.opacity | divided_by: 100.0 }};
          ">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy">
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} Image Slider / Single Image Composition {%- endcomment -%}
      <div class="ma-promise__slider-wrapper" id="slider-{{ section.id }}">
        {%- assign image_count = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'visual_image' -%}
            {%- assign image_count = image_count | plus: 1 -%}
            <div class="ma-promise__slide {% if image_count == 1 %}is-active{% endif %}" data-index="{{ image_count }}">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 1400 }}" 
                     alt="{{ block.settings.image.alt | escape }}" 
                     style="object-position: {{ block.settings.focal_point }};"
                     loading="lazy">
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- if image_count == 0 -%}
          <div class="ma-promise__slide is-active">
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}

        {%- if image_count > 1 -%}
          <div class="ma-promise__nav">
            <button class="ma-promise__nav-btn" data-action="prev" aria-label="Previous image">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <button class="ma-promise__nav-btn" data-action="next" aria-label="Next image">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
            </button>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} RIGHT COLUMN: Content Spread {%- endcomment -%}
    <div class="ma-promise__content">
      
      {%- comment -%} Reused Watermark Implementation from Live Section {%- endcomment -%}
      {%- if section.settings.enable_watermark -%}
        <div class="ma-promise__watermark" aria-hidden="true">
          <img src="https://maisonamiir.com/cdn/shop/files/MAISON-LOGO-NEW.png?v=1775626552&width=800" alt="" loading="lazy">
        </div>
      {%- endif -%}

      <div class="ma-promise__header {% if section.settings.enable_animations %}anim-item{% endif %}" style="animation-delay: {{ section.settings.animation_delay }}s;">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ma-promise__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="ma-promise__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <div class="ma-promise__intro">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>

      <div class="ma-promise__grid {% if section.settings.enable_animations %}anim-item{% endif %}" style="animation-delay: {{ section.settings.animation_delay | plus: 0.2 }}s;">
        {%- for block in section.blocks -%}
          {%- if block.type == 'promise_card' -%}
            <div class="ma-promise__card" {{ block.shopify_attributes }}>
              
              <div class="ma-promise__card-icon">
                {%- if block.settings.custom_svg != blank -%}
                  {{ block.settings.custom_svg }}
                {%- elsif block.settings.image_icon != blank -%}
                  <img src="{{ block.settings.image_icon | image_url: width: 100 }}" alt="" loading="lazy">
                {%- else -%}
                  {%- case block.settings.builtin_icon -%}
                    {%- when 'tester' -%}
                      <svg viewBox="0 0 24 24"><path d="M9 2.5h6M10 2.5v4.6L6.5 15.1A3 3 0 0 0 9.3 20.9h5.4a3 3 0 0 0 2.8-5.8L14 7.1V2.5"/><path d="M8 14.5h8"/></svg>
                    {%- when 'return' -%}
                      <svg viewBox="0 0 24 24"><path d="M12 3l7 2.6v5.1c0 4.4-3 7.4-7 8.8-4-1.4-7-4.4-7-8.8V5.6L12 3z"/><path d="M9 12l2 2 4-4.2"/></svg>
                    {%- when 'climate' -%}
                      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4.1"/><path d="M12 2v2.3M12 19.7V22M2 12h2.3M19.7 12H22M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M19.1 4.9l-1.6 1.6M6.5 17.5l-1.6 1.6"/></svg>
                    {%- when 'formula' -%}
                      <svg viewBox="0 0 24 24"><path d="M12 3s6 6.6 6 11a6 6 0 0 1-12 0c0-4.4 6-11 6-11z"/><path d="M9.6 14.2a2.6 2.6 0 0 0 2.1 2.4"/></svg>
                  {%- endcase -%}
                {%- endif -%}
              </div>

              {%- if block.settings.eyebrow != blank -%}
                <p class="ma-promise__card-eyebrow">{{ block.settings.eyebrow | escape }}</p>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="ma-promise__card-title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <p class="ma-promise__card-body">{{ block.settings.body | escape }}</p>
              {%- endif -%}

            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>

  </div>
</section>

{%- comment -%} Lightweight Vanilla JS for Automatic Slider (Only executes if > 1 slide) {%- endcomment -%}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const slider = document.getElementById('slider-{{ section.id }}');
    if (!slider) return;
    const slides = slider.querySelectorAll('.ma-promise__slide');
    if (slides.length <= 1) return;

    let currentIndex = 0;
    const prevBtn = slider.querySelector('[data-action="prev"]');
    const nextBtn = slider.querySelector('[data-action="next"]');

    function showSlide(index) {
      slides[currentIndex].classList.remove('is-active');
      currentIndex = (index + slides.length) % slides.length;
      slides[currentIndex].classList.add('is-active');
    }

    if (prevBtn) prevBtn.addEventListener('click', () => showSlide(currentIndex - 1));
    if (nextBtn) nextBtn.addEventListener('click', () => showSlide(currentIndex + 1));
  });
</script>

{% schema %}
{
  "name": "The Maison Promise",
  "tag": "section",
  "class": "ma-maison-promise-section",
  "settings": [
    {
      "type": "header",
      "content": "Color Presets"
    },
    {
      "type": "select",
      "id": "color_preset",
      "label": "Theme Mode Preset",
      "options": [
        { "value": "ivory", "label": "Maison Ivory (Warm & Gold)" },
        { "value": "noir", "label": "Maison Noir (Dark & Gold)" },
        { "value": "light", "label": "Editorial Light (Minimal White)" },
        { "value": "dark", "label": "Editorial Dark (Slate Luxury)" },
        { "value": "custom", "label": "Custom (Use Controls Below)" }
      ],
      "default": "ivory"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom Background Color",
      "default": "#F4EEE1"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom Body Text Color",
      "default": "#171310"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Custom Heading Color",
      "default": "#171310"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Custom Eyebrow Color",
      "default": "#8C703B"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Custom Icon Color",
      "default": "#A8894E"
    },
    {
      "type": "header",
      "content": "Typography Controls"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Section Eyebrow",
      "default": "BUY WITHOUT A DOUBT"
    },
    {
      "type": "text",
      "id": "eyebrow_font",
      "label": "Eyebrow Font Family",
      "default": "Marcellus"
    },
    {
      "type": "range",
