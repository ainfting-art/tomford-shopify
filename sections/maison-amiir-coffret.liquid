{%- comment -%} ── JAVASCRIPT ─────────────────────────────────────────── {%- endcomment -%}
<script>
(function () {
  var sec = document.getElementById('ma-cof-{{ sid }}');
  if (!sec) return;

  var useSlider = sec.dataset.slider === 'true';
  var autoplay  = sec.dataset.autoplay === 'true';
  var speed     = parseInt(sec.dataset.speed, 10) || 5000;
  var loop      = sec.dataset.loop === 'true';

  {% if section.settings.enable_animations %}
  (function () {
    var anims = sec.querySelectorAll('.ma-cof__anim');
    if (!anims.length || !('IntersectionObserver' in window)) {
      anims.forEach(function (el) { el.classList.add('is-visible'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    anims.forEach(function (el) { io.observe(el); });
  })();
  {% endif %}

  if (!useSlider) return;

  function initSlider(sliderId) {
    var container = document.getElementById(sliderId);
    if (!container) return;
    var slides = Array.from(container.querySelectorAll('.ma-cof__slide'));
    if (slides.length < 2) return;
    var current = 0;
    var timer   = null;

    var dotsWrap = sec.querySelector('.ma-cof__dots[data-target="' + sliderId + '"]');
    var dots = dotsWrap ? Array.from(dotsWrap.querySelectorAll('.ma-cof__dot')) : [];

    function goTo(idx) {
      slides[current].classList.remove('is-active');
      if (dots[current]) dots[current].classList.remove('is-active');
      current = (idx + slides.length) % slides.length;
      slides[current].classList.add('is-active');
      if (dots[current]) dots[current].classList.add('is-active');
    }

    function next() { goTo(current + 1); }
    function prev() { goTo(current - 1); }

    var prevBtn = sec.querySelector('.ma-cof__arrow--prev[data-target="' + sliderId + '"]');
    var nextBtn = sec.querySelector('.ma-cof__arrow--next[data-target="' + sliderId + '"]');
    if (prevBtn) prevBtn.addEventListener('click', function () { clearInterval(timer); prev(); if (autoplay) startAuto(); });
    if (nextBtn) nextBtn.addEventListener('click', function () { clearInterval(timer); next(); if (autoplay) startAuto(); });

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        clearInterval(timer);
        goTo(parseInt(this.dataset.index, 10));
        if (autoplay) startAuto();
      });
    });

    /* Mobile Touch Swipe Detection */
    var startX = 0, endX = 0;
    container.addEventListener('touchstart', function(e) {
      startX = e.changedTouches[0].screenX;
      clearInterval(timer);
    }, { passive: true });
    container.addEventListener('touchend', function(e) {
      endX = e.changedTouches[0].screenX;
      var diff = startX - endX;
      if (Math.abs(diff) > 40) {
        if (diff > 0) { next(); } else { prev(); }
      }
      if (autoplay) startAuto();
    }, { passive: true });

    function startAuto() {
      timer = setInterval(function () {
        if (!loop && current === slides.length - 1) { clearInterval(timer); return; }
        next();
      }, speed);
    }

    if (autoplay) startAuto();
  }

  initSlider('ma-cof-slider-dt-{{ sid }}');
  initSlider('ma-cof-slider-mob-{{ sid }}');
})();
</script>

