ransform: translateY(-50%);\n      width: 40%;\n      align-items: flex-start;\n      text-align: left;\n    }\n    .ma-banner__eyebrow  { font-size: 15px;  margin-bottom: 20px; }\n    .ma-banner__headline { font-size: clamp(36px, 3.6vw, 58px); margin-bottom: 22px; max-width: 9em; }\n    .ma-banner__sub      { font-size: 19px;  margin-bottom: 34px; max-width: 360px; }\n    .ma-banner__shop     { font-size: 14px; }\n    .ma-banner__m { display: none; }\n  }\n\n  /* MOBILE */\n  @media (max-width: 767px) {\n    .ma-banner::after {\n      content: '';\n      position: absolute;\n      left: 0; right: 0; bottom: 0;\n      height: 42%;\n      z-index: 1;\n      pointer-events: none;\n      background: linear-gradient(\n        to top,\n        rgba(10, 18, 32, 0.92) 0%,\n        rgba(10, 18, 32, 0.55) 45%,\n        rgba(10, 18, 32, 0.0) 100%\n      );\n    }\n    .ma-banner__text {\n      left: 22px;\n      right: 22px;\n      bottom: 24px;\n      align-items: center;\n      text-align: center;\n    }\n    .ma-banner__eyebrow  { font-size: 12px; letter-spacing: 0.24em; margin-bottom: 11px; }\n    .ma-banner__headline { font-size: 22px; margin-bottom: 12px; }\n    .ma-banner__sub      { font-size: 14px; margin-bottom: 18px; }\n    .ma-banner__shop     { font-size: 13px; padding-bottom: 5px; }\n    .ma-banner__d { display: none; }\n  }\n</style>\n\n<section class=\"ma-banner\">\n\n  <picture>\n    <source media=\"(max-width: 767px)\" srcset=\"{{ 'ma-iconic-mobile.jpg' | asset_url }}\">\n    <img class=\"ma-banner__img\"\n         style=\"display:block !important; width:100% !important; height:auto !important; max-height:none !important; object-fit:contain !important; aspect-ratio:auto !important;\"\n         src=\"https://cdn.shopify.com/s/files/1/0979/6553/9647/files/Hero.jpg?v=1782406611\"\n         alt=\"The Iconic Collection — Maison Amiir\">\n  </picture>\n\n  <div class=\"ma-banner__text\">\n    <p class=\"ma-banner__eyebrow\">The Iconic Collection</p>\n    <h2 class=\"ma-banner__headline\">Worn by those who arrive first.</h2>\n\n    <p class=\"ma-banner__sub ma-banner__d\">Extrait De Parfum. Crafted without compromise.\nOne unmistakable signature.</p>\n    <a class=\"ma-banner__shop ma-banner__d\" href=\"/collections/all-perfumes\">Shop the Collection</a>\n\n    <p class=\"ma-banner__sub ma-banner__m\">Extrait de parfum. One unmistakable signature.</p>\n    <a class=\"ma-banner__shop ma-banner__m\" href=\"/collections/all-perfumes\">Shop Now</a>\n  </div>\n\n</section>\n\n<script>\n  document.querySelector('.ma-banner').addEventListener('click', function(e) {\n    if (!e.target.closest('a')) {\n      window.location.href = '/collections/all-perfumes';\n    }\n  });\n</script>",
