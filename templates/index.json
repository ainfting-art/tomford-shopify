    "ma_editorial_social_proof_6tWRTb": {
      "type": "ma-editorial-social-proof",
      "blocks": {
        "review_axFFD9": {
          "type": "review",
          "settings": {
            "product": "desert-velvet-oud",
            "stars": 5,
            "heading": "My boyfriend wears it and I'm obsessed",
            "quote": "My boyfriend bought this and honestly I want to wear it myself. The amber and oud combination smells incredible on skin. Very long lasting. I can smell it on his jacket even after he's gone for the day. Might buy my own bottle haha.",
            "author": "Ananya T"
          }
        },
        "review_BcWrR7": {
          "type": "review",
          "settings": {
            "product": "earthly-accord",
            "stars": 5,
            "heading": "Very natural and grounded smell",
            "quote": "Hard to describe but it smells like a walk through a forest after rain. Really natural and clean. Not synthetic at all. I'm a fitness trainer and I apply this after morning workouts before clients come. Its subtle enough to not overwhelm but present enough to smell fresh and professional. Love it.",
            "author": "Abhishek R"
          }
        },
        "review_F6UUiC": {
          "type": "review",
          "settings": {
            "product": "horizon-valley",
            "stars": 5,
            "heading": "My husband uses it everyday",
            "quote": "Gifted this to my husband for our anniversary trip. He wore it every single day of the trip. Says it felt right with the mountains and outdoors we were visiting. Now it's become his daily scent back home too. Very happy with this purchase.",
            "author": "Swati N"
          }
        },
        "review_AeGifM": {
          "type": "review",
          "settings": {
            "product": "sailor-elixir",
            "stars": 5,
            "heading": "Absolute beast mode fragrance",
            "quote": "I need to be careful how many sprays I do with this one lol. Two sprays and the whole room knows I'm there. Sailor Elixir is bold, sweet, and incredibly addictive smelling. I've had 4 different people ask about it in the last month alone. The sweet seductive combination is just irresistible.",
            "author": "Vihaan S"
          }
        },
        "review_6qdhFa": {
          "type": "review",
          "settings": {
            "product": "floral-tapestry",
            "stars": 5,
            "heading": "Gifted to my daughter",
            "quote": "My 21 year old daughter loves this. She's been wearing it daily since I gave it to her last month. The scent is perfect for her age - fresh, feminine, not too mature. I can smell it on her when she gives me a hug and it always makes me smile.",
            "author": "Geeta B"
          }
        },
        "review_VnbcpP": {
          "type": "review",
          "settings": {
            "product": "raised-in-rome",
            "stars": 5,
            "heading": "My son loves this for office",
            "quote": "Gifted to my 32 year old son who works in sales. He says his clients now remember him as the guy who smells great. Which apparently helps in his line of work. Very happy with the product and the service.",
            "author": "Manish D"
          }
        },
        "review_x9WfW3": {
          "type": "review",
          "settings": {
            "product": "femme-freedom",
            "stars": 5,
            "heading": "A confident woman's scent",
            "quote": "I'm 50 years old and this fragrance makes me feel young and vibrant. Not trying to be something it's not - it's just beautiful, confident, and elegant. I wore it to my daughter's wedding and received so many compliments from guests. Longevity is also excellent.",
            "author": "Padma I"
          }
        }
      },
      "block_order": [
        "review_axFFD9",
