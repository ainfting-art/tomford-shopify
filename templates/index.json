ht:22px;display:block;filter:drop-shadow(0 1px 6px rgba(0,0,0,.6));transition:opacity .2s ease}\n.mute-toggle:hover svg{opacity:.75}\n@media(max-width:770px){.mute-toggle{bottom:16px;right:12px}.mute-toggle svg{width:20px;height:20px}}@media(max-width:770px){.hero-overlay-headline{max-width:9em}.hero-overlay-ctas{flex-direction:column}.hero-overlay-cta{flex:0 0 auto;width:100%}}\n</style>\n\n<div class=\"custom-hero-video\">\n  <video class=\"desktop-video\" autoplay loop muted playsinline data-src=\"https://cdn.shopify.com/videos/c/o/v/fbfa22cb1b0d4e51b748da7e06db1f85.mp4\"></video>\n  <video class=\"mobile-video\" autoplay loop muted playsinline data-src=\"https://cdn.shopify.com/videos/c/o/v/2530bf3f1b634feba91cc6a29f9c0076.mp4\"></video>\n  <script>(function(){var m=window.matchMedia('(max-width: 770px)').matches;var v=document.querySelector(m?'.custom-hero-video .mobile-video':'.custom-hero-video .desktop-video');if(v&&!v.getAttribute('src')){v.setAttribute('src',v.getAttribute('data-src'));v.load();var p=v.play();if(p&&p.catch)p.catch(function(){});}})();</script>\n\n  <div class=\"hero-overlay-gradient\"></div>\n  <div class=\"hero-overlay-scrim\"></div>\n  <div class=\"hero-overlay-content\">\n    <p class=\"hero-overlay-eyebrow\">Extrait de Parfum · 30% Concentration</p>\n    <h1 class=\"hero-overlay-headline\">The world's iconic scents. Honestly priced.</h1>\n    <p class=\"hero-overlay-subline\">Same pyramids, same oil houses, 30% extrait. <strong>The ₹28,000 counter scent, from ₹2,200.</strong></p>\n    <div class=\"hero-overlay-ctas\">\n      <a href=\"/pages/find-your-signature\" class=\"hero-overlay-cta hero-overlay-cta--ghost\">Find Your Signature</a>\n    </div>\n  </div>\n\n  <button class=\"mute-toggle\" aria-label=\"Toggle mute\">\n    <svg class=\"icon-unmuted\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"display:none\">\n      <polygon points=\"11 5 6 9 2 9